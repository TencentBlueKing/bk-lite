#!/bin/sh
# 仓库唯一 pre-commit 入口（web/mobile 的 prepare 均指向根目录 .husky）。
# web 变更：变更文件 eslint + 全仓 pnpm type-check；mobile 同理。
# 运营分析 i18n：只在指定路径上额外跑，不跟每次 web ts 走。

CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)


# ===== Python pre-commit (server) =====
# Set BKLITE_PYTHON env var to override, e.g.:
#   export BKLITE_PYTHON="/path/to/venv/bin/python"
# 语言包是 yaml。只改 language/ 时也要进 pre-commit，目录门禁的 files 过滤才会生效。
if echo "$CHANGED_FILES" | grep -Eq '\.py$|^server/apps/(operation_analysis|system_mgmt)/language/'; then
    ARGS="hook-impl --config=server/.pre-commit-config.yaml --hook-type=pre-commit --skip-on-missing-config"

    # Use .git/hooks as hook-dir to avoid Windows file lock on .husky/pre-commit
    # during pre-commit's stash/restore cycle
    HOOK_DIR="$(git rev-parse --git-dir)/hooks"

    if [ -n "$BKLITE_PYTHON" ] && [ -x "$BKLITE_PYTHON" ]; then
        "$BKLITE_PYTHON" -mpre_commit $ARGS --hook-dir "$HOOK_DIR" -- "$@"
    elif command -v pre-commit > /dev/null; then
        pre-commit $ARGS --hook-dir "$HOOK_DIR" -- "$@"
    elif command -v python > /dev/null; then
        python -mpre_commit $ARGS --hook-dir "$HOOK_DIR" -- "$@"
    else
        echo 'pre-commit not found. Set BKLITE_PYTHON or activate your virtualenv.' 1>&2
        exit 1
    fi

    PYTHON_EXIT=$?
    if [ $PYTHON_EXIT -ne 0 ]; then
        exit $PYTHON_EXIT
    fi
fi

# ===== Web frontend checks =====
WEB_FILES=$(echo "$CHANGED_FILES" | grep "^web/" | grep -E '\.(js|jsx|ts|tsx)$' || true)
if [ -n "$WEB_FILES" ]; then
    echo "Checking web project..."
    WEB_LINT_FILES=$(echo "$WEB_FILES" | sed 's|^web/||' | grep -v '^scripts/' || true)
    cd web || exit 1
    if [ -n "$WEB_LINT_FILES" ]; then
        echo "$WEB_LINT_FILES" | xargs pnpm eslint || exit 1
    fi
    pnpm type-check || exit 1
    cd ..
fi

# 运营分析 i18n：源码 / 应用语言包 / 共享 en|zh / 门禁脚本。json 变更不进上面的 eslint 分支。
OPS_I18N_FILES=$(echo "$CHANGED_FILES" | grep -E \
    -e '^web/src/app/ops-analysis/' \
    -e '^web/src/locales/(en|zh)\.json$' \
    -e '^web/scripts/ops-analysis-i18n-check-test\.ts$' \
    -e '^web/src/app/ops-analysis/locales/__tests__/localeIcu\.test\.ts$' \
    || true)
if [ -n "$OPS_I18N_FILES" ]; then
    echo "Checking ops-analysis i18n..."
    (cd web && pnpm test:ops-analysis-i18n) || exit 1
fi

# ===== Mobile frontend checks =====
MOBILE_FILES=$(echo "$CHANGED_FILES" | grep "^mobile/" | grep -E '\.(js|jsx|ts|tsx)$' || true)
if [ -n "$MOBILE_FILES" ]; then
    echo "Checking mobile project..."
    MOBILE_LINT_FILES=$(echo "$MOBILE_FILES" | sed 's|^mobile/||')
    cd mobile && echo "$MOBILE_LINT_FILES" | xargs pnpm eslint || exit 1
    pnpm type-check || exit 1
    cd ..
fi

echo "Pre-commit checks passed!"
