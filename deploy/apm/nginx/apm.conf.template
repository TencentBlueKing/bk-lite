limit_req_zone $binary_remote_addr zone=apm_ingest:1m rate=${APM_INGEST_RATE};

server {
    listen 8080;
    server_name _;

    client_max_body_size ${APM_MAX_REQUEST_BODY};
    limit_req_status 429;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /healthz/collector {
        access_log off;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization "";
        proxy_set_header X-BK-Ingest-Source-Id "";
        proxy_pass http://apm-otel-collector:13133/;
    }

    location = /v1/traces {
        if ($request_method != POST) {
            return 405;
        }

        limit_req zone=apm_ingest burst=${APM_INGEST_BURST} nodelay;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_set_header Connection "";
        proxy_set_header Authorization "";
        proxy_set_header X-BK-Ingest-Source-Id "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://apm-otel-collector:4318;
    }

    location / {
        return 404;
    }
}

server {
    listen 8081;
    http2 on;
    server_name _;

    client_max_body_size ${APM_MAX_REQUEST_BODY};
    limit_req_status 429;

    location = /opentelemetry.proto.collector.trace.v1.TraceService/Export {
        limit_req zone=apm_ingest burst=${APM_INGEST_BURST} nodelay;

        grpc_set_header Authorization "";
        grpc_set_header X-BK-Ingest-Source-Id "";
        grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        grpc_pass grpc://apm-otel-collector:4317;
    }

    location / {
        return 404;
    }
}
