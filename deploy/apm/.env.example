# 区域 Collector 身份与直连 OTLP 监听。生产默认绑定内网地址，不要暴露公网。
APM_CLOUD_REGION_ID=local
APM_OTLP_HTTP_BIND=127.0.0.1
APM_OTLP_HTTP_PORT=4318
APM_OTLP_GRPC_BIND=127.0.0.1
APM_OTLP_GRPC_PORT=4317
APM_REGIONAL_HEALTH_BIND=127.0.0.1
APM_REGIONAL_HEALTH_PORT=13133
APM_REGIONAL_METRICS_BIND=127.0.0.1
APM_REGIONAL_METRICS_PORT=18888

# 生产凭据必须由部署环境/Secret 注入。URL 用户密码方式与现有 Monitor/Log NATS 配置兼容；
# 也可改用 credentials 文件和 mTLS 文件路径。
APM_REGIONAL_NATS_URL=nats://apm_region:replace-me@nats.example.internal:4222
APM_SYSTEM_NATS_URL=nats://apm_system:replace-me@nats.example.internal:4222
APM_REGIONAL_NATS_CREDENTIALS_FILE=
APM_SYSTEM_NATS_CREDENTIALS_FILE=
APM_NATS_CA_FILE=
APM_NATS_CERT_FILE=
APM_NATS_KEY_FILE=
APM_NATS_TLS_SERVER_NAME=

# JetStream 由运维预创建；这些值是仓库参考配置与健康/容量契约。
APM_NATS_STREAM=APM_TRACES
APM_NATS_CONSUMER=BKLITE_APM_SYSTEM
APM_NATS_STREAM_MAX_BYTES=268435456
APM_NATS_STREAM_MAX_AGE=24h
APM_NATS_MAX_MESSAGE_BYTES=8388608
APM_NATS_DUPLICATE_WINDOW=2m
APM_NATS_ACK_WAIT=60s
APM_NATS_MAX_DELIVER=8
APM_NATS_MAX_ACK_PENDING=256

# 聚合消费者与明细分开 ACK。deliver new 不回放创建前的积压。
# ACK 等待 30s，短于系统侧 60s，且必须大于聚合接收器里写死的 downstream_timeout 20s。
# 重投上限 3：正常路径不 NAK，只给崩溃时尚未 ACK 的在途消息再试两次。不取 1，否则重启会丢已拉取的消息。
APM_AGG_NATS_CONSUMER=BKLITE_APM_AGGREGATE
APM_AGG_NATS_ACK_WAIT=30s
APM_AGG_NATS_MAX_DELIVER=3

# 区域持久队列使用 bytes 计量，达到上限时拒绝新批次并产生 Collector exporter 失败指标。
APM_REGIONAL_QUEUE_MAX_BYTES=1073741824
APM_TRACE_BATCH_SIZE=256
APM_TRACE_BATCH_MAX_SIZE=512

# 30 天 SLO 需要至少 30 天原始 Trace；默认留 5 天安全余量。
APM_TRACE_RETENTION=35d
APM_VICTORIATRACES_QUERY_BIND=127.0.0.1
APM_VICTORIATRACES_QUERY_PORT=10428
APM_VICTORIATRACES_OTLP_ENDPOINT=http://apm-victoria-traces:10428/insert/opentelemetry/v1/traces
APM_VICTORIATRACES_MAX_REQUEST_SIZE=8MiB
APM_SYSTEM_HEALTH_BIND=127.0.0.1
APM_SYSTEM_HEALTH_PORT=23133
APM_SYSTEM_METRICS_BIND=127.0.0.1
APM_SYSTEM_METRICS_PORT=18889

# Server 运行期查询与健康变量不在数据面 Compose 中重复维护；正式模板见：
# server/support-files/env/.env.apm.example

# 聚合 Collector 的聚合库。只配在聚合进程上。留空不会回落到 VICTORIAMETRICS_HOST，
# 但聚合进程无法启动。系统 Collector 不读这些变量，明细入库不受影响。
# 下面是示例名字，不是某个环境的真实地址。认证留空表示不加载 aggregate-auth.yaml。
AGG_VICTORIAMETRICS_WRITE_URL=http://aggregate-metrics.example.internal/api/v1/write
APM_AGG_SHARD=apm-aggregate-0
AGG_VICTORIAMETRICS_USER=
AGG_VICTORIAMETRICS_PASSWORD=
APM_AGG_METRICS_BIND=127.0.0.1
APM_AGG_METRICS_PORT=18428
# 聚合刷出间隔。Server 查询结束时间读同一个变量，改它必须同时改采集端和 Server。
APM_AGG_FLUSH_INTERVAL=60s
# 每个服务资源（命名空间 + 服务名 + 环境）的组合上限，不是全局。
APM_AGG_CARDINALITY_LIMIT=500
# 一条序列多久没有新 Span 后从聚合进程内存删除。再出现时从 0 计，increase() 按重置处理。
APM_AGG_SERIES_EXPIRATION=1h
# 依据容量压测约 236 MiB 聚合堆。软拒绝线 384 MiB，容器上限 640 MiB。
APM_AGG_COLLECTOR_MEMORY_LIMIT_MIB=512
APM_AGG_COLLECTOR_MEMORY_SPIKE_MIB=128
APM_AGG_COLLECTOR_CONTAINER_MEMORY_LIMIT=640m
APM_AGG_COLLECTOR_HEALTH_BIND=127.0.0.1
APM_AGG_COLLECTOR_HEALTH_PORT=33133
APM_AGG_COLLECTOR_METRICS_BIND=127.0.0.1
APM_AGG_COLLECTOR_METRICS_PORT=18890
