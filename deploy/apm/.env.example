# APM 控制面地址（边缘代理只调用机器鉴权，不转发 Span 给 Django）
APM_SERVER_UPSTREAM=http://host.docker.internal:8000

# 对外仅暴露 OTLP/HTTP；Collector 的 4317/4318 保留在内部网络。
APM_OTLP_HTTP_BIND=0.0.0.0
APM_OTLP_HTTP_PORT=4318
APM_INGEST_RATE=20r/s
APM_INGEST_BURST=40
APM_MAX_REQUEST_BODY=8m
APM_VICTORIATRACES_MAX_REQUEST_SIZE=8MiB

# 默认复用已有 VictoriaMetrics。启用 standalone-metrics profile 时改为容器内地址。
APM_VICTORIAMETRICS_WRITE_ENDPOINT=http://host.docker.internal:8428/api/v1/write
APM_TRACE_RETENTION=7d
APM_METRIC_RETENTION=30d
APM_SLOW_TRACE_THRESHOLD_MS=1000
APM_NORMAL_TRACE_SAMPLE_PERCENT=10
