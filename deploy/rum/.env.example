# Local contract fixture defaults — NOT production secrets.
# Bind publishes stay on loopback.

RUM_REDIS_BIND=127.0.0.1
RUM_REDIS_PORT=16379
RUM_NATS_BIND=127.0.0.1
RUM_NATS_PORT=14222
RUM_NATS_MONITOR_PORT=18223
RUM_VICTORIA_LOGS_BIND=127.0.0.1
RUM_VICTORIA_LOGS_PORT=19428
RUM_VICTORIA_TRACES_BIND=127.0.0.1
RUM_VICTORIA_TRACES_PORT=10429
RUM_MINIO_API_BIND=127.0.0.1
RUM_MINIO_API_PORT=19000
RUM_MINIO_CONSOLE_BIND=127.0.0.1
RUM_MINIO_CONSOLE_PORT=19001

RUM_NATS_CTL_USERNAME=rum_ctl
RUM_NATS_CTL_PASSWORD=rum-ctl-contract-password
RUM_NATS_CONTROLLER_USERNAME=rum_controller
RUM_NATS_CONTROLLER_PASSWORD=rum-controller-contract-password

RUM_MINIO_ROOT_USER=rumminio
RUM_MINIO_ROOT_PASSWORD=rum-minio-contract-password
RUM_MINIO_BUCKET=rum-replay

# Data-plane processes (make up-all / --profile dataplane).
# Secrets fall back to dev values matching redis/users.acl; override for any shared env.
RUM_COLLECTOR_IMAGE=bklite/rum-collector:0.1.0-bklite.1
RUM_GATEWAY_BIND=127.0.0.1
RUM_GATEWAY_COLLECT_PORT=4319
RUM_GATEWAY_REPLAY_PORT=4320
RUM_GATEWAY_HEALTH_PORT=13135
RUM_GATEWAY_METRICS_PORT=18890
RUM_MAINTAINER_METRICS_PORT=19090
RUM_IDENTITY_HMAC_CURRENT_VERSION=v1
RUM_TENANT_ID=core
RUM_REPLAY_INDEX_EPOCH=2026-01-01T00:00:00Z

# Host-side binary env (see collector/env/*.env.example) should point at:
#   redis://…@127.0.0.1:${RUM_REDIS_PORT}
#   nats://rum_controller:…@127.0.0.1:${RUM_NATS_PORT}
#   http://127.0.0.1:${RUM_VICTORIA_LOGS_PORT}
#   http://127.0.0.1:${RUM_VICTORIA_TRACES_PORT}
#   127.0.0.1:${RUM_MINIO_API_PORT}
