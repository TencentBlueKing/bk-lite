# Local/dev defaults for bklite-rum-gateway + otel/rum.gateway.dev.yaml
# against `deploy/rum` compose (`make up`). Host ports: Redis 16379,
# VictoriaLogs 19428, VictoriaTraces 10429, MinIO 19000.
# Redis URLs must use dedicated ACL usernames + 32–256 char URL-safe passwords
# (enforced by RUM ingress/session/replay config validation).
export RUM_TENANT_ID=core
export RUM_IDENTITY_HMAC_CURRENT='dev-bklite-rum-hmac-secret-key-32b'
export RUM_IDENTITY_HMAC_CURRENT_VERSION=v1
export RUM_IDENTITY_HMAC_PREVIOUS=
export RUM_IDENTITY_HMAC_PREVIOUS_VERSION=
export RUM_ADMISSION_REDIS_URL='redis://rum-admission:rum-admission-dev-secret-2026-000002@127.0.0.1:16379/0'
export RUM_SESSION_REDIS_URL='redis://rum-sessionizer:rum-sessionizer-dev-secret-2026-000004@127.0.0.1:16379/1'
export RUM_REPLAY_REDIS_URL='redis://rum-replay-exporter:rum-replay-exporter-dev-secret-000003@127.0.0.1:16379/2'
export RUM_VICTORIA_LOGS_ENDPOINT=http://127.0.0.1:19428
export RUM_VICTORIA_TRACES_ENDPOINT=http://127.0.0.1:10429
export RUM_MINIO_ENDPOINT=127.0.0.1:19000
export RUM_MINIO_ACCESS_KEY=rumminio
export RUM_MINIO_SECRET_KEY=rum-minio-contract-password
export RUM_MINIO_SECURE=false
export RUM_QUEUE_DIR=/tmp/bklite-rum-queue
