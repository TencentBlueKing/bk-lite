# Local/dev defaults for bklite-rum-maintainer against `deploy/rum` compose (`make up`).
# Host ports: Redis 16379, VictoriaLogs 19428, VictoriaTraces 10429, MinIO 19000.
# Redis URLs must use dedicated ACL usernames.
# MinIO secret key file must be mode 0600. Access key cannot be minioadmin.
export RUM_MAINTAINER_REDIS_URL='redis://rum-maintainer:rum-maintainer-dev-secret-2026-000005@127.0.0.1:16379/0'
export RUM_REPLAY_INDEX_REDIS_URL='redis://rum-replay-index-maintainer:rum-replay-index-maintainer-dev-secret-000006@127.0.0.1:16379/2'
export RUM_REPLAY_INDEX_EPOCH=2026-01-01T00:00:00Z
export RUM_VICTORIA_LOGS_ENDPOINT=http://127.0.0.1:19428
export RUM_VICTORIA_TRACES_ENDPOINT=http://127.0.0.1:10429
export RUM_MINIO_ENDPOINT=127.0.0.1:19000
export RUM_MINIO_SECURE=false
export RUM_MINIO_ACCESS_KEY=rumminio
export RUM_MINIO_SECRET_KEY_FILE=/tmp/bklite-rum-minio-secret
export RUM_MINIO_BUCKET=rum-replay
export RUM_MAINTAINER_METRICS_ADDRESS=127.0.0.1:19090

# Redis password must be via *-password-file (mode 0600); URL must not embed it.
# Compose VL/VT must include -delete.enable or Start() fails.
#
# Example run (after `make build-maintainer`):
#   printf '%s' 'rum-maintainer-dev-secret-2026-000005' > /tmp/bklite-rum-maintainer-redis-pass
#   printf '%s' 'rum-replay-index-maintainer-dev-secret-000006' > /tmp/bklite-rum-replay-index-maintainer-redis-pass
#   printf '%s' 'rum-minio-contract-password' > /tmp/bklite-rum-minio-secret
#   chmod 600 /tmp/bklite-rum-maintainer-redis-pass /tmp/bklite-rum-replay-index-maintainer-redis-pass /tmp/bklite-rum-minio-secret
#   ./_build/bklite-rum-maintainer \
#     -redis-url='redis://rum-maintainer@127.0.0.1:16379/0' \
#     -redis-password-file=/tmp/bklite-rum-maintainer-redis-pass \
#     -replay-index-redis-url='redis://rum-replay-index-maintainer@127.0.0.1:16379/2' \
#     -replay-index-redis-password-file=/tmp/bklite-rum-replay-index-maintainer-redis-pass \
#     -replay-index-epoch='2026-01-01T00:00:00Z' \
#     -victoria-logs-endpoint='http://127.0.0.1:19428' \
#     -victoria-traces-endpoint='http://127.0.0.1:10429' \
#     -minio-endpoint='127.0.0.1:19000' \
#     -minio-secure=false \
#     -minio-access-key='rumminio' \
#     -minio-secret-key-file=/tmp/bklite-rum-minio-secret \
#     -minio-bucket='rum-replay' \
#     -metrics-address='127.0.0.1:19090'
