# Local/dev defaults for bklite-rum-controller against `deploy/rum` compose (`make up`).
# Host ports: Redis 16379, NATS 14222. Redis URL must use ACL user rum-controller.
# NATS user must be rum_controller (subscribe rum.v1.control.*). Django uses rum_ctl.
# Identity HMAC files must be mode 0600 and ≥32 bytes.
export RUM_TENANT_ID=core
export RUM_NATS_URL=nats://rum_controller:rum-controller-contract-password@127.0.0.1:14222
export RUM_NATS_INSECURE=1
export RUM_CONTROLLER_REDIS_URL='redis://rum-controller:rum-controller-dev-secret-2026-000001@127.0.0.1:16379/0'
export RUM_IDENTITY_HMAC_CURRENT_FILE=/tmp/bklite-rum-hmac-current
export RUM_IDENTITY_HMAC_CURRENT_VERSION=v1
# Optional previous generation:
# export RUM_IDENTITY_HMAC_PREVIOUS_FILE=/tmp/bklite-rum-hmac-previous
# export RUM_IDENTITY_HMAC_PREVIOUS_VERSION=v0

# Example run (after `make build-controller`):
#   printf '%s' 'dev-bklite-rum-hmac-secret-key-32b' > "$RUM_IDENTITY_HMAC_CURRENT_FILE"
#   chmod 600 "$RUM_IDENTITY_HMAC_CURRENT_FILE"
#   set -a; . ./env/rum.controller.dev.env.example; set +a
#   ./_build/bklite-rum-controller \
#     -nats-url="$RUM_NATS_URL" -nats-insecure \
#     -redis-url="$RUM_CONTROLLER_REDIS_URL" \
#     -identity-hmac-current-file="$RUM_IDENTITY_HMAC_CURRENT_FILE" \
#     -identity-hmac-current-version="$RUM_IDENTITY_HMAC_CURRENT_VERSION" \
#     -tenant-id="$RUM_TENANT_ID"
