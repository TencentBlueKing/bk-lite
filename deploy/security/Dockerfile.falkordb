ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG RUNTIME_USER
USER root

# 原镜像使用 NodeSource 24.x deb；包级升级同时更新运行文件及漏扫依赖清单。
RUN . /etc/os-release && \
    case "$ID:$VERSION_ID" in \
      debian:12) ;; \
      *) echo "未验证的 FalkorDB 发行版：$ID:$VERSION_ID" >&2; exit 1 ;; \
    esac && \
    dpkg-query -W -f='${db:Status-Abbrev}' nodejs | grep -q '^ii ' && \
    apt-get update && \
    apt-get install -y --no-install-recommends libbrotli1 nodejs && \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libbrotli1)" ge '1.0.9-2+deb12u1' && \
    package_version="$(dpkg-query -W -f='${Version}' nodejs)" && \
    dpkg --compare-versions "$package_version" ge '24.22.1' && \
    node_version="$(node --version)" && \
    printf '%s\n' "$node_version" | grep -Eq '^v24\.[0-9]+\.[0-9]+$' && \
    dpkg --compare-versions "${node_version#v}" ge '24.22.1' && \
    package_upstream="${package_version#*:}" && \
    test "${package_upstream%%-*}" = "${node_version#v}" && \
    rm -rf /var/lib/apt/lists/*

USER ${RUNTIME_USER}
