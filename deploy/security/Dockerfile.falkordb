ARG BASE_IMAGE
FROM node:24.22.1-bookworm-slim AS patched_node

FROM ${BASE_IMAGE}

ARG RUNTIME_USER
USER root

# CVE-2026-111497：仅更新系统 Brotli，保留上游应用启动入口。
RUN apt-get update && \
    apt-get install -y --no-install-recommends libbrotli1 && \
    . /etc/os-release && \
    case "$ID:$VERSION_ID" in \
      debian:12) minimum='1.0.9-2+deb12u1' ;; \
      debian:13) minimum='1.1.0-2+deb13u1' ;; \
      ubuntu:20.04) minimum='1.0.7-6ubuntu0.1+esm1' ;; \
      ubuntu:22.04) minimum='1.0.9-2ubuntu0.1' ;; \
      ubuntu:24.04) minimum='1.1.0-2ubuntu0.1' ;; \
      *) echo "未验证的 Brotli 发行版：$ID:$VERSION_ID" >&2; exit 1 ;; \
    esac && \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libbrotli1)" ge "$minimum" && \
    rm -rf /var/lib/apt/lists/*

# 替换原可执行文件的真实路径，兼容入口脚本使用绝对路径启动 Node。
COPY --from=patched_node /usr/local/bin/node /tmp/brotli-patched-node
RUN . /etc/os-release && test "$ID:$VERSION_ID" = 'debian:12' && \
    install -m 0755 /tmp/brotli-patched-node "$(readlink -f "$(command -v node)")" && \
    test "$(node --version)" = 'v24.22.1' && \
    rm /tmp/brotli-patched-node

USER ${RUNTIME_USER}
