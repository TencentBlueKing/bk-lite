  "cards": [
    {
      "dot": "cyan",
      "title": "模块定位",
      "items": [
        "Monitor 是控制面与查询面，不是指标写入服务",
        "HTTP、NATS、Celery 是入口适配，不应各自实现业务规则"
      ]
    },
    {
      "dot": "amber",
      "title": "事实边界",
      "items": [
        "DB 保存管理事实，VictoriaMetrics 保存指标事实",
        "NodeMgmt 持有配置内容，外部告警中心是生命周期投影"
      ]
    },
    {
      "dot": "rose",
      "title": "结构压力",
      "items": [
        "本地事务无法覆盖远程 RPC 副作用",
        "管理实例、观测实例、派生实例需要明确分型"
      ]
    }
