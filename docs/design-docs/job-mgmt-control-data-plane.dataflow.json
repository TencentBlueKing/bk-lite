  "cards": [
    {
      "dot": "emerald",
      "title": "控制面已经能裁决什么",
      "items": [
        "Web 与 OpenAPI 网关注入用户/团队；worker 用行锁把 PENDING 变成 RUNNING",
        "取消、超时和 Ansible 回调会重新锁执行行，并用 callback token 挡住陈旧写回"
      ]
    },
    {
      "dot": "rose",
      "title": "控制面与数据面的断裂",
      "items": [
        "legacy job_script_execute / job_file_distribute 仍把 payload team 当授权事实",
        "Sidecar 终态直接 send_callback；只有 Ansible、取消和超时进入 Completion Outbox"
      ]
    },
    {
      "dot": "amber",
      "title": "数据面容量仍绑在单行上",
      "items": [
        "执行路径由第一个手动目标的 driver 决定，多云区域只跑第一组",
        "全部目标 stdout/stderr 写入 execution_results JSON，没有跨 worker 的共享预算"
      ]
    }
  ]
