    {"dot": "cyan", "title": "短期：收紧数据能力", "items": ["NATS 改为批准的 DataCapability registry；数据库账号强制只读、SQL AST/statement timeout/response bytes；DB 与 WeOps 接入统一 egress policy", "建立 CanvasDependency 索引；DataSource/Connection 删除或缩权先返回受影响画布、分享和订阅，禁止静默断链"]},
    {"dot": "violet", "title": "中期：查询计划与持久运行", "items": ["所有 viewer/share/render 查询编译为 ScopedQueryPlan，统一限制时间、行/字节、复杂度、并发和 connector 配额", "Execution/Excel/Render/Delivery 使用同一 token lease、heartbeat、retry_at 和 reaper；重试拆成持久 StepWorkItem，不在一个任务里紧循环"]},
    {"dot": "emerald", "title": "长期：可重放报告与可重建投影", "items": ["ExecutionBundle 冻结 datasource query plan、connection endpoint digest、transform/excel generation；同一 execution 重试保持相同语义", "Canvas JSON 迁移为 typed aggregate + dependency projection；导入导出、分享、报告和网络拓扑只消费公开 Port，不解析彼此私有 JSON"]}
