  "cards": [
    {
      "dot": "rose",
      "title": "P0：优先处理",
      "items": [
        "CMDB：中心资产事实与跨模块依赖最多",
        "NodeMgmt / Alerts：远程副作用和并发链路突出",
        "OpsPilot：单应用体量最大，报告内必须再按能力域拆解"
      ]
    },
    {
      "dot": "cyan",
      "title": "默认独立分析",
      "items": [
        "每个业务模块单独输出现状架构、核心数据流与目标架构",
        "Monitor 作为格式与分析深度基线，不把相似告警概念强行合并"
      ]
    },
    {
      "dot": "amber",
      "title": "唯一合并项",
      "items": [
        "base / core / rpc / console_mgmt / nats_client 共同分析平台接口与适配器",
        "它们规模较小且业务接口高度重叠，拆开会得到多个浅模块报告"
      ]
    }
  ]
