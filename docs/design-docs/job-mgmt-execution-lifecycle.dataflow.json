    {"id": "direct", "type": "backend", "label": "Direct Finalize", "sublabel": "results JSON + direct callback", "stage": 3, "row": 1, "width": 160, "tag": "best effort"},
    {"id": "transactional", "type": "database", "label": "Callback + Outbox", "sublabel": "one-time token / row lock / lease", "stage": 3, "row": 3, "width": 160, "tag": "可恢复终态"},
    {"id": "effects", "type": "external", "label": "Completion Consumers", "sublabel": "SSE / Webhook / NATS / cleanup", "stage": 4, "row": 2, "width": 155, "tag": "副作用"}
