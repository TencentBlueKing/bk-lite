  ],
  "cards": [
    {"dot": "emerald", "title": "正确的裁决点已经存在", "items": ["worker 用行锁原子 claim PENDING→RUNNING；取消、Ansible callback 和 outbox lease 都重新校验数据库状态", "一次性 callback attempt/token 阻断陈旧回调，Outbox 的 delivery_id 使下游能够去重"]},
    {"dot": "rose", "title": "核心生命周期没有唯一 reducer", "items": ["Sidecar、危险规则早退、Ansible 提交失败和 Playbook 失败直接写终态，绕过 Completion Outbox", "执行 worker 硬退出后没有 heartbeat/lease/reaper，RUNNING 可永久滞留且调度 queue/skip 被持续阻塞"]},
    {"dot": "amber", "title": "计划与结果都缺少显式容量单位", "items": ["入口 target_list 多数无 max_length，Ansible 接受混合区域后只处理第一组", "所有逐目标结果和输出汇总到 execution_results JSON，扩大内存、行锁、详情响应与回调载荷"]}
  ]
}
