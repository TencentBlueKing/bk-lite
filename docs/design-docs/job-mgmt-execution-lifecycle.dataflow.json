    {"id": "ansible_transactional", "from": "ansible", "to": "transactional", "label": "callback", "variant": "security", "labelAt": [636, 558]},
    {"id": "direct_effects", "from": "direct", "to": "effects", "label": "direct", "variant": "dashed", "labelAt": [854, 330]},
