  "nodes": [
    {"id": "command", "type": "security", "label": "Command Gate", "sublabel": "HTTP / OpenAPI / NATS / Schedule", "stage": 0, "row": 2, "width": 130, "tag": "actor + scope + risk"},
    {"id": "pending", "type": "database", "label": "Persist / Dispatch / Claim", "sublabel": "JobExecution + Celery + row lock", "stage": 1, "row": 2, "width": 160, "tag": "无运行 lease"},
    {"id": "sidecar", "type": "backend", "label": "Sidecar Batch", "sublabel": "thread pool / results in memory", "stage": 2, "row": 1, "width": 155, "tag": "无全局预算"},
