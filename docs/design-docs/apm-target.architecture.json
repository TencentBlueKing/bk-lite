      {"id": "runtime", "label": "预算化目录与策略运行", "focus": ["catalogRun", "scheduler", "scan", "store"], "note": "目录活动和策略目标都变为可分片 Run/WorkItem，由共享 VictoriaTraces 预算、公平性和背压控制。"},
      {"id": "lifecycle", "label": "统一生命周期与副作用", "focus": ["scan", "reducer", "facts", "outbox", "consumers"], "note": "Reducer 原子写事件、证据意图和投递意图；带 token 的 lease worker 执行 MinIO 和通知。"}
    ]
  },
  "boundaries": [
