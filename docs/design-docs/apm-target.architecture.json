  "cards": [
    {"dot": "cyan", "title": "短期：先修授权与 fencing", "items": ["Trace 列表按 AuthorizedTelemetryScope 查询；详情只返回当前组织可见 span，并显式标记跨范围边被裁剪", "Outbox 和 Snapshot worker 增加 claim_token；结果更新必须匹配 token，外部 I/O 移出数据库锁事务"]},
    {"dot": "violet", "title": "中期：运行计划与共享预算", "items": ["保存策略时限制 endpoint×version 总成本；生成 ScanRun/WorkItem，按团队、服务和 VT 集群配额调度并补扫缺失 cursor", "Catalog reconcile 按 identity 批量 upsert，使用带 token 的 lease/cursor；Dashboard 复用短 TTL rollup，禁止每请求私有扇出无限放大"]},
    {"dot": "emerald", "title": "长期：不可变窗口事实与可重建投影", "items": ["每次评估保存 WindowEvidence；AlertMetricSnapshot 只做有界 rollup，可从事件事实重建", "Trace/Span、RED、目录、策略与通知共享 scope digest、query plan digest、run identity 和成本观测，形成可审计链路"]}
  ]
}
