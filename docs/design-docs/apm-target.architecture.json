    {"kind": "region", "label": "查询计划与共享容量", "wraps": ["planner", "scheduler", "store"], "pad": 18},
    {"kind": "region", "label": "运行计划与领域事实", "wraps": ["catalogRun", "scan", "reducer", "facts", "outbox"], "pad": 18},
    {"kind": "region", "label": "基础设施消费者", "wraps": ["consumers"], "pad": 18}
  ],
  "components": [
