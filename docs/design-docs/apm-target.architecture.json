    {"id": "reducer", "type": "security", "label": "Lifecycle Reducer", "sublabel": "fencing + consecutive windows", "tag": "唯一状态裁决", "pos": [1300, 80], "size": [160, 100]},
    {"id": "facts", "type": "database", "label": "Alert / Event / Evidence", "sublabel": "window facts + rollup", "tag": "可审计", "pos": [1300, 545], "size": [160, 100]},
