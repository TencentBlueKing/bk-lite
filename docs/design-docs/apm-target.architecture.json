    {"id": "planner", "type": "backend", "label": "Telemetry Query Planner", "sublabel": "scope + AST + cost + window", "tag": "授权下推", "pos": [520, 310], "size": [220, 100]},
    {"id": "scheduler", "type": "messagebus", "label": "VT Budget Scheduler", "sublabel": "team / API / policy / dashboard", "tag": "公平 + 背压", "pos": [790, 310], "size": [220, 100]},
