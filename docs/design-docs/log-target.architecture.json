  "cards": [
    {"dot": "cyan", "title": "短期：先封住范围与分布式一致性", "items": ["策略分组构建失败 fail-closed；为 alert_condition 建 typed schema 和字段白名单，限制查询跨度、group 数、样本数与 SSE 并发", "新增 CollectorConfigOperation 与 DeliveryIntent；本地事务只写意图，NodeMgmt、MinIO、通知和 broker 均由可重扫 worker 收敛"]},
    {"dot": "violet", "title": "中期：建立查询计划与共享预算", "items": ["把 raw query + group rules 编译为 typed QueryPlan，记录 scope digest、窗口、估算成本、截断与执行统计", "按团队、策略、VictoriaLogs 集群和 SSE 连接实行并发/速率预算；grouped sample 使用分片和背压，不在单任务内创建私有线程池"]},
    {"dot": "emerald", "title": "长期：统一 desired / effective 与审计事实", "items": ["采集配置和 Vector 配置都采用 desired generation、consumer effective generation、checksum、last error 与 rollout ACK", "EventRawData/AlertEvidence 使用不可变对象；AlertSnapshot 只是可重建读模型，生命周期副作用共享 outbox 协议"]}
  ]
}
