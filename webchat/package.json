{
  "name": "webchat",
  "version": "1.0.0",
  "description": "A web chat library with SSE support, similar to Rasa-web",
  "private": true,
  "workspaces": [
    "packages/webchat-core",
    "packages/webchat-ui",
    "packages/webchat-demo"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @webchat/demo",
    "build": "npm run build:core && npm run build:ui && npm run build:browser && npm run build:demo",
    "build:core": "npm run build --workspace @webchat/core",
    "build:ui": "npm run build --workspace @webchat/ui",
    "build:browser": "npm run build:browser --workspace @webchat/ui",
    "build:demo": "npm run build --workspace @webchat/demo",
    "test": "node tests/state-machine.issue-3882.mjs && node --test tests/stream-lifecycle.issue-3556.test.mjs && node --test tests/content-chunks.test.mjs tests/workspace-install.test.mjs tests/publish-workspaces.test.mjs tests/workflow-registration.test.mjs && npm run test:core && npm run test:config",
    "pretest:core": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "test:core": "tsc -p tests/tsconfig.json && node --test .test-dist/tests/core/core.test.js",
    "pretest:config": "node -e \"require('node:fs').rmSync('packages/webchat-ui/.test-dist/issue-4037', { recursive: true, force: true })\"",
    "test:config": "tsc -p tests/tsconfig.issue-4037.json && node packages/webchat-ui/.test-dist/issue-4037/tests/webchat-config.issue-4037.test.js",
    "lint": "eslint \"packages/webchat-core/src/**/*.{ts,tsx}\" \"packages/webchat-ui/src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx,mjs}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist packages/*/.next"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.0.0",
    "turbo": "^1.13.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
