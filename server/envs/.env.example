DEBUG=False
LOG_LEVEL=INFO
LOG_FILE_OUTPUT=false
SECRET_KEY=weops-lite

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

ENABLE_CELERY=False
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_BEAT_SCHEDULER=

REDIS_CACHE_URL=

# ops-analysis Python 转换 Runner（非关键依赖；V1 单副本+单 worker）
# URL 与 Token 均需配置；Token 须与 Runner TRANSFORM_RUNNER_TOKEN 一致
TRANSFORM_RUNNER_URL=
TRANSFORM_RUNNER_TOKEN=
TRANSFORM_RUNNER_TIMEOUT=8

NATS_SERVERS=
NATS_NAMESPACE=

SNMP_TRAP_NATS_SUBJECT=vector
SNMP_TRAP_ALERTS_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/alerts/api/source/snmp_trap/webhook/
SNMP_TRAP_ALERTS_SECRET=
SNMP_TRAP_ALERTS_TIMEOUT=10
SNMP_TRAP_ALERTS_MAX_RETRIES=3
SNMP_TRAP_PUSH_SOURCE_ID=snmp_trap_bridge

VICTORIALOGS_HOST=
VICTORIALOGS_USER=
VICTORIALOGS_PWD=
VICTORIALOGS_SSL_VERIFY=false
VICTORIALOGS_QUERY_LIMIT_MAX=1000
VICTORIALOGS_FIELD_VALUES_LIMIT_MAX=1000
VICTORIALOGS_HITS_FIELDS_LIMIT_MAX=100

VICTORIATRACES_HOST=

# webhookd 渲染请求（log/monitor/cmdb K8s 接入，会下发 NATS 凭据）的 TLS 校验：
# 留空/true=校验系统CA（默认安全）；自签名内网填受信 CA 路径（如 /etc/ssl/webhook-ca.pem）；false=显式关闭（不推荐）
WEBHOOK_SERVER_SSL_VERIFY=true

# MLOps 批量预测上界校验（超出时返回 HTTP 413）
# 文本/时序/日志/异常检测类算法单次 predict 最大条目数（默认 10000）
MLOPS_PREDICT_MAX_BATCH_SIZE=10000
# 图像类算法单次 predict 最大图片数（默认 100）
MLOPS_PREDICT_MAX_IMAGE_BATCH_SIZE=100
# 图像类算法单张图片 base64 字符串最大字节数（默认 10 MiB）
MLOPS_PREDICT_MAX_IMAGE_BYTES=10485760

# ---- 告警处理动作回调地址（必填） ----
# 告警处理触发作业平台（JobMgmt）后，作业平台会通过 SELF_BASE_URL 反向回调 alerts 服务。
# 必须填写 alerts 服务对 job_mgmt 网络可达的入口（不要写 127.0.0.1，job_mgmt 的 SSRF 校验会拒绝 localhost）。
# 留空时：作业可执行但完成后不会回调，ActionExecution.status 会停在 running，不会自动更新为 success/failed。
# 示例（内网 IP）：
#   SELF_BASE_URL=http://10.11.27.147:8011
SELF_BASE_URL=

# 告警详情 → "查看作业" 链接拼到的前端入口。留空时只用相对路径（dev 可用，部署后端与前端不同地址时必须填写）。
# 示例：
#   WEB_BASE_URL=http://10.11.27.147:3000
WEB_BASE_URL=

# OpsPilot DeepAgent 分步执行限制（缺失/非法时用默认值）
# 每步（单次 ainvoke）模型调用次数兜底上限，默认 10
OPSPILOT_DEEPAGENT_RUN_MODEL_CALL_LIMIT=10
# 累计 token 预算主控；0=不限制。请求字段 max_tokens_budget>0 时优先生效
OPSPILOT_DEEPAGENT_MAX_TOKENS_BUDGET=0

# OpsPilot Wiki 系统级预算（缺失时使用下列默认值；必须为正整数）
# 单次问答最多 2 次 LLM：低置信度时 1 次 Overview 路由 + 1 次最终回答
WIKI_QA_MAX_LLM_CALLS=2
# 单次问答装配的纯 Wiki 知识上下文上限（不含用户问题和对话历史）
WIKI_QA_MAX_KNOWLEDGE_TOKENS=8000
# 单次最终回答的最大输出 token
WIKI_QA_MAX_OUTPUT_TOKENS=1500
# 每份资料独立计算的知识构建 LLM 调用硬熔断上限，防止异常循环
WIKI_BUILD_MAX_LLM_CALLS_PER_MATERIAL=64
# 每份资料知识构建的累计 token 软阈值；超过后继续构建并记录审计，不因此失败
WIKI_BUILD_MAX_TOTAL_TOKENS_PER_MATERIAL=60000

CLIENT_ID=


# 运营分析画布分享链接的签名密钥。每套环境独立生成并长期保持稳定，禁止提交真实密钥。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(64))"
# 轮换会使全部已有分享链接失效。
DASHBOARD_SHARE_SIGNING_KEY=
# 分享短会话有效期（秒）；普通请求不续期，默认 8 小时。
DASHBOARD_SHARE_SESSION_AGE=28800

# ---- 仪表盘报告订阅（Dashboard Report Subscription） ----
# Chromium Render Worker 打开的 Web 基址。必须是 Worker 进程网络可达的前端入口，
# 用于访问 /ops-analysis/render/execution/{id}。不要写仅本机浏览器可访问、Worker 不可达的地址。
# 本地示例：
#   DASHBOARD_REPORT_WEB_BASE_URL=http://127.0.0.1:3000
# 部署示例：
#   DASHBOARD_REPORT_WEB_BASE_URL=http://web:3000
DASHBOARD_REPORT_WEB_BASE_URL=

# PDF 临时产物根目录（Render Worker 写入，Delivery 读取）。
# 作用：存放每次执行生成的短期 PDF（按 execution-{id}/ 子目录隔离），仅用于当前邮件发送；
# 不是长期归档，也不提供用户下载入口。生产环境（DEBUG=False）必须配置，且 Render Worker
# 与执行 Delivery 的进程必须看到同一路径（同机目录或共享卷）。未配置且 DEBUG=True 时回退到
# 系统临时目录下的 bk-lite-dashboard-report-artifacts。
# 本地示例：
#   DASHBOARD_REPORT_ARTIFACT_ROOT=/tmp/bk-lite-dashboard-report-artifacts
# 部署示例（共享卷挂载点）：
#   DASHBOARD_REPORT_ARTIFACT_ROOT=/data/bk-lite/dashboard-report-artifacts
DASHBOARD_REPORT_ARTIFACT_ROOT=

# PDF 临时保留期（秒）。到期后 Delivery 不再读取；默认 86400（24 小时）。
DASHBOARD_REPORT_ARTIFACT_RETENTION_SECONDS=86400

# Execution / Snapshot 保留天数；默认 180。仅终态且 coalesce(finished_at, created_at)
# 超过该天数后由独立 cleanup 任务分批删除；不影响 Subscription 生命周期审计。
DASHBOARD_REPORT_EXECUTION_RETENTION_DAYS=180

# 一次性 Render Token 有效期（秒）；默认 600（10 分钟）。
DASHBOARD_REPORT_RENDER_TOKEN_TTL_SECONDS=600

# 独立 dashboard_report_render 队列 Worker 并发数；默认 2。仅 release Supervisor 启动脚本读取。
DASHBOARD_REPORT_RENDER_CONCURRENCY=2
