{
  "plugin": "Hardware Server Redfish",
  "plugin_desc": "Collect generic DMTF Redfish BMC health, firmware, thermal, power, storage, drive, and NIC metrics over HTTPS. Discovers Systems/Managers/Chassis by @odata.id and does not split by brand or crawl Sensors, logs, DIMMs, or EthernetInterfaces.",
  "collector": "Telegraf",
  "collect_type": "redfish",
  "support_collect_detect": false,
  "status_query": "any({instance_type='hardware_server', collect_type='redfish'}) by (instance_id)",
  "instance_fact_bindings": [{"fact":"asset.ip","value_type":"ip","resolver":"input","options":{"field":"ip"}}],
  "instance_summary_columns": [{"fact":"asset.ip","title":"monitor.views.assetIp","order":10}],
  "name": "Hardware Server",
  "icon": "mm-hardwareDevice_硬件设备",
  "type": "Hardware Device",
  "description": "",
  "default_metric": "any({instance_type='hardware_server'}) by (instance_id)",
  "instance_id_keys": ["instance_id"],
  "supplementary_indicators": ["redfish_system_health", "redfish_system_power_state", "redfish_inlet_temperature_celsius", "redfish_psu_redundant", "redfish_drive_health"],
  "display_fields": [
    {"name": "Health", "sort_order": 0, "metrics": [{"plugin": "Hardware Server Redfish", "metric": "redfish_system_health"}]},
    {"name": "Power State", "sort_order": 1, "metrics": [{"plugin": "Hardware Server Redfish", "metric": "redfish_system_power_state"}, {"plugin": "Hardware Server IPMI", "metric": "ipmi_chassis_power_state"}]},
    {"name": "Inlet Temperature", "sort_order": 2, "metrics": [{"plugin": "Hardware Server Redfish", "metric": "redfish_inlet_temperature_celsius"}]},
    {"name": "Temperature", "sort_order": 3, "metrics": [{"plugin": "Hardware Server Redfish", "metric": "redfish_temperature_celsius"}, {"plugin": "Hardware Server IPMI", "metric": "ipmi_temperature_celsius"}]}
  ],
  "metrics": [
    {
      "metric_group": "Health",
      "name": "redfish_system_health",
      "query": "redfish_system_health_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "System Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Overall computer-system health reported by the BMC Redfish System.Status.Health field."
    },
    {
      "metric_group": "Health",
      "name": "redfish_system_power_state",
      "query": "redfish_system_power_state_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Power State",
      "data_type": "Enum",
      "unit": "[{\"name\":\"Off\",\"id\":0,\"color\":\"#ff4d4f\"},{\"name\":\"On\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Other\",\"id\":2,\"color\":\"#faad14\"}]",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Computer-system power state from Redfish System.PowerState. On is 1 and Off is 0."
    },
    {
      "metric_group": "Health",
      "name": "redfish_manager_health",
      "query": "redfish_manager_health_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "BMC Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "BMC / iDRAC manager health from Redfish Manager.Status.Health."
    },
    {
      "metric_group": "Health",
      "name": "redfish_processor_health_rollup",
      "query": "redfish_processor_health_rollup_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Processor Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Rolled-up processor health from Redfish System.ProcessorSummary.Status, without enumerating each CPU."
    },
    {
      "metric_group": "Health",
      "name": "redfish_memory_health_rollup",
      "query": "redfish_memory_health_rollup_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Memory Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Rolled-up memory health from Redfish System.MemorySummary.Status, without enumerating each DIMM."
    },
    {
      "metric_group": "Environment",
      "name": "redfish_temperature_celsius",
      "query": "redfish_temperature_celsius_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Temperature",
      "data_type": "Number",
      "unit": "celsius",
      "dimensions": [{"name": "name", "description": "Sensor name"}],
      "instance_id_keys": ["instance_id"],
      "description": "Chassis temperature sensors from Redfish Thermal.Temperatures, in degrees Celsius."
    },
    {
      "metric_group": "Environment",
      "name": "redfish_inlet_temperature_celsius",
      "query": "redfish_inlet_temperature_celsius_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Inlet Temperature",
      "data_type": "Number",
      "unit": "celsius",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "First-class inlet / intake temperature from Thermal.Temperatures. Matches sensor name or PhysicalContext containing inlet or intake. When several match, the highest reading is kept."
    },
    {
      "metric_group": "Environment",
      "name": "redfish_inlet_temperature_upper_critical_celsius",
      "query": "redfish_inlet_temperature_upper_critical_celsius_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Inlet Temperature Upper Critical",
      "data_type": "Number",
      "unit": "celsius",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "UpperThresholdCritical of the selected inlet / intake sensor. Missing thresholds are omitted."
    },
    {
      "metric_group": "Environment",
      "name": "redfish_fan_speed",
      "query": "redfish_fan_speed_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Fan Speed",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [{"name": "name", "description": "Fan name"}, {"name": "unit", "description": "Reading unit"}],
      "instance_id_keys": ["instance_id"],
      "description": "Chassis fan readings from Redfish Thermal.Fans. The unit label is typically RPM or Percent."
    },
    {
      "metric_group": "Power",
      "name": "redfish_power_consumed_watts",
      "query": "redfish_power_consumed_watts_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Power Consumed",
      "data_type": "Number",
      "unit": "watts",
      "dimensions": [{"name": "name", "description": "Power control name"}],
      "instance_id_keys": ["instance_id"],
      "description": "System power consumption from Redfish Power.PowerControl.PowerConsumedWatts."
    },
    {
      "metric_group": "Power",
      "name": "redfish_psu_health",
      "query": "redfish_psu_health_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "PSU Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [{"name": "name", "description": "Power supply name"}],
      "instance_id_keys": ["instance_id"],
      "description": "Power-supply health from Redfish Power.PowerSupplies.Status.Health."
    },
    {
      "metric_group": "Power",
      "name": "redfish_psu_input_watts",
      "query": "redfish_psu_input_watts_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "PSU Input Power",
      "data_type": "Number",
      "unit": "watts",
      "dimensions": [{"name": "name", "description": "Power supply name"}],
      "instance_id_keys": ["instance_id"],
      "description": "Power-supply input wattage from Redfish Power.PowerSupplies.PowerInputWatts."
    },
    {
      "metric_group": "Power",
      "name": "redfish_psu_output_watts",
      "query": "redfish_psu_output_watts_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "PSU Output Power",
      "data_type": "Number",
      "unit": "watts",
      "dimensions": [{"name": "name", "description": "Power supply name"}],
      "instance_id_keys": ["instance_id"],
      "description": "Power-supply output wattage from Redfish Power.PowerSupplies.PowerOutputWatts."
    },
    {
      "metric_group": "Power",
      "name": "redfish_psu_capacity_watts",
      "query": "redfish_psu_capacity_watts_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "PSU Capacity",
      "data_type": "Number",
      "unit": "watts",
      "dimensions": [{"name": "name", "description": "Power supply name"}],
      "instance_id_keys": ["instance_id"],
      "description": "Power-supply rated capacity from Redfish Power.PowerSupplies.PowerCapacityWatts."
    },
    {
      "metric_group": "Power",
      "name": "redfish_psu_delivering",
      "query": "redfish_psu_delivering_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "PSU Delivering",
      "data_type": "Enum",
      "unit": "[{\"name\":\"Idle\",\"id\":0,\"color\":\"#faad14\"},{\"name\":\"Delivering\",\"id\":1,\"color\":\"#1ac44a\"}]",
      "dimensions": [{"name": "name", "description": "Power supply name"}],
      "instance_id_keys": ["instance_id"],
      "description": "1 when PowerInputWatts is greater than 20 W, else 0. Distinguishes an idle OK PSU from one actually delivering power."
    },
    {
      "metric_group": "Power",
      "name": "redfish_psu_redundant",
      "query": "redfish_psu_redundant_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "PSU Redundant",
      "data_type": "Enum",
      "unit": "[{\"name\":\"Lost\",\"id\":0,\"color\":\"#ff4d4f\"},{\"name\":\"Redundant\",\"id\":1,\"color\":\"#1ac44a\"}]",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "1 when at least two power supplies are delivering more than 20 W. Health=OK on an idle PSU does not count as redundancy."
    },
    {
      "metric_group": "Power",
      "name": "redfish_power_limit_watts",
      "query": "redfish_power_limit_watts_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Power Limit",
      "data_type": "Number",
      "unit": "watts",
      "dimensions": [{"name": "name", "description": "Power control name"}],
      "instance_id_keys": ["instance_id"],
      "description": "Configured power cap from Redfish Power.PowerControl.PowerLimit.LimitInWatts. Missing limits are omitted."
    },
    {
      "metric_group": "Power",
      "name": "redfish_power_over_limit",
      "query": "redfish_power_over_limit_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Power Over Limit",
      "data_type": "Enum",
      "unit": "[{\"name\":\"Within Limit\",\"id\":0,\"color\":\"#1ac44a\"},{\"name\":\"Over Limit\",\"id\":1,\"color\":\"#ff4d4f\"}]",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "1 when any PowerConsumedWatts exceeds the matching LimitInWatts. Omitted when no power limit is present."
    },
    {
      "metric_group": "Inventory",
      "name": "redfish_firmware_info",
      "query": "redfish_firmware_info_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Firmware",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [{"name": "bmc_firmware", "description": "BMC firmware version"}, {"name": "bios_version", "description": "System BIOS version"}],
      "instance_id_keys": ["instance_id"],
      "description": "BMC FirmwareVersion and ComputerSystem.BiosVersion from the Manager and System resources already fetched for health. Value is always 1; versions are labels."
    },
    {
      "metric_group": "Environment",
      "name": "redfish_temperature_upper_critical_celsius",
      "query": "redfish_temperature_upper_critical_celsius_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Temperature Upper Critical",
      "data_type": "Number",
      "unit": "celsius",
      "dimensions": [{"name": "name", "description": "Sensor name"}],
      "instance_id_keys": ["instance_id"],
      "description": "BMC UpperThresholdCritical from the same Thermal.Temperatures array as the temperature reading. Missing thresholds are omitted."
    },
    {
      "metric_group": "Environment",
      "name": "redfish_fan_health",
      "query": "redfish_fan_health_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Fan Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [{"name": "name", "description": "Fan name"}],
      "instance_id_keys": ["instance_id"],
      "description": "Fan Status.Health from Redfish Thermal.Fans, without enumerating Sensors."
    },
    {
      "metric_group": "Power",
      "name": "redfish_psu_input_voltage",
      "query": "redfish_psu_input_voltage_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "PSU Input Voltage",
      "data_type": "Number",
      "unit": "volts",
      "dimensions": [{"name": "name", "description": "Power supply name"}],
      "instance_id_keys": ["instance_id"],
      "description": "Power-supply line input voltage from Redfish Power.PowerSupplies.LineInputVoltage."
    },
    {
      "metric_group": "Power",
      "name": "redfish_voltage_volts",
      "query": "redfish_voltage_volts_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Voltage",
      "data_type": "Number",
      "unit": "volts",
      "dimensions": [{"name": "name", "description": "Voltage sensor name"}],
      "instance_id_keys": ["instance_id"],
      "description": "Chassis voltage rails from Redfish Power.Voltages.ReadingVolts when the Power resource includes them."
    },
    {
      "metric_group": "Storage",
      "name": "redfish_storage_health",
      "query": "redfish_storage_health_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Storage Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [{"name": "id", "description": "Storage subsystem id"}],
      "instance_id_keys": ["instance_id"],
      "description": "Storage subsystem HealthRollup from Systems/{id}/Storage/{StorageId}."
    },
    {
      "metric_group": "Storage",
      "name": "redfish_drive_health",
      "query": "redfish_drive_health_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Drive Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [{"name": "name", "description": "Drive name"}, {"name": "media_type", "description": "Media type"}, {"name": "protocol", "description": "Drive protocol"}],
      "instance_id_keys": ["instance_id"],
      "description": "Per-drive Status.Health from Storage.Drives, capped at 32 drives per scrape. Absent bays are skipped."
    },
    {
      "metric_group": "Storage",
      "name": "redfish_drive_present_count",
      "query": "redfish_drive_present_count_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Present Drive Count",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Count of present drives after skipping Status.State=Absent. Capped by the 32-drive scrape limit."
    },
    {
      "metric_group": "Storage",
      "name": "redfish_drive_life_percent",
      "query": "redfish_drive_life_percent_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Drive Life Remaining",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [{"name": "name", "description": "Drive name"}, {"name": "media_type", "description": "Media type"}, {"name": "protocol", "description": "Drive protocol"}],
      "instance_id_keys": ["instance_id"],
      "description": "PredictedMediaLifeLeftPercent when the drive reports it. HDD and empty bays omit this metric."
    },
    {
      "metric_group": "Storage",
      "name": "redfish_storage_controller_health",
      "query": "redfish_storage_controller_health_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "Storage Controller Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [{"name": "id", "description": "Controller id"}, {"name": "storage_id", "description": "Storage subsystem id"}],
      "instance_id_keys": ["instance_id"],
      "description": "Embedded StorageControllers[].Status from the Storage resource. Controllers that are only @odata.id links are skipped."
    },
    {
      "metric_group": "Network",
      "name": "redfish_nic_health",
      "query": "redfish_nic_health_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "NIC Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [{"name": "id", "description": "Network adapter id"}],
      "instance_id_keys": ["instance_id"],
      "description": "Chassis NetworkAdapter.Status.Health. Uses Chassis/NetworkAdapters, not Systems/EthernetInterfaces."
    },
    {
      "metric_group": "Network",
      "name": "redfish_nic_port_health",
      "query": "redfish_nic_port_health_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "NIC Port Health",
      "data_type": "Enum",
      "unit": "[{\"name\":\"OK\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"Warning\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"Critical\",\"id\":3,\"color\":\"#ff4d4f\"}]",
      "dimensions": [{"name": "adapter_id", "description": "Network adapter id"}, {"name": "id", "description": "Port id"}],
      "instance_id_keys": ["instance_id"],
      "description": "Network port Status.Health from adapter Ports or Controllers.Links.NetworkPorts, capped per scrape."
    },
    {
      "metric_group": "Network",
      "name": "redfish_nic_port_link_up",
      "query": "redfish_nic_port_link_up_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "NIC Port Link",
      "data_type": "Enum",
      "unit": "[{\"name\":\"Down\",\"id\":0,\"color\":\"#ff4d4f\"},{\"name\":\"Up\",\"id\":1,\"color\":\"#1ac44a\"}]",
      "dimensions": [{"name": "adapter_id", "description": "Network adapter id"}, {"name": "id", "description": "Port id"}],
      "instance_id_keys": ["instance_id"],
      "description": "NetworkPort.LinkStatus mapped to 1=LinkUp and 0=LinkDown/NoLink."
    },
    {
      "metric_group": "Network",
      "name": "redfish_nic_port_speed_mbps",
      "query": "redfish_nic_port_speed_mbps_gauge{instance_type='hardware_server', collect_type='redfish', __$labels__}",
      "display_name": "NIC Port Speed",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [{"name": "adapter_id", "description": "Network adapter id"}, {"name": "id", "description": "Port id"}],
      "instance_id_keys": ["instance_id"],
      "description": "Current link speed in Mbps from CurrentLinkSpeedMbps or CurrentSpeedGbps."
    }
  ]
}
