{
  "object_name": "Hardware Server",
  "instance_type": "hardware_server",
  "collect_type": "redfish",
  "config_type": [
    "hardware_server"
  ],
  "collector": "Telegraf",
  "instance_id": "{{cloud_region}}_hardware_server_redfish_{{ip}}",
  "form_fields": [
    {
      "name": "ip",
      "label": "IP",
      "type": "input",
      "required": true,
      "visible_in": "edit",
      "editable": false,
      "description": "BMC / iDRAC 管理地址，用于 Redfish HTTPS 采集",
      "widget_props": {
        "placeholder": "BMC IP"
      },
      "transform_on_edit": {
        "origin_path": "child.content.config.http_headers.host"
      },
      "label_en": "IP"
    },
    {
      "name": "port",
      "label": "端口",
      "type": "inputNumber",
      "required": true,
      "editable": false,
      "default_value": 443,
      "description": "Redfish HTTPS 端口，默认 443",
      "widget_props": {
        "min": 1,
        "precision": 0,
        "placeholder": "端口",
        "placeholder_en": "Port"
      },
      "transform_on_edit": {
        "origin_path": "child.content.config.http_headers.port"
      },
      "label_en": "Port"
    },
    {
      "name": "username",
      "label": "用户名",
      "type": "input",
      "required": true,
      "editable": false,
      "description": "Redfish 只读账号",
      "widget_props": {
        "placeholder": "用户名",
        "placeholder_en": "Username"
      },
      "transform_on_edit": {
        "origin_path": "child.content.config.http_headers.username"
      },
      "label_en": "Username",
      "description_en": "Read-only Redfish account"
    },
    {
      "name": "ENV_PASSWORD",
      "label": "密码",
      "type": "password",
      "required": true,
      "editable": false,
      "encrypted": false,
      "description": "对应的登录密码",
      "widget_props": {
        "placeholder": "密码",
        "placeholder_en": "Password"
      },
      "transform_on_edit": {
        "origin_path": "child.env_config.PASSWORD__{{config_id}}"
      },
      "label_en": "Password",
      "description_en": "Password for the Redfish account"
    },
    {
      "name": "verify_tls",
      "label": "校验证书",
      "type": "switch",
      "required": false,
      "default_value": true,
      "description": "校验 BMC HTTPS 证书。仅在受信任管理网络使用自签名证书时关闭。",
      "widget_props": {},
      "transform_on_edit": {
        "origin_path": "child.content.config.http_headers.verify_tls"
      },
      "label_en": "Verify TLS",
      "description_en": "Verify the BMC HTTPS certificate. Disable only for self-signed certificates on a trusted management network."
    },
    {
      "name": "interval",
      "label": "间隔",
      "type": "inputNumber",
      "required": true,
      "default_value": 60,
      "description": "监控数据的采集时间间隔（单位：秒）",
      "widget_props": {
        "min": 1,
        "precision": 0,
        "placeholder": "间隔",
        "addonAfter": "s",
        "placeholder_en": "Interval"
      },
      "transform_on_edit": {
        "origin_path": "child.content.config.interval",
        "to_form": {
          "regex": "^(\\d+)s$"
        },
        "to_api": {
          "suffix": "s"
        }
      },
      "label_en": "Interval",
      "description_en": "Collection time interval (unit: seconds)"
    }
  ],
  "table_columns": [
    {
      "name": "node_ids",
      "label": "节点",
      "type": "select",
      "required": true,
      "widget_props": {
        "placeholder": "请选择节点",
        "placeholder_en": "Please select node"
      },
      "enable_row_filter": false,
      "label_en": "Node"
    },
    {
      "name": "ip",
      "label": "IP",
      "type": "input",
      "required": true,
      "widget_props": {
        "placeholder": "BMC IP"
      },
      "change_handler": {
        "type": "simple",
        "source_fields": [
          "ip"
        ],
        "target_field": "instance_name"
      },
      "label_en": "IP"
    },
    {
      "name": "instance_name",
      "label": "实例名称",
      "type": "input",
      "required": true,
      "widget_props": {
        "placeholder": "实例名称",
        "disabled": false,
        "placeholder_en": "Instance Name"
      },
      "label_en": "Instance Name"
    },
    {
      "name": "group_ids",
      "label": "组",
      "type": "group_select",
      "required": false,
      "widget_props": {
        "placeholder": "请选择组",
        "placeholder_en": "Please select group"
      },
      "label_en": "Group"
    }
  ],
  "extra_edit_fields": {}
}
