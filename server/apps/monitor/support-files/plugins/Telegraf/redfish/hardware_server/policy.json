{
  "object": "Hardware Server",
  "plugin": "Hardware Server Redfish",
  "templates": [
    {
      "name": "系统健康异常",
      "alert_name": "硬件服务器${resource_name} Redfish 系统健康异常",
      "description": "BMC 上报的 System.Status.Health 不是 OK 时告警。",
      "metric_name": "redfish_system_health",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 3,
          "method": ">="
        },
        {
          "level": "error",
          "value": 2,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 2,
          "method": ">="
        }
      ]
    },
    {
      "name": "系统关机",
      "alert_name": "硬件服务器${resource_name} 已关机",
      "description": "Redfish System.PowerState 为 Off 时告警。",
      "metric_name": "redfish_system_power_state",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 0,
          "method": "="
        },
        {
          "level": "error",
          "value": 0,
          "method": "="
        },
        {
          "level": "warning",
          "value": 0,
          "method": "="
        }
      ]
    },
    {
      "name": "进风口温度过高",
      "alert_name": "硬件服务器${resource_name} 进风口温度过高",
      "description": "Redfish 进风口温度超过机房常用阈值时告警。",
      "metric_name": "redfish_inlet_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 45,
          "method": ">="
        },
        {
          "level": "error",
          "value": 40,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 35,
          "method": ">="
        }
      ]
    },
    {
      "name": "风扇健康异常",
      "alert_name": "硬件服务器${resource_name} 风扇 ${metric_name} 健康异常",
      "description": "Redfish Thermal.Fans.Status.Health 不是 OK 时告警。",
      "metric_name": "redfish_fan_health",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 3,
          "method": ">="
        },
        {
          "level": "error",
          "value": 2,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 2,
          "method": ">="
        }
      ]
    },
    {
      "name": "存储健康异常",
      "alert_name": "硬件服务器${resource_name} 存储 ${metric_name} 健康异常",
      "description": "Redfish Storage.Status.HealthRollup 不是 OK 时告警。",
      "metric_name": "redfish_storage_health",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 3,
          "method": ">="
        },
        {
          "level": "error",
          "value": 2,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 2,
          "method": ">="
        }
      ]
    },
    {
      "name": "电源模块健康异常",
      "alert_name": "硬件服务器${resource_name} 电源 ${metric_name} 健康异常",
      "description": "Redfish 电源模块 Status.Health 不是 OK 时告警。",
      "metric_name": "redfish_psu_health",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 3,
          "method": ">="
        },
        {
          "level": "error",
          "value": 2,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 2,
          "method": ">="
        }
      ]
    },
    {
      "name": "电源冗余丢失",
      "alert_name": "硬件服务器${resource_name} 电源冗余丢失",
      "description": "正在供电的电源少于两路时告警。Health=OK 的空闲电源不计入冗余。",
      "metric_name": "redfish_psu_redundant",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 0,
          "method": "="
        },
        {
          "level": "error",
          "value": 0,
          "method": "="
        },
        {
          "level": "warning",
          "value": 0,
          "method": "="
        }
      ]
    },
    {
      "name": "功耗超限",
      "alert_name": "硬件服务器${resource_name} 功耗超过功率上限",
      "description": "PowerConsumedWatts 超过 PowerLimit.LimitInWatts 时告警。",
      "metric_name": "redfish_power_over_limit",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 1,
          "method": "="
        },
        {
          "level": "error",
          "value": 1,
          "method": "="
        },
        {
          "level": "warning",
          "value": 1,
          "method": "="
        }
      ]
    },
    {
      "name": "磁盘健康异常",
      "alert_name": "硬件服务器${resource_name} 磁盘 ${metric_name} 健康异常",
      "description": "Redfish Storage.Drives.Status.Health 不是 OK 时告警。",
      "metric_name": "redfish_drive_health",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 3,
          "method": ">="
        },
        {
          "level": "error",
          "value": 2,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 2,
          "method": ">="
        }
      ]
    }
  ]
}
