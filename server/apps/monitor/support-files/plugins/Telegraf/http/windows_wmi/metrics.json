{
  "plugin": "Windows WMI",
  "plugin_desc": "Remote Windows host metrics collection through WMI/DCOM from Stargazer. Requires WMI service, account permission, and WMI/DCOM/RPC network reachability.",
  "status_query": "any({instance_type='os', collect_type='http', config_type='windows_wmi'}) by (instance_id)",
  "instance_fact_bindings": [
    {
      "fact": "asset.ip",
      "value_type": "ip",
      "resolver": "input",
      "options": {
        "field": "host",
        "required": true
      }
    }
  ],
  "instance_summary_columns": [
    {
      "fact": "asset.ip",
      "title": "monitor.views.assetIp",
      "order": 10
    }
  ],
  "node_selector": {
    "is_container": true
  },
  "name": "Host",
  "icon": "mm-host_主机",
  "type": "OS",
  "description": "Remote Windows host monitoring through WMI",
  "default_metric": "any({instance_type='os'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "cpu_usage_total",
    "mem_used_percent",
    "disk_used_percent"
  ],
  "display_fields": [
    {
      "name": "CPU使用率",
      "sort_order": 0,
      "metrics": [
        {
          "plugin": "Host",
          "metric": "cpu_usage_total"
        },
        {
          "plugin": "Windows WMI",
          "metric": "cpu_usage_total"
        },
        {
          "plugin": "Host Remote",
          "metric": "cpu_usage_total"
        },
        {
          "plugin": "Host AIX Remote",
          "metric": "cpu_usage_total"
        },
        {
          "plugin": "Host FreeBSD Remote",
          "metric": "cpu_usage_total"
        },
        {
          "plugin": "Host HP-UX Remote",
          "metric": "cpu_usage_total"
        },
        {
          "plugin": "Host Solaris Remote",
          "metric": "cpu_usage_total"
        }
      ]
    },
    {
