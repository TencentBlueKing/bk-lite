{
  "plugin": "Host HP-UX Remote",
  "plugin_desc": "A Linux collect node SSHes to HP-UX on each interval and runs system commands. It collects CPU, load, memory and swap, disk capacity and inodes, disk busy and combined throughput, NICs, uptime, and OS version. The target does not need a collector installed. Fill in IP, SSH username (for example root), password or private key, port (default 22), interval, and a Linux collect node. It does not collect hardware inventory, lastlog, lsof, or connection tables. There is no version picker; version and architecture are detected automatically.",
  "status_query": "any({instance_type='os', collect_type='http', config_type='host_hpux_remote'}) by (instance_id)",
  "instance_fact_bindings": [{"fact":"asset.ip","value_type":"ip","resolver":"input","options":{"field":"host","required":true}}],
  "instance_summary_columns": [{"fact":"asset.ip","title":"monitor.views.assetIp","order":10}],
  "node_selector": {
    "is_container": true
  },
  "name": "Host",
  "icon": "mm-host_主机",
  "type": "OS",
  "description": "HP-UX OS monitoring via SSH from a Linux collect node",
  "default_metric": "any({instance_type='os'}) by (instance_id)",
  "instance_id_keys": ["instance_id"],
  "supplementary_indicators": ["cpu_usage_total", "mem_used_percent", "disk_used_percent"],
  "display_fields": [
    {"name":"CPU使用率","sort_order":0,"metrics":[{"plugin":"Host","metric":"cpu_usage_total"},{"plugin":"Windows WMI","metric":"cpu_usage_total"},{"plugin":"Host Remote","metric":"cpu_usage_total"},{"plugin":"Host AIX Remote","metric":"cpu_usage_total"},{"plugin":"Host FreeBSD Remote","metric":"cpu_usage_total"},{"plugin":"Host HP-UX Remote","metric":"cpu_usage_total"},{"plugin":"Host Solaris Remote","metric":"cpu_usage_total"}]},
    {"name":"内存使用率","sort_order":1,"metrics":[{"plugin":"Host","metric":"mem_used_percent"},{"plugin":"Windows WMI","metric":"mem_used_percent"},{"plugin":"Host Remote","metric":"mem_used_percent"},{"plugin":"Host AIX Remote","metric":"mem_used_percent"},{"plugin":"Host FreeBSD Remote","metric":"mem_used_percent"},{"plugin":"Host HP-UX Remote","metric":"mem_used_percent"},{"plugin":"Host Solaris Remote","metric":"mem_used_percent"}]},
    {"name":"磁盘使用率","sort_order":2,"metrics":[{"plugin":"Host","metric":"disk_used_percent"},{"plugin":"Windows WMI","metric":"disk_used_percent"},{"plugin":"Host Remote","metric":"disk_used_percent"},{"plugin":"Host AIX Remote","metric":"disk_used_percent"},{"plugin":"Host FreeBSD Remote","metric":"disk_used_percent"},{"plugin":"Host HP-UX Remote","metric":"disk_used_percent"},{"plugin":"Host Solaris Remote","metric":"disk_used_percent"}]},
    {"name":"网络入向吞吐","sort_order":3,"metrics":[{"plugin":"Host","metric":"net_bytes_recv_rate"},{"plugin":"Windows WMI","metric":"net_bytes_recv_rate"},{"plugin":"Host Remote","metric":"net_bytes_recv_rate"},{"plugin":"Host AIX Remote","metric":"net_bytes_recv_rate"},{"plugin":"Host FreeBSD Remote","metric":"net_bytes_recv_rate"},{"plugin":"Host HP-UX Remote","metric":"net_bytes_recv_rate"},{"plugin":"Host Solaris Remote","metric":"net_bytes_recv_rate"}]},
    {"name":"磁盘IO使用率","sort_order":4,"metrics":[{"plugin":"Host","metric":"diskio_io_util"},{"plugin":"Windows WMI","metric":"diskio_io_util"},{"plugin":"Host AIX Remote","metric":"disk_tm_act"},{"plugin":"Host FreeBSD Remote","metric":"disk_tm_act"},{"plugin":"Host HP-UX Remote","metric":"disk_tm_act"},{"plugin":"Host Solaris Remote","metric":"disk_tm_act"}]}
  ],
  "metrics": [
    {"metric_group":"CPU","name":"cpu_usage_total","query":"cpu_usage_total_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"CPU Usage","data_type":"Number","unit":"%","dimensions":[],"instance_id_keys":["instance_id"],"description":"HP-UX CPU usage from sar -u (user + sys + wio)"},
    {"metric_group":"CPU","name":"cpu_usage_user_total","query":"cpu_usage_user_total_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"CPU User Usage","data_type":"Number","unit":"%","dimensions":[],"instance_id_keys":["instance_id"],"description":"CPU user usage percentage"},
    {"metric_group":"CPU","name":"cpu_usage_system_total","query":"cpu_usage_system_total_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"CPU System Usage","data_type":"Number","unit":"%","dimensions":[],"instance_id_keys":["instance_id"],"description":"CPU system usage percentage"},
    {"metric_group":"CPU","name":"cpu_usage_iowait_total","query":"cpu_usage_iowait_total_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"CPU IOWait Usage","data_type":"Number","unit":"%","dimensions":[],"instance_id_keys":["instance_id"],"description":"CPU iowait usage percentage from sar %wio"},
    {"metric_group":"System","name":"system_load1","query":"system_load1_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Load 1m","data_type":"Number","unit":"","dimensions":[],"instance_id_keys":["instance_id"],"description":"1-minute system load"},
    {"metric_group":"System","name":"system_load5","query":"system_load5_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Load 5m","data_type":"Number","unit":"","dimensions":[],"instance_id_keys":["instance_id"],"description":"5-minute system load"},
    {"metric_group":"System","name":"system_load15","query":"system_load15_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Load 15m","data_type":"Number","unit":"","dimensions":[],"instance_id_keys":["instance_id"],"description":"15-minute system load"},
    {"metric_group":"System","name":"system_uptime","query":"system_uptime_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"System Uptime","data_type":"Number","unit":"s","dimensions":[],"instance_id_keys":["instance_id"],"description":"System uptime in seconds"},
    {"metric_group":"System","name":"os_info","query":"os_info_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"OS Version","data_type":"Number","unit":"","dimensions":[{"name":"os_version"},{"name":"arch"},{"name":"machine"}],"instance_id_keys":["instance_id"],"description":"HP-UX uname release and architecture"},
    {"metric_group":"Memory","name":"mem_total","query":"mem_total_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Total Memory","data_type":"Number","unit":"bytes","dimensions":[],"instance_id_keys":["instance_id"],"description":"Total physical memory in bytes"},
    {"metric_group":"Memory","name":"mem_used_percent","query":"mem_used_percent_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Memory Usage","data_type":"Number","unit":"%","dimensions":[],"instance_id_keys":["instance_id"],"description":"Used physical memory percentage"},
    {"metric_group":"Memory","name":"mem_swap_free","query":"mem_swap_free_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Swap Free Memory","data_type":"Number","unit":"bytes","dimensions":[],"instance_id_keys":["instance_id"],"description":"Free swap space in bytes"},
    {"metric_group":"Memory","name":"mem_swap_total","query":"mem_swap_total_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Swap Total Memory","data_type":"Number","unit":"bytes","dimensions":[],"instance_id_keys":["instance_id"],"description":"Total swap space in bytes"},
    {"metric_group":"Disk","name":"disk_total","query":"disk_total_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Disk Total","data_type":"Number","unit":"bytes","dimensions":[{"name":"mount"},{"name":"path"}],"instance_id_keys":["instance_id"],"description":"Total disk space in bytes"},
    {"metric_group":"Disk","name":"disk_free","query":"disk_free_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Disk Free","data_type":"Number","unit":"bytes","dimensions":[{"name":"mount"},{"name":"path"}],"instance_id_keys":["instance_id"],"description":"Free disk space in bytes"},
    {"metric_group":"Disk","name":"disk_used_percent","query":"disk_used_percent_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Disk Usage","data_type":"Number","unit":"%","dimensions":[{"name":"mount"},{"name":"path"}],"instance_id_keys":["instance_id"],"description":"Disk usage percentage per mount"},
    {"metric_group":"Disk","name":"disk_inodes_used_percent","query":"disk_inodes_used_percent_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Disk Inodes Usage","data_type":"Number","unit":"%","dimensions":[{"name":"mount"},{"name":"path"}],"instance_id_keys":["instance_id"],"description":"Disk inode usage percentage"},
    {"metric_group":"Disk","name":"disk_iused","query":"disk_iused_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Used Inodes","data_type":"Number","unit":"counts","dimensions":[{"name":"mount"},{"name":"path"}],"instance_id_keys":["instance_id"],"description":"Used inode count"},
    {"metric_group":"Disk","name":"disk_ifree","query":"disk_ifree_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Free Inodes","data_type":"Number","unit":"counts","dimensions":[{"name":"mount"},{"name":"path"}],"instance_id_keys":["instance_id"],"description":"Free inode count"},
    {"metric_group":"Disk IO","name":"diskio_read_bytes_rate","query":"diskio_read_bytes_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Disk Read Rate","data_type":"Number","unit":"byteps","dimensions":[{"name":"device"}],"instance_id_keys":["instance_id"],"description":"Disk transfer bytes from the sar -d 1s sample (combined blks/s when read/write are not split)"},
    {"metric_group":"Disk IO","name":"diskio_write_bytes_rate","query":"diskio_write_bytes_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Disk Write Rate","data_type":"Number","unit":"byteps","dimensions":[{"name":"device"}],"instance_id_keys":["instance_id"],"description":"Disk write bytes from the sar -d 1s sample when a split source is present"},
    {"metric_group":"Disk IO","name":"disk_tm_act","query":"disk_tm_act_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}","display_name":"Disk tm_act","data_type":"Number","unit":"%","dimensions":[{"name":"device"}],"instance_id_keys":["instance_id"],"description":"HP-UX sar -d %busy disk busy"},
    {"metric_group":"Network","name":"net_bytes_recv_rate","query":"rate(net_bytes_recv_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}[1m])","display_name":"Network Receive Byte Rate","data_type":"Number","unit":"byteps","dimensions":[{"name":"interface"}],"instance_id_keys":["instance_id"],"description":"Network received byte rate over the past 1 minute"},
    {"metric_group":"Network","name":"net_bytes_sent_rate","query":"rate(net_bytes_sent_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}[1m])","display_name":"Network Transmit Byte Rate","data_type":"Number","unit":"byteps","dimensions":[{"name":"interface"}],"instance_id_keys":["instance_id"],"description":"Network transmitted byte rate over the past 1 minute"},
    {"metric_group":"Network","name":"net_err_in_rate","query":"rate(net_err_in_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}[1m])","display_name":"Network Receive Error Rate","data_type":"Number","unit":"cps","dimensions":[{"name":"interface"}],"instance_id_keys":["instance_id"],"description":"Network receive error rate over the past 1 minute"},
    {"metric_group":"Network","name":"net_err_out_rate","query":"rate(net_err_out_gauge{instance_type=\"os\", config_type=\"host_hpux_remote\", __$labels__}[1m])","display_name":"Network Transmit Error Rate","data_type":"Number","unit":"cps","dimensions":[{"name":"interface"}],"instance_id_keys":["instance_id"],"description":"Network transmit error rate over the past 1 minute"}
  ]
}
