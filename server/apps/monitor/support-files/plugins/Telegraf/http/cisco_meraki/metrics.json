{
  "plugin": "Cisco Meraki",
  "plugin_desc": "Collect Cisco Meraki organization, device, wireless AP, switch, and MX metrics from Dashboard API v1 with one organization API key.",
  "collector": "Telegraf",
  "collect_type": "http",
  "status_query": "any({instance_type='cisco_meraki', collect_type='http'}) by (instance_id)",
  "instance_fact_bindings": [
    {
      "fact": "collector.nodes",
      "value_type": "node_ref_list",
      "resolver": "selected_nodes",
      "options": {
        "selection_field": "node_ids"
      }
    },
    {
      "fact": "probe.target",
      "value_type": "endpoint",
      "resolver": "input",
      "options": {
        "field": "base_url"
      }
    }
  ],
  "instance_summary_columns": [
    {
      "fact": "collector.nodes",
      "title": "monitor.views.probeNodes",
      "order": 10
    },
    {
      "fact": "probe.target",
      "title": "monitor.views.probeTarget",
      "order": 20
    }
  ],
  "node_selector": {
    "is_container": true
  },
  "is_compound_object": true,
  "objects": [
    {
      "name": "Cisco Meraki",
      "icon": "mm-router_路由器",
      "type": "Network Device",
      "level": "base",
      "description": "",
      "default_metric": "any({instance_type='cisco_meraki'}) by (instance_id)",
      "instance_id_keys": [
        "instance_id"
      ],
      "supplementary_indicators": [
        "meraki_org_connect_status",
        "meraki_org_network_count",
        "meraki_device_inventory_count",
        "meraki_wireless_ap_count",
        "meraki_switch_port_active_count",
        "meraki_appliance_vpn_network_count"
      ],
      "display_fields": [
        {
          "name": "Connect Status",
          "sort_order": 0,
          "metrics": [
            {
              "plugin": "Cisco Meraki",
              "metric": "meraki_org_connect_status"
            }
          ]
        },
        {
          "name": "Network Count",
          "sort_order": 1,
          "metrics": [
            {
              "plugin": "Cisco Meraki",
              "metric": "meraki_org_network_count"
            }
