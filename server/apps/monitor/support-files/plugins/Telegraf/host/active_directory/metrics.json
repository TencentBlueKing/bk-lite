{
  "plugin": "Active Directory",
  "plugin_desc": "Collects Active Directory NTDS/DirectoryServices performance counters with local Telegraf win_perf_counters, plus TCP probes of LDAP (389) and LDAPS (636). Install telegraf_windows on the domain controller; this plugin does not use inputs.ldap (OpenLDAP), Get-HealthReport, AD replication cmdlets, or agentless remote WMI.",
  "collector": "Telegraf",
  "collect_type": "host",
  "support_collect_detect": false,
  "status_query": "any({instance_type='active_directory', collect_type='host'}) by (instance_id)",
  "instance_fact_bindings": [
    {
      "fact": "asset.ip",
      "value_type": "ip",
      "resolver": "selected_node",
      "options": {
        "selection_field": "node_ids",
        "node_field": "ip",
        "required": true
      }
    }
  ],
  "instance_summary_columns": [
    {
      "fact": "asset.ip",
      "title": "monitor.views.assetIp",
      "order": 10
    }
  ],
  "name": "Active Directory",
  "icon": "mm-active-directory_AD",
  "type": "Middleware",
  "description": "Active Directory domain controller monitoring via local telegraf_windows",
  "default_metric": "any({instance_type='active_directory'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "ad_ldap_successful_binds_persec",
    "ad_ldap_client_sessions",
    "ad_ds_threads_in_use",
    "ad_ldap_probe_result_code"
  ],
  "display_fields": [
    {
      "name": "LDAP Successful Binds",
      "sort_order": 0,
      "metrics": [
        {
          "plugin": "Active Directory",
          "metric": "ad_ldap_successful_binds_persec"
        }
      ]
    },
    {
      "name": "LDAP Client Sessions",
      "sort_order": 1,
      "metrics": [
        {
          "plugin": "Active Directory",
          "metric": "ad_ldap_client_sessions"
        }
      ]
    },
    {
      "name": "LDAP Bind Time",
      "sort_order": 2,
      "metrics": [
        {
          "plugin": "Active Directory",
          "metric": "ad_ldap_bind_time"
        }
      ]
    },
    {
      "name": "DS Threads in Use",
      "sort_order": 3,
      "metrics": [
        {
          "plugin": "Active Directory",
          "metric": "ad_ds_threads_in_use"
        }
      ]
    },
    {
      "name": "LDAP Probe",
      "sort_order": 4,
      "metrics": [
        {
          "plugin": "Active Directory",
          "metric": "ad_ldap_probe_result_code"
        }
      ]
    }
  ],
  "metrics": [
    {
      "metric_group": "LDAP",
      "name": "ad_ldap_successful_binds_persec",
      "query": "win_ad_LDAP_Successful_Binds_persec{instance_type=\"active_directory\", __$labels__}",
      "display_name": "LDAP Successful Binds",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "NTDS DirectoryServices LDAP successful binds per second."
    },
    {
      "metric_group": "LDAP",
      "name": "ad_ldap_client_sessions",
      "query": "win_ad_LDAP_Client_Sessions{instance_type=\"active_directory\", __$labels__}",
