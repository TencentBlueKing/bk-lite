{
  "object": "Exchange",
  "plugin": "Exchange",
  "templates": [
    {
      "name": "邮箱投递队列积压",
      "alert_name": "Exchange ${resource_name} 邮箱投递队列过长",
      "description": "MSExchangeTransport Queues 活动邮箱投递队列持续偏高，邮件可能积压。",
      "metric_name": "exchange_active_mailbox_delivery_queue_length",
      "algorithm": "max_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 100,
          "method": ">="
        },
        {
          "level": "error",
          "value": 50,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 20,
          "method": ">="
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "Poison 队列非空",
      "alert_name": "Exchange ${resource_name} Poison 队列存在邮件",
      "description": "Poison Queue Length 大于 0，存在无法投递的问题邮件。",
      "metric_name": "exchange_poison_queue_length",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 0,
          "method": ">"
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "OWA 探测失败",
      "alert_name": "Exchange ${resource_name} OWA 探测失败",
      "description": "本机 http_response 探测 OWA 失败，Outlook Web App 可能不可用。",
      "metric_name": "exchange_owa_probe_result_code",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 0,
          "method": ">"
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "复制队列过长",
      "alert_name": "Exchange ${resource_name} 数据库复制队列过长",
      "description": "被动副本等待复制的事务日志过多，故障切换可能丢日志。滞后副本可忽略。",
      "metric_name": "exchange_copy_queue_length",
      "algorithm": "max_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 100,
          "method": ">="
        },
        {
          "level": "error",
          "value": 50,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 10,
          "method": ">="
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "重放队列过长",
      "alert_name": "Exchange ${resource_name} 数据库重放队列过长",
      "description": "被动副本等待重放的事务日志过多，激活时间会变长。滞后副本可忽略。",
      "metric_name": "exchange_replay_queue_length",
      "algorithm": "max_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 100,
          "method": ">="
        },
        {
          "level": "error",
          "value": 50,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 10,
          "method": ">="
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "数据库缓存命中率过低",
      "alert_name": "Exchange ${resource_name} 数据库缓存命中率过低",
      "description": "Database Cache % Hit 持续低于 90%，数据库缓存可能不足。",
      "metric_name": "exchange_database_cache_hit_percent",
      "algorithm": "min_over_time",
      "threshold": [
        {
          "level": "warning",
          "value": 90,
          "method": "<"
        }
      ],
      "group_algorithm": "min"
    }
  ]
}
