      "query": "http_response_result_code{instance_type=\"exchange\", endpoint=\"owa\", __$labels__}",
      "display_name": "OWA Probe Result",
      "data_type": "Enum",
      "unit": "[{\"name\":\"成功\",\"id\":0,\"color\":\"#1ac44a\"},{\"name\":\"响应内容不匹配\",\"id\":1,\"color\":\"#faad14\"},{\"name\":\"响应体读取失败\",\"id\":2,\"color\":\"#faad14\"},{\"name\":\"连接失败\",\"id\":3,\"color\":\"#ff4d4f\"},{\"name\":\"超时\",\"id\":4,\"color\":\"#ff4d4f\"},{\"name\":\"DNS错误\",\"id\":5,\"color\":\"#ff4d4f\"},{\"name\":\"响应状态码不匹配\",\"id\":6,\"color\":\"#faad14\"}]",
