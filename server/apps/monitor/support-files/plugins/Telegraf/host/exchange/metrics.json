{
  "plugin": "Exchange",
  "plugin_desc": "Collects Exchange MSExchange queue/OWA/HttpProxy (and related) performance counters with local Telegraf win_perf_counters, plus http_response probes of OWA and EWS. Install telegraf_windows on the Exchange Windows host. Does not implement Get-HealthReport or agentless remote WMI.",
  "collector": "Telegraf",
  "collect_type": "host",
  "support_collect_detect": false,
  "status_query": "any({instance_type='exchange', collect_type='host'}) by (instance_id)",
  "instance_fact_bindings": [
    {
      "fact": "asset.ip",
      "value_type": "ip",
      "resolver": "selected_node",
      "options": {
        "selection_field": "node_ids",
        "node_field": "ip",
        "required": true
      }
    }
  ],
  "instance_summary_columns": [
    {
      "fact": "asset.ip",
      "title": "monitor.views.assetIp",
      "order": 10
    }
  ],
  "name": "Exchange",
  "icon": "mm-exchange_Exchange",
  "type": "Middleware",
  "description": "Exchange Server monitoring via local telegraf_windows",
  "default_metric": "any({instance_type='exchange'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "exchange_active_mailbox_delivery_queue_length",
    "exchange_owa_current_unique_users",
    "exchange_poison_queue_length",
    "exchange_owa_probe_result_code"
  ],
  "display_fields": [
    {
      "name": "Mailbox Delivery Queue",
      "sort_order": 0,
      "metrics": [
        {
          "plugin": "Exchange",
          "metric": "exchange_active_mailbox_delivery_queue_length"
        }
      ]
    },
    {
      "name": "Poison Queue",
      "sort_order": 1,
      "metrics": [
        {
          "plugin": "Exchange",
          "metric": "exchange_poison_queue_length"
        }
      ]
    },
    {
      "name": "OWA Unique Users",
      "sort_order": 2,
      "metrics": [
        {
          "plugin": "Exchange",
          "metric": "exchange_owa_current_unique_users"
        }
      ]
    },
    {
      "name": "OWA Requests",
      "sort_order": 3,
      "metrics": [
        {
          "plugin": "Exchange",
          "metric": "exchange_owa_requests_persec"
        }
      ]
    },
    {
      "name": "OWA Probe",
      "sort_order": 4,
      "metrics": [
        {
          "plugin": "Exchange",
          "metric": "exchange_owa_probe_result_code"
        }
      ]
    }
  ],
