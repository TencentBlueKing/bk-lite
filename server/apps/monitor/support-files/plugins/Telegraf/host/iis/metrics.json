{
  "plugin": "IIS",
  "plugin_desc": "Collects IIS Web Service, APP_POOL_WAS, W3SVC_W3WP, HTTP request-queue and cache counters with local Telegraf win_perf_counters, plus an http_response probe of the site URL. Install telegraf_windows on the IIS Windows host.",
  "collector": "Telegraf",
  "collect_type": "host",
  "support_collect_detect": false,
  "status_query": "any({instance_type='iis', collect_type='host'}) by (instance_id)",
  "instance_fact_bindings": [
    {
      "fact": "asset.ip",
      "value_type": "ip",
      "resolver": "selected_node",
      "options": {
        "selection_field": "node_ids",
        "node_field": "ip",
        "required": true
      }
    }
  ],
  "instance_summary_columns": [
    {
      "fact": "asset.ip",
      "title": "monitor.views.assetIp",
      "order": 10
    }
  ],
  "name": "IIS",
  "icon": "mm-iis_IIS",
  "type": "Middleware",
  "description": "IIS monitoring via local telegraf_windows",
  "default_metric": "any({instance_type='iis'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "iis_current_connections",
    "iis_total_method_requests_persec",
    "iis_recent_worker_process_failures",
    "iis_site_probe_result_code"
  ],
  "display_fields": [
    {
      "name": "Current Connections",
      "sort_order": 0,
      "metrics": [
        {
          "plugin": "IIS",
          "metric": "iis_current_connections"
        }
      ]
    },
    {
      "name": "Method Requests",
      "sort_order": 1,
      "metrics": [
        {
          "plugin": "IIS",
          "metric": "iis_total_method_requests_persec"
        }
      ]
    },
    {
      "name": "Queue Size",
      "sort_order": 2,
      "metrics": [
        {
          "plugin": "IIS",
          "metric": "iis_queue_current_size"
        }
      ]
    },
    {
      "name": "Worker Failures",
      "sort_order": 3,
      "metrics": [
        {
          "plugin": "IIS",
          "metric": "iis_recent_worker_process_failures"
        }
      ]
    },
    {
      "name": "Site Probe",
      "sort_order": 4,
      "metrics": [
        {
          "plugin": "IIS",
          "metric": "iis_site_probe_result_code"
        }
      ]
    }
  ],
  "metrics": [
