{
  "object": "Hardware Server",
  "plugin": "Hardware Server IPMI",
  "templates": [
    {
      "name": "设备功率过高",
      "alert_name": "设备 ${resource_name} 功率过高",
      "description": "测量设备功率使用情况，若功率输出超标发出告警，帮助用户关注设备能耗问题或硬件异常。",
      "metric_name": "ipmi_power_watts",
      "algorithm": "max_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 200,
          "method": ">="
        },
        {
          "level": "error",
          "value": 150,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 100,
          "method": ">="
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "电压异常",
      "alert_name": "设备 ${resource_name} 电压异常",
      "description": "检测设备的电压变化，若发生异常波动或不稳定，将告警提示用户检查供电或设备电力问题。",
      "metric_name": "ipmi_voltage_volts",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 240,
          "method": ">="
        },
        {
          "level": "error",
          "value": 220,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 200,
          "method": ">="
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "风扇转速过高",
      "alert_name": "设备 ${resource_name} 风扇转速过高",
      "description": "监测设备风扇的运行状态，若转速过高可能导致损耗或散热问题，及时提醒用户采取降温措施。",
      "metric_name": "ipmi_fan_speed_rpm",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 5000,
          "method": ">="
        },
        {
          "level": "error",
          "value": 4000,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 3000,
          "method": ">="
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "温度异常",
      "alert_name": "设备 ${resource_name} 温度异常",
      "description": "持续检测设备温度，若检测到过高或过低的异常情况，触发告警以确保设备在安全温控范围内工作。",
      "metric_name": "ipmi_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 80,
          "method": ">="
        },
        {
          "level": "error",
          "value": 70,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 60,
          "method": ">="
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "电源状态异常",
      "alert_name": "设备 ${resource_name} 电源状态异常",
      "description": "监控设备电源的工作状态，若出现断电、电源损坏或其他异常情况，将触发告警以防止设备运行异常。",
      "metric_name": "ipmi_chassis_power_state",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 1,
          "method": "!="
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
