[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_alpha_cordex"
        config_type = "alpha_cordex"
        brand = "alpha_cordex"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # Cordex HP rectifierSystem under PEN 7309.5.3.1. Scalars use field OIDs with .0.
    # ScaledNumber DISPLAY-HINT d-3, divide by 1000. Do not invent CPU% or memory.
    # Do not collect ALPHA-RESOURCE multi-system tables in this pass.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7309.5.3.1.10.0"
        name = "raw_system_voltage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7309.5.3.1.11.0"
        name = "raw_system_current"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7309.5.3.1.12.0"
        name = "raw_battery_voltage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7309.5.3.1.13.0"
        name = "raw_battery_current"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7309.5.3.1.14.0"
        name = "raw_battery_temperature"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7309.5.3.1.45.0"
        name = "raw_rectifier_ambient_temperature"

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def scale_milli(metric, src, dest, lo, hi):
    raw = metric.fields.pop(src, None)
    if raw == None:
        return
    if raw == -2147483648:
        return
    value = float(raw) / 1000.0
    if value < lo or value > hi:
        return
    metric.fields[dest] = value

def apply(metric):
    f = metric.fields
    if len(f.keys()) == 0:
        return metric
    scale_milli(metric, "raw_system_voltage", "system_voltage_volts", -80, 80)
    scale_milli(metric, "raw_system_current", "system_load_current_amps", -2000, 2000)
    scale_milli(metric, "raw_battery_voltage", "battery_voltage_volts", -80, 80)
    scale_milli(metric, "raw_battery_current", "battery_current_amps", -2000, 2000)
    scale_milli(metric, "raw_battery_temperature", "battery_temperature_celsius", -40, 100)
    scale_milli(metric, "raw_rectifier_ambient_temperature", "rectifier_ambient_temperature_celsius", -40, 100)
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["alpha_cordex"]
