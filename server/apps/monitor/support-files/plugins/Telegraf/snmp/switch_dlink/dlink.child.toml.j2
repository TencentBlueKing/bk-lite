[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_dlink"
        config_type = "dlink"
        brand = "dlink"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：AGENT-GENERAL-MIB 标量，顶层 field GET 必须带实例 .0；禁止 table.field+.0 ----
    # 发现身份为 sysObjectID 前缀 1.3.6.1.4.1.171.10。不采集路由器对象。
    # agentCPUutilizationIn5min 作 headline；5s / 1min 为同组可选窗口。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.171.12.1.1.6.1.0"
        name = "device_cpu_usage_5s"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.171.12.1.1.6.2.0"
        name = "device_cpu_usage_1min"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.171.12.1.1.6.3.0"
        name = "device_cpu_usage"
    # ---- 内存：agentDRAMutilizationTable，INDEX unitID（0=本机）；table.field 不得带 .0 ----
    # Total/Used 原始单位 KB，盘侧 *1024 换成字节；利用率取厂商 0-100 直报。Flash 未进本轮最小集。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.12.1.1.9.1.1"
        name = "unitID"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.12.1.1.9.1.2"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.12.1.1.9.1.3"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.12.1.1.9.1.4"
        name = "usage"
    # ---- DGS-1250 ENTITY-EXT 温度：dEntityExtEnvTempCurrent（℃），tag=dEntityExtEnvTempDescr ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.11.165.1000.5.1.1.1.1.3"
        name = "sensor_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.11.165.1000.5.1.1.1.1.4"
        name = "celsius"
    # ---- DGS-1250 ENTITY-EXT 风扇：dEntityExtEnvFanStatus ok(1)/fault(2) ----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.11.165.1000.5.1.1.2.1.3"
        name = "fan_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.11.165.1000.5.1.1.2.1.4"
        name = "state"
    # ---- DGS-1250 ENTITY-EXT 电源：dEntityExtEnvPowerStatus inOperation(1)/failed(2)/empty(3) ----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.11.165.1000.5.1.1.3.1.3"
        name = "psu_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.171.11.165.1000.5.1.1.3.1.6"
        name = "state"
# ---- DGS-1250 温度范围过滤与风扇/电源枚举归一；无该树的设备不产生行。----
[[processors.starlark]]
    namepass = ["device_temperature", "device_fan", "device_psu"]
    source = '''
def apply(metric):
    name = metric.name
    if name == "device_temperature":
        value = metric.fields.get("celsius")
        if value == None:
            return None
        celsius = float(value)
        if celsius < -40 or celsius > 125:
            return None
        metric.fields["celsius"] = celsius
        return metric
    if name == "device_fan":
        raw = metric.fields.get("state")
        if raw == None:
            return None
        value = int(raw)
        if value == 1:
            metric.fields["state"] = 1
            return metric
        if value == 2:
            metric.fields["state"] = 2
            return metric
        return None
    if name == "device_psu":
        raw = metric.fields.get("state")
        if raw == None:
            return None
        value = int(raw)
        if value == 1:
            metric.fields["state"] = 1
            return metric
        if value == 2 or value == 3:
            metric.fields["state"] = 2
            return metric
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["dlink"]

