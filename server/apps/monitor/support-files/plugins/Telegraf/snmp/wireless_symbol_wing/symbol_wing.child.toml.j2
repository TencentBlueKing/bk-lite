[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_symbol_wing"
        config_type = "symbol_wing"
        brand = "symbol_wing"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # Extreme / Symbol / Motorola WiNG 设备系统信息表（PEN 388，wingMIB …388.50）
    # INDEX 为设备 MAC（6 段子 OID），保留为 tag index；控制器下一行一台被管设备。
    # CPU 原始值为 10×百分比，Starlark 中 ÷10；内存原始值为 KiB，Starlark 中 ×1024 为字节。
    [[inputs.snmp.table]]
        name = "device"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.388.50.1.4.2.1.1.3"
        name = "hostname"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.388.50.1.4.2.2.1.1.1"
        name = "mem_free_kib"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.388.50.1.4.2.2.1.1.2"
        name = "mem_total_kib"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.388.50.1.4.2.2.1.1.8"
        name = "cpu_limit_s0"
# ---- WiNG sysinfo：去掉原始 KiB / ×10 辅助列，写出 CPU% 与字节内存；越界与哨兵丢弃。----
[[processors.starlark]]
    namepass = ["device"]
    source = '''
def _to_float(raw):
    if raw == None:
        return None
    if type(raw) == "int" or type(raw) == "float":
        return float(raw)
    return None

def _is_sentinel(value):
    n = int(value)
    if n == 65535 or n == 65534 or n == -1:
        return True
    if n == 2147483647 or n == -2147483648:
        return True
    if n == 4294967295:
        return True
    return False

def apply(metric):
    f = metric.fields
    cpu_raw = f.pop("cpu_limit_s0", None)
    free_raw = f.pop("mem_free_kib", None)
    total_raw = f.pop("mem_total_kib", None)

    cpu_val = _to_float(cpu_raw)
    if cpu_val != None and not _is_sentinel(cpu_val):
        cpu_pct = cpu_val / 10.0
        cpu_pct = float(int(cpu_pct * 10.0 + 0.5)) / 10.0
        if cpu_pct >= 0 and cpu_pct <= 100:
            f["cpu_usage"] = cpu_pct

    free_val = _to_float(free_raw)
    total_val = _to_float(total_raw)
    if free_val != None and _is_sentinel(free_val):
        free_val = None
    if total_val != None and _is_sentinel(total_val):
        total_val = None
    if total_val != None and total_val > 0 and free_val != None and free_val >= 0 and free_val <= total_val:
        total_bytes = total_val * 1024.0
        free_bytes = free_val * 1024.0
        used_pct = (total_bytes - free_bytes) / total_bytes * 100.0
        used_pct = float(int(used_pct * 100.0 + 0.5)) / 100.0
        if used_pct >= 0 and used_pct <= 100:
            f["memory_total"] = total_bytes
            f["memory_free"] = free_bytes
            f["memory_usage"] = used_pct

    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["symbol_wing"]
