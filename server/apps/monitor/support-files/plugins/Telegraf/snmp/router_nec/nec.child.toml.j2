[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_nec"
        config_type = "nec"
        brand = "nec"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- NEC UNIVERGE IX 系统 MIB（PICO-SMI picoSystem 1.3.6.1.4.1.119.2.3.84.2）----
    # CPU/内存/温度均为标量：顶层 field GET 带实例 .0 → measurement snmp → 查询 snmp_ 前缀。
    # picoSchedRtUtl1Min（.5.3.0）：最近 1 分钟系统利用率%（Gauge）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.119.2.3.84.2.5.3.0"
        name = "device_cpu_usage"
    # picoHeapUtil（.6.2.0）：当前堆内存利用率%（Gauge）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.119.2.3.84.2.6.2.0"
        name = "device_memory_usage"
    # picoCelsius（.1.1.0）：设备内部温度，摄氏度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.119.2.3.84.2.1.1.0"
        name = "device_temperature_celsius"
    # ---- 风扇：picoFanTable .3（INDEX picoFanIndex），picoFanStatus .3.1.2 normal(1)/failure(2)，picoFanRpm .3.1.3 转速 rpm ----
    # 风扇/电源表为 optional 对象，仅部分机型（如 IX2310/IX3315）实现；未实现时表为空不产出。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.119.2.3.84.2.3.1.2"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.119.2.3.84.2.3.1.3"
        name = "speed"
    # ---- 电源：picoPowerSupplyTable .4（INDEX picoPowerSupplyIndex），picoPowerSupplyStatus .4.1.3 notInstalled(0)/normal(1)/failure(2) ----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.119.2.3.84.2.4.1.3"
        name = "state"
# ---- 风扇状态归一：normal(1)→1(正常)，failure(2) 及其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
    [processors.enum.tagpass]
        brand = ["nec"]
# ---- 电源状态归一：notInstalled(0) 空槽整行丢弃，不计入故障；normal(1)→1(正常)，failure(2) 及其余→2(异常)。----
[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    if "state" not in metric.fields:
        return None
    raw = int(metric.fields["state"])
    if raw == 0:
        return None
    if raw == 1:
        metric.fields["state"] = 1
    else:
        metric.fields["state"] = 2
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["nec"]
