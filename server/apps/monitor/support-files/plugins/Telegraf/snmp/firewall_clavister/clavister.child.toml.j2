[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_clavister"
        config_type = "clavister"
        brand = "clavister"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # 识别门：sysObjectID 前缀 1.3.6.1.4.1.5089（clavister / CLAVISTER-MIB）。
    # 标量：顶层 field GET 必须带实例 .0；禁止 table.field+.0。
    # ---- CPU：clvSysCpuLoad，Gauge32 0-100 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5089.1.2.1.1.0"
        name = "device_cpu_usage"
    # ---- 内存利用率：clvSysMemUsage，Gauge32 0-100 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5089.1.2.1.12.0"
        name = "device_memory_usage"
    # ---- 内存 KiB：clvSysMemUsedKiB / clvSysMemFreeKiB；盘侧 *1024 转字节 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5089.1.2.1.18.0"
        name = "device_memory_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5089.1.2.1.19.0"
        name = "device_memory_free"
    # ---- 会话：clvSysConns → firewall_active_sessions ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5089.1.2.1.5.0"
        name = "firewall_active_sessions"
    # ---- 硬件传感器：clvHWSensorTable 1.3.6.1.4.1.5089.1.2.1.11（表，table.field 不带 .0）----
    # clvHWSensorName .1.2（DisplayString）/ clvHWSensorValue .1.3（Gauge32）/ clvHWSensorUnit .1.4（DisplayString）；下方 starlark 只保留温度行 → device_temperature_celsius{sensor}。
    [[inputs.snmp.table]]
        name = "clv_hw_sensor"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5089.1.2.1.11.1.2"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5089.1.2.1.11.1.3"
        name = "value"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5089.1.2.1.11.1.4"
        name = "unit"
# ---- 不采集 clvSysForwardedBits(.2) / clvSysBuffUse(.4)；接口走内置 IF-MIB。不搬 IPsec/Pipe/ALG 树。----

# ---- 温度行筛选：单位为 C / °C / degC / Celsius（不区分大小写）的行，或单位为空且名称含 temp 的行 → device_temperature（celsius）；其它单位（风扇转速、电压等）与无值行丢弃。----
[[processors.starlark]]
    namepass = ["clv_hw_sensor"]
    source = '''
CELSIUS_UNITS = ["c", "°c", "degc", "deg c", "celsius", "degree celsius", "degrees celsius"]

def apply(metric):
    value = metric.fields.get("value")
    if value == None:
        return None
    unit = str(metric.fields.get("unit", "")).strip().lower()
    name = str(metric.tags.get("sensor", "")).lower()
    is_temp = unit in CELSIUS_UNITS or "celsius" in unit
    if unit == "" and "temp" in name:
        is_temp = True
    if not is_temp:
        return None
    m = Metric("device_temperature")
    for k, v in metric.tags.items():
        m.tags[k] = v
    m.fields["celsius"] = int(value)
    m.time = metric.time
    return m
'''
    [processors.starlark.tagpass]
        brand = ["clavister"]
