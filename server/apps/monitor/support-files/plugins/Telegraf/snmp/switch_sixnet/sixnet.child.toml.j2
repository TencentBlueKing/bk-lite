[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_sixnet"
        config_type = "sixnet"
        brand = "sixnet"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- 可选：序列号 / 固件版本（设备返回时作为实例标签，无响应则自然缺省）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20540.2.1.1.4"
        name = "serialNumber"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20540.2.1.1.6"
        name = "firmwareRevision"
        is_tag = true
# @bk_include_ifmib_table
    # ---- P1 电源输入状态 → psu1_status ----
    # 原始码 off(0) / on(1) / unknown(2)。
    [[inputs.snmp.table]]
        name = "psu1"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.20540.2.1.1.1"
        name = "status"
    # ---- P2 电源输入状态 → psu2_status ----
    # 原始码 off(0) / on(1) / unknown(2)。
    [[inputs.snmp.table]]
        name = "psu2"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.20540.2.1.1.2"
        name = "status"
    # ---- OK 告警继电器状态 → ok_relay_status ----
    # 原始码 off(0) / on(1) / unknown(2)。on 表示继电器处于正常（OK）侧。
    [[inputs.snmp.table]]
        name = "ok_relay"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.20540.2.1.1.3"
        name = "status"
# ---- CPU/内存/温度/风扇：无私有 CPU 或内存使用率标量，不臆造 CPU%/内存%；无风扇对象 → N/A 不采。----
