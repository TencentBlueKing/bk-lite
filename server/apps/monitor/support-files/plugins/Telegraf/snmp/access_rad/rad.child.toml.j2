[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_rad"
        config_type = "rad"
        brand = "rad"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # Power-supply table (RAD-GEN systemPsTable, PEN 164).
    # systemPsStatus ENUM notApplicable(1)/failed(2)/ok(3)/degraded(4) → psu_status.
    # Optional systemPsType is kept as a dimension.
    [[inputs.snmp.table]]
        name = "psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.164.6.2.25.1.3"
        name = "psType"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.164.6.2.25.1.4"
        name = "status"
    # Optical-port laser temperature (RAD-GEN optPrtMonitorTable).
    # Integer32 hundredths °C → query-side /100. Empty table yields no rows.
    [[inputs.snmp.table]]
        name = "sfp_laser_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.164.6.2.15.8.1.1.5"
        name = "celsius"
    # CPU/mem: no stable private scalar in RAD-GEN this round; do not invent.
