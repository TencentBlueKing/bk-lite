[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_aruba"
        config_type = "aruba"
        brand = "aruba"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Aruba CX module CPU utilization (ARUBAWIRED-VSF/CHASSIS MIB, ent 47196, per module) ----
    # 待现网核验：arubaWiredModuleCpuUtilization 1.3.6.1.4.1.47196.4.1.1.3.22.1.0.1.1.3（已归一化 0-100%）
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.22.1.0.1.1.3"
        name = "usage"
    # ---- Aruba CX module memory utilization (per module, % 直报，无 used/free 字节) ----
    # 待现网核验：arubaWiredModuleMemoryUtilization 1.3.6.1.4.1.47196.4.1.1.3.22.1.0.1.1.4 → 统一 device_memory_usage(原始%)
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.22.1.0.1.1.4"
        name = "usage"
    # ---- Aruba CX temperature sensors (ARUBAWIRED-SYSTEM MIB, per sensor) ----
    # 待现网核验：温度值 1.3.6.1.4.1.47196.4.1.1.3.11.3.1.1.7；descr=传感器名 ...1.1.5。
    # ⚠ 若现网为毫摄氏度(模版阈值有 /1000)，需现网加换算；mock 用摄氏度正常值不受影响。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.3.1.1.5"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.3.1.1.7"
        name = "celsius"
    # ---- Aruba CX fans (arubaWiredFanTable, PEN 47196) ----
    # arubaWiredFanName …11.5.1.1.4；arubaWiredFanRPM …11.5.1.1.8（Integer32 RPM，−1 无回读）；
    # arubaWiredFanStateEnum …11.5.1.1.10：unknown(1)/empty(2)/uninitialized(3)/ok(4)/fault(5)。
    # 归一：empty(2)/ok(4)→1；uninitialized(3)/fault(5)→2；unknown(1)→3。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.5.1.1.4"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.5.1.1.8"
        name = "rpm"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.5.1.1.10"
        name = "state"
    # ---- Aruba CX power supplies (arubaWiredPowerSupplyTable) ----
    # arubaWiredPSUProductName …11.2.1.1.5 作 descr；arubaWiredPSUStateEnum …11.2.1.1.11。
    # 归一：ok(1)/empty(12)→1；unknown(8)→3；faultAbsent(2)/init(11)/fault* 及其余→2。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.2.1.1.5"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.2.1.1.11"
        name = "state"
    # ---- Aruba CX PSU watts (own prefix, not mixed into device_psu_state) ----
    # arubaWiredPSUName …11.2.1.1.3；InstantaneousPower …1.7 / MaximumPower …1.8，单位 W。
    [[inputs.snmp.table]]
        name = "aruba_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.2.1.1.3"
        name = "psu_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.2.1.1.7"
        name = "instantaneous_watts"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.11.2.1.1.8"
        name = "maximum_watts"
    # ---- Aruba CX CPU 1/5 min averages (arubaWiredSystemInfoTable, own prefix) ----
    # CpuAvgOneMin …22.1.0.1.1.10 / CpuAvgFiveMin …22.1.0.1.1.11，Unsigned32 0..100。
    [[inputs.snmp.table]]
        name = "aruba_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.22.1.0.1.1.10"
        name = "avg_1min"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47196.4.1.1.3.22.1.0.1.1.11"
        name = "avg_5min"

[[processors.starlark]]
    namepass = ["device_fan", "device_psu", "aruba_psu", "aruba_cpu"]
    source = '''
def as_int(raw):
    if raw == None:
        return None
    if type(raw) == "int":
        return raw
    if type(raw) == "float":
        return int(raw)
    return int(raw)

def apply(metric):
    f = metric.fields
    name = metric.name
    if name == "device_fan":
        st = as_int(f.get("state"))
        if st == None:
            if "state" in f:
                f.pop("state")
        elif st == 1:
            f["state"] = 3
        elif st == 2 or st == 4:
            f["state"] = 1
        elif st >= 3 and st <= 5:
            f["state"] = 2
        else:
            f.pop("state")
        rpm = as_int(f.get("rpm"))
        if rpm == None:
            if "rpm" in f:
                f.pop("rpm")
        elif rpm < 0 or rpm > 100000:
            f.pop("rpm")
        else:
            f["rpm"] = rpm
    elif name == "device_psu":
        st = as_int(f.get("state"))
        if st == None:
            if "state" in f:
                f.pop("state")
        elif st == 1 or st == 12:
            f["state"] = 1
        elif st == 8:
            f["state"] = 3
        elif st >= 2 and st <= 17:
            f["state"] = 2
        else:
            f.pop("state")
    elif name == "aruba_psu":
        for key in ("instantaneous_watts", "maximum_watts"):
            w = as_int(f.get(key))
            if w == None:
                if key in f:
                    f.pop(key)
            elif w < 0 or w > 100000:
                f.pop(key)
            else:
                f[key] = w
    elif name == "aruba_cpu":
        for key in ("avg_1min", "avg_5min"):
            v = as_int(f.get(key))
            if v == None:
                if key in f:
                    f.pop(key)
            elif v < 0 or v > 100:
                f.pop(key)
            else:
                f[key] = v
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["aruba"]
