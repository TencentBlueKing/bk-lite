[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_mrv"
        config_type = "mrv"
        brand = "mrv"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- NBS-CMMC (PEN 629) nbsCmmcChassisTemperature ----
    # 1.3.6.1.4.1.629.200.6.1.1.15.<chassisIdx> → temperature_celsius
    # Integer32 摄氏度，不换算。不受支持哨兵 -2147483648（0x80000000）在采集侧丢弃，查询侧仍跳过。
    [[inputs.snmp.table]]
        name = "temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.15"
        name = "celsius"
        conversion = "int"
    # ---- NBS-CMMC nbsCmmcChassisTable 1.3.6.1.4.1.629.200.6.1（INDEX nbsCmmcChassisIndex）：电源 / 风扇 / 供电充足度，table.field 不带 .0 ----
    # nbsCmmcChassisPS1..4Status .7-.10：notInstalled(1)/acBad(2)/dcBad(3)/acGood(4)/dcGood(5)/notSupported(6)/good(7)/bad(8)
    # nbsCmmcChassisFan1..4Status .11-.14、Fan5..8Status .36-.39：notSupported(1)/bad(2)/good(3)/notInstalled(4)
    # nbsCmmcChassisPowerStatus .51：notSupported(1)/sufficient(2)/insufficient(3)
    [[inputs.snmp.table]]
        name = "mrv_chassis"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.7"
        name = "ps1_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.8"
        name = "ps2_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.9"
        name = "ps3_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.10"
        name = "ps4_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.11"
        name = "fan1_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.12"
        name = "fan2_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.13"
        name = "fan3_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.14"
        name = "fan4_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.36"
        name = "fan5_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.37"
        name = "fan6_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.38"
        name = "fan7_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.39"
        name = "fan8_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.51"
        name = "power_raw"
# ---- CPU/内存：NBS-CMMC 无稳定、无需行级过滤的 CPU%/内存% 共享健康对象 → N/A，不臆造。----

# ---- 机箱表拆分：电源 device_psu_state（psu=1..4）good/acGood/dcGood → 1，bad/acBad/dcBad → 2；风扇 device_fan_state（fan=1..8）good → 1，bad → 2；----
# ---- 供电充足度 device_power_sufficiency_state sufficient → 1，insufficient → 2。notInstalled / notSupported 及其它取值不输出。----
[[processors.starlark]]
    namepass = ["mrv_chassis"]
    source = '''
PSU_MAP = {4: 1, 5: 1, 7: 1, 2: 2, 3: 2, 8: 2}
FAN_MAP = {3: 1, 2: 2}
POWER_MAP = {2: 1, 3: 2}

def child(metric, name, tag, tagval, value):
    m = Metric(name)
    for k, v in metric.tags.items():
        m.tags[k] = v
    if tag != None:
        m.tags[tag] = tagval
    m.fields["state"] = value
    m.time = metric.time
    return m

def apply(metric):
    out = []
    for i in range(1, 5):
        v = metric.fields.get("ps%d_raw" % i)
        if type(v) == "int" and v in PSU_MAP:
            out.append(child(metric, "device_psu", "psu", str(i), PSU_MAP[v]))
    for i in range(1, 9):
        v = metric.fields.get("fan%d_raw" % i)
        if type(v) == "int" and v in FAN_MAP:
            out.append(child(metric, "device_fan", "fan", str(i), FAN_MAP[v]))
    v = metric.fields.get("power_raw")
    if type(v) == "int" and v in POWER_MAP:
        out.append(child(metric, "device_power_sufficiency", None, None, POWER_MAP[v]))
    return out
'''
    [processors.starlark.tagpass]
        brand = ["mrv"]

# ---- 机箱温度：不受支持哨兵 -2147483648（0x80000000）或非整数读数在采集侧直接丢弃（查询侧过滤保留不变）。----
[[processors.starlark]]
    namepass = ["temperature"]
    source = '''
def apply(metric):
    value = metric.fields.get("celsius")
    if type(value) != "int" or value == -2147483648:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["mrv"]
