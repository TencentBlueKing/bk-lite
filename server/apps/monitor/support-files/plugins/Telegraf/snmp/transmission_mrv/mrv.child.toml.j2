[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_mrv"
        config_type = "mrv"
        brand = "mrv"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- NBS-CMMC (PEN 629) nbsCmmcChassisTemperature ----
    # 1.3.6.1.4.1.629.200.6.1.1.15.<chassisIdx> → temperature_celsius
    # Integer32 摄氏度，不换算。不受支持哨兵 -2147483648（0x80000000），查询侧跳过。
    [[inputs.snmp.table]]
        name = "temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.629.200.6.1.1.15"
        name = "celsius"
        conversion = "int"
# ---- CPU/内存/风扇/电源：NBS-CMMC 已确认机箱温度表。无稳定、无需行级过滤的 CPU%/内存% 共享健康对象 → N/A，不臆造。----
