[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_nokia_router"
        config_type = "nokia_router"
        brand = "nokia"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # 识别门：sysObjectID 前缀 1.3.6.1.4.1.6527（timetra / TiMOS / SROS / 7705 SAR / 7750 SR）。
    # 不绑定 OmniSwitch 1.3.6.1.4.1.6486（那是 switch_nokia）。
    # 标量：顶层 field GET 必须带实例 .0；table.field 禁止 .0。
    # ---- CPU：TIMETRA-SYSTEM-MIB sgiCpuUsage，Unsigned32 0..100 percent ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6527.3.1.2.1.1.1.0"
        name = "device_cpu_usage"
    # ---- 内存字节：sgiMemoryUsed / sgiMemoryAvailable，Unsigned32 bytes ----
    # 大内存机 Unsigned32 会饱和到 4294967295，查询侧优先 KB 叶。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6527.3.1.2.1.1.2.0"
        name = "device_memory_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6527.3.1.2.1.1.3.0"
        name = "device_memory_free"
    # ---- 内存 KB：sgiKbMemoryUsed / sgiKbMemoryAvailable，查询侧 *1024 转字节 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6527.3.1.2.1.1.9.0"
        name = "device_memory_used_kb"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6527.3.1.2.1.1.10.0"
        name = "device_memory_free_kb"
    # ---- 机箱温度：TIMETRA-CHASSIS-MIB tmnxHwTemperature，table.field 禁止 .0 ----
    # -1 表示该硬件无温度传感器，starlark 丢弃。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6527.3.1.2.2.1.8.1.8"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6527.3.1.2.2.1.8.1.18"
        name = "celsius"
# ---- 不采集 TIMETRA 服务/路由大表；接口走内置 IF-MIB。----

[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    value = metric.fields.get("celsius")
    if value == None:
        return None
    if value == -1 or value == "-1":
        return None
    return metric
'''
