[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_hirschmann"
        config_type = "hirschmann"
        brand = "hirschmann"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：HMPRIV Classic 标量，顶层 field GET 必须带实例 .0；禁止 table.field+.0 ----
    # 发现身份为 sysObjectID 前缀 1.3.6.1.4.1.248，且走 hmConfiguration(14) 资源树。
    # 不采集 HiOS IT 树 248.100，也不与 RUGGEDCOM 15004 / Westermo 16177 混用。
    # hmCpuUtilization 作 headline；hmCpuAverageUtilization 为 ≤30 分钟均值可选窗口。
    # 部分固件需 hmEnableMeasurement 1.3.6.1.4.1.248.14.2.15.1.0 = enable(1) 后资源 Gauge 才填充。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.2.1.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.2.2.0"
        name = "device_cpu_usage_avg"
    # ---- 内存：hmMemoryAllocated / hmMemoryFree，标量 field 带 .0，原始单位 kBytes ----
    # 盘侧 *1024 换成字节；利用率 allocated/(allocated+free)（单位相消）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.3.1.0"
        name = "device_memory_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.3.2.0"
        name = "device_memory_free"
    # ---- 温度：hmTemperature 标量 ℃，顶层 field 必须带 .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.5.1.0"
        name = "device_temperature_celsius"
    # ---- 风扇：hmFanState 表列禁止 .0；INDEX hmFanSysID+hmFanID ----
    # ok(1)→1(正常)，failed(2) 及其余→2(异常)。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.14.1.3.1.3"
        name = "state"
# ---- 不采集 VLAN/PTP/traps，也不把 hmIfaceUtilization 当 CPU。接口走内置 IF-MIB。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
