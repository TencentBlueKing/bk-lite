[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_hirschmann"
        config_type = "hirschmann"
        brand = "hirschmann"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Hirschmann CPU (HMPRIV-MGMT-SNMP-MIB hmCpuUtilization, 直接%, scalar, PEN 248) ----
    # 顶层 field GET 必须带实例 .0；禁止 table.field（标量 GET-NEXT 会走到空子树，指标静默为空）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.2.1.0"
        name = "device_cpu_usage"
    # ---- Hirschmann 内存 (hmMemoryAllocated 已用 + hmMemoryFree 空闲, KB；无总量 → used/(used+free)) ----
    # 顶层 field GET 必须带实例 .0。查询侧 ×1024 转为字节；用量按 used/(used+free)。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.3.1.0"
        name = "device_memory_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.3.2.0"
        name = "device_memory_free"
    # ---- Hirschmann 温度 (hmTemperature, 直接 ℃, scalar) ----
    # 顶层 field GET 必须带实例 .0；禁止 table.field。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.5.1.0"
        name = "device_temperature_celsius"
    # ---- Hirschmann 电源状态 (hmPSState 表 .248.14.1.2.1.3, 每电源 ok(1)/failed(2)/notInstalled(3)/unknown(4)) ----
    # 原始码 ok=1；下方 enum 归一 1→1(正常),其余→2(异常)。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.14.1.2.1.3"
        name = "state"
    # SFP DDM: hmSfpTemperature (°C), hmSfpTxPowerInt/hmSfpRxPowerInt (0.1 µW),
    # hmSfpRxPowerState ok(1)/warning(2)/alarm(3). Composite index kept as tag.
    [[inputs.snmp.table]]
        name = "device_sfp"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.14.1.1.13.1.12"
        name = "temperature_celsius"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.14.1.1.13.1.15"
        name = "tx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.14.1.1.13.1.16"
        name = "rx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.14.1.1.13.1.17"
        name = "rx_power_state"
    # Fan state: hmFanState ok(1)/failed(2), per-slot table.
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.14.1.3.1.3"
        name = "state"
# ---- 状态归一:电源 ok(1)→1(正常),其余(failed/notInstalled/unknown)→2(异常)。----
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1

# SFP temp range -40..125 C (drops the -1000 read-error by range). Power is
# stored in µW after dividing the 0.1 µW integer once. Fan/Rx-power states map
# every defined code to 1 or 2; undefined values are dropped.
[[processors.starlark]]
    namepass = ["device_sfp", "device_fan"]
    source = '''
def apply(metric):
    f = metric.fields
    if metric.name == "device_fan":
        st = f.get("state")
        if st == None:
            return None
        if st == 1:
            f["state"] = 1
        elif st == 2:
            f["state"] = 2
        else:
            return None
        return metric
    t = f.get("temperature_celsius")
    if t != None:
        if t < -40 or t > 125:
            f.pop("temperature_celsius")
    tx = f.get("tx_power")
    if tx != None:
        if tx < 0 or tx > 1000000:
            f.pop("tx_power")
        else:
            f["tx_power"] = tx / 10.0
    rx = f.get("rx_power")
    if rx != None:
        if rx < 0 or rx > 1000000:
            f.pop("rx_power")
        else:
            f["rx_power"] = rx / 10.0
    rs = f.get("rx_power_state")
    if rs != None:
        if rs == 1:
            f["rx_power_state"] = 1
        elif rs == 2 or rs == 3:
            f["rx_power_state"] = 2
        else:
            f.pop("rx_power_state")
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["hirschmann"]
