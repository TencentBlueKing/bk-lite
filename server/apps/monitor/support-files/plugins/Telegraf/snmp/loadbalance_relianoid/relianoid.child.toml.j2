[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_relianoid"
        config_type = "relianoid"
        brand = "relianoid"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Identity only (noidHostname under enterprise 61269; not a health gauge) ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.61269.1.0.1"
        name = "noid_hostname"
        is_tag = true
    # ---- Interfaces (generic IF-MIB HC chassis) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- CPU (UCD-SNMP 1.3.6.1.4.1.2021; private 61269 has no CPU scalars) ----
    # ssCpuIdle 1.3.6.1.4.1.2021.11.11.0 → usage = 100−idle；缺 idle 时用 ssCpuUser+ssCpuSystem。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.11.11.0"
        name = "idle"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.11.9.0"
        name = "user"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.11.10.0"
        name = "system"
    # ---- Memory (UCD-SNMP memTotalReal/memAvailReal, kB; usage=(total-avail)/total) ----
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "total"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.4.6.0"
        name = "free"
        conversion = "int"
    # ---- Optional load averages (UCD-SNMP laLoad.1/2/3) ----
    [[inputs.snmp.table]]
        name = "device"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.10.1.3.1"
        name = "load1"
        conversion = "float"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.10.1.3.2"
        name = "load5"
        conversion = "float"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.10.1.3.3"
        name = "load15"
        conversion = "float"
# ---- 不扩展 IF-MIB 错误计数、ifOperStatus 或 32 位字节计数器。温度/风扇/电源/连接数：私有 61269 与 UCD-SNMP 均无无需行级过滤的标量 → N/A 不采。----

[[processors.starlark]]
    namepass = ["device_cpu"]
    [processors.starlark.tagpass]
        brand = ["relianoid"]
    source = '''
def apply(metric):
    idle = metric.fields.get("idle")
    user = metric.fields.get("user")
    system = metric.fields.get("system")
    if idle != None:
        metric.fields["usage"] = 100 - idle
    elif user != None and system != None:
        metric.fields["usage"] = user + system
    return metric
'''
