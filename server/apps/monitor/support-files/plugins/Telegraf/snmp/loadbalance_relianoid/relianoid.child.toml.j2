[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_relianoid"
        config_type = "relianoid"
        brand = "relianoid"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Identity only (noidHostname under enterprise 61269; not a health gauge) ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.61269.1.0.1"
        name = "noid_hostname"
        is_tag = true
    # ---- Interfaces (generic IF-MIB HC chassis) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- CPU (UCD-SNMP 1.3.6.1.4.1.2021; private 61269 has no CPU scalars) ----
    # ssCpuIdle / ssCpuUser / ssCpuSystem are scalars: top-level fields with instance .0 (direct GET),
    # landing in measurement snmp; queries use the snmp_ prefix.
    # The starlark below computes usage = 100 - idle, or user + system when idle is missing.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.11.0"
        name = "device_cpu_idle"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.9.0"
        name = "device_cpu_user"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.10.0"
        name = "device_cpu_system"
        conversion = "int"
    # ---- Memory (UCD-SNMP memTotalReal .4.5.0 / memAvailReal .4.6.0, scalars in kB) ----
    # Converted to bytes at collection time; used and usage % are computed by the starlark below.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "device_memory_total"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.6.0"
        name = "device_memory_free"
        conversion = "int"
    # ---- Optional load averages (UCD-SNMP laTable laLoad, rows 1/2/3 = 1/5/15 min) ----
    # laLoad is a table column; 2021.10.1.3.1/.2/.3 are already the full row instances, so they are
    # read with a direct GET as top-level fields (no extra .0). DisplayString such as "0.12" -> float.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.10.1.3.1"
        name = "device_load1"
        conversion = "float"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.10.1.3.2"
        name = "device_load5"
        conversion = "float"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.10.1.3.3"
        name = "device_load15"
        conversion = "float"
# ---- 不扩展 IF-MIB 错误计数、ifOperStatus 或 32 位字节计数器。温度/风扇/电源/连接数：私有 61269 与 UCD-SNMP 均无无需行级过滤的标量 → N/A 不采。----

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    idle = metric.fields.get("device_cpu_idle")
    user = metric.fields.get("device_cpu_user")
    system = metric.fields.get("device_cpu_system")
    if idle != None:
        metric.fields["device_cpu_usage"] = 100 - int(idle)
    elif user != None and system != None:
        metric.fields["device_cpu_usage"] = int(user) + int(system)
    total = metric.fields.get("device_memory_total")
    free = metric.fields.get("device_memory_free")
    if total != None:
        total = int(total) * 1024
        metric.fields["device_memory_total"] = total
    if free != None:
        free = int(free) * 1024
        metric.fields["device_memory_free"] = free
    if total != None and free != None and total > 0 and free <= total:
        used = total - free
        metric.fields["device_memory_used"] = used
        metric.fields["device_memory_usage"] = used * 100.0 / total
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["relianoid"]
