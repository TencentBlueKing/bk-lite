[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_parks_olt"
        config_type = "parks_olt"
        brand = "parks_olt"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Parks Fiberlink OLT CPU / 内存（PEN 3893，…3893.4.4）：标量，顶层 field 带 .0 → measurement snmp ----
    # pkCpuSystem .4.4.1.2.0：CPU 平均使用率，单位 0.1%（67 = 6.7%），下方 starlark ÷10。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3893.4.4.1.2.0"
        name = "device_cpu_usage"
    # pkMemoryTotal .4.4.2.1.0 / pkMemoryFree .4.4.2.2.0 / pkMemoryUsed .4.4.2.3.0：KB（查询侧 ×1024 换算为字节）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3893.4.4.2.1.0"
        name = "device_memory_total"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3893.4.4.2.2.0"
        name = "device_memory_free"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3893.4.4.2.3.0"
        name = "device_memory_used"
        conversion = "int"
    # ---- 温度传感器表（pkTemperatureSensorTable …3893.1.27.1.1）----
    # pkTemperatureSensorLocation .2 作 sensor 标签；pkTemperatureSensorValue .3：℃；pkTemperatureSensorStatus .4：normal(1) / limitexceeded(2)。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3893.1.27.1.1.2"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3893.1.27.1.1.3"
        name = "celsius"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3893.1.27.1.1.4"
        name = "state"
# ---- 风扇/电源：通用传感器表混合多种类型，需按标签/类型逐行区分，本模板不采集。----
# ---- CPU 换算：pkCpuSystem 以 0.1% 为单位，÷10 得百分比。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    v = metric.fields.get("device_cpu_usage")
    if v != None:
        metric.fields["device_cpu_usage"] = int(v) / 10.0
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["parks_olt"]
# ---- 温度状态归一：normal(1)→1(正常)，limitexceeded(2) 及其它→2(异常)。----
[[processors.enum]]
    namepass = ["device_temperature"]
    [processors.enum.tagpass]
        brand = ["parks_olt"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
