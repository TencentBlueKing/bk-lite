[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_ceragon"
        config_type = "ceragon"
        brand = "ceragon"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- MWRM-UNIT-MIB genEquipUnitInfo 1.3.6.1.4.1.2281.10.1.1：IDU 机箱侧标量，顶层 field 带 .0，落 measurement snmp ----
    # genEquipUnitMeasurementSystem .8.0：metric(0) / imperial(1)；genEquipUnitIduTemperature .9.0：IDU 温度，按度量制上报；
    # genEquipUnitIduVoltageInput .10.0：输入电压（INTEGER，伏）。不采 genEquipUnitIduPowerSupply*AlarmAdmin（告警屏蔽配置，非电源运行状态）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2281.10.1.1.8.0"
        name = "idu_measurement_system"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2281.10.1.1.9.0"
        name = "idu_temperature_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2281.10.1.1.10.0"
        name = "idu_voltage_input_raw"
# @bk_include_ifmib_table
    # ---- MWRM-RADIO-MIB genEquipRfuStatusTable 1.3.6.1.4.1.2281.10.5.1（INDEX genEquipRfuStatusId，每个 RFU 一行）：table.field 不带 .0 ----
    # genEquipRfuStatusTemperature .1.4：Integer32 RFU 温度；genEquipRfuStatusPATemp .1.24：Integer32 功放（PA）温度，型号不支持时缺省。
    # 仅 RFU 温度随 genEquipUnitMeasurementSystem 设置变化（英制时为 ℉），按公制（℃）处理；PA 温度 MIB 明确为 celsius。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2281.10.5.1.1.4"
        name = "celsius"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2281.10.5.1.1.24"
        name = "pa_celsius"
# ---- CPU/内存/风扇/电源：MWRM-RADIO-MIB 不提供整机 CPU、内存、风扇、电源对象，不采集。----

# ---- 温度合理性：非数值或超出 -50~150 的读数视为无效丢弃；两项都无效时整行丢弃。----
[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    for key in ["celsius", "pa_celsius"]:
        value = metric.fields.get(key)
        if value == None:
            continue
        if type(value) not in ["int", "float"] or value < -50 or value > 150:
            metric.fields.pop(key)
    if "celsius" not in metric.fields and "pa_celsius" not in metric.fields:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["ceragon"]

# ---- IDU 标量：imperial(1) 时把 ℉ 换算成 ℃，其余按 ℃；换算后超出 -50~150 丢弃。输入电压只保留绝对值不超过 1000 的整数。----
# ---- 输出 device_idu_temperature_celsius / device_voltage_input（查询带 snmp_ 前缀），原始字段与度量制字段不落库。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    system = metric.fields.pop("idu_measurement_system", None)
    temp = metric.fields.pop("idu_temperature_raw", None)
    volt = metric.fields.pop("idu_voltage_input_raw", None)
    if type(temp) == "int":
        celsius = float(temp)
        if system == 1:
            celsius = (temp - 32) * 5.0 / 9.0
        if celsius >= -50 and celsius <= 150:
            metric.fields["device_idu_temperature_celsius"] = celsius
    if type(volt) == "int" and volt >= -1000 and volt <= 1000:
        metric.fields["device_voltage_input"] = volt
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["ceragon"]
