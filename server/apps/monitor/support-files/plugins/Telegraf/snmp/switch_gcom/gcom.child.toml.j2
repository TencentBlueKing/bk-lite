[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_gcom"
        config_type = "gcom"
        brand = "gcom"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU 空闲%（gbnPlatformOAMSystem cpuIdle，标量 field 带 .0）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.13464.1.2.1.1.2.11.0"
        name = "cpu_idle"
    # ---- 内存总量/空闲（memorySize / memoryIdle，Integer32 字节，标量 field 带 .0）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.13464.1.2.1.1.2.12.0"
        name = "memory_size"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.13464.1.2.1.1.2.13.0"
        name = "memory_idle"
# ---- 温度/风扇/电源：本 OAM 系统组无环境传感器，不采。----
# ---- CPU%=100−cpuIdle；Mem%=(Size−Idle)×100/Size。原始辅助字段不入库。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    f = metric.fields
    idle = f.pop("cpu_idle", None)
    size = f.pop("memory_size", None)
    mem_idle = f.pop("memory_idle", None)
    if idle != None and idle >= 0 and idle <= 100:
        f["device_cpu_usage"] = 100 - idle
    if size != None and mem_idle != None and size > 0 and mem_idle >= 0 and mem_idle <= size:
        total = int(size)
        free = int(mem_idle)
        used = total - free
        f["device_memory_total"] = total
        f["device_memory_free"] = free
        f["device_memory_used"] = used
        f["device_memory_usage"] = int(used * 1000.0 / total + 0.5) / 10.0
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["gcom"]
