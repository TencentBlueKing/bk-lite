[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_enlogic"
        config_type = "enlogic"
        brand = "enlogic"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ENLOGIC-PDU-MIB under PEN 38446.1. PDU2 uses the same tree; collect once.
    # Do not invent CPU% or memory. Do not walk Smart Cabinet tables.
    # pduUnitStatusActivePower, Watts.
    [[inputs.snmp.table]]
        name = "pdu_active_power"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.2.4.1.2"
        name = "pdu_unit"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.2.4.1.4"
        name = "watts"
    # pduInputPhaseStatusCurrent (hundredths A, /100 in query), optional
    # pduInputPhaseStatusVoltage (V) and pduInputPhaseStatusActivePower (W).
    [[inputs.snmp.table]]
        name = "pdu_phase"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.3.4.1.2"
        name = "phase"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.3.4.1.5"
        name = "current_amps"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.3.4.1.6"
        name = "voltage_volts"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.3.4.1.7"
        name = "power_watts"
    # pduOutletMeteredStatusName plus pduOutletMeteredStatusCurrent (hundredths A, /100 in query).
    [[inputs.snmp.table]]
        name = "pdu_outlet"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.5.9.1.3"
        name = "outlet"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.5.9.1.5"
        name = "current_amps"
    # pduExternalSensorStatusHighPrecisionValue is tenths. Keep temperature rows
    # where type=1 and units=1 (degreeC). Query divides by 10.
    [[inputs.snmp.table]]
        name = "env_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.6.4.1.2"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.6.2.1.6"
        name = "sensor_type"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.6.2.1.7"
        name = "sensor_units"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.6.4.1.8"
        name = "celsius"
    # Same high-precision value column. Keep humidity rows where type=2 and
    # units=3 (percent). Query divides by 10.
    [[inputs.snmp.table]]
        name = "env_humidity"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.6.4.1.2"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.6.2.1.6"
        name = "sensor_type"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.6.2.1.7"
        name = "sensor_units"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.38446.1.6.4.1.8"
        name = "percent"
