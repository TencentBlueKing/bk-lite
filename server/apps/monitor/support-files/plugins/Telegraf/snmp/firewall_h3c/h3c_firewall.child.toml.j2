[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_h3c_firewall"
        config_type = "h3c_firewall"
        brand = "h3c"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：HH3C-ENTITY-EXT-MIB hh3cEntityExtCpuUsage，直接百分比，实体表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.6。多数实体行回 0，有效值在承载 CPU 的实体上。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.6"
        name = "usage"
    # ---- 内存：HH3C-ENTITY-EXT-MIB hh3cEntityExtMemUsage，直接利用率百分比，实体表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.8。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.8"
        name = "usage"
    # ---- 温度：HH3C-ENTITY-EXT-MIB hh3cEntityExtTemperature，摄氏度，实体表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.12。不支持温度的实体回填 65535，查询侧 != 65535。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.12"
        name = "celsius"
    # ---- 风扇：ENTITY-MIB entPhysicalClass fan(7) + hh3cEntityExtOperStatus ----
    # OperStatus 列 1.3.6.1.4.1.25506.2.6.1.1.1.1.3：1 notSupported / 2 disabled / 3 enabled / 4 dangerous。
    # 查询侧 entPhysicalClass='7'。processors.enum：enabled(3)/notSupported(1)→1(正常)，其余→2(异常)。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "entPhysicalClass"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.3"
        name = "state"
    # ---- 电源：ENTITY-MIB entPhysicalClass powerSupply(6) + 同一 OperStatus 列 ----
    # 查询侧 entPhysicalClass='6'；枚举归一同风扇。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "entPhysicalClass"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.3"
        name = "state"
    # ---- 防火墙会话：HH3C-FIREWALL-MIB 标量，顶层 field 带实例 .0 ----
    # hh3cFWConnNumCurr ...2.88.1.2.1 → firewall_active_sessions
    # hh3cFWMaxConnNum ...2.88.1.1.1 → 容量分母
    # hh3cFWConnRate ...2.88.1.2.2 → firewall_session_rate（conn/s）
    # 不采集 accessible-for-notify 的会话用量对象。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.25506.2.88.1.2.1.0"
        name = "firewall_active_sessions"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.25506.2.88.1.1.1.0"
        name = "firewall_max_sessions"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.25506.2.88.1.2.2.0"
        name = "firewall_session_rate"

# ---- 风扇状态归一：enabled(3)→1(正常)，notSupported(1) 视为无传感器/不适用→1(正常)，其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            "3" = 1
# ---- 电源状态归一：同 OperStatus。----
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            "3" = 1
