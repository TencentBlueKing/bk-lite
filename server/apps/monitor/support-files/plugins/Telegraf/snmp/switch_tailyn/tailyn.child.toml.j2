[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_tailyn"
        config_type = "tailyn"
        brand = "tailyn"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Tailyn IMP-HF528 系统健康标量（PEN 5833 · IMP-HF528-MIB）----
    # 顶层 field GET 必须带实例 .0；百分比已是 0..100，温度已是 ℃，不做倍率换算。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5833.2017.3.15.1.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5833.2017.3.15.3.0"
        name = "device_memory_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5833.2017.4.11.1.0"
        name = "device_temperature_celsius"
# ---- 风扇/电源：本 MIB 无机箱风扇与电源状态叶 → N/A 不采。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    f = metric.fields
    cpu = f.get("device_cpu_usage")
    if cpu != None:
        if cpu < 0 or cpu > 100 or cpu == 65535 or cpu == 65534 or cpu == -1 or cpu == 2147483647 or cpu == -2147483648 or cpu == 4294967295:
            f.pop("device_cpu_usage")
    mem = f.get("device_memory_usage")
    if mem != None:
        if mem < 0 or mem > 100 or mem == 65535 or mem == 65534 or mem == -1 or mem == 2147483647 or mem == -2147483648 or mem == 4294967295:
            f.pop("device_memory_usage")
    temp = f.get("device_temperature_celsius")
    if temp != None:
        if temp < -40 or temp > 125 or temp == 65535 or temp == 65534 or temp == -1 or temp == 2147483647 or temp == -2147483648 or temp == 4294967295:
            f.pop("device_temperature_celsius")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["tailyn"]
