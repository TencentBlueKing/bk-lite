[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_barracuda_cloudgen"
        config_type = "barracuda_cloudgen"
        brand = "barracuda_cloudgen"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Barracuda CloudGen Firewall 硬件传感器（PHION-MIB，PEN 10704，hwSensors 1.3.6.1.4.1.10704.1.4，INDEX hwSensorName）----
    # 仅 F 系列硬件机型提供。table.field 不带 .0；hwSensorName 作为 sensor 标签，hwSensorType 区分传感器类型：
    # unknown(-1) / voltage(0) / fan(1) / temperature(2) / psu-status(3)。hwSensorValue 为 Integer32，含义随类型而定，由下方 starlark 分拆换算。
    [[inputs.snmp.table]]
        name = "hw_sensor"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10704.1.4.1.1"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10704.1.4.1.2"
        name = "sensor_type"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10704.1.4.1.3"
        name = "value"
# ---- CPU/内存使用率：PHION-MIB 没有整机利用率对象，不采集（boxServices 是服务运行状态，不能当利用率）。----

# ---- 按 sensor_type 拆成四类，sensor 标签保留：
# ----   temperature(2)：千分之一摄氏度 → device_temperature.celsius（÷1000），须在 -50~150 ℃；
# ----   fan(1)：转速 RPM → device_fan.speed，须为 0~50000；
# ----   voltage(0)：毫伏 → device_voltage.volts（÷1000），须为非 0 且绝对值不超过 100 V；
# ----   psu-status(3)：1 正常 → device_psu.state = 1，0 / 2 异常 → 2，其它值丢弃。
# ---- unknown(-1)、其它类型和无效读数整行丢弃。----
[[processors.starlark]]
    namepass = ["hw_sensor"]
    source = '''
def apply(metric):
    kind = metric.fields.pop("sensor_type", None)
    value = metric.fields.pop("value", None)
    if type(kind) != "int" or type(value) != "int":
        return None
    if kind == 2:
        if value < -50000 or value > 150000:
            return None
        metric.name = "device_temperature"
        metric.fields["celsius"] = value / 1000.0
    elif kind == 1:
        if value < 0 or value > 50000:
            return None
        metric.name = "device_fan"
        metric.fields["speed"] = value
    elif kind == 0:
        if value == 0 or value < -100000 or value > 100000:
            return None
        metric.name = "device_voltage"
        metric.fields["volts"] = value / 1000.0
    elif kind == 3:
        if value == 1:
            state = 1
        elif value == 0 or value == 2:
            state = 2
        else:
            return None
        metric.name = "device_psu"
        metric.fields["state"] = state
    else:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["barracuda_cloudgen"]
