[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_comtrol"
        config_type = "comtrol"
        brand = "comtrol"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- SFP DDM (portSfpTable) ----
    # managedSwitch model leaf 5 = es8520-xt (primary). Swap 5 → 8 on every
    # OID below for es9528 (same .3.2.2 suffix). PEN 1.3.6.1.4.1.2882.
    # portSfpDdmTempatureCurrent …1.5 → temperature_celsius (DisplayString, parse °C)
    # portSfpDdmTxPowerCurrent    …1.7 → tx_power
    # portSfpDdmRxPowerCurrent    …1.9 → rx_power
    # Optional portSfpDdmStatus   …1.4 used only to skip disabled / empty rows.
    [[inputs.snmp.table]]
        name = "sfp"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2882.2.1.5.3.2.2.1.1"
        name = "portSfpIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2882.2.1.5.3.2.2.1.4"
        name = "ddm_status"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2882.2.1.5.3.2.2.1.5"
        name = "temperature_celsius"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2882.2.1.5.3.2.2.1.7"
        name = "tx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2882.2.1.5.3.2.2.1.9"
        name = "rx_power"
# ---- ES8510 双路电源 LED（hardwareStatusTable，es8510=…2882.2.1.1）----
    # ledPower1Status …10.3.1.1.2 / ledPower2Status …10.3.1.1.3，INTEGER on(1)/off(2)。
    # 空槽或对象未出现则丢弃该字段；定义域外取值丢弃。SFP 树 …2882.2.1.5 不改。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2882.2.1.1.10.3.1.1.2"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2882.2.1.1.10.3.1.1.3"
        name = "state_backup"
# ---- CPU/内存：私有 MIB 无整机 CPU%/内存% 标量 → 不臆造，不采。----

[[processors.starlark]]
    namepass = ["sfp"]
    source = '''
def parse_numeric(raw):
    if raw == None:
        return None
    t = type(raw)
    if t == "int":
        return float(raw)
    if t == "float":
        return raw
    text = str(raw).strip()
    if text == "" or text == "N/A" or text == "n/a" or text == "NA" or text == "na" or text == "--" or text == "-":
        return None
    digits = ""
    started = False
    sign = ""
    for i in range(len(text)):
        c = text[i]
        if (c == "-" or c == "+") and not started and digits == "":
            sign = c
        elif c >= "0" and c <= "9":
            digits += c
            started = True
        elif c == "." and started:
            if "." not in digits:
                digits += c
        elif started:
            break
    if digits == "" or digits == ".":
        return None
    return float(sign + digits)

def apply(metric):
    status = metric.fields.get("ddm_status")
    if "ddm_status" in metric.fields:
        metric.fields.pop("ddm_status")
    if status == 2 or status == "2":
        return None
    kept = 0
    for key in ("temperature_celsius", "tx_power", "rx_power"):
        parsed = parse_numeric(metric.fields.get(key))
        if parsed == None:
            if key in metric.fields:
                metric.fields.pop(key)
        else:
            metric.fields[key] = parsed
            kept += 1
    if kept == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["comtrol"]

[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def map_led(raw, present):
    if not present or raw == None:
        return None
    v = raw
    if type(raw) != "int":
        v = int(raw)
    if v < 1 or v > 2:
        return None
    if v == 1:
        return 1
    return 2

def apply(metric):
    f = metric.fields
    kept = 0
    for key in ("state", "state_backup"):
        present = key in f
        raw = None
        if present:
            raw = f[key]
        mapped = map_led(raw, present)
        if mapped == None:
            if present:
                f.pop(key)
        else:
            f[key] = mapped
            kept += 1
    if kept == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["comtrol"]
