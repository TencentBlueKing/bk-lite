[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_robustel_switch"
        config_type = "robustel"
        brand = "robustel"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：ROS-SYSUTIL 标量，顶层 field GET 必须带实例 .0；禁止 table.field+.0 ----
    # 发现身份为 sysObjectID 前缀 1.3.6.1.4.1.39699。不采集蜂窝路由对象，也不与其它 Microsemi 白牌 ROS 栈混用。
    # rosSysutilStatusCpuLoadAverage1sec 作 headline；10sec 为同组可选窗口。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.39699.1.24.1.3.1.2.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.39699.1.24.1.3.1.3.0"
        name = "device_cpu_usage_10s"
    # ---- 内存：rosSysutilStatusMemoryTotalKb / UsedKb，标量 field 带 .0，原始单位 KB ----
    # 盘侧 *1024 换成字节；利用率 used/total（单位相消）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.39699.1.24.1.3.8.1.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.39699.1.24.1.3.8.2.0"
        name = "device_memory_used"
    # ---- 温度表：rosSysutilStatusTemperatureMonitorTemperature，table.field 不得带 .0 ----
    # 索引 board(0)/junction(1)；同表 SensorId 作 descr 标签，index_as_tag 保留行号。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.39699.1.24.1.3.6.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.39699.1.24.1.3.6.1.5"
        name = "celsius"
# ---- 风扇转速未进本轮最小集。本对象不采集蜂窝路由 HOST-RESOURCES 树。----
