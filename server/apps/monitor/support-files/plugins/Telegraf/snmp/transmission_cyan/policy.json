{
  "object": "Transmission",
  "plugin": "Transmission Cyan SNMP",
  "templates": [
    {
      "name": "Cyan传输设备进风口温度过高",
      "alert_name": "传输设备${resource_name} 模块 ${metric__index} 进风口温度过高",
      "description": "监控 Cyan BOSS 模块进风口温度，当持续高于阈值时触发告警，提示可能存在环境过热、进风受阻或机框散热异常。",
      "metric_name": "intake_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 85,
          "method": ">"
        },
        {
          "level": "error",
          "value": 75,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 65,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Cyan传输设备出风口温度过高",
      "alert_name": "传输设备${resource_name} 模块 ${metric__index} 出风口温度过高",
      "description": "监控 Cyan BOSS 模块出风口温度，当持续高于阈值时触发告警，提示可能存在散热不良、风道堵塞或模块过载。",
      "metric_name": "exhaust_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 85,
          "method": ">"
        },
        {
          "level": "error",
          "value": 75,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 65,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Cyan传输设备电源温度过高",
      "alert_name": "传输设备${resource_name} 模块 ${metric__index} 电源温度过高",
      "description": "监控 Cyan BOSS 模块电源温度，当持续高于阈值时触发告警，提示可能存在电源过载或散热异常。",
      "metric_name": "psu_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 85,
          "method": ">"
        },
        {
          "level": "error",
          "value": 75,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 65,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Cyan传输设备馈电异常",
      "alert_name": "传输设备${resource_name} 模块 ${metric__index} 馈电 ${metric__feed} 异常",
      "description": "监控 Cyan BOSS 模块双路馈电开关状态，非正常状态表示对应馈电关闭或输入丢失。",
      "metric_name": "device_psu_state",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 2,
          "method": "="
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
