[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "{{ auth_password }}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "{{ priv_password }}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_futurematrix"
        config_type = "futurematrix"
        brand = "futurematrix"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.2.2"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # Info-Finder FM S1730S：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- FutureMatrix CPU utilization (FutureMatrix ENTITY-EXTENT (enterprise 56813) FMEntityCpuUsage, per entity) ----
    # Info-Finder FM S1730S：FMEntityCpuUsage 1.3.6.1.4.1.56813.5.25.31.1.1.1.1.5（已归一化为 0-100 百分比）
    # descr 取 ENTITY-MIB entPhysicalName（与 CPU 同行 entPhysicalIndex）；metrics 声明 dimensions=descr。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56813.5.25.31.1.1.1.1.5"
        name = "usage"
    # ---- FutureMatrix Memory utilization (FutureMatrix ENTITY-EXTENT (enterprise 56813) FMEntityMemUsage, per entity) ----
    # Info-Finder FM S1730S：华为以利用率(%)直接上报内存，无 used/free 字节 → 统一字段名 device_memory_usage(原始百分比)
    # FMEntityMemUsage 1.3.6.1.4.1.56813.5.25.31.1.1.1.1.7；多实体 → descr 维度。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56813.5.25.31.1.1.1.1.7"
        name = "usage"
    # ---- FutureMatrix Temperature sensors (FutureMatrix ENTITY-EXTENT (enterprise 56813) FMEntityTemperature, per entity) ----
    # Info-Finder FM S1730S：温度 FMEntityTemperature 1.3.6.1.4.1.56813.5.25.31.1.1.1.1.11；
    # descr 取 ENTITY-MIB entPhysicalName 1.3.6.1.2.1.47.1.1.1.1.7（与温度同 entPhysicalIndex，按 index 关联）
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56813.5.25.31.1.1.1.1.11"
        name = "celsius"
    # ---- FutureMatrix Fans (FutureMatrix ENTITY-EXTENT (enterprise 56813) FMEntityFanState) ----
    # Info-Finder FM S1730S：风扇状态 FMEntityFanState 1.3.6.1.4.1.56813.5.25.31.1.1.10.1.7；
    # 华为原生编码 1=normal,2=abnormal（已与统一约定 1=normal 对齐，无需重映射，偏离 1 即异常）；
    # descr 取风扇槽位 1.3.6.1.4.1.56813.5.25.31.1.1.10.1.1
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56813.5.25.31.1.1.10.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56813.5.25.31.1.1.10.1.7"
        name = "state"
    # 注：与华为交换机模板对齐，本模板不做电源(PSU)状态（虽 MIB 有 FMEntityPwrState）。
    # ---- FutureMatrix SFP optical DDM (FMOpticalModuleInfoTable / FMEntityOptical*) ----
    # RX=FMEntityOpticalRxPower ...3.1.8 / TX=FMEntityOpticalTxPower ...3.1.9。
    # 实际单位 µW（MIB 曾误标 dBm）；无模块/无效常为 <=0；descr=entPhysicalName。
    # 不做 starlark 换算（避免 processor 与 IF-MIB 注入顺序冲突 / starlark 版本差异）；
    # metrics 查询侧 10*log10(µW/1000) → dBm。
    [[inputs.snmp.table]]
        name = "device_optical"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56813.5.25.31.1.1.3.1.8"
        name = "rx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56813.5.25.31.1.1.3.1.9"
        name = "tx_power"
