[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_barracuda"
        config_type = "barracuda"
        brand = "barracuda"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"

    # Barracuda bspyware system leaves under 1.3.6.1.4.1.20632.3.1.10.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20632.3.1.10.3.0"
        name = "barracuda_cpu_temperature_celsius"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20632.3.1.10.4.0"
        name = "barracuda_system_temperature_celsius"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20632.3.1.10.5.0"
        name = "barracuda_firmware_storage_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20632.3.1.10.6.0"
        name = "barracuda_log_storage_usage"
    # 风扇转速（RPM，Integer32）：.10.1.0 为 CPU 风扇，.10.2.0 为系统风扇；由下方 starlark 拆成 device_fan（fan 标签）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20632.3.1.10.1.0"
        name = "fan_cpu_rpm_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20632.3.1.10.2.0"
        name = "fan_system_rpm_raw"

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    metric.fields["device_temperature_celsius"] = max(
        metric.fields.get("barracuda_cpu_temperature_celsius", 0),
        metric.fields.get("barracuda_system_temperature_celsius", 0),
    )
    metric.fields["device_disk_usage"] = max(
        metric.fields.get("barracuda_firmware_storage_usage", 0),
        metric.fields.get("barracuda_log_storage_usage", 0),
    )
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["barracuda"]

# ---- 风扇转速：从 snmp 中取出两路原始值，各输出一条 device_fan（fan 标签 = cpu / system，字段 speed，单位 RPM）；
# ---- 须为 0~50000 的整数，否则不输出；原始字段不落库。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
FANS = [("fan_cpu_rpm_raw", "cpu"), ("fan_system_rpm_raw", "system")]

def apply(metric):
    out = [metric]
    for field, fan in FANS:
        value = metric.fields.pop(field, None)
        if type(value) != "int" or value < 0 or value > 50000:
            continue
        row = Metric("device_fan")
        for key, tag in metric.tags.items():
            row.tags[key] = tag
        row.tags["fan"] = fan
        row.fields["speed"] = value
        row.time = metric.time
        out.append(row)
    return out
'''
    [processors.starlark.tagpass]
        brand = ["barracuda"]
