[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_yamaha_router"
        config_type = "yamaha"
        brand = "yamaha"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # 识别门：sysObjectID 前缀 1.3.6.1.4.1.1182.1，且产品叶为 rtx*/nvr*/fwx*/vRX/rt*。
    # 不绑定 swx*/swr*/swp*（交换机，yamahaSW 1182.3）。
    # 标量：顶层 field GET 必须带实例 .0；table.field 禁止 .0。
    # yrhCpuUtil5sec 优先；1 分钟 / 5 分钟为可选窗口。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1182.2.1.5.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1182.2.1.6.0"
        name = "device_cpu_usage_1min"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1182.2.1.7.0"
        name = "device_cpu_usage_5min"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1182.2.1.4.0"
        name = "device_memory_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1182.2.1.19.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1182.2.1.15.0"
        name = "device_temperature_celsius"
# ---- 风扇/电源：Yamaha RTX/NVR/FWX 为紧凑型固定配置，未以无需行级过滤的标量形式暴露独立风扇/电源传感器 → 风扇/电源 N/A。CPU/内存干净可采；温度与内存总量按型号可选。----
