[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_quanta"
        config_type = "quanta"
        brand = "quanta"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Broadcom FastPath agentSwitchCpuProcessGroup（PEN 4413）1.3.6.1.4.1.4413.1.1.1.1.4 ----
    # agentSwitchCpuProcessTotalUtilization：DisplayString，形如 "5 Secs ( 12.3%) 60 Secs ( 8.1%) 300 Secs ( 6.0%)"；下方 starlark 取最后一个百分数（300 秒窗口）写入 usage；没有百分号时只接受纯数字，其它内容丢弃。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4413.1.1.1.1.4.9"
        name = "cpu_total_util"
    # agentSwitchCpuProcessMemAvailable（总量）/ agentSwitchCpuProcessMemFree（空闲）：Integer32 KBytes；下方 starlark 换算为字节并计算已用与使用率。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4413.1.1.1.1.4.2"
        name = "mem_total_kb"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4413.1.1.1.1.4.1"
        name = "mem_free_kb"
        conversion = "int"

[[processors.starlark]]
    namepass = ["device_cpu"]
    source = '''
def to_number(value):
    if value == "" or value.count(".") > 1 or value.startswith(".") or value.endswith("."):
        return None
    for c in value.elems():
        if not (c.isdigit() or c == "."):
            return None
    return float(value)

def last_percent(raw):
    text = str(raw).strip()
    pos = text.rfind("%")
    if pos < 0:
        return to_number(text)
    end = pos
    for i in range(pos):
        if text[end - 1] == " ":
            end = end - 1
        else:
            break
    start = end
    for i in range(end):
        c = text[end - 1 - i]
        if c.isdigit() or c == ".":
            start = end - 1 - i
        else:
            break
    return to_number(text[start:end])

def apply(metric):
    raw = metric.fields.pop("cpu_total_util", None)
    if raw != None:
        cpu = last_percent(raw)
        if cpu != None and cpu >= 0 and cpu <= 100:
            metric.fields["usage"] = cpu
    if "usage" not in metric.fields:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["quanta"]

[[processors.starlark]]
    namepass = ["device_memory"]
    source = '''
def apply(metric):
    total = metric.fields.pop("mem_total_kb", None)
    free = metric.fields.pop("mem_free_kb", None)
    if total != None and free != None and int(total) > 0 and int(free) >= 0 and int(free) <= int(total):
        metric.fields["total"] = int(total) * 1024
        metric.fields["free"] = int(free) * 1024
        metric.fields["used"] = (int(total) - int(free)) * 1024
        metric.fields["usage"] = (int(total) - int(free)) * 100.0 / int(total)
        return metric
    return None
'''
    [processors.starlark.tagpass]
        brand = ["quanta"]
