[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_quanta"
        config_type = "quanta"
        brand = "quanta"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Broadcom FastPath agentSwitchCpuProcessGroup（PEN 4413）1.3.6.1.4.1.4413.1.1.1.1.4：标量，顶层 field 带 .0 → measurement snmp，查询用 snmp_ 前缀 ----
    # agentSwitchCpuProcessTotalUtilization .9.0：DisplayString，形如 "5 Secs ( 12.3%) 60 Secs ( 8.1%) 300 Secs ( 6.0%)"，下方 starlark 取第一个百分数 → device_cpu_usage。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.4413.1.1.1.1.4.9.0"
        name = "cpu_total_util"
    # agentSwitchCpuProcessMemAvailable .2.0（总量）/ agentSwitchCpuProcessMemFree .1.0（空闲）：Integer32 KBytes；下方 starlark 换算为字节并计算已用与使用率。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.4413.1.1.1.1.4.2.0"
        name = "mem_total_kb"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.4413.1.1.1.1.4.1.0"
        name = "mem_free_kb"
        conversion = "int"

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def first_percent(raw):
    text = str(raw)
    pos = text.find("%")
    if pos <= 0:
        return None
    start = pos
    for i in range(pos):
        c = text[pos - 1 - i]
        if c.isdigit() or c == ".":
            start = pos - 1 - i
        else:
            break
    value = text[start:pos].strip(".")
    if value == "" or value.count(".") > 1:
        return None
    return float(value)

def apply(metric):
    raw = metric.fields.pop("cpu_total_util", None)
    if raw != None:
        cpu = first_percent(raw)
        if cpu != None and cpu >= 0 and cpu <= 100:
            metric.fields["device_cpu_usage"] = cpu
    total = metric.fields.pop("mem_total_kb", None)
    free = metric.fields.pop("mem_free_kb", None)
    if total != None and free != None and int(total) > 0 and int(free) >= 0 and int(free) <= int(total):
        metric.fields["device_memory_total"] = int(total) * 1024
        metric.fields["device_memory_free"] = int(free) * 1024
        metric.fields["device_memory_used"] = (int(total) - int(free)) * 1024
        metric.fields["device_memory_usage"] = (int(total) - int(free)) * 100.0 / int(total)
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["quanta"]
