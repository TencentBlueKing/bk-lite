[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_wisi"
        config_type = "wisi"
        brand = "wisi"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- 机箱温度表 gtTempsTable（PEN 7465，INDEX {gtModule,gtTemp} 两段索引保留）----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.2.1.2"
        name = "gtTempName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.2.1.3"
        name = "celsius"
    # ---- 风扇转速表 gtFansTable（INDEX {gtFan}；不采集转速设定 gtFanControl）----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.4.1.2"
        name = "gtFanName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.4.1.4"
        name = "speed"
    # ---- 电源表 gtPSUsTable（INDEX {gtPSU}；电流 mA、电压 mV、功率 mW 在 starlark 中 ÷1000）----
    [[inputs.snmp.table]]
        name = "psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.6.1.2"
        name = "gtPSUName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.6.1.3"
        name = "power_mW"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.6.1.4"
        name = "current_mA"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.6.1.5"
        name = "voltage_int_mV"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.6.1.7"
        name = "voltage_ext_mV"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7465.20.2.9.1.3.1.6.1.8"
        name = "temperature_celsius"
    # ---- CPU/内存：GTSENSORS 无机箱主机利用率对象，不采集。----

[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    raw = metric.fields.get("celsius")
    if raw == None:
        return None
    value = float(raw)
    if value < -60.0 or value > 195.0:
        return None
    metric.fields["celsius"] = value
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["wisi"]

[[processors.starlark]]
    namepass = ["device_fan"]
    source = '''
def is_sentinel(v):
    n = int(v)
    if n == 65535 or n == 65534 or n == -1:
        return True
    if n == 2147483647 or n == -2147483648:
        return True
    if n == 4294967295:
        return True
    return False

def apply(metric):
    raw = metric.fields.get("speed")
    if raw == None:
        return None
    if is_sentinel(raw):
        return None
    value = float(raw)
    if value < 0.0 or value > 15000.0:
        return None
    metric.fields["speed"] = value
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["wisi"]

[[processors.starlark]]
    namepass = ["psu"]
    source = '''
def is_sentinel(v):
    n = int(v)
    if n == 65535 or n == 65534 or n == -1:
        return True
    if n == 2147483647 or n == -2147483648:
        return True
    if n == 4294967295:
        return True
    return False

def copy_tags(src, dest):
    for key, value in src.tags.items():
        dest.tags[key] = value
    dest.time = src.time

def emit_voltage(metric, raw, voltage_type):
    if raw == None:
        return None
    if is_sentinel(raw):
        return None
    milli = float(raw)
    if milli <= 0.0 or milli > 16000.0:
        return None
    out = Metric("device_voltage")
    copy_tags(metric, out)
    out.tags["voltage_type"] = voltage_type
    out.fields["volts"] = milli / 1000.0
    return out

def apply(metric):
    results = []
    current_raw = metric.fields.pop("current_mA", None)
    power_raw = metric.fields.pop("power_mW", None)
    vint = metric.fields.pop("voltage_int_mV", None)
    vext = metric.fields.pop("voltage_ext_mV", None)
    temp = metric.fields.pop("temperature_celsius", None)

    # 双路电压均为 0 视为空槽，仅抑制两路电压；电流、额定功率、温度仍上报。
    both_zero = False
    if vint != None and vext != None:
        if not is_sentinel(vint) and not is_sentinel(vext):
            if float(vint) == 0.0 and float(vext) == 0.0:
                both_zero = True

    if not both_zero:
        emitted = emit_voltage(metric, vint, "internal")
        if emitted != None:
            results.append(emitted)
        emitted = emit_voltage(metric, vext, "external")
        if emitted != None:
            results.append(emitted)
    if current_raw != None and not is_sentinel(current_raw):
        milliamp = float(current_raw)
        if milliamp >= 0.0 and milliamp <= 25000.0:
            metric.fields["current_amps"] = milliamp / 1000.0
    if power_raw != None and not is_sentinel(power_raw):
        milliwatt = float(power_raw)
        if milliwatt > 0.0:
            metric.fields["rated_power_watts"] = milliwatt / 1000.0
    if temp != None:
        celsius = float(temp)
        if celsius >= -60.0 and celsius <= 195.0:
            metric.fields["temperature_celsius"] = celsius

    f = metric.fields
    if len(f.keys()) > 0:
        results.append(metric)
    if len(results) == 0:
        return None
    return results
'''
    [processors.starlark.tagpass]
        brand = ["wisi"]
