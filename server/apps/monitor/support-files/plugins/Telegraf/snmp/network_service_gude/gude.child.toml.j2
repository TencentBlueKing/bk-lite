[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_gude"
        config_type = "gude"
        brand = "gude"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.2.0"
        name = "sysObjectID"
        is_tag = true
# @bk_include_ifmib_table
    # Primary live metering subtree is GUDEADS-PDU8310-MIB (PEN 28507.27),
    # selected by sysObjectID gadsPDU8310 and a responding pdu8310PowerTable.
    # Do not invent CPU% or memory. Do not mix-bind other GUDEADS product
    # branches such as 28507.64 even when the table shape looks similar.
    # pdu8310PowerActive, Watts.
    [[inputs.snmp.table]]
        name = "pdu_active_power"
        inherit_tags = ["source", "sysObjectID"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28507.27.1.5.1.2.1.1"
        name = "channel"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28507.27.1.5.1.2.1.4"
        name = "watts"
    # pdu8310Current (mA, /1000 in query -> A) plus optional pdu8310Voltage (V)
    # from the same pdu8310PowerTable parent.
    [[inputs.snmp.table]]
        name = "pdu_channel"
        inherit_tags = ["source", "sysObjectID"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28507.27.1.5.1.2.1.1"
        name = "channel"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28507.27.1.5.1.2.1.5"
        name = "current_amps"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28507.27.1.5.1.2.1.6"
        name = "voltage_volts"
    # Fallback for old EPC8 without metering: epc8PortState only (0=off/1=on).
    [[inputs.snmp.table]]
        name = "pdu_outlet"
        inherit_tags = ["source", "sysObjectID"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28507.1.1.2.2.1.1"
        name = "outlet"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28507.1.1.2.2.1.2"
        name = "outlet_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28507.1.1.2.2.1.3"
        name = "power_state"
