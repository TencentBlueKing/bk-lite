[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_aten"
        config_type = "aten"
        brand = "aten"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.2.0"
        name = "sysObjectID"
        is_tag = true
# @bk_include_ifmib_table
    # ---- ATEN PE / eco PDU（ATEN-PE-CFG，PEN 21317，pe 1.3.6.1.4.1.21317.1.3.2.2）----
    # Integer 表：device 100 环境温湿度、device 99 整机电流/电压/功率。table.field 不带 .0。
    # DisplayString 传感器表与 outletInteger 支路表、私有 CPU%/Mem% 不在本模板内。
    [[inputs.snmp.table]]
        name = "env_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    # sensorIntegerTemperature（1.3.6.1.4.1.21317.1.3.2.2.2.1.100.1.2）：INTEGER，÷1000 → ℃。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21317.1.3.2.2.2.1.100.1.2"
        name = "celsius_raw"
    [[inputs.snmp.table]]
        name = "env_humidity"
        inherit_tags = ["source"]
        index_as_tag = true
    # sensorIntegerHumidity（…100.1.3）：INTEGER，÷1000 → %RH。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21317.1.3.2.2.2.1.100.1.3"
        name = "percent_raw"
    [[inputs.snmp.table]]
        name = "pdu_device"
        inherit_tags = ["source"]
        index_as_tag = true
    # deviceIntegerCurrent（…99.1.2）：INTEGER，÷1000 → A。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21317.1.3.2.2.2.1.99.1.2"
        name = "current_raw"
    # deviceIntegerVoltage（…99.1.3）：INTEGER，÷1000 → V。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21317.1.3.2.2.2.1.99.1.3"
        name = "voltage_raw"
    # deviceIntegerPower（…99.1.4）：INTEGER，÷1000 → W。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21317.1.3.2.2.2.1.99.1.4"
        name = "power_raw"
# ---- 换算：温/湿/电流/电压/功率原始值 ÷1000；-1000000 无读数、-2000000 不支持，丢弃该字段；行内无有效字段则整行丢弃。原始字段不落库。----
[[processors.starlark]]
    namepass = ["env_temperature", "env_humidity", "pdu_device"]
    source = '''
def scale_milli(raw):
    if type(raw) != "int":
        return None
    if raw == -1000000 or raw == -2000000:
        return None
    return raw / 1000.0

def apply(metric):
    f = metric.fields
    if metric.name == "env_temperature":
        value = scale_milli(f.pop("celsius_raw", None))
        if value == None:
            return None
        f["celsius"] = value
        return metric
    if metric.name == "env_humidity":
        value = scale_milli(f.pop("percent_raw", None))
        if value == None:
            return None
        f["percent"] = value
        return metric
    current = scale_milli(f.pop("current_raw", None))
    volts = scale_milli(f.pop("voltage_raw", None))
    watts = scale_milli(f.pop("power_raw", None))
    if current != None:
        f["current_amps"] = current
    if volts != None:
        f["voltage_volts"] = volts
    if watts != None:
        f["power_watts"] = watts
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["aten"]
