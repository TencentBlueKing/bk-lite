[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_mguard"
        config_type = "mguard"
        brand = "mguard"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- HMPRIV-MGMT-SNMP-MIB hmCpuResources 1.3.6.1.4.1.248.14.2.15.2：标量，顶层 field 带 .0 → measurement snmp ----
    # hmCpuUtilization .2.1.0：Integer32 0~100 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.2.1.0"
        name = "device_cpu_usage"
    # ---- hmMemoryResources 1.3.6.1.4.1.248.14.2.15.3：标量，顶层 field 带 .0 ----
    # hmMemoryAllocated .3.1.0 / hmMemoryFree .3.2.0：kBytes；starlark ×1024 输出 device_memory_used / free / total 字节与 device_memory_usage。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.3.1.0"
        name = "mem_alloc_kb_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.15.3.2.0"
        name = "mem_free_kb_raw"
    # ---- hmTemperature 1.3.6.1.4.1.248.14.2.5.1.0：标量，顶层 field 带 .0，Integer32 ℃（-99~99）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.248.14.2.5.1.0"
        name = "device_temperature_celsius"
    # ---- hmPSTable 1.3.6.1.4.1.248.14.1.2.1：hmPSState .3（table.field 不带 .0），ok(1)/failed(2)/notInstalled(3)/unknown(4) ----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.14.1.2.1.3"
        name = "state"
# ---- 风扇：HMPRIV-MGMT-SNMP-MIB 没有可轮询的风扇状态/转速对象，不采集。----

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    cpu = metric.fields.get("device_cpu_usage")
    if cpu != None and (type(cpu) not in ["int", "float"] or cpu < 0 or cpu > 100):
        metric.fields.pop("device_cpu_usage")
    used = metric.fields.pop("mem_alloc_kb_raw", None)
    free = metric.fields.pop("mem_free_kb_raw", None)
    if type(used) == "int" and type(free) == "int" and used >= 0 and free >= 0 and used + free > 0:
        metric.fields["device_memory_used"] = used * 1024
        metric.fields["device_memory_free"] = free * 1024
        metric.fields["device_memory_total"] = (used + free) * 1024
        metric.fields["device_memory_usage"] = used * 100.0 / (used + free)
    temp = metric.fields.get("device_temperature_celsius")
    if temp != None and (type(temp) not in ["int", "float"] or temp < -99 or temp > 99):
        metric.fields.pop("device_temperature_celsius")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["mguard"]

# ---- 电源状态归一：ok(1)→1(正常)，failed(2)/unknown(4)→2(异常)，notInstalled(3) 与其它值丢弃。----
[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    state = metric.fields.get("state")
    if state == 1:
        metric.fields["state"] = 1
    elif state == 2 or state == 4:
        metric.fields["state"] = 2
    else:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["mguard"]
