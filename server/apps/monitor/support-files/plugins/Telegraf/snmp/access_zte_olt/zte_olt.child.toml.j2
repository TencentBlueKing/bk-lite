[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_zte_olt"
        config_type = "zte_olt"
        brand = "zte_olt"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- ZTE ZXA10 板卡 CPU / 内存：ZTE-AN-CHASSIS-MIB zxAnCardTable（PEN 3902.1082，table.field 不带 .0，索引为 机架.机框.槽位）----
    # zxAnCardActualType .4 → descr；zxAnCardCpuLoad .9（0~100 %）；zxAnCardMemUsage .11（0~100 %）；zxAnCardMemSize .19（MB）。
    # MIB 约定板卡不支持该属性时返回 0，下方 starlark 丢弃 0 值行。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.1.2.4.1.4"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.1.2.4.1.9"
        name = "usage"
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.1.2.4.1.4"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.1.2.4.1.11"
        name = "usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.1.2.4.1.19"
        name = "size_mb_raw"
    # ---- 板卡温度：ZTE-AN-ENVMON-MIB zxAnCardEnvParamTable zxAnCardTemp 1.3.6.1.4.1.3902.1082.10.10.2.1.6.1.2（℃，索引为 机架.机框.槽位）----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.10.2.1.6.1.2"
        name = "celsius"
    # ---- 风扇：zxAnEnvFanTable（索引为 机架.机框.风扇）OperStatus .5 up(1)/down(2)/unknown(3)，OnlineStatus .6 online(1)/offline(2)，ActualSpeed .7（转/分）----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.10.2.4.11.1.5"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.10.2.4.11.1.6"
        name = "online_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.10.2.4.11.1.7"
        name = "rpm"
    # ---- 电源：zxAnPowerSupplyTable zxAnPowerSupplyInVoltageStatus 1.3.6.1.4.1.3902.1082.10.10.2.3.11.1.3：normal(1)/overVoltage(2)/underVoltage(3)/off(4) ----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.1082.10.10.2.3.11.1.3"
        name = "state"
# ---- ONU / 光模块等大表未纳入。----

# ---- CPU：0 表示板卡无此属性，丢弃；超出 0~100 丢弃。----
[[processors.starlark]]
    namepass = ["device_cpu"]
    source = '''
def apply(metric):
    usage = metric.fields.get("usage")
    if type(usage) not in ["int", "float"] or usage <= 0 or usage > 100:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["zte_olt"]

# ---- 内存：usage 为 0（无此属性）或超出 0~100 时丢弃整行；容量 MB → 字节输出 total。----
[[processors.starlark]]
    namepass = ["device_memory"]
    source = '''
def apply(metric):
    usage = metric.fields.get("usage")
    size = metric.fields.pop("size_mb_raw", None)
    if type(usage) not in ["int", "float"] or usage <= 0 or usage > 100:
        return None
    if type(size) in ["int", "float"] and size > 0:
        metric.fields["total"] = int(size) * 1048576
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["zte_olt"]

# ---- 温度：0（无效）或超出 -40~150 ℃ 时丢弃。----
[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    value = metric.fields.get("celsius")
    if type(value) not in ["int", "float"] or value == 0 or value < -40 or value > 150:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["zte_olt"]

# ---- 风扇：offline(2) 不在位的风扇丢弃；up(1)→1(正常)，down(2)→2(异常)，unknown 等丢弃；转速为负时去掉转速。----
[[processors.starlark]]
    namepass = ["device_fan"]
    source = '''
def apply(metric):
    online = metric.fields.pop("online_raw", None)
    state = metric.fields.get("state")
    if online == 2:
        return None
    if state != 1 and state != 2:
        return None
    rpm = metric.fields.get("rpm")
    if rpm != None and (type(rpm) not in ["int", "float"] or rpm < 0):
        metric.fields.pop("rpm")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["zte_olt"]

# ---- 电源：normal(1)→1(正常)，overVoltage(2)/underVoltage(3)→2(异常)，off(4) 与其它值丢弃。----
[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    state = metric.fields.get("state")
    if state == 1:
        return metric
    if state == 2 or state == 3:
        metric.fields["state"] = 2
        return metric
    return None
'''
    [processors.starlark.tagpass]
        brand = ["zte_olt"]
