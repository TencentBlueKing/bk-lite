[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_perle"
        config_type = "perle"
        brand = "perle"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- adminTemperature (PEN 1966) chassis internal temperature ----
    # 1.3.6.1.4.1.1966.12.1.1.28.0 → temperature_celsius
    # DisplayString（例如 "42 C"）；starlark 解析前导数字为摄氏度。空值或无法解析则跳过。
    [[inputs.snmp.table]]
        name = "temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1966.12.1.1.28.0"
        name = "celsius"
# ---- CPU/内存/风扇/电源：已确认机箱内部温度标量。无稳定、无需行级过滤的 CPU%/内存% 共享健康对象 → N/A，不臆造。adminPowerStatus 需 line:plug 输入，不是机箱电源健康。----

[[processors.starlark]]
    namepass = ["temperature"]
    source = '''
def parse_celsius(raw):
    if raw == None:
        return None
    t = type(raw)
    if t == "int":
        return float(raw)
    if t == "float":
        return raw
    text = str(raw)
    digits = ""
    started = False
    sign = ""
    i = 0
    while i < len(text):
        c = text[i]
        if (not started) and (c == " " or c == "\t"):
            i += 1
            continue
        if (not started) and (c == "-" or c == "+") and sign == "":
            sign = c
            i += 1
            continue
        if c >= "0" and c <= "9":
            digits += c
            started = True
        elif c == "." and started:
            if "." not in digits:
                digits += c
        elif started:
            break
        elif sign != "":
            return None
        i += 1
    if digits == "" or digits == ".":
        return None
    return float(sign + digits)

def apply(metric):
    parsed = parse_celsius(metric.fields.get("celsius"))
    if parsed == None:
        return None
    metric.fields["celsius"] = parsed
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["perle"]
