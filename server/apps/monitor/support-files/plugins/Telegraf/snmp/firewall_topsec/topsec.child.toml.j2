[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_topsec"
        config_type = "topsec"
        brand = "topsec"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # 识别门：sysObjectID 前缀 1.3.6.1.4.1.14331（topsec / TOS）。
    # 标量：顶层 field GET 必须带实例 .0；禁止 table.field+.0。
    # ---- Identity：TOS-SYSINFO sysInfo 标量 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14331.5.5.1.3.1.0"
        name = "product_sn"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14331.5.5.1.3.2.0"
        name = "product_type"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14331.5.5.1.3.3.0"
        name = "software_version"
        is_tag = true
    # ---- CPU：TOS-SYSSTATE cpuLoad，SYNTAX Integer32，DESCRIPTION percent*100 ----
    # 盘侧 /100 得到 0-100%。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14331.5.5.1.4.5.0"
        name = "device_cpu_usage"
    # ---- 内存利用率：TOS-SYSSTATE memoryLoad，同样 percent*100，盘侧 /100 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14331.5.5.1.4.6.0"
        name = "device_memory_usage"
    # ---- 内存字节：memoryFree / memoryTotal，单位 byte；used = total − free ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14331.5.5.1.4.7.0"
        name = "device_memory_free"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14331.5.5.1.4.8.0"
        name = "device_memory_total"
    # ---- 会话：currentConnections → firewall_active_sessions；cps → firewall_session_rate ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14331.5.5.1.4.9.0"
        name = "firewall_active_sessions"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14331.5.5.1.4.10.0"
        name = "firewall_session_rate"
# ---- 不采集 TOS-IF 私有口表；接口走内置 IF-MIB。不搬 TOS-IDS/IV/UC 表。----
