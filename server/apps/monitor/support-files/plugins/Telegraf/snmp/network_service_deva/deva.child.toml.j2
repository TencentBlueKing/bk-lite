[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_deva"
        config_type = "deva"
        brand = "deva"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # Inventory tags only (not health metrics). Empty strings yield empty tags.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.1.1.0"
        name = "fwrev"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.1.2.0"
        name = "sernum"
        is_tag = true
    # Chassis temperature Fr8p8 Integer32; metric query uses /256 to Celsius.
    # Do not treat the raw value as °C. Do not invent CPU% or memory.
    # Do not bind HOST-RESOURCES.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.3.39.0"
        name = "device_temperature_celsius"
    # Fan RPM Integer32, no scaling.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.3.42.0"
        name = "device_fan_rpm"
    # RF level Fr8p8; metric query uses /256 to dBµV.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.3.2.0"
        name = "deva_rf_level"
    # Optional broadcast monitors (Fr8p8 /256 unless noted). Missing scalars yield no point.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.3.15.0"
        name = "deva_pilot_level"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.3.9.0"
        name = "deva_mpx_level"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.3.21.0"
        name = "deva_left_audio_level"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.3.24.0"
        name = "deva_right_audio_level"
    # RDS BER Fr1p15; metric query uses /32768.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35833.37.3.35.0"
        name = "deva_rds_ber"
