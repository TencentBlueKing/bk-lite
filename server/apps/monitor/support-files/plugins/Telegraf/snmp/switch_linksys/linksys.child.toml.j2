[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_linksys"
        config_type = "linksys"
        brand = "linksys"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3955.1000.201.1.9.0"
        name = "device_cpu_usage"
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3955.1000.201.83.1.1.1.2"
        name = "fan_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3955.1000.201.83.1.1.1.3"
        name = "state"
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3955.1000.201.83.1.2.1.2"
        name = "psu_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3955.1000.201.83.1.2.1.3"
        name = "state"
    [[inputs.snmp.table]]
        name = "device"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3955.1000.201.83.5.1.1.2"
        name = "temperature_celsius"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3955.1000.201.83.5.1.1.3"
        name = "fan_speed"

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    f = metric.fields
    cpu = f.get("device_cpu_usage")
    if cpu != None:
        if cpu < 0 or cpu > 100:
            f.pop("device_cpu_usage")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["linksys"]

[[processors.starlark]]
    namepass = ["device_fan"]
    source = '''
def apply(metric):
    f = metric.fields
    raw = f.get("state")
    if raw == None:
        return None
    if raw == 1:
        f["state"] = 1
        return metric
    if raw == 2 or raw == 3 or raw == 4 or raw == 6:
        f["state"] = 2
        return metric
    return None
'''
    [processors.starlark.tagpass]
        brand = ["linksys"]

[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    f = metric.fields
    raw = f.get("state")
    if raw == None:
        return None
    if raw == 1:
        f["state"] = 1
        return metric
    if raw == 2 or raw == 3 or raw == 4 or raw == 6:
        f["state"] = 2
        return metric
    return None
'''
    [processors.starlark.tagpass]
        brand = ["linksys"]

[[processors.starlark]]
    namepass = ["device"]
    source = '''
def apply(metric):
    f = metric.fields
    temp = f.get("temperature_celsius")
    if temp != None:
        if temp < -40 or temp > 125:
            f.pop("temperature_celsius")
    speed = f.get("fan_speed")
    if speed != None:
        if speed < 0 or speed > 30000:
            f.pop("fan_speed")
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["linksys"]
