[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_raisecom"
        config_type = "raisecom"
        brand = "raisecom"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"

    # Raisecom ROAP/ROS health from RAISECOM-SYSTEM/FAN/POWER monitor MIBs.
    # CPU：raisecomTotalCPUUtilization oneMin，整实例 GET，禁止再拼 .0。
    # 列 OID …8886.1.1.1.3.1.2.1.2，INDEX raisecomTotalCPUPeriod，oneMin(3)。
    # SYNTAX INTEGER (0..10000) UNITS percent；若值 >100 则按百分之一缩放（/100）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8886.1.1.1.3.1.2.1.2.3"
        name = "device_cpu_usage"
    # 内存：raisecomMemoryTotal / raisecomMemoryAvailable 标量，顶层 field GET 必须带实例 .0。
    # UNITS Byte；利用率按 (total-free)/total 计算。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8886.1.1.3.2.1.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8886.1.1.3.2.2.0"
        name = "device_memory_free"
    # 机箱温度：raisecomTemperatureValue 标量，顶层 field GET 必须带实例 .0。
    # UNITS Celsius，直接摄氏度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8886.1.1.4.2.1.0"
        name = "device_temperature_celsius"

    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.8886.1.1.5.2.2.1.3"
        name = "state"

    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.8886.1.24.2.1.1.6"
        name = "state"

[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1

[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "2" = 1
            "3" = 1

# CPU oneMin 原始值可能是 0-100 或 0-10000（百分之一）；仅当值 >100 时 /100。
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    cpu = metric.fields.get("device_cpu_usage")
    if cpu != None and cpu > 100:
        metric.fields["device_cpu_usage"] = cpu / 100.0
    return metric
'''
    [processors.starlark.tagpass]
        collect_type = ["snmp_raisecom"]
