        collect_type = "snmp_fiberroad"
        config_type = "fiberroad"
        brand = "fiberroad"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # FiberRoad 2U MC chassis shelfTable (enterprise 6688). INDEX shelfName:
    # master(1)/slave1(2)/slave2(3)/slave3(4). table.field OIDs must not end in .0.
    # Temperature keeps sibling status columns as helpers so an all-nc absent
    # slave shelf (temp 0) can be dropped as a whole.
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.7"
        name = "celsius"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.2"
        name = "psuA"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.3"
        name = "psuB"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.4"
        name = "volA"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.5"
        name = "volB"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.6"
        name = "fan"
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.6"
        name = "state"
    [[inputs.snmp.table]]
        name = "fiberroad_psu_a"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.2"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.4"
        name = "voltage_state"
    [[inputs.snmp.table]]
        name = "fiberroad_psu_b"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.3"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6688.1.1.1.2.1.5"
        name = "voltage_state"

[[processors.starlark]]
    namepass = ["device_temperature", "device_fan", "fiberroad_psu_a", "fiberroad_psu_b"]
    source = '''
def is_nc(raw):
    return raw == 3 or raw == 3.0 or raw == "3"

def is_sentinel(raw):
    if raw == None:
        return True
    if raw == 65535 or raw == 65534 or raw == -1:
        return True
    if raw == 2147483647 or raw == -2147483648 or raw == 4294967295:
        return True
    return False

def map_on_off(raw):
    if raw == 1 or raw == 1.0 or raw == "1":
        return 1
    if raw == 2 or raw == 2.0 or raw == "2":
        return 2
    return None

def map_shelf(metric):
    shelves = {"1": "master", "2": "slave1", "3": "slave2", "4": "slave3"}
    idx = metric.tags.get("index")
    shelf = shelves.get(idx)
    if shelf == None:
        return False
    metric.tags["shelf"] = shelf
    if "index" in metric.tags:
        metric.tags.pop("index")
    return True

def pop_helpers(metric, names):
    for k in names:
        if k in metric.fields:
            metric.fields.pop(k)

def apply(metric):
    if not map_shelf(metric):
        return None
    f = metric.fields
    name = metric.name
    if name == "device_temperature":
        if is_nc(f.get("psuA")) and is_nc(f.get("psuB")) and is_nc(f.get("volA")) and is_nc(f.get("volB")) and is_nc(f.get("fan")):
            return None
        pop_helpers(metric, ["psuA", "psuB", "volA", "volB", "fan"])
        temp = f.get("celsius")
        if temp == None or is_sentinel(temp):
            return None
        tv = float(temp)
        if tv < -40 or tv > 125:
            return None
        f["celsius"] = tv
        if len(f.keys()) == 0:
            return None
        return metric
    if name == "device_fan":
        mapped = map_on_off(f.get("state"))
        if mapped == None:
            return None
        f["state"] = mapped
        return metric
    mapped_state = map_on_off(f.get("state"))
    mapped_vol = map_on_off(f.get("voltage_state"))
    if mapped_state == None and mapped_vol == None:
        return None
    if mapped_state == None:
        if "state" in f:
            f.pop("state")
    else:
        f["state"] = mapped_state
    if mapped_vol == None:
        if "voltage_state" in f:
            f.pop("voltage_state")
    else:
        f["voltage_state"] = mapped_vol
    if name == "fiberroad_psu_a":
        metric.tags["psu"] = "A"
    else:
        metric.tags["psu"] = "B"
    metric.name = "device_psu"
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["fiberroad"]
