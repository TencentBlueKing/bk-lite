{
  "object": "Wireless",
  "plugin": "Wireless HPE MSM SNMP",
  "templates": [
    {
      "name": "HPE MSM无线设备CPU使用率过高",
      "alert_name": "无线设备${resource_name} CPU 使用率过高",
      "description": "监控 HPE MSM / Colubris 无线设备的当前 CPU 使用率，当持续高于阈值时触发告警。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "HPE MSM无线设备内存使用率过高",
      "alert_name": "无线设备${resource_name} 内存使用率过高",
      "description": "监控 HPE MSM / Colubris 无线设备的内存使用率，当持续高于阈值时触发告警。",
      "metric_name": "device_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
