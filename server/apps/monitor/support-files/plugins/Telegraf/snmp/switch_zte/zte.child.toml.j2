[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_zte"
        config_type = "zte"
        brand = "zte"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.2.2"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- ZTE ZXR10 CPU (ZXR10-MIB zxr10SystemCpuUtility5m, %, per-unit table, PEN 3902) ----
    # 待现网核验：列 OID 1.3.6.1.4.1.3902.3.3.1.1.12（5 分钟 CPU%，zxr10SystemUnitEntry 第12列）。
    # 可选 1 分钟列 1.3.6.1.4.1.3902.3.3.1.1.11（zxr10SystemCpuUtility1m）不采，避免重复 CPU 序列。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.3.3.1.1.12"
        name = "usage"
    # ---- ZTE ZXR10 memory (ZXR10-MIB MemSize 总量字节 + MemUsed 已用 octets，per-unit table) ----
    # 待现网核验：总量 1.3.6.1.4.1.3902.3.3.1.1.3（zxr10SystemMemSize, bytes）/
    # 已用 1.3.6.1.4.1.3902.3.3.1.1.4（zxr10SystemMemUsed, octets）。MemUsed 是已用字节，不是百分比。
    # 利用率在 metrics 按 used/total 计算。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.3.3.1.1.3"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.3.3.1.1.4"
        name = "used"
    # ---- ZTE ZXR10 slot temperature (ZXR10-MIB zxr10SlotTemperature, °C, per-slot table) ----
    # 待现网核验：列 OID 1.3.6.1.4.1.3902.3.2.3.1.10。device_temperature_celsius 按槽位表直采。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.3.2.3.1.10"
        name = "celsius"
    # ---- ZTE POWERFANS fan state (fanStat, per-fan table) ----
    # 待现网核验：state 列 1.3.6.1.4.1.3902.3.200.1.1.2。原始码 0=online / 1=offline。
    # 下方 processors.enum 归一为 1=正常(0)/2=异常(1 及其余)。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.3.200.1.1.2"
        name = "state"
    # ---- ZTE POWERFANS PSU state (powerStat, per-supply table) ----
    # 待现网核验：state 列 1.3.6.1.4.1.3902.3.200.2.1.2。原始码 0=work / 1=online / 2=offline。
    # 下方 processors.enum 归一为 1=正常(0/1)/2=异常(2 及其余)。风扇 1=offline、电源 1=online，必须分两个 enum。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3902.3.200.2.1.2"
        name = "state"
# ---- 新机型 ZXR10-SYSTEM-HARDWARE 风扇/电源（3902.3.6002）与 POWERFANS 重叠，只采一条路径以免重复告警。----
# ---- zxr10FanStatus ...6002.2.3.1.7（0 abnormal/1 normal）；zxr10PowerModulePowerStatus ...6002.2.6.2.1.5（0 unknown/1 normal/2 abnormal）。----
# ---- 风扇状态归一：0=online→1(正常)，1=offline 及其余→2(异常)。共享盘 device_fan_state 约定 1=正常,>1=异常。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "0" = 1
# ---- 电源状态归一：0=work/1=online→1(正常)，2=offline 及其余→2(异常)。注意电源 1=online 为正常，与风扇 1=offline 相反。----
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "0" = 1
            "1" = 1
