[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_geist"
        config_type = "geist"
        brand = "geist"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # VERTIV-V5 / IMD under Geist PEN 21239.5. Do not mix the older V3 tree.
    # Do not invent CPU% or memory. Do not bind HOST-RESOURCES or UCD.
    # Do not port airflow, RPM or relay trees in this pass.
    # temperatureUnits 0=Fahrenheit 1=Celsius; tempSensorTemp is tenths of a degree.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21239.5.2.1.7.0"
        name = "temperature_units"
    # pduMainTable pduTotalRealPower (W). Empty tables yield no rows.
    [[inputs.snmp.table]]
        name = "pdu_active_power"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.3.1.1.3"
        name = "pduMainName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.3.1.1.9"
        name = "watts"
    # pduPhaseTable pduPhaseCurrent, centiamps RMS; metric query uses /100 to amps.
    [[inputs.snmp.table]]
        name = "pdu_phase_current"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.3.2.1.2"
        name = "pduPhaseName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.3.2.1.8"
        name = "amps"
    # Optional pduLineTable pduLineCurrent, centiamps RMS; metric query uses /100 to amps.
    [[inputs.snmp.table]]
        name = "pdu_line_current"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.3.4.1.2"
        name = "pduLineName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.3.4.1.4"
        name = "amps"
    # pduOutletMeterTable pduOutletMeterCurrent, centiamps RMS; metric query uses /100 to amps.
    [[inputs.snmp.table]]
        name = "pdu_outlet_current"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.3.6.1.2"
        name = "pduOutletMeterName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.3.6.1.8"
        name = "amps"
    # tempSensorTable tempSensorTemp, tenths of a degree. Query uses /10 and temperatureUnits.
    [[inputs.snmp.table]]
        name = "env_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.4.1.3"
        name = "tempSensorLabel"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.4.1.5"
        name = "celsius"
    # humiditySensorTable humiditySensorValue, percent 0-100. Empty tables yield no rows.
    [[inputs.snmp.table]]
        name = "env_humidity"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.12.1.3"
        name = "humiditySensorLabel"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21239.5.2.12.1.5"
        name = "percent"
