[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_omniswitch"
        config_type = "omniswitch"
        brand = "omniswitch"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe) ----
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- AOS6 HEALTH 设备级标量（ALCATEL-IND1-HEALTH-MIB healthDeviceInfo，PEN 6486.800）----
    # 顶层 field GET 必须带实例 .0；禁止 table.field（标量 GET-NEXT 会走到空子树，指标静默为空）。
    # CPU 用 healthDeviceCpuLatest（INTEGER 0..100，最近采样周期），不用 1 分钟均 healthDeviceCpu1MinAvg。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6486.800.1.2.1.16.1.1.1.13.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6486.800.1.2.1.16.1.1.1.9.0"
        name = "device_memory_usage"
# ---- 温度/风扇/电源：healthDeviceTemperatureChasLatest 是 0..100 百分比而非摄氏度，不得映射为 device_temperature_celsius；风扇/电源需实体类型行级过滤，inputs.snmp 不支持 → N/A。仅采集 AOS6 6486.800 设备级 CPU/内存标量与 IF-MIB。----
