{
  "collector": "Telegraf",
  "collect_type": "snmp_arris",
  "plugin": "Access ARRIS Cadant SNMP",
  "plugin_desc": "SNMP monitoring template for ARRIS Cadant access device. It reports uptime, per-card CPU and heap memory, temperature, power supply status, disk usage, interface traffic, and card status (enterprise PEN 4998).",
  "support_collect_detect": true,
  "status_query": "any({instance_type='access', collect_type='snmp_arris'}) by (instance_id)",
  "name": "Access",
  "icon": "mm-access_接入设备",
  "type": "Network Device",
  "description": "",
  "default_metric": "any({instance_type='access'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "snmp_uptime",
    "device_cpu_usage",
    "device_memory_usage",
    "device_temperature_celsius",
    "device_card_temperature_level",
    "device_card_state",
    "device_psu_state",
    "device_disk_usage",
    "device_disk_state"
  ],
  "metrics": [
    {
      "metric_group": "Temperature",
      "name": "device_temperature_celsius",
      "query": "device_temperature_celsius{instance_type='access', __$labels__}",
      "display_name": "Fan Ambient Temperature",
      "data_type": "Number",
      "unit": "celsius",
      "dimensions": [
        {
          "name": "index",
          "description": "SNMP table row index"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Fan ambient temperature from cerFanAmbientTemperature, read directly in degrees Celsius."
    },
    {
      "metric_group": "Temperature",
      "name": "device_card_temperature_level",
      "query": "device_card_temperature_level{instance_type='access', __$labels__}",
      "display_name": "Card Temperature Level",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [
        {
          "name": "index",
          "description": "SNMP table row index"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Relative card temperature from cerCardTemperature. Values 1-10 represent coolest to hottest; 999 means no report."
    },
    {
      "metric_group": "Hardware Status",
      "name": "device_card_state",
      "query": "device_card_state{instance_type='access', __$labels__}",
      "display_name": "Card State",
      "data_type": "Enum",
      "unit": "[{\"name\":\"正常\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"异常\",\"id\":2,\"color\":\"#ff4d4f\"}]",
      "dimensions": [
        {
          "name": "index",
          "description": "SNMP table row index"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Card primary state from cerCardPrState, normalized so that in-service is healthy and every other value is abnormal."
    },
    {
      "metric_group": "Hardware Status",
      "name": "device_psu_state",
      "query": "device_psu_state{instance_type='access', __$labels__}",
      "display_name": "Power Module State",
      "data_type": "Enum",
      "unit": "[{\"name\":\"正常\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"异常\",\"id\":2,\"color\":\"#ff4d4f\"}]",
      "dimensions": [
        {
          "name": "index",
          "description": "SNMP table row index"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Power entry-module LED status from cerPemLedStatus, normalized so that normal(1) is healthy and alarm(2) or unknown values are abnormal."
    },
    {
      "metric_group": "Hardware Status",
      "name": "device_disk_usage",
      "query": "device_disk_usage{instance_type='access', __$labels__}",
      "display_name": "Disk Volume Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [
        {
          "name": "index",
          "description": "SNMP table row index"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Disk volume usage percentage from cerDiskVolumeUsagePercentage, aggregated with the highest volume usage per device."
    },
    {
      "metric_group": "Hardware Status",
      "name": "device_disk_state",
      "query": "device_disk_state{instance_type='access', __$labels__}",
      "display_name": "Disk Volume Usage State",
      "data_type": "Enum",
      "unit": "[{\"name\":\"正常\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"异常\",\"id\":2,\"color\":\"#ff4d4f\"}]",
      "dimensions": [
        {
          "name": "index",
          "description": "SNMP table row index"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Disk volume usage level from cerDiskVolumeUsageLevel, normalized so that normal(1) is healthy and minor/major/critical or unknown values are abnormal."
    },
    {
      "metric_group": "Access",
      "name": "device_cpu_usage",
      "query": "device_cpu_usage{instance_type='access', __$labels__}",
      "display_name": "CPU Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [
        {
          "name": "index",
          "description": "Card ID (SNMP table row index)"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Per-card CPU utilization from CADANT-CMTS-PROCESS-MIB cadIdleCpuRecentPercent, converted at collection as 100 - idle percent over the last reporting cycle."
    },
    {
      "metric_group": "Access",
      "name": "device_memory_total",
      "query": "device_memory_total{instance_type='access', __$labels__}",
      "display_name": "Heap Memory Total",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [
        {
          "name": "index",
          "description": "Card ID (SNMP table row index)"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Per-card total dynamic heap size from cadMeHeapSize, in bytes."
    },
    {
      "metric_group": "Access",
      "name": "device_memory_free",
      "query": "device_memory_free{instance_type='access', __$labels__}",
      "display_name": "Heap Memory Free",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [
        {
          "name": "index",
          "description": "Card ID (SNMP table row index)"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Per-card unallocated dynamic heap from cadMeHeapRemaining, in bytes."
    },
    {
      "metric_group": "Access",
      "name": "device_memory_used",
      "query": "device_memory_used{instance_type='access', __$labels__}",
      "display_name": "Heap Memory Used",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [
        {
          "name": "index",
          "description": "Card ID (SNMP table row index)"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Per-card allocated dynamic heap, computed at collection as cadMeHeapSize - cadMeHeapRemaining, in bytes."
    },
    {
      "metric_group": "Access",
      "name": "device_memory_usage",
      "query": "device_memory_usage{instance_type='access', __$labels__}",
      "display_name": "Heap Memory Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [
        {
          "name": "index",
          "description": "Card ID (SNMP table row index)"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Per-card dynamic heap utilization, computed at collection as (cadMeHeapSize - cadMeHeapRemaining) / cadMeHeapSize * 100."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCInOctets",
      "query": "rate(interface_ifHCInOctets{instance_type='access', __$labels__}[5m])",
      "display_name": "Interface Incoming Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the average rate of bytes received over the past 5 minutes, based on the 64-bit ifHCInOctets counter which does not wrap on high-speed interfaces."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCOutOctets",
      "query": "rate(interface_ifHCOutOctets{instance_type='access', __$labels__}[5m])",
      "display_name": "Interface Outgoing Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the average rate of bytes sent over the past 5 minutes, based on the 64-bit ifHCOutOctets counter which does not wrap on high-speed interfaces."
    },
    {
      "metric_group": "Base",
      "name": "snmp_uptime",
      "query": "sum(snmp_uptime{instance_type='access', __$labels__}/100) by (instance_id)",
      "display_name": "System Uptime",
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the uptime of the device since the last restart. By monitoring the uptime, network administrators can understand the stability and reliability of the device and identify potential reboot or failure issues."
    }
  ]
}
