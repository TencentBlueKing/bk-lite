[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_bats"
        config_type = "bats"
        brand = "bats"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- BATS 天线自动跟踪系统（PEN 37069，AATS-MIB system 1.3.6.1.4.1.37069.1.1）：标量，顶层 field 带 .0 → measurement snmp，查询用 snmp_ 前缀 ----
    # cpuTemp 1.3.6.1.4.1.37069.1.1.4.0：Integer32，CPU 温度（摄氏度），-1000 表示不可用。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.37069.1.1.4.0"
        name = "cpu_temp_raw"

# ---- 温度：整数且不为 -1000（不可用）时输出 device_temperature_celsius，原始字段不落库。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    v = metric.fields.pop("cpu_temp_raw", None)
    if type(v) == "int" and v != -1000:
        metric.fields["device_temperature_celsius"] = v
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["bats"]
