[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_huawei"
        config_type = "huawei"
        brand = "huawei"
    # ---- sysObjectID model dictionary (display names). Interfaces use built-in IF-MIB; no IF expansion. ----
    # Identity only; this template does not collect extra private metrics.
    # CE/dcswitch family 1.3.6.1.4.1.2011.2.239
    #   ...239.58  CE16804 · ...239.59  CE16808 · ...239.60  CE16816
    #   ...239.120 CE16800-X4 · ...239.121 CE16800-X8 · ...239.122 CE16800-X16
    # S8700 family 1.3.6.1.4.1.2011.2.383
    #   ...383.3 S8704 · ...383.1 S8706 · ...383.2 S8710
    # S16700 family 1.3.6.1.4.1.2011.2.409
    #   ...409.1 S16704 · ...409.2 S16708
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Huawei CPU utilization (HUAWEI-ENTITY-EXTENT-MIB hwEntityCpuUsage, per entity) ----
    # 待现网核验：hwEntityCpuUsage 1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5（已归一化为 0-100 百分比）
    # descr 取 ENTITY-MIB entPhysicalName（与 CPU 同行 entPhysicalIndex）；metrics 声明 dimensions=descr。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5"
        name = "usage"
    # ---- Huawei Memory utilization (HUAWEI-ENTITY-EXTENT-MIB hwEntityMemUsage, per entity) ----
    # 待现网核验：华为以利用率(%)直接上报内存，无 used/free 字节 → 统一字段名 device_memory_usage(原始百分比)
    # hwEntityMemUsage 1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7；多实体 → descr 维度。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7"
        name = "usage"
    # ---- Huawei Temperature sensors (HUAWEI-ENTITY-EXTENT-MIB hwEntityTemperature, per entity) ----
    # 待现网核验：温度 hwEntityTemperature 1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11；
    # descr 取 ENTITY-MIB entPhysicalName 1.3.6.1.2.1.47.1.1.1.1.7（与温度同 entPhysicalIndex，按 index 关联）
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11"
        name = "celsius"
    # ---- Huawei Entity voltage (HUAWEI-ENTITY-EXTENT-MIB hwEntityVoltage, per entity) ----
    # hwEntityVoltage ...1.1.13 Integer32 RO，线侧 mV；metrics 查询 /1000 → V。
    # descr 取 ENTITY-MIB entPhysicalName，与 CPU/Mem/Temp 同 entPhysicalIndex。
    # 与光模块 hwEntityOpticalVoltage (...3.1.6) 不同，二者可并存。
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.13"
        name = "volts"
    # ---- Huawei Fans (HUAWEI-ENTITY-EXTENT-MIB hwFanStatusTable) ----
    # hwEntityFanState ...10.1.7 线侧 INTEGER 仅 normal(1)/abnormal(2)，不是 Cisco 六段枚举。
    # hwEntityFanSpeed ...10.1.5 Integer32，单位为满速百分比，不是 RPM。
    # hwEntityFanPresent ...10.1.6 present(1)/absent(2)，用于过滤空槽。
    # descr 取风扇槽位 hwEntityFanSlot ...10.1.1。偏离 1 即异常。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.7"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.5"
        name = "speed"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.6"
        name = "present"
    # ---- Huawei PSU (HUAWEI-ENTITY-EXTENT-MIB hwPwrStatusTable) ----
    # hwEntityPwrState ...18.1.6 线侧 INTEGER：supply(1)/notSupply(2)/sleep(3)/unknown(4)。
    # sleep(3) 是冗余电源休眠，不是故障；策略不得把 >1 当成异常。
    # hwEntityPwrPresent ...18.1.5：present(1)/absent(2)（与风扇在位同向，不是 0/1）。
    # descr 取电源槽位 hwEntityPwrSlot ...18.1.1。
    # hwEntityPwrCurrent ...18.1.7 Integer32，单位毫安 (mA)，不是安培。
    # hwEntityPwrVoltage ...18.1.8 Integer32，单位毫伏 (mV)，不是伏特。
    # hwEntityPwrPower ...18.1.10 Integer32，单位瓦特 (W)，为电源模块额定功率，不是整机瞬时功耗。
    # 电参查询侧仅保留 present(1) 行。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.6"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.5"
        name = "present"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.7"
        name = "current_mA"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.8"
        name = "voltage_mV"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.10"
        name = "rated_power_watts"
    # ---- Chassis used/total power (hwDevicePowerInfoUsedPower / TotalPower, watts) ----
    [[inputs.snmp.table]]
        name = "device_power"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.3.2"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.3.1"
        name = "total"
    # ---- Entity board power (hwEntityBoardPower, watts) ----
    # hwEntityBoardPower ...1.1.24 Integer32 RO，单位瓦特；descr=entPhysicalName。
    # 与 ENERGYMNGT 板卡毫瓦指标 device_board_*_mw 并存，勿混单位。
    [[inputs.snmp.table]]
        name = "device_entity"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.24"
        name = "board_power"
    # ---- Chassis/board energy (hwCurrentPower / hwBoardCurrentPower, milliwatts) ----
    # 与 hwDevicePowerInfo*（瓦特）并存，线侧为毫瓦，展示可 ÷1000 为瓦特。
    # hwCurrentPower ...6.157.1.6 / hwAveragePower ...1.3 / hwRatedPower ...1.4
    # 板卡表 hwBoardName ...2.1.1.3 / hwBoardCurrentPower ...2.1.1.4 / hwBoardRatedPower ...2.1.1.5
    [[inputs.snmp.table]]
        name = "device_energy"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.1.6"
        name = "current_power_mw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.1.3"
        name = "average_power_mw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.1.4"
        name = "rated_power_mw"
    [[inputs.snmp.table]]
        name = "device_board"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.2.1.1.3"
        name = "hwBoardName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.2.1.1.4"
        name = "current_power_mw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.2.1.1.5"
        name = "rated_power_mw"
    # ---- Huawei SFP optical DDM (HUAWEI-ENTITY-EXTENT-MIB hwOpticalModuleInfoTable) ----
    # RX=hwEntityOpticalRxPower ...3.1.8 / TX=hwEntityOpticalTxPower ...3.1.9。
    # TEMP=hwEntityOpticalTemperature ...3.1.5（°C）/ VOLT=hwEntityOpticalVoltage ...3.1.6（mV）/
    # BIAS=hwEntityOpticalBiasCurrent ...3.1.7（µA）。descr=entPhysicalName。
    # 园区交换机线侧光功率是 µW（MIB 文本常误标 dBm×100）；查询侧 10*log10(µW/1000)→dBm。
    # 无效哨兵 2147483647；无模块/无效功率常为 <=0。电压查询侧 /1000 → V。不做 starlark 换算。
    [[inputs.snmp.table]]
        name = "device_optical"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.8"
        name = "rx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.9"
        name = "tx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.5"
        name = "temperature"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.7"
        name = "bias"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.6"
        name = "voltage"
    # ---- Stack / CSS (HUAWEI-STACK-MIB, hwDatacomm 183) ----
    # iStack/CE 走 hwStackObject(183.1)；框式 CSS 走 hwCssObject(183.3)。未启用时表为空。
    # 183.1.4/5/6 是标量（系统 MAC / 是否堆叠 / 保留 VLAN），不是成员/端口/链路表。
    # 183.1.22 是 trap 节点，没有可轮询的 hwStackLinkStatus。堆叠链路健康看堆叠口状态。
    # 成员角色：hwMemberStackRole ...183.1.20.1.3 = master(1)/standby(2)/slave(3)。
    # ...20.1.4 是 hwMemberStackMacAddress，不能当角色采。
    [[inputs.snmp.table]]
        name = "device_stack_member"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.20.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.20.1.3"
        name = "role"
    # CSS 成员：hwCssMemberFrameId ...183.3.2.1.1 / hwCssMemberRole ...183.3.2.1.8
    # 角色 INTEGER：master(1)/standby(2)/slave(3)/single(4)/unknown(10)
    [[inputs.snmp.table]]
        name = "device_css_member"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.3.2.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.3.2.1.8"
        name = "role"
    # 堆叠口：hwStackPortName ...183.1.21.1.3 / hwStackPortStatus ...183.1.21.1.5 = up(1)/down(2)
    [[inputs.snmp.table]]
        name = "device_stack_port"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.21.1.3"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.21.1.5"
        name = "state"
    # CSS 口：hwCssPortName ...183.3.4.1.5 / hwCssPortOperStatus ...183.3.4.1.7 = down(0)/up(1)
    # 与堆叠口 up(1)/down(2) 不同；策略不得用 >1，down 必须按 ==0。
    [[inputs.snmp.table]]
        name = "device_css_port"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.3.4.1.5"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.3.4.1.7"
        name = "state"
    # ---- M-LAG (HUAWEI-M-LAG-MIB, hwETrunkMIB 178.8) ----
    # 一致性检查（hwMLagConsistency*）是 trap / accessible-for-notify，不可轮询。
    # 可轮询：hwmlagInfoTable 成员口状态；hwmlagDfsInfoTable 本端心跳。
    # 未启用 M-LAG 时表为空，不阻断其余指标。
    # 成员口：hwMlagPortName ...178.8.1.5.1.4 / hwPortState ...5.1.5 = down(0)/up(1)
    [[inputs.snmp.table]]
        name = "device_mlag_port"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.178.8.1.5.1.4"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.178.8.1.5.1.5"
        name = "state"
    # 成员心跳：hwLocalNodeId ...178.8.1.4.1.2 / hwLocalHeartBeatState ...4.1.1 = ok(1)/lost(2)
    [[inputs.snmp.table]]
        name = "device_mlag_member"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.178.8.1.4.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.178.8.1.4.1.1"
        name = "heartbeat"
