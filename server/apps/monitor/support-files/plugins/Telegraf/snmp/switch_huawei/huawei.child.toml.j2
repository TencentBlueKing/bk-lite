[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_huawei"
        config_type = "huawei"
        brand = "huawei"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.2.2"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Huawei CPU utilization (HUAWEI-ENTITY-EXTENT-MIB hwEntityCpuUsage, per entity) ----
    # 待现网核验：hwEntityCpuUsage 1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5（已归一化为 0-100 百分比）
    # descr 取 ENTITY-MIB entPhysicalName（与 CPU 同行 entPhysicalIndex）；metrics 声明 dimensions=descr。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5"
        name = "usage"
    # ---- Huawei Memory utilization (HUAWEI-ENTITY-EXTENT-MIB hwEntityMemUsage, per entity) ----
    # 待现网核验：华为以利用率(%)直接上报内存，无 used/free 字节 → 统一字段名 device_memory_usage(原始百分比)
    # hwEntityMemUsage 1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7；多实体 → descr 维度。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7"
        name = "usage"
    # ---- Huawei Temperature sensors (HUAWEI-ENTITY-EXTENT-MIB hwEntityTemperature, per entity) ----
    # 待现网核验：温度 hwEntityTemperature 1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11；
    # descr 取 ENTITY-MIB entPhysicalName 1.3.6.1.2.1.47.1.1.1.1.7（与温度同 entPhysicalIndex，按 index 关联）
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11"
        name = "celsius"
    # ---- Huawei Fans (HUAWEI-ENTITY-EXTENT-MIB hwEntityFanState) ----
    # 待现网核验：风扇状态 hwEntityFanState 1.3.6.1.4.1.2011.5.25.31.1.1.10.1.7；
    # 华为原生编码 1=normal,2=abnormal（已与统一约定 1=normal 对齐，无需重映射，偏离 1 即异常）；
    # descr 取风扇槽位 1.3.6.1.4.1.2011.5.25.31.1.1.10.1.1
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.7"
        name = "state"
    # ---- Huawei PSU (HUAWEI-ENTITY-EXTENT-MIB hwEntityPwrState / hwEntityPwrPresent) ----
    # 与同族 NE 模板一致：hwEntityPwrState ...18.1.6 / hwEntityPwrPresent ...18.1.5。
    # descr 取电源槽位 hwEntityPwrIndex ...18.1.1（与风扇槽位 descr 同形）。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.6"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.5"
        name = "present"
    # ---- Huawei SFP optical DDM (HUAWEI-ENTITY-EXTENT-MIB hwOpticalModuleInfoTable) ----
    # RX=hwEntityOpticalRxPower ...3.1.8 / TX=hwEntityOpticalTxPower ...3.1.9。
    # TEMP=hwEntityOpticalTemperature ...3.1.5 / VOLT=hwEntityOpticalVoltage ...3.1.6 /
    # BIAS=hwEntityOpticalBiasCurrent ...3.1.7（与同族 NE 光模块列一致）。
    # 实际单位 µW（MIB 曾误标 dBm）；无模块/无效常为 <=0；descr=entPhysicalName。
    # 电压原始为 mV，metrics 查询侧 /1000 → V。不做 starlark 换算。
    [[inputs.snmp.table]]
        name = "device_optical"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.8"
        name = "rx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.9"
        name = "tx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.5"
        name = "temperature"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.7"
        name = "bias"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.6"
        name = "voltage"
    # ---- Stack / CSS member, port, link (HUAWEI-STACK-MIB / HUAWEI-CSS-MIB, hwDatacomm 183) ----
    # 校园 iStack 与 CE 走 hwStack*；框式 CSS（S12700/S9700 等）走 hwCss*。未启用堆叠/CSS 的设备表为空，不影响其余指标。
    # 现网 CE/VRP8：hwMemberId ...183.1.20.1.1 / hwMemberRole ...183.1.20.1.4
    [[inputs.snmp.table]]
        name = "device_stack_member"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.20.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.20.1.4"
        name = "role"
    # 校园早期 iStack / CSS 成员表：hwMemberStackId ...183.1.4.1.1 / hwMemberStackRole ...183.1.4.1.3
    [[inputs.snmp.table]]
        name = "device_css_member"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.4.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.4.1.3"
        name = "role"
    # Stack port：hwStackPortName ...183.1.21.1.3 / hwStackPortStatus ...183.1.21.1.5（1=up,2=down）
    [[inputs.snmp.table]]
        name = "device_stack_port"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.21.1.3"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.21.1.5"
        name = "state"
    # CSS / 早期堆叠口：hwStackPortStatus ...183.1.5.1.3
    [[inputs.snmp.table]]
        name = "device_css_port"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.5.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.5.1.3"
        name = "state"
    # Stack link：hwStackLinkIndex ...183.1.22.1.1 / hwStackLinkStatus ...183.1.22.1.6
    [[inputs.snmp.table]]
        name = "device_stack_link"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.22.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.22.1.6"
        name = "state"
    # CSS / 早期堆叠链路：hwCssLink / hwStackLink ...183.1.6.1.1 / 状态 ...183.1.6.1.4
    [[inputs.snmp.table]]
        name = "device_css_link"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.6.1.1"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.183.1.6.1.4"
        name = "state"
