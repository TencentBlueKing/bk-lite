[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_opengear"
        config_type = "opengear"
        brand = "opengear"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB ifTable, 用于自动展开 ifDescr/ifOperStatus 等接口属性列) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64 位 IF-MIB HC 流量计数器 (ifXTable，高速无线接口不易回绕，按 ifIndex 与上表接口行对齐) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- CPU / 内存：UCD-SNMP-MIB（1.3.6.1.4.1.2021）标量，顶层 field GET 带实例 .0 → measurement snmp → 查询 snmp_ 前缀 ----
    # ssCpuIdle（.11.11.0）为最近 1 分钟空闲百分比，CPU 使用率 = 100 - idle；设备不返回 idle 时以 ssCpuUser（.11.9.0）+ ssCpuSystem（.11.10.0）兜底。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.11.0"
        name = "cpu_idle_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.9.0"
        name = "cpu_user_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.10.0"
        name = "cpu_system_raw"
    # memTotalReal（.4.5.0）/ memAvailReal（.4.6.0），单位 kB；下方 starlark ×1024 换算为字节并计算使用率。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "memory_total_kb"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.6.0"
        name = "memory_avail_kb"
    # ---- 设备私有健康指标（温度/电源等）→ N/A ----
    # Opengear 私有 MIB 的健康指标多为 per-row 索引表(带行级 skip_values),telegraf inputs.snmp 不支持行级过滤,本插件不采集,不伪造。

# ---- CPU：usage = 100 - idle（无 idle 时取 user + system）；内存：kB ×1024 → 字节，usage = (total - avail) / total × 100。原始字段换算后删除。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    idle = metric.fields.pop("cpu_idle_raw", None)
    user = metric.fields.pop("cpu_user_raw", None)
    system = metric.fields.pop("cpu_system_raw", None)
    if idle != None:
        metric.fields["device_cpu_usage"] = 100.0 - float(idle)
    elif user != None and system != None:
        metric.fields["device_cpu_usage"] = float(user) + float(system)
    total = metric.fields.pop("memory_total_kb", None)
    avail = metric.fields.pop("memory_avail_kb", None)
    if total != None:
        metric.fields["device_memory_total"] = int(total) * 1024
    if avail != None:
        metric.fields["device_memory_free"] = int(avail) * 1024
    if total != None and avail != None and int(total) > 0:
        metric.fields["device_memory_usage"] = (int(total) - int(avail)) * 100.0 / int(total)
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["opengear"]
