[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_exinda"
        config_type = "exinda"
        brand = "exinda"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Identity: EXINDA-MIB systemInfo scalars. Gate sysObjectID under 1.3.6.1.4.1.21091 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.1.1.0"
        name = "hardware_series"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.1.2.0"
        name = "licensed_model"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.1.3.0"
        name = "system_version"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.1.4.0"
        name = "system_host_id"
        is_tag = true
    # ---- CPU：cpuUsagePercent 标量，顶层 field GET 必须带实例 .0；禁止 table.field+.0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.2.4.0"
        name = "device_cpu_usage"
    # ---- CPU load：cpuLoad1/5/15，单位为百分之一负载，不是百分比 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.2.1.0"
        name = "device_cpu_load_1"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.2.2.0"
        name = "device_cpu_load_5"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.2.3.0"
        name = "device_cpu_load_15"
    # ---- 温度：cpuTemperature 标量，顶层 field GET 带 .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.2.5.0"
        name = "device_temperature_celsius"
    # ---- 内存：totalRam / usedRam / freeRam，标量 field 带 .0，原始单位 kbytes ----
    # 盘侧 *1024 换成字节；利用率 used/total（单位相消）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.3.1.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.3.2.0"
        name = "device_memory_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.21091.1.3.3.0"
        name = "device_memory_free"
# ---- 不采集已废弃的 cpuAlarm/ramAlarm OCTET STRING，也不采集 CIFS/TCPA/wan-memory 加速表。----
