{
  "object": "Wanopt",
  "plugin": "Wanopt Exinda SNMP",
  "templates": [
    {
      "name": "Exinda WAN优化CPU使用率过高",
      "alert_name": "WAN优化${resource_name} CPU 使用率过高",
      "description": "监控 Exinda / GFI ExOS WAN 优化设备的整机 CPU 使用率（cpuUsagePercent），当持续高于阈值时触发告警，提示可能存在加速、整形或深度检测负载过重，避免转发与优化效果下降。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Exinda WAN优化内存使用率过高",
      "alert_name": "WAN优化${resource_name} 内存使用率过高",
      "description": "监控 Exinda / GFI ExOS WAN 优化设备的物理内存使用率（已用/总量），当超过阈值时触发告警，便于及时发现内存压力导致加速会话或整形性能下降的风险。",
      "metric_name": "device_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Exinda WAN优化温度过高",
      "alert_name": "WAN优化${resource_name} 温度过高",
      "description": "监控 Exinda / GFI ExOS WAN 优化设备的 CPU 温度（cpuTemperature），当持续高于阈值时触发告警，提示可能存在散热不良或环境温度过高，避免器件过热损坏。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 70,
          "method": ">"
        },
        {
          "level": "error",
          "value": 60,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 55,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
