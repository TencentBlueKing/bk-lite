[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_versa"
        config_type = "versa"
        brand = "versa"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # 识别门：sysObjectID 前缀 1.3.6.1.4.1.42359（Versa FlexVNF / VOS）。
    # DEVICE-MIB deviceTable 列：table.field 禁止 .0；按 deviceClientId（及 ifIndex）walk 发现实例。
    # 不要把 device 节点 1.3.6.1.4.1.42359.2.2.1.1 或 1.3.6.1.4.1.42359.2.2.1.2 当 CPU/内存叶。
    # ---- CPU%：deviceCPULoad，UnsignedShort 0–100 ----
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.42359.2.2.1.1.1.1.8"
        name = "deviceClientId"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.42359.2.2.1.1.1.1.2"
        name = "usage"
    # ---- 内存%：deviceMemoryLoad，UnsignedShort 0–100 ----
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.42359.2.2.1.1.1.1.8"
        name = "deviceClientId"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.42359.2.2.1.1.1.1.3"
        name = "usage"
    # ---- 会话：deviceActiveSessions / deviceFailedSessions / deviceMaxSessions ----
    [[inputs.snmp.table]]
        name = "device"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.42359.2.2.1.1.1.1.8"
        name = "deviceClientId"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.42359.2.2.1.1.1.1.5"
        name = "active_sessions"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.42359.2.2.1.1.1.1.6"
        name = "failed_sessions"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.42359.2.2.1.1.1.1.7"
        name = "max_sessions"
# ---- 温度/风扇/电源：Versa SD-WAN（软件型/虚拟化 VNF）私有 MIB 未以无需行级过滤的标量形式暴露环境传感器 → N/A。不采 alarm / deviceCpuInfoTable。接口走内置 IF-MIB。----
