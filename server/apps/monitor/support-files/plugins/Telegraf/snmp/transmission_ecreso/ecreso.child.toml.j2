[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_ecreso"
        config_type = "ecreso"
        brand = "ecreso"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- ECRESO-FM-TRANS-MIB maMo* / maDr*（PEN 6404），标量顶层 field 带 .0 ----
    # 环境温度 maMoCoMeAmb，Integer32 ℃。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6404.3.1.2.11.1.3.1.1.0"
        name = "ecreso_ambient_temperature_celsius"
    # 散热片1温度 maMoCoMeHeat1，Integer32 ℃。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6404.3.1.2.11.1.3.1.7.0"
        name = "ecreso_heatsink_temperature_celsius"
    # 电源温度 maMoCoMePsuTemp，Integer32 ℃。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6404.3.1.2.11.1.3.1.9.0"
        name = "ecreso_psu_temperature_celsius"
    # 内部温度 maMoCoMeIntTemp，Gauge32 ℃。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6404.3.1.2.11.1.3.1.10.0"
        name = "device_temperature_celsius"
    # 电源效率 maMoMaEffPsu，Gauge32 0..100 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6404.3.1.2.11.1.1.3.0"
        name = "ecreso_psu_efficiency_percent"
    # ---- 风扇转速 maMoFanSpeed；与告警分表采集，starlark 再归入 measurement ecreso_fan ----
    [[inputs.snmp.table]]
        name = "ecreso_fan_speed"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6404.3.1.2.11.1.5.1.2"
        name = "speed_rpm"
    # ---- 风扇告警 maMoFanAlarms {undefined(0), on(1), off(2)} ----
    [[inputs.snmp.table]]
        name = "ecreso_fan_alarm"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6404.3.1.2.11.1.5.1.3"
        name = "alarm_state"
    # ---- 驱动表 maDrEntry：前向/反射功率 Gauge32 W；仅在设备返回行时产出 ----
    [[inputs.snmp.table]]
        name = "ecreso_driver"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6404.3.1.2.11.2.1.1.5"
        name = "forward_power_watts"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6404.3.1.2.11.2.1.1.6"
        name = "reflected_power_watts"
# ---- CPU/内存：广播发射机机箱无 CPU/内存 Gauge，不采集。----

[[processors.starlark]]
    namepass = ["snmp", "ecreso_fan_speed", "ecreso_fan_alarm", "ecreso_driver"]
    source = '''
def apply(metric):
    f = metric.fields
    name = metric.name
    if name == "snmp":
        ranges = [
            ("ecreso_ambient_temperature_celsius", -125, 125),
            ("ecreso_heatsink_temperature_celsius", -125, 125),
            ("ecreso_psu_temperature_celsius", -125, 125),
            ("device_temperature_celsius", 0, 999),
            ("ecreso_psu_efficiency_percent", 0, 100),
        ]
        for item in ranges:
            key = item[0]
            lo = item[1]
            hi = item[2]
            v = f.get(key)
            if v != None:
                if v < lo or v > hi:
                    f.pop(key)
        return metric
    if name == "ecreso_fan_speed":
        v = f.get("speed_rpm")
        if v != None:
            if v < 0 or v > 99999:
                f.pop("speed_rpm")
        if len(f.keys()) == 0:
            return None
        metric.name = "ecreso_fan"
        return metric
    if name == "ecreso_fan_alarm":
        raw = f.get("alarm_state")
        if raw != None:
            a = int(raw)
            if a == 2:
                f["alarm_state"] = 1
            elif a == 1 or a == 0:
                f["alarm_state"] = 2
            else:
                f.pop("alarm_state")
        if len(f.keys()) == 0:
            return None
        metric.name = "ecreso_fan"
        return metric
    if name == "ecreso_driver":
        keys = ["forward_power_watts", "reflected_power_watts"]
        for key in keys:
            v = f.get(key)
            if v != None:
                if v < 0 or v > 99999:
                    f.pop(key)
        if len(f.keys()) == 0:
            return None
        return metric
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["ecreso"]
