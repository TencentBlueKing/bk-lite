{
  "object": "Wireless",
  "plugin": "Wireless UHP SNMP",
  "templates": [
    {
      "name": "UHP无线设备CPU使用率过高",
      "alert_name": "无线设备${resource_name} CPU 使用率过高",
      "description": "监控 UHP VSAT 终端的 CPU 使用率，当持续高于阈值时触发告警，提示可能存在处理过载或异常负载。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "UHP无线设备温度过高",
      "alert_name": "无线设备${resource_name} 温度过高",
      "description": "监控 UHP VSAT 终端的机箱温度，当持续高于阈值时触发告警，提示可能存在散热不良或环境温度过高。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 85,
          "method": ">"
        },
        {
          "level": "error",
          "value": 75,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
