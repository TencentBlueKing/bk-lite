{
  "object": "Transmission",
  "plugin": "Transmission BTI SNMP",
  "templates": [
    {
      "name": "BTI传输设备温度过高",
      "alert_name": "传输设备${resource_name} 系统温度过高",
      "description": "监控 BTI8xx 主系统温度（systemTemperature，摄氏度），当持续高于阈值时触发告警，提示机箱温升、散热不良或环境温度过高。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 85,
          "method": ">"
        },
        {
          "level": "error",
          "value": 75,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 65,
          "method": ">"
        }
      ],
      "group_algorithm": "max"
    }
  ]
}
