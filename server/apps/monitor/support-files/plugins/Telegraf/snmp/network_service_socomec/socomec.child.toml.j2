[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_socomec"
        config_type = "socomec"
        brand = "socomec"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # SOCOMECUPS-MIB Net Vision classic tree under PEN 4555.1.1.1.
    # Prefer classic when both classic and NV7 (4555.1.1.7) respond.
    # Do not mix both trees in this collect path. Do not invent CPU% or memory.
    # Do not collect iPDU proprietary identity, inlet, outlet, EMD or alarm tables.
    # upsEstimatedChargeRemaining (%), upsBatteryStatus, optional
    # upsBatteryVoltage (0.1 V, /10 in query).
    [[inputs.snmp.table]]
        name = "ups_battery"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4555.1.1.1.1.2.4"
        name = "charge_percent"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4555.1.1.1.1.2.1"
        name = "status"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4555.1.1.1.1.2.5"
        name = "voltage"
    # upsOutputPercentLoad per output line index (%).
    [[inputs.snmp.table]]
        name = "ups_output"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4555.1.1.1.1.4.4.1.1"
        name = "line"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4555.1.1.1.1.4.4.1.4"
        name = "load_percent"
