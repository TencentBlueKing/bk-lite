{
  "collector": "Telegraf",
  "collect_type": "snmp_dahua",
  "plugin": "NetworkService Dahua SNMP",
  "plugin_desc": "SNMP monitoring template for Dahua IP cameras, NVRs and video recorders (DAHUA-SNMP-MIB). It reports uptime, CPU utilization, and interface traffic (enterprise PEN 1004849).",
  "support_collect_detect": true,
  "status_query": "any({instance_type='network_service', collect_type='snmp_dahua'}) by (instance_id)",
  "name": "NetworkService",
  "icon": "mm-network_service_网络服务",
  "type": "Network Device",
  "description": "",
  "default_metric": "any({instance_type='network_service'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "device_cpu_usage",
    "snmp_uptime"
  ],
  "metrics": [
    {
      "metric_group": "NetworkService",
      "name": "device_cpu_usage",
      "query": "max(snmp_device_cpu_usage{instance_type='network_service', __$labels__}) by (instance_id)",
      "display_name": "CPU Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "CPU utilization of the Dahua device (DAHUA-SNMP-MIB cpuUsage, scalar 1.3.6.1.4.1.1004849.2.1.3.0), reported directly as a percentage; values outside 0-100 are dropped at collection."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCInOctets",
      "query": "rate(interface_ifHCInOctets{instance_type='network_service', __$labels__}[5m])",
      "display_name": "Interface Incoming Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average inbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCInOctets counter."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCOutOctets",
      "query": "rate(interface_ifHCOutOctets{instance_type='network_service', __$labels__}[5m])",
      "display_name": "Interface Outgoing Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average outbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCOutOctets counter."
    },
    {
      "metric_group": "Traffic",
      "name": "device_total_incoming_traffic",
      "query": "sum(rate(interface_ifHCInOctets{instance_type='network_service', __$labels__}[5m])) by (instance_id)",
      "display_name": "Device Total Incoming Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Total inbound interface bytes per second over five minutes, summed from 64-bit ifHCInOctets."
    },
    {
      "metric_group": "Traffic",
      "name": "device_total_outgoing_traffic",
      "query": "sum(rate(interface_ifHCOutOctets{instance_type='network_service', __$labels__}[5m])) by (instance_id)",
      "display_name": "Device Total Outgoing Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Total outbound interface bytes per second over five minutes, summed from 64-bit ifHCOutOctets."
    },
    {
      "metric_group": "Base",
      "name": "snmp_uptime",
      "query": "sum(snmp_uptime{instance_type='network_service', __$labels__}/100) by (instance_id)",
      "display_name": "System Uptime",
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Device uptime since the last restart, derived from sysUpTime."
    }
  ]
}
