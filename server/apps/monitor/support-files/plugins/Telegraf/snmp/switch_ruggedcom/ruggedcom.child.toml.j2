[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_ruggedcom"
        config_type = "ruggedcom"
        brand = "ruggedcom"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：rcDeviceStsCpuUsagePercent 标量，顶层 field GET 必须带实例 .0；禁止 table.field ----
    # 主路径为 percent 叶 1.3.6.1.4.1.15004.4.2.2.6.0。不要把 tenths 叶 …4.2.2.1 当百分数。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.15004.4.2.2.6.0"
        name = "device_cpu_usage"
    # ---- 内存空闲：rcDeviceStsAvailableRam 标量，单位字节（available/free，不是 used）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.15004.4.2.2.2.0"
        name = "device_memory_free"
    # ---- 内存总量：rcDeviceInfoTotalRam 标量，单位字节；used=total−available ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.15004.4.2.3.5.0"
        name = "device_memory_total"
    # ---- 温度：rcDeviceStsTemperature 标量，单位 ℃；不要把该叶当内存 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.15004.4.2.2.3.0"
        name = "device_temperature_celsius"
    # ---- 电源：rcDeviceStsPowerSupply1/2 标量，RcHardwareStatus ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.15004.4.2.2.4.0"
        name = "device_psu1_status"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.15004.4.2.2.5.0"
        name = "device_psu2_status"
    # ---- 风扇：rcDeviceStsFanBank1/2 标量，RcFanStatus ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.15004.4.2.2.10.0"
        name = "device_fan1_status"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.15004.4.2.2.11.0"
        name = "device_fan2_status"
# ---- 枚举归一（1=正常 / 2=异常；notPresent 记 0，查询侧跳过）----
# RcHardwareStatus：notPresent(1)→0 / functional(2)→1 / notFunctional(3)→2 / notConnected(4)→2
# RcFanStatus：notPresent(1)→0 / failed(2)→2 / standby(3)→1 / off(4)→2 / on(5)→1
[[processors.enum]]
    [processors.enum.tagpass]
        brand = ["ruggedcom"]
    [[processors.enum.mapping]]
        field = "device_psu1_status"
        dest = "device_psu1_status"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 0
            "2" = 1
            "3" = 2
            "4" = 2
    [[processors.enum.mapping]]
        field = "device_psu2_status"
        dest = "device_psu2_status"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 0
            "2" = 1
            "3" = 2
            "4" = 2
    [[processors.enum.mapping]]
        field = "device_fan1_status"
        dest = "device_fan1_status"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 0
            "2" = 2
            "3" = 1
            "4" = 2
            "5" = 1
    [[processors.enum.mapping]]
        field = "device_fan2_status"
        dest = "device_fan2_status"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 0
            "2" = 2
            "3" = 1
            "4" = 2
            "5" = 1
[[processors.starlark]]
    namepass = ["snmp"]
    [processors.starlark.tagpass]
        brand = ["ruggedcom"]
    source = '''
def apply(metric):
    psu = []
    for key in ("device_psu1_status", "device_psu2_status"):
        value = metric.fields.get(key)
        if value != None and value > 0:
            psu.append(value)
    if psu:
        metric.fields["device_psu_state"] = max(psu)
    fan = []
    for key in ("device_fan1_status", "device_fan2_status"):
        value = metric.fields.get(key)
        if value != None and value > 0:
            fan.append(value)
    if fan:
        metric.fields["device_fan_state"] = max(fan)
    return metric
'''
