[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_yamaha"
        config_type = "yamaha"
        brand = "yamaha"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Yamaha SWX 硬件（YAMAHA-SW-HARDWARE yamahaSWHardware 1.3.6.1.4.1.1182.3.1）----
    # CPU/内存/机箱温度均为标量 Gauge：顶层 field GET 带实例 .0 → measurement snmp → 查询 snmp_ 前缀。
    # yshCpuUtil1min（.6.0）：1 分钟平均 CPU%，0..100。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1182.3.1.6.0"
        name = "device_cpu_usage"
    # yshMemoryUtil（.4.0）：主内存使用率%，0..100。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1182.3.1.4.0"
        name = "device_memory_usage"
    # yshInboxTemperature（.15.0）：机箱内温度，摄氏度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1182.3.1.15.0"
        name = "device_temperature_celsius"
    # ---- 风扇模块：yshFanModuleTable .14（INDEX yshFanModuleIndex），yshFanModuleStatus 列 .14.1.2，good(1) / noGood(2) ----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1182.3.1.14.1.2"
        name = "state"
    # ---- 电源模块：yshPowerModuleTable .13（INDEX yshPowerModuleIndex），yshPowerModuleStatus 列 .13.1.2，up(1) / down(2) / notInstalled(3) ----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1182.3.1.13.1.2"
        name = "state"
# ---- 风扇模块状态归一：good(1)→1(正常)，noGood(2) 及其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
    [processors.enum.tagpass]
        brand = ["yamaha"]
# ---- 电源模块状态归一：notInstalled(3) 空槽整行丢弃，不计入故障；up(1)→1(正常)，down(2) 及其余→2(异常)。----
[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    if "state" not in metric.fields:
        return None
    raw = int(metric.fields["state"])
    if raw == 3:
        return None
    if raw == 1:
        metric.fields["state"] = 1
    else:
        metric.fields["state"] = 2
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["yamaha"]
