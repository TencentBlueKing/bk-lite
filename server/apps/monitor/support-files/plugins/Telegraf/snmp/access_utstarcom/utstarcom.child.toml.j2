[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_utstarcom"
        config_type = "utstarcom"
        brand = "utstarcom"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # Board performance table (PEN 1949). CPU/mem Integer32 0-1000; query-side /10.
    # Index boardPhyId: 1-12 service card, 13 CSM A, 14 CSM B.
    [[inputs.snmp.table]]
        name = "device"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1949.1.3.10.200.6.4.4.1.1.1.1"
        name = "boardPhyId"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1949.1.3.10.200.6.4.4.1.1.1.2"
        name = "boardType"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1949.1.3.10.200.6.4.4.1.1.1.3"
        name = "cpu_usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1949.1.3.10.200.6.4.4.1.1.1.4"
        name = "memory_usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1949.1.3.10.200.6.4.4.1.1.1.5"
        name = "temperature_celsius"
