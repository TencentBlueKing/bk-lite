[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_liebert"
        config_type = "liebert"
        brand = "liebert"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # LIEBERT-GP-ENVIRONMENTAL and LIEBERT-GP-PDU under PEN 476.1.42.
    # Do not invent CPU% or memory. Do not bind HOST-RESOURCES or UCD.
    # Do not collect the UPS / LIEBERT-GP-POWER tree in this pass.
    # Temperature uses the Celsius table only; do not walk the Fahrenheit table.
    # lgpEnvTemperatureMeasurementDegC, degrees Celsius. Empty tables yield no rows.
    [[inputs.snmp.table]]
        name = "env_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.476.1.42.3.4.1.3.3.1.3"
        name = "celsius"
    # lgpEnvHumidityMeasurementRel, relative humidity percent 0-100.
    [[inputs.snmp.table]]
        name = "env_humidity"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.476.1.42.3.4.2.2.3.1.3"
        name = "percent"
    # lgpPduPsLineEntry line label plus current. Prefer EcHundredths (/100 to A);
    # Ec (/10 to A) is the fallback when hundredths is absent. Empty tables yield no rows.
    [[inputs.snmp.table]]
        name = "pdu_line_current"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.476.1.42.3.8.30.40.1.15"
        name = "line"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.476.1.42.3.8.30.40.1.22"
        name = "amps"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.476.1.42.3.8.30.40.1.21"
        name = "ec"
