[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_alcoma"
        config_type = "alcoma"
        brand = "alcoma"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- ALCOMA alMP (PEN 12140) 微波健康标量：顶层 field 带实例 .0 直接 GET，落 measurement snmp，查询用 snmp_ 前缀 ----
    # alMPTemperature 1.3.6.1.4.1.12140.2.3.9.0 → temperature_celsius，INTEGER 摄氏度；offline(-1) 由下方 starlark 丢弃。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12140.2.3.9.0"
        name = "temperature_celsius"
        conversion = "int"
    # alMPRX-Level 1.3.6.1.4.1.12140.2.3.4.0 → rx_level_db，INTEGER dB；offline(-128) 由下方 starlark 丢弃。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12140.2.3.4.0"
        name = "rx_level_db"
        conversion = "int"
    # alMPTX-PWR 1.3.6.1.4.1.12140.2.3.3.0 → tx_power_db，INTEGER dB；offline(-128) 由下方 starlark 丢弃。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12140.2.3.3.0"
        name = "tx_power_db"
        conversion = "int"
    # 可选 alMPSNR 1.3.6.1.4.1.12140.2.4.2.0 → snr_db。DisplayString（不做 int 转换），
    # 下方 starlark 取文本中的第一个数值；为空或无数字时丢弃该字段。部分固件缺省时字段缺省。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12140.2.4.2.0"
        name = "snr_db"
# ---- CPU/内存/风扇/电源：alMP 无稳定、无需行级过滤的共享健康对象 → N/A，不臆造 CPU%/内存%。----

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
OFFLINE = {"temperature_celsius": -1, "rx_level_db": -128, "tx_power_db": -128}

def first_number(raw):
    text = str(raw)
    digits = ""
    sign = ""
    started = False
    for i in range(len(text)):
        c = text[i]
        if c >= "0" and c <= "9":
            digits += c
            started = True
        elif c == "." and started:
            if "." in digits:
                break
            digits += c
        elif started:
            break
        elif c == "-" or c == "+":
            sign = c
        else:
            sign = ""
    if digits == "" or digits == ".":
        return None
    if digits.endswith("."):
        digits = digits[:-1]
    return float(sign + digits)

def apply(metric):
    for key, offline in OFFLINE.items():
        if key in metric.fields and int(metric.fields[key]) == offline:
            metric.fields.pop(key)
    if "snr_db" in metric.fields:
        parsed = first_number(metric.fields["snr_db"])
        if parsed == None:
            metric.fields.pop("snr_db")
        else:
            metric.fields["snr_db"] = parsed
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["alcoma"]
