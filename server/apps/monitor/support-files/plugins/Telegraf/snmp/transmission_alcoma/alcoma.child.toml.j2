[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_alcoma"
        config_type = "alcoma"
        brand = "alcoma"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- ALCOMA alMP (PEN 12140) 微波健康标量 ----
    # alMPTemperature 1.3.6.1.4.1.12140.2.3.9.0 → temperature_celsius
    # Integer32 摄氏度；-1 表示离线，查询侧跳过。
    [[inputs.snmp.table]]
        name = "temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.12140.2.3.9"
        name = "celsius"
        conversion = "int"
    # alMPRX-Level 1.3.6.1.4.1.12140.2.3.4.0 → rx_level_db
    # Integer32 dB；-128 表示离线，查询侧跳过。
    [[inputs.snmp.table]]
        name = "rx_level"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.12140.2.3.4"
        name = "db"
        conversion = "int"
    # alMPTX-PWR 1.3.6.1.4.1.12140.2.3.3.0 → tx_power_db
    # Integer32 dB；-128 表示离线，查询侧跳过。
    [[inputs.snmp.table]]
        name = "tx_power"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.12140.2.3.3"
        name = "db"
        conversion = "int"
    # 可选 alMPSNR 1.3.6.1.4.1.12140.2.4.2.0 → snr_db
    # Integer32 dB。部分固件缺省时该表为空。
    [[inputs.snmp.table]]
        name = "snr"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.12140.2.4.2"
        name = "db"
        conversion = "int"
# ---- CPU/内存/风扇/电源：alMP 无稳定、无需行级过滤的共享健康对象 → N/A，不臆造 CPU%/内存%。----
