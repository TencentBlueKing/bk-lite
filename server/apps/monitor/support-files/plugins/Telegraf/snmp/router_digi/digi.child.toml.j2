[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_digi"
        config_type = "digi"
        brand = "digi"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # 识别门：sysObjectID 前缀 1.3.6.1.4.1.332.11.6（digiConnect / ConnectPort）。
    # 不混入 TransPort SARIAN（16378）树。
    # DIGI-DEVICE-INFO 标量：顶层 field GET 必须带实例 .0；table.field 禁止 .0。
    # 旧映射 .1/.2/.3/.4 为 DisplayString（产品/MAC/固件/Boot），不是 CPU/内存/温度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.332.11.6.1.6.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.332.11.6.1.8.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.332.11.6.1.9.0"
        name = "device_memory_free"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.332.11.6.1.10.0"
        name = "device_memory_used"
# ---- 温度/风扇/电源：DIGI-DEVICE-INFO-MIB 无机箱温度标量；Connect/ConnectPort 为紧凑型设计 → 温度/风扇/电源 N/A。CPU/内存干净可采。----
