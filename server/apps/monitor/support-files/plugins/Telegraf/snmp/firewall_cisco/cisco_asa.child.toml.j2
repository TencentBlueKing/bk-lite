[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_cisco_asa"
        config_type = "cisco_asa"
        brand = "cisco"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Cisco CPU (CISCO-PROCESS-MIB cpmCPUTotalTable) ----
    # cpmCPUTotal5minRev 1.3.6.1.4.1.9.9.109.1.1.1.1.8（主指标 device_cpu_usage，0-100）。
    # cpmCPUTotal1minRev ...1.1.1.1.7 为可选 1 分钟修订值（device_cpu_usage_1min）。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.109.1.1.1.1.8"
        name = "usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.109.1.1.1.1.7"
        name = "usage_1min"
    # ---- Cisco Memory pool (CISCO-MEMORY-POOL-MIB ciscoMemoryPoolTable) ----
    # name/used/free = ...9.9.48.1.1.1.2/.5/.6。不采 ciscoMemoryPoolLargestFree (...1.1.1.7)。
    # MEMPOOL_GLOBAL_SHARED 会把整机利用率拉满，由下方 starlark 丢弃该池。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.2"
        name = "name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.5"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.6"
        name = "free"
    # ---- Cisco firewall sessions (CISCO-FIREWALL-MIB cfwConnectionStatTable) ----
    # ConnectionStat: other(1) totalOpen(2) currentOpen(3) currentClosing(4)
    #   currentHalfOpen(5) currentInUse(6) high(7)。
    # Services protoIp(40) + currentInUse(6) 为整机当前占用连接数
    # （cfwConnectionStatValue.40.6）。不展开 buffer 统计表。
    [[inputs.snmp.table]]
        name = "firewall"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.147.1.2.2.2.1.5.40.6"
        name = "active_sessions"

[[processors.starlark]]
    namepass = ["device_memory"]
    source = '''
def apply(metric):
    if metric.tags.get("name") == "MEMPOOL_GLOBAL_SHARED":
        return None
    return metric
'''
