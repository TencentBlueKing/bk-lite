[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_teldat"
        config_type = "teldat"
        brand = "teldat"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # Teldat CPU/内存标量：顶层 field GET 必须带实例 .0；table.field 禁止 .0。
    # teldatCPUBusy5min 直接 0-100%；cache 内存总量/空闲为字节。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2007.4.1.2.1.2.1.1.3.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2007.4.1.2.1.2.1.1.2.0"
        name = "device_cpu_usage_1min"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2007.4.1.2.1.2.1.1.1.0"
        name = "device_cpu_usage_5sec"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2007.4.1.2.1.1.27.0"
        name = "device_memory_total"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2007.4.1.2.1.1.28.0"
        name = "device_memory_free"
        conversion = "int"
# ---- 温度/风扇/电源：Teldat 紧凑型企业路由器为无风扇固定配置设计，私有 MIB 未以无需行级过滤的标量形式暴露独立温度/风扇/电源传感器 → 温度/风扇/电源 N/A 不采。CPU/内存/接口干净可采。----
