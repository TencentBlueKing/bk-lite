{
  "object": "Wireless",
  "plugin": "Wireless H3C SNMP",
  "templates": [
    {
      "name": "H3C无线控制器CPU使用率过高",
      "alert_name": "无线控制器${resource_name} CPU 使用率过高",
      "description": "监控 H3C 无线控制器实体 CPU 使用率，当持续高于阈值时触发告警，提示可能存在 AP 或终端管理负载过重，避免影响接入、漫游与管理响应。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "H3C无线控制器内存使用率过高",
      "alert_name": "无线控制器${resource_name} 内存使用率过高",
      "description": "监控 H3C 无线控制器实体内存使用率，当超过阈值时触发告警。内存压力过高可能影响 AP 上线和终端漫游，需及时排查容量或异常负载。",
      "metric_name": "device_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
