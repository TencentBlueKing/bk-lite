[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_fibernet_xmux"
        config_type = "fibernet_xmux"
        brand = "fibernet_xmux"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Fibernet XMUX4+（PEN 29003，XMUX4-PLUS dmux4 1.3.6.1.4.1.29003.2.44.1.1）：muxTable 1.3.6.1.4.1.29003.2.44.1.1.9，INDEX muxTableIndex ----
    # table.field 不带 .0；index 标签即 muxTableIndex。
    [[inputs.snmp.table]]
        name = "xmux"
        inherit_tags = ["source"]
        index_as_tag = true
    # muxFanTemp / muxInteriorTemp：DisplayString，风扇侧 / 机箱内温度（摄氏度），由 starlark 解析数字。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.29003.2.44.1.1.9.1.4"
        name = "fan_temp_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.29003.2.44.1.1.9.1.5"
        name = "interior_temp_raw"
    # muxLeftPower / muxRightPower：powerOn(1) / powerOff(0) / unknown(8)。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.29003.2.44.1.1.9.1.9"
        name = "psu_left_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.29003.2.44.1.1.9.1.10"
        name = "psu_right_raw"

# ---- 每个 XMUX 行拆成：温度 device_temperature_celsius（sensor=fan / interior，字符串中解析出的第一个数字，解析失败不输出）
# ---- 与左 / 右电源 device_psu_state（position=left / right，powerOn(1) → 1 正常，powerOff(0) → 2 异常，unknown(8) → 3 未知，其它取值不输出）。----
[[processors.starlark]]
    namepass = ["xmux"]
    source = '''
def parse_temp(v):
    if type(v) == "int" or type(v) == "float":
        return float(v)
    if type(v) != "string":
        return None
    cur = ""
    for c in (v + " ").elems():
        if c.isdigit():
            cur += c
        elif c == "-" and cur == "":
            cur = "-"
        elif (c == "." or c == ",") and cur not in ("", "-") and "." not in cur:
            cur += "."
        elif cur not in ("", "-"):
            break
        else:
            cur = ""
    if cur in ("", "-") or cur.endswith("."):
        if cur.endswith(".") and len(cur) > 1:
            cur = cur[:-1]
        else:
            return None
    return float(cur)

def child(metric, name, tag, tagval, field, val):
    m = Metric(name)
    for k, v in metric.tags.items():
        m.tags[k] = v
    m.tags[tag] = tagval
    m.fields[field] = val
    m.time = metric.time
    return m

def apply(metric):
    out = []
    for field, sensor in [("fan_temp_raw", "fan"), ("interior_temp_raw", "interior")]:
        t = parse_temp(metric.fields.get(field))
        if t != None:
            out.append(child(metric, "device_temperature", "sensor", sensor, "celsius", t))
    for field, pos in [("psu_left_raw", "left"), ("psu_right_raw", "right")]:
        v = metric.fields.get(field)
        state = None
        if v == 1:
            state = 1
        elif v == 0:
            state = 2
        elif v == 8:
            state = 3
        if state != None:
            out.append(child(metric, "device_psu", "position", pos, "state", state))
    return out
'''
    [processors.starlark.tagpass]
        brand = ["fibernet_xmux"]
