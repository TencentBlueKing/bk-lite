[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_scalance"
        config_type = "scalance"
        brand = "scalance"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- SCALANCE 电源状态 (AUTOMATION-PS automationPSStatus 表列，无 .0) ----
    # 原始码 inactive(1)/active(2)；下方 enum 将 active(2)→1(正常)，其余→2(异常)。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4329.6.3.5.1.1.1.2"
        name = "state"
    # ---- SN-MSPS 温度表（snMspsDiagnosticsTemperatureTable，表列无 .0）----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4329.20.1.1.1.1.79.7.1.7"
        name = "sensor_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4329.20.1.1.1.1.79.7.1.4"
        name = "present"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4329.20.1.1.1.1.79.7.1.10"
        name = "status"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4329.20.1.1.1.1.79.7.1.16"
        name = "celsius"
    # ---- SN-MSPS 故障信号标量 snMspsFaultState，顶层 field 带 .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.4329.20.1.1.1.1.28.1.0"
        name = "scalance_fault_state"
# ---- CPU/内存/风扇：无私有 CPU/内存标量；多为无风扇被动散热 → 均 N/A。温度与故障信号见 SN-MSPS。----
# ---- 状态归一：automationPSStatus active(2)→1(正常)，inactive(1)及其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "2" = 1
[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    present = metric.fields.get("present")
    status = metric.fields.get("status")
    if "present" in metric.fields:
        metric.fields.pop("present")
    if "status" in metric.fields:
        metric.fields.pop("status")
    if present != 1 and present != "1":
        return None
    if status == 4 or status == "4" or status == 5 or status == "5":
        return None
    raw = metric.fields.get("celsius")
    if raw == None:
        return None
    t = type(raw)
    if t == "int" or t == "float":
        val = float(raw)
    else:
        return None
    if val < -40 or val > 125:
        return None
    if val == 65535 or val == 65534 or val == -1 or val == 2147483647 or val == -2147483648 or val == 4294967295:
        return None
    metric.fields["celsius"] = val
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["scalance"]
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    raw = metric.fields.get("scalance_fault_state")
    if raw == None:
        return metric
    if raw == 1 or raw == "1":
        metric.fields["scalance_fault_state"] = 1
        return metric
    if raw == 2 or raw == "2":
        metric.fields["scalance_fault_state"] = 2
        return metric
    metric.fields.pop("scalance_fault_state")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["scalance"]
