[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_westermo"
        config_type = "westermo"
        brand = "westermo"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- WeOS CPU loadAvg* 标量（WESTERMO-WEOS-MIB …16177.2.1.5.3.2.*）。上报值为负载×100，不是 0–100%。顶层 field GET 必须带实例 .0；禁止 table.field ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.16177.2.1.5.3.2.1.0"
        name = "device_cpu_load"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.16177.2.1.5.3.2.2.0"
        name = "device_cpu_load5"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.16177.2.1.5.3.2.3.0"
        name = "device_cpu_load15"
    # ---- WeOS 可用内存 memoryAvail（KB 标量 …16177.2.1.5.3.1.0）。只采 available，不编造 used/free，不推导使用率 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.16177.2.1.5.3.1.0"
        name = "device_memory_available"
# ---- 温度/风扇/电源：WeOS 私有 MIB 无整机温度、风扇、电源 Gauge；不把 SFP DDM 温度当机箱温度。接口走内置 IF-MIB。----
