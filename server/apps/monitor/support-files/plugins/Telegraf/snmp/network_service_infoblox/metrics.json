{
  "collector": "Telegraf",
  "collect_type": "snmp_infoblox",
  "plugin": "NetworkService Infoblox SNMP",
  "plugin_desc": "SNMP monitoring template for Infoblox network service device. It reports uptime, CPU utilization, memory utilization, interface traffic, and swap usage (enterprise PEN 7779).",
  "support_collect_detect": true,
  "status_query": "any({instance_type='network_service', collect_type='snmp_infoblox'}) by (instance_id)",
  "name": "NetworkService",
  "icon": "mm-network_service_网络服务",
  "type": "Network Device",
  "description": "",
  "default_metric": "any({instance_type='network_service'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "device_cpu_usage",
    "device_memory_usage",
    "device_swap_usage",
    "snmp_uptime"
  ],
  "metrics": [
    {
      "metric_group": "NetworkService",
      "name": "device_cpu_usage",
      "query": "snmp_device_cpu_usage{instance_type='network_service', __$labels__}",
      "display_name": "CPU Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "IB platform average CPU usage (ibSystemMonitorCpuUsage), reported directly as a 0-100 percentage."
    },
    {
      "metric_group": "NetworkService",
      "name": "device_memory_usage",
      "query": "snmp_device_memory_usage{instance_type='network_service', __$labels__}",
      "display_name": "Memory Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "IB platform memory usage (ibSystemMonitorMemUsage), reported directly as a 0-100 percentage."
    },
    {
      "metric_group": "NetworkService",
      "name": "device_swap_usage",
      "query": "snmp_device_swap_usage{instance_type='network_service', __$labels__}",
      "display_name": "Swap Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "IB platform swap usage (ibSystemMonitorSwapUsage), reported directly as a 0-100 percentage."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCInOctets",
      "query": "rate(interface_ifHCInOctets{instance_type='network_service', __$labels__}[5m])",
      "display_name": "Interface Incoming Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average inbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCInOctets counter."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCOutOctets",
      "query": "rate(interface_ifHCOutOctets{instance_type='network_service', __$labels__}[5m])",
      "display_name": "Interface Outgoing Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average outbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCOutOctets counter."
    },
    {
      "metric_group": "Traffic",
      "name": "device_total_incoming_traffic",
      "query": "sum(rate(interface_ifHCInOctets{instance_type='network_service', __$labels__}[5m])) by (instance_id)",
      "display_name": "Device Total Incoming Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Total inbound interface bytes per second over five minutes, summed from 64-bit ifHCInOctets."
    },
    {
      "metric_group": "Traffic",
      "name": "device_total_outgoing_traffic",
      "query": "sum(rate(interface_ifHCOutOctets{instance_type='network_service', __$labels__}[5m])) by (instance_id)",
      "display_name": "Device Total Outgoing Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Total outbound interface bytes per second over five minutes, summed from 64-bit ifHCOutOctets."
    },
    {
      "metric_group": "Base",
      "name": "snmp_uptime",
      "query": "sum(snmp_uptime{instance_type='network_service', __$labels__}/100) by (instance_id)",
      "display_name": "System Uptime",
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Device uptime since the last restart, derived from sysUpTime."
    }
  ]
}
