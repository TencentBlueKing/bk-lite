[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_planet"
        config_type = "planet"
        brand = "planet"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- NMS-CHASSIS nmscardTable 1.3.6.1.4.1.10456.3.6.10（PEN 10456，nmschassis=…10456.3.6）：按板卡逐行 walk，table.field 不带 .0 ----
    # nmscardCPUUtilization .1.11：板卡 CPU 利用率，单位 1%。nmscardDescr .1.3 作 card 标签。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10456.3.6.10.1.3"
        name = "card"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10456.3.6.10.1.11"
        name = "usage"
        conversion = "int"
    # nmscardMEMUtilization .1.12：板卡内存利用率，单位 1%。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10456.3.6.10.1.3"
        name = "card"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10456.3.6.10.1.12"
        name = "usage"
        conversion = "int"
    # nmscardTemperature .1.13：板卡温度，单位 ℃。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10456.3.6.10.1.3"
        name = "card"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10456.3.6.10.1.13"
        name = "celsius"
        conversion = "int"
    # ---- NMS-CHASSIS nmsAuxTable 1.3.6.1.4.1.10456.3.6.15：电源 / 风扇辅件，table.field 不带 .0 ----
    # nmsAuxDescr .1.2（标签）/ nmsAuxClass .1.3：power(1) / fan(2) / nmsAuxState .1.5：ok(1) / failure(2)；下方 starlark 按 Class 拆分。
    [[inputs.snmp.table]]
        name = "planet_aux"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10456.3.6.15.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10456.3.6.15.1.3"
        name = "class"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10456.3.6.15.1.5"
        name = "state"
        conversion = "int"

# ---- 辅件拆分：class power(1) → device_psu{psu}，fan(2) → device_fan{fan}；state ok(1)→1(正常)，failure(2)→2(异常)，其它类别或状态值丢弃。----
[[processors.starlark]]
    namepass = ["planet_aux"]
    source = '''
def apply(metric):
    cls = metric.fields.get("class")
    state = metric.fields.get("state")
    if cls == None or state == None:
        return None
    if int(state) not in [1, 2]:
        return None
    if int(cls) == 1:
        name, tag = "device_psu", "psu"
    elif int(cls) == 2:
        name, tag = "device_fan", "fan"
    else:
        return None
    m = Metric(name)
    for k, v in metric.tags.items():
        if k != "descr":
            m.tags[k] = v
    label = metric.tags.get("descr", "")
    if label == "":
        label = metric.tags.get("index", "")
    m.tags[tag] = label
    m.fields["state"] = int(state)
    m.time = metric.time
    return m
'''
    [processors.starlark.tagpass]
        brand = ["planet"]
