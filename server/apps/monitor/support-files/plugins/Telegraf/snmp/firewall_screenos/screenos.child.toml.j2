[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_screenos"
        config_type = "screenos"
        brand = "screenos"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Juniper ScreenOS CPU (NETSCREEN-RESOURCE-MIB nsResCpuLast5Min, 直接%, 标量, PEN 3224) ----
    # 标量用顶层 field GET，带实例 .0。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3224.16.1.3.0"
        name = "device_cpu_usage"
    # ---- 内存 (nsResMemAllocate 已用 / nsResMemLeft 空闲, 字节, 标量；无总量 OID，用量=used/(used+free)) ----
    # 标量用顶层 field GET，带实例 .0。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3224.16.2.1.0"
        name = "device_memory_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3224.16.2.2.0"
        name = "device_memory_free"
# ---- 会话/温/风/电：本插件只采 CPU 与内存（used/free）；会话与机箱温度/风扇/电源未纳入。----
