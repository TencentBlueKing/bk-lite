[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_huawei_ac"
        config_type = "huawei_ac"
        brand = "huawei_ac"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.18"
        name = "ifAlias"
        is_tag = true
    # ---- Entity CPU / memory / temperature (same OIDs as switch_huawei) ----
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5"
        name = "usage"
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7"
        name = "usage"
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11"
        name = "celsius"
    # ---- Chassis used/total power (hwDevicePowerInfoUsedPower / TotalPower, watts) ----
    # hwDevicePowerInfoTotalPower 1.3.6.1.4.1.2011.5.25.31.3.1
    # hwDevicePowerInfoUsedPower  ...5.25.31.3.2
    # Integer32; wire unit is watts.
    # Invalid samples (-1 or empty) are dropped.
    [[inputs.snmp.table]]
        name = "device_power"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.3.2"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.3.1"
        name = "total"
    # ---- Chassis fan table (hwFanStatusTable) ----
    # hwEntityFanSlot ...10.1.1 / hwEntityFanSn ...10.1.2
    # hwEntityFanSpeed ...10.1.5 Integer32, percent of full speed
    # hwEntityFanState ...10.1.7 normal(1)/abnormal(2)
    # Empty table is expected on fanless SKUs and must not fail collection.
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.1"
        name = "slot"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.2"
        name = "sn"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.5"
        name = "speed_pct"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.7"
        name = "state"
    # ---- Optical DDM (hwOpticalModuleInfoTable, index=entPhysicalIndex) ----
    # TEMP=hwEntityOpticalTemperature ...3.1.5 (°C)
    # VOLT=hwEntityOpticalVoltage ...3.1.6 (mV; query /1000 → V)
    # BIAS=hwEntityOpticalBiasCurrent ...3.1.7 (µA)
    # RX=hwEntityOpticalRxPower ...3.1.8 / TX=hwEntityOpticalTxPower ...3.1.9
    # Raw Rx/Tx is dBm×100; query /100 → dBm. Drop invalid sentinel 2147483647.
    # descr=entPhysicalName. Empty table is expected when no optical modules are present.
    [[inputs.snmp.table]]
        name = "optical"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.5"
        name = "temp_c"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.6"
        name = "voltage_mV"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.7"
        name = "bias_uA"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.8"
        name = "rx_dbm"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.9"
        name = "tx_dbm"
    # ---- WLAN AC global scalars ----
    [[inputs.snmp.table]]
        name = "wlan"
