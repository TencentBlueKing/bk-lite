[[processors.starlark]]
    namepass = ["wlan_ap"]
    source = '''
def apply(metric):
    for field in ["environment_temperature", "cpu_temperature", "np_temperature"]:
        value = metric.fields.get(field)
        if value == 255 or value == 255.0 or value == "255":
            metric.fields.pop(field)
    return metric
'''
    [processors.starlark.tagpass]
        collect_type = ["snmp_huawei_ac"]

[[processors.starlark]]
    namepass = ["wlan_radio"]
    source = '''
def apply(metric):
    for field in ["per", "tx_ratio", "rx_ratio"]:
        value = metric.fields.get(field)
        if value == 255 or value == 255.0 or value == "255":
            metric.fields.pop(field)
    return metric
'''
    [processors.starlark.tagpass]
        collect_type = ["snmp_huawei_ac"]

[[processors.starlark]]
    namepass = ["device_power", "device_fan"]
    source = '''
def apply(metric):
    for field in ["total", "used", "speed_pct"]:
        value = metric.fields.get(field)
        if value == -1 or value == -1.0 or value == "-1" or value == "":
            metric.fields.pop(field)
    return metric
'''
    [processors.starlark.tagpass]
        collect_type = ["snmp_huawei_ac"]

[[processors.starlark]]
    namepass = ["optical"]
    source = '''
def apply(metric):
    sentinel = 2147483647
    for field in ["temp_c", "voltage_mV", "bias_uA", "rx_dbm", "tx_dbm"]:
        value = metric.fields.get(field)
        if value == sentinel or value == 2147483647.0 or value == "2147483647":
            metric.fields.pop(field)
    return metric
'''
    [processors.starlark.tagpass]
        collect_type = ["snmp_huawei_ac"]
[[processors.enum]]
    namepass = ["device_fan"]
    [processors.enum.tagpass]
        collect_type = ["snmp_huawei_ac"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
