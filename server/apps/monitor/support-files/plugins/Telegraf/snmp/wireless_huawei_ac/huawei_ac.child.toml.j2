    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.139.12.1.2.1"
        name = "cur_joint_ap_num"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.139.12.1.5.7"
        name = "ap_count"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.139.12.1.5.6"
        name = "service_normal_ap_count"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.139.12.1.5.1"
