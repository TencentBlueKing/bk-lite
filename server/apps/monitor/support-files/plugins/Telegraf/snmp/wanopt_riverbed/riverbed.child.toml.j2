[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_riverbed"
        config_type = "riverbed"
        brand = "riverbed"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- 身份：STEELHEAD-MIB system 标量，顶层 field GET 必须带实例 .0 ----
    # 发现身份为 sysObjectID 前缀 1.3.6.1.4.1.17163.1.1（SteelHead，PEN 17163）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.1.1.0"
        name = "model"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.1.2.0"
        name = "serial"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.1.3.0"
        name = "systemVersion"
        is_tag = true
    # ---- CPU：cpuUtil1 全 CPU 近 1 分钟滚动平均百分比，Unsigned32 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.1.4.0"
        name = "device_cpu_usage"
    # ---- 负载辅助：cpuLoad1/5/15 为百分之一负载（hundredths），不是百分比 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.1.1.0"
        name = "device_cpu_load1"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.1.2.0"
        name = "device_cpu_load5"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.1.3.0"
        name = "device_cpu_load15"
    # ---- 温度：systemTemperature，摄氏度 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.2.9.0"
        name = "device_temperature_celsius"
    # ---- 健康：systemHealth INTEGER healthy(10000)/degraded(30000)/admissionControl(31000)/critical(50000) ----
    # processors.enum 归一为 1=healthy / 2=非 healthy。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.2.7.0"
        name = "device_health_state"
# ---- 无私有内存 Gauge，不发明 Mem OID。不采集 bandwidth/datastore/peer 表。----
[[processors.enum]]
    [processors.enum.tagpass]
        brand = ["riverbed"]
    [[processors.enum.mapping]]
        field = "device_health_state"
        dest = "device_health_state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "10000" = 1
            "30000" = 2
            "31000" = 2
            "50000" = 2
