[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_riverbed"
        config_type = "riverbed"
        brand = "riverbed"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- 身份：STEELHEAD-MIB system 标量，顶层 field GET 必须带实例 .0 ----
    # 发现身份为 sysObjectID 前缀 1.3.6.1.4.1.17163.1.1（SteelHead，PEN 17163）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.1.1.0"
        name = "model"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.1.2.0"
        name = "serial"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.1.3.0"
        name = "systemVersion"
        is_tag = true
    # ---- CPU：cpuUtil1 全 CPU 近 1 分钟滚动平均百分比，Unsigned32 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.1.4.0"
        name = "device_cpu_usage"
    # ---- 负载辅助：cpuLoad1/5/15 为百分之一负载（hundredths），不是百分比 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.1.1.0"
        name = "device_cpu_load1"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.1.2.0"
        name = "device_cpu_load5"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.1.3.0"
        name = "device_cpu_load15"
    # ---- 温度：systemTemperature，摄氏度 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.2.9.0"
        name = "device_temperature_celsius"
    # ---- 健康：systemHealth INTEGER healthy(10000)/degraded(30000)/admissionControl(31000)/critical(50000) ----
    # processors.enum 归一为 1=healthy / 2=非 healthy。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.2.7.0"
        name = "device_health_state"
    # ---- 连接计数：connectionCounts 标量，顶层 field GET 必须带实例 .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.2.1.0"
        name = "optimized_connections"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.2.2.0"
        name = "passthrough_connections"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.2.3.0"
        name = "half_opened_connections"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.2.4.0"
        name = "half_closed_connections"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.2.5.0"
        name = "established_connections"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.2.6.0"
        name = "active_connections"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.5.2.7.0"
        name = "total_connections"
    # ---- 连接上限：shMaxConnections，标量必须带 .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.2.13.1.0"
        name = "max_connections"
    # ---- 优化服务状态：optServiceStatus INTEGER。none(0)/unmanaged(1)/running(2)/sentCom1(3)/sentTerm1(4)/sentTerm2(5)/sentTerm3(6)/pending(7)/stopped(8) ----
    # processors.enum 派生 opt_service_ok：仅 running(2)→1，其余→2。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17163.1.1.2.8.0"
        name = "opt_service_status"
    # ---- 对端表 peerTable：表列禁止 .0。hostname/address 直接作 tag；version/model 先作 field 再提升为 tag。 ----
    [[inputs.snmp.table]]
        name = "steelhead_peer"
        inherit_tags = ["source"]
        index_as_tag = true
        oid = "1.3.6.1.4.1.17163.1.1.2.6.1"
        [[inputs.snmp.table.field]]
            oid = "1.3.6.1.4.1.17163.1.1.2.6.1.1.2"
            name = "peer_hostname"
            is_tag = true
        [[inputs.snmp.table.field]]
            oid = "1.3.6.1.4.1.17163.1.1.2.6.1.1.3"
            name = "peer_version"
        [[inputs.snmp.table.field]]
            oid = "1.3.6.1.4.1.17163.1.1.2.6.1.1.4"
            name = "peer_address"
            is_tag = true
        [[inputs.snmp.table.field]]
            oid = "1.3.6.1.4.1.17163.1.1.2.6.1.1.5"
            name = "peer_model"
# ---- 无私有内存 Gauge，不发明 Mem OID。不采集 bandwidth/datastore。接口仍只走 IF-MIB。----
[[processors.enum]]
    [processors.enum.tagpass]
        brand = ["riverbed"]
    [[processors.enum.mapping]]
        field = "device_health_state"
        dest = "device_health_state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "10000" = 1
            "30000" = 2
            "31000" = 2
            "50000" = 2
    [[processors.enum.mapping]]
        field = "opt_service_status"
        dest = "opt_service_ok"
        default = 2
        [processors.enum.mapping.value_mappings]
            "2" = 1
            "0" = 2
            "1" = 2
            "3" = 2
            "4" = 2
            "5" = 2
            "6" = 2
            "7" = 2
            "8" = 2
# 对端行只有字符串列。提升 version/model 为 tag，并写入 present=1，否则序列在数值存储中会被丢掉，行数也无法计数。
[[processors.starlark]]
    namepass = ["steelhead_peer"]
    source = '''
def apply(metric):
    version = metric.fields.get("peer_version")
    if version != None:
        metric.tags["peer_version"] = str(version)
        metric.fields.pop("peer_version")
    model = metric.fields.get("peer_model")
    if model != None:
        metric.tags["peer_model"] = str(model)
        metric.fields.pop("peer_model")
    metric.fields["present"] = 1
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["riverbed"]
