[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_alvarion"
        config_type = "alvarion"
        brand = "alvarion"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- brzaccVLAverageReceiveSNR 1.3.6.1.4.1.12394.1.1.11.1.0：标量，顶层 field 带 .0；仅 SU/RB 上报。----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12394.1.1.11.1.0"
        name = "alvarion_avg_receive_snr_db"
# ---- CPU/内存/温度/风扇/电源：本项不采集。----

# ---- 平均接收 SNR 仅保留 0..100；越界与哨兵值删除该字段，AU/BU 无此对象时不补占位。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    snr = metric.fields.get("alvarion_avg_receive_snr_db")
    if snr == None:
        return metric
    drop = False
    if type(snr) not in ["int", "float"]:
        drop = True
    else:
        sentinels = [65535, 65534, -1, 2147483647, -2147483648, 4294967295]
        for sentinel in sentinels:
            if snr == sentinel:
                drop = True
                break
        if snr < 0 or snr > 100:
            drop = True
    if drop:
        metric.fields.pop("alvarion_avg_receive_snr_db")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["alvarion"]
