[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_proxim"
        config_type = "proxim"
        brand = "proxim"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (existing wireless IF pattern: ifIndex + ifDescr tags only; do not expand ifInErrors/ifOperStatus) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64 位 IF-MIB HC 流量计数器 (ifXTable，无线回传链路高吞吐不易回绕，按 ifIndex 与上表接口行对齐) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- CPU：sysMonitorCPUUsage 标量，DisplayString 百分比文本，解析为 device_cpu_usage / cpu_usage_percent ----
    # OID 1.3.6.1.4.1.841.1.1.3.9.1.0。starlark 去掉 % 后转为 0-100 数值。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.841.1.1.3.9.1"
        name = "usage"
    # ---- 内存：sysMonitorRAMUsage 标量，DisplayString 百分比文本，解析为 device_memory_usage / memory_usage_percent ----
    # OID 1.3.6.1.4.1.841.1.1.3.9.2.0。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.841.1.1.3.9.2"
        name = "usage"
    # ---- 可选温度：currentUnitTemp（temperature 1.3.6.1.4.1.841.1.1.3.8.1.0，Integer32 ℃）。设备无响应时该字段缺省，不伪造。----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.841.1.1.3.8.1"
        name = "celsius"

[[processors.starlark]]
    namepass = ["device_cpu", "device_memory"]
    source = '''
def parse_percent(raw):
    if raw == None:
        return None
    text = str(raw).strip()
    if text.endswith("%"):
        text = text[:-1].strip()
    if text == "":
        return None
    return float(text)

def apply(metric):
    parsed = parse_percent(metric.fields.get("usage"))
    if parsed == None:
        return None
    metric.fields["usage"] = parsed
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["proxim"]
