[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_proxim"
        config_type = "proxim"
        brand = "proxim"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (existing wireless IF pattern: ifIndex + ifDescr tags only; do not expand ifInErrors/ifOperStatus) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64 位 IF-MIB HC 流量计数器 (ifXTable，无线回传链路高吞吐不易回绕，按 ifIndex 与上表接口行对齐) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- PROXIM-MIB 设备健康标量（PEN 841，deviceMon …841.1.1.3）：顶层 field 带实例 .0 直接 GET，落 measurement snmp，查询用 snmp_ 前缀 ----
    # sysMonitorCPUUsage .3.9.1.0 / sysMonitorRAMUsage .3.9.2.0：DisplayString 百分比文本，下方 starlark 去 % 转 0-100 数值，空串或非数字时丢弃该字段。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.841.1.1.3.9.1.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.841.1.1.3.9.2.0"
        name = "device_memory_usage"
    # currentUnitTemp .3.8.1.0：Integer32 整 ℃，可选；设备无响应时该字段缺省，不伪造。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.841.1.1.3.8.1.0"
        name = "device_temperature_celsius"
        conversion = "int"

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def parse_percent(raw):
    text = str(raw).strip()
    if text.endswith("%"):
        text = text[:-1].strip()
    if text == "" or text == ".":
        return None
    dots = 0
    for i in range(len(text)):
        c = text[i]
        if c == ".":
            dots += 1
            if dots > 1:
                return None
        elif not c.isdigit():
            return None
    return float(text)

def apply(metric):
    for key in ("device_cpu_usage", "device_memory_usage"):
        raw = metric.fields.get(key)
        if raw == None:
            continue
        parsed = parse_percent(raw)
        if parsed == None:
            metric.fields.pop(key)
        else:
            metric.fields[key] = parsed
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["proxim"]
