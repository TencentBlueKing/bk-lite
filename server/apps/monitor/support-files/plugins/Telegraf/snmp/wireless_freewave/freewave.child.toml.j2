[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_freewave"
        config_type = "freewave"
        brand = "freewave"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- FreeWave ZumLink / Plus 电台状态（FREEWAVE-TECHNOLOGIES-MIB，PEN 29956）：fwtPlusModemStatusTable 1.3.6.1.4.1.29956.3.1.1.1，INDEX fwtPlusModemSerial ----
    # table.field 不带 .0；index 标签即电台序列号（fwtPlusModemSerial）。
    # fwtPlusModemTemperature（.7）：电台温度，Integer32 摄氏度。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.29956.3.1.1.1.1.7"
        name = "celsius"
    # fwtPlusModemSupplyVoltage（.4）：供电电压，Integer32，单位 1/100 V。
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.29956.3.1.1.1.1.4"
        name = "volts"
# ---- CPU/内存使用率、风扇、电源状态：该 MIB 不提供，不采集。----

# ---- 温度须为 -60~150 的整数；供电电压 1/100 V → V（÷100），原始值须为 1~10000 的整数（0 视为未测量）。字段无效时整行丢弃。----
[[processors.starlark]]
    namepass = ["device_temperature", "device_voltage"]
    source = '''
def apply(metric):
    if metric.name == "device_temperature":
        value = metric.fields.get("celsius")
        if type(value) != "int" or value < -60 or value > 150:
            return None
        return metric
    value = metric.fields.get("volts")
    if type(value) != "int" or value < 1 or value > 10000:
        return None
    metric.fields["volts"] = value / 100.0
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["freewave"]
