[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_ionodes"
        config_type = "ionodes"
        brand = "ionodes"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ionSystem scalars (PEN 40748). Integer32 CPU%/Mem% and chassis temperature in Celsius.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.40748.2.1.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.40748.2.2.0"
        name = "device_memory_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.40748.2.3.0"
        name = "device_temperature_celsius"
# Drop CPU/Mem outside 0..100, temperature outside -40..125, and common sentinels. No placeholder zeros.
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def is_sentinel(v):
    if v == 65535 or v == 65534 or v == -1 or v == 2147483647 or v == -2147483648 or v == 4294967295:
        return True
    return False

def apply(metric):
    f = metric.fields
    v = f.get("device_cpu_usage")
    if v != None:
        if is_sentinel(v) or v < 0 or v > 100:
            f.pop("device_cpu_usage")
    v = f.get("device_memory_usage")
    if v != None:
        if is_sentinel(v) or v < 0 or v > 100:
            f.pop("device_memory_usage")
    v = f.get("device_temperature_celsius")
    if v != None:
        if is_sentinel(v) or v < -40 or v > 125:
            f.pop("device_temperature_celsius")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["ionodes"]
