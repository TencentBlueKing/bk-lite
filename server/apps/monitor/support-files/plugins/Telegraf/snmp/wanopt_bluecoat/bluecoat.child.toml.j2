[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_bluecoat"
        config_type = "bluecoat"
        brand = "bluecoat"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Identity: BLUECOAT-SG-PROXY-MIB sgProxySoftware/Version/SerialNumber. Gate sysObjectID under 1.3.6.1.4.1.3417.1.1 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3417.2.11.1.2.0"
        name = "proxy_software"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3417.2.11.1.3.0"
        name = "proxy_version"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3417.2.11.1.4.0"
        name = "proxy_serial_number"
        is_tag = true
    # ---- 内存利用率：sgProxyMemoryPressure 标量 Gauge32 Percentage，顶层 field GET 必须带实例 .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3417.2.11.2.3.4.0"
        name = "device_memory_usage"
    # ---- 内存字节：sgProxyMemAvailable 为可用总量（Bytes）；sys+cache 为已用分解；标量 field 带 .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3417.2.11.2.3.1.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3417.2.11.2.3.3.0"
        name = "device_memory_sys_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3417.2.11.2.3.2.0"
        name = "device_memory_cache_usage"
    # ---- CPU：sgProxyCpuCoreBusyPerCent 是表列，table.field 禁止 .0；按 sgProxyCpuCoreIndex 每核一行 ----
    # 可选空闲：sgProxyCpuCoreIdlePerCent。不采已废弃标量 sgProxyCpuBusyPerCent。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3417.2.11.2.4.1.8"
        name = "usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3417.2.11.2.4.1.9"
        name = "idle"
# ---- 不采集已废弃的 sgProxyCpuBusyPerCent / sgProxyCpuIdlePerCent 标量，也不采集 HTTP client/server/median 统计表。----
