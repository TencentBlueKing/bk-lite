[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_etherwan"
        config_type = "etherwan"
        brand = "etherwan"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- EtherWAN 机箱温度（ewnSensorObjects 2736.1.1.15.2，标量，顶层 field 带 .0 → measurement snmp）----
    # ewnSensorTempValue .12.0 为 (度 × 10)，单位由 ewnSensorTempUnit .11.0 决定：celsius(0) / fahrenheit(1)。
    # 下方 starlark ÷10，华氏时换算为摄氏度，写入 device_temperature_celsius；原始字段删除。温度传感器为选配，无传感器机型该标量缺省。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2736.1.1.15.2.12.0"
        name = "temp_value_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2736.1.1.15.2.11.0"
        name = "temp_unit"
    # ---- EtherWAN 双路电源输入状态（ewnPowerSupplyTable，每路一行，列 OID 走表，不带 .0）----
    # ewnPowerSupplyStatus .21.1.1.4：up(0) / down(1)；ewnPowerSupplyName .21.1.1.2（Power1/Power2）作 tag。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2736.1.1.21.1.1.2"
        name = "psuName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2736.1.1.21.1.1.4"
        name = "state"
# ---- 温度换算：(度 × 10) ÷ 10；单位为华氏(1)时换算为摄氏度。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    raw = metric.fields.pop("temp_value_raw", None)
    unit = metric.fields.pop("temp_unit", None)
    if raw != None:
        value = float(raw) / 10.0
        if unit != None and int(unit) == 1:
            value = (value - 32.0) * 5.0 / 9.0
        metric.fields["device_temperature_celsius"] = value
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["etherwan"]
# ---- 电源状态归一：0=up(正常)→1(正常)，1=down(失电/缺省)→2(异常)，其余未知码 default=2。----
# ---- 共享盘 device_psu_state 约定 1=正常,>1=异常。----
[[processors.enum]]
    namepass = ["device_psu"]
    [processors.enum.tagpass]
        brand = ["etherwan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "0" = 1
            "1" = 2
# ---- CPU/内存/风扇：ADVANTECH-EKI 同类工业交换机族外，EtherWAN EX 系列私有 MIB（PEN 2736）无 CPU、无内存、无风扇对象（EX 系列为无风扇导热式被动散热），故 CPU/内存/风扇 N/A 不采。----
