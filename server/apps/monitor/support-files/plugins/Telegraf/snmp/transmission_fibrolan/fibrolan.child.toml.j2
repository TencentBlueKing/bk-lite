[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_fibrolan"
        config_type = "fibrolan"
        brand = "fibrolan"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- FIBROLAN-DEVICE (PEN 4467) CPU: flDeviceCpuUtilization, direct 0-100% ----
    # OID 1.3.6.1.4.1.4467.1000.10.1.120.1.2.<idx>. Index is often 0; walk the column, do not hardcode a non-0 index.
    [[inputs.snmp.table]]
        name = "cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4467.1000.10.1.120.1.2"
        name = "usage_percent"
    # ---- FIBROLAN-DEVICE DRAM: flDeviceMemoryUtilization → memory_usage_percent (direct 0-100%) ----
    [[inputs.snmp.table]]
        name = "memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4467.1000.10.1.120.1.3"
        name = "usage_percent"
    # ---- optional NV memory utilization (FIBROLAN-DEVICE …120.1.4.<idx>); some revisions omit this column ----
    [[inputs.snmp.table]]
        name = "nv_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4467.1000.10.1.120.1.4"
        name = "usage_percent"
# ---- 温度/风扇/电源：FIBROLAN-DEVICE 本轮仅确认 CPU/DRAM/可选 NV 使用率；无私有温度/风扇/电源状态标量 → N/A 不采。----
