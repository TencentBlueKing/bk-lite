[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_ligowave"
        config_type = "ligowave"
        brand = "ligowave"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- LIGO-RADIO3-DRV (PEN 32750) ligoRdo3StatsTable ----
    # 索引 ifIndex + endpoint。只采下列列；缺天线的列由采集端跳过。
    # ligoRdo3RxLastSigLevel0 1.3.6.1.4.1.32750.3.8.1.3.1.1.75 → rx_signal_level_0
    # 可选天线 1/2 信号 …76/77 → rx_signal_level_1 / rx_signal_level_2
    # ligoRdo3RxNoise …1.3.1.1.78 → rx_noise
    # ligoRdo3RxLastSnr0 …1.3.1.1.79 → rx_snr_0
    [[inputs.snmp.table]]
        name = "rx"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.32750.3.8.1.3.1.1.75"
        name = "signal_level_0"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.32750.3.8.1.3.1.1.76"
        name = "signal_level_1"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.32750.3.8.1.3.1.1.77"
        name = "signal_level_2"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.32750.3.8.1.3.1.1.78"
        name = "noise"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.32750.3.8.1.3.1.1.79"
        name = "snr_0"
        conversion = "int"
    # 可选 ligoRdo3TxPower 1.3.6.1.4.1.32750.3.8.1.3.1.1.9 → tx_power
    [[inputs.snmp.table]]
        name = "tx"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.32750.3.8.1.3.1.1.9"
        name = "power"
        conversion = "int"
# ---- CPU/内存/温度/风扇/电源：Radio3 驱动表只确认射频 RSSI/底噪/SNR/可选发射功率。无私有稳定机箱健康标量 → N/A，不臆造 CPU%/内存%。----
