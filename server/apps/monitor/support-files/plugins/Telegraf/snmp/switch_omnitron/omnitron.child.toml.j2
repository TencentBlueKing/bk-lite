[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_omnitron"
        config_type = "omnitron"
        brand = "omnitron"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- OMNITRON-EXT-MIB ostModuleStatusTable (PEN 7342) ----
    # Indexed by ostModuleIndex (CCSS = chassis 1-99 + slot 1-99). Walk every
    # module row; do not collapse the table into a fabricated chassis scalar.
    # ostSnmpCpuUtilization is Unsigned32 milli-percent (1 = 0.001 percent,
    # range 0-100000). conversion float(3) divides by 10^3 so the stored field
    # is cpu usage percent (0-100).
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.7.1.3.2.1.5"
        name = "usage"
        conversion = "float(3)"
    # ostSnmpRamUsed is kbytes where 1 indicates 1000 bytes (not KiB/1024).
    # Stored as device_memory_used; the metric query multiplies by 1000 to bytes.
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.7.1.3.2.1.6"
        name = "used"
        conversion = "int"
    # ostSnmpFlashUsed is optional on some modules; same kbytes unit
    # (1 = 1000 bytes). Metric query multiplies by 1000 to bytes.
    [[inputs.snmp.table]]
        name = "device_flash"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.7.1.3.2.1.7"
        name = "used"
        conversion = "int"
