[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_omnitron"
        config_type = "omnitron"
        brand = "omnitron"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- OMNITRON-EXT-MIB ostModuleStatusTable (PEN 7342) ----
    # Indexed by ostModuleIndex (CCSS = chassis 1-99 + slot 1-99). Walk every
    # module row; do not collapse the table into a fabricated chassis scalar.
    # ostSnmpCpuUtilization is Unsigned32 milli-percent (1 = 0.001 percent,
    # range 0-100000). conversion float(3) divides by 10^3 so the stored field
    # is cpu usage percent (0-100).
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.7.1.3.2.1.5"
        name = "usage"
        conversion = "float(3)"
    # ostSnmpRamUsed is kbytes where 1 indicates 1000 bytes (not KiB/1024).
    # Stored as device_memory_used; the metric query multiplies by 1000 to bytes.
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.7.1.3.2.1.6"
        name = "used"
        conversion = "int"
    # ostSnmpFlashUsed is optional on some modules; same kbytes unit
    # (1 = 1000 bytes). Metric query multiplies by 1000 to bytes.
    [[inputs.snmp.table]]
        name = "device_flash"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.7.1.3.2.1.7"
        name = "used"
        conversion = "int"
    # ---- OMNITRON-MIB 模块环境状态（PEN 7342，prodAgent = 1.3.6.1.4.1.7342.2）----
    # ostEnvironmentalStatusTable 1.3.6.1.4.1.7342.2.1.11，行索引 modchassnum.modslotnum，table.field 不带 .0：
    #   Ps1Status .1.1 / Ps2Status .1.5、Fan1/2/3Status .1.10/.1.12/.1.14：notApplicable(0) / notInstalled(1) / installedNotPowered(2) / installedPowered(3)；
    #   Temperature .1.9：模块内部环境温度 ℃，0 表示 0 ℃ 或模块不支持；Fan1/2/3Speed .1.11/.1.13/.1.15：RPM。
    # moduleMgtCfgTable 1.3.6.1.4.1.7342.2.1.3 的 cpuTemperature .1.38（CPU 环境温度 ℃）同索引，合并到同一行。
    # 下方 starlark 拆成 device_psu / device_fan / device_temperature 标准指标。
    [[inputs.snmp.table]]
        name = "device_env"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.11.1.1"
        name = "ps1_status"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.11.1.5"
        name = "ps2_status"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.11.1.9"
        name = "module_temp"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.11.1.10"
        name = "fan1_status"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.11.1.11"
        name = "fan1_speed"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.11.1.12"
        name = "fan2_status"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.11.1.13"
        name = "fan2_speed"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.11.1.14"
        name = "fan3_status"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.11.1.15"
        name = "fan3_speed"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7342.2.1.3.1.38"
        name = "cpu_temp"
        conversion = "int"

# ---- 环境状态归一：installedPowered(3)→1(正常)，installedNotPowered(2)→2(异常)，notApplicable(0)/notInstalled(1) 不上报；
#      风扇转速只在风扇已安装时上报；温度 0 视为不支持，丢弃。----
[[processors.starlark]]
    namepass = ["device_env"]
    source = '''
def child(metric, name, tag, tag_value, field, value):
    m = Metric(name)
    for k, v in metric.tags.items():
        m.tags[k] = v
    m.tags[tag] = tag_value
    m.fields[field] = value
    m.time = metric.time
    return m

def state_of(raw):
    if raw == None:
        return None
    value = int(raw)
    if value == 3:
        return 1
    if value == 2:
        return 2
    return None

def apply(metric):
    out = []
    for i in range(1, 3):
        state = state_of(metric.fields.get("ps%d_status" % i))
        if state != None:
            out.append(child(metric, "device_psu", "psu", "ps%d" % i, "state", state))
    for i in range(1, 4):
        state = state_of(metric.fields.get("fan%d_status" % i))
        if state != None:
            fan = child(metric, "device_fan", "fan", "fan%d" % i, "state", state)
            speed = metric.fields.get("fan%d_speed" % i)
            if speed != None:
                fan.fields["speed"] = int(speed)
            out.append(fan)
    for key, sensor in [("module_temp", "module"), ("cpu_temp", "cpu")]:
        raw = metric.fields.get(key)
        if raw != None and int(raw) != 0:
            out.append(child(metric, "device_temperature", "sensor", sensor, "celsius", int(raw)))
    return out
'''
    [processors.starlark.tagpass]
        brand = ["omnitron"]
