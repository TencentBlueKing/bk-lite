[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_engenius"
        config_type = "engenius"
        brand = "engenius"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB ifTable, 用于自动展开 ifDescr/ifOperStatus 等接口属性列) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64 位 IF-MIB HC 流量计数器 (ifXTable，无线 AP 上联高吞吐不易回绕，按 ifIndex 与上表接口行对齐) ----
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- 可选库存标签：firmware_version / device_name（非健康必做；无响应则缺省）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14125.9.1.1.1.0"
        name = "firmware_version"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14125.9.1.1.4.0"
        name = "device_name"
        is_tag = true
    # ---- CPU：cpu_loading 标量，DisplayString 百分比文本，解析为 device_cpu_usage ----
    # OID 1.3.6.1.4.1.14125.9.1.1.9.0。starlark 去掉 % 后转为 0-100 数值。
    # 空串 / 非数字 / 解析失败跳过该点，不当 0%。设备无该叶时字段缺省，不报错、不伪造。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source", "firmware_version", "device_name"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.14125.9.1.1.9"
        name = "usage"
    # ---- 内存：mem_usage 标量，DisplayString 百分比文本，解析为 device_memory_usage ----
    # OID 1.3.6.1.4.1.14125.9.1.1.10.0。过滤口径与 CPU 相同。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source", "firmware_version", "device_name"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.14125.9.1.1.10"
        name = "usage"
    # ---- 温度/风扇：无私有 Gauge，不臆造。关联客户端表逐行计数与信道利用率不采。----
    # 不扩展 ifHC* / ifOperStatus；接口仍仅 ifIndex/ifDescr + ifHCInOctets/ifHCOutOctets。

[[processors.starlark]]
    namepass = ["device_cpu", "device_memory"]
    source = '''
def parse_percent(raw):
    if raw == None:
        return None
    t = type(raw)
    if t == "int":
        return float(raw)
    if t == "float":
        return raw
    text = str(raw).strip()
    if text.endswith("%"):
        text = text[:-1].strip()
    if text == "":
        return None
    i = 0
    if text[0] == "+" or text[0] == "-":
        i = 1
    if i >= len(text):
        return None
    dots = 0
    digits = 0
    while i < len(text):
        c = text[i]
        if c >= "0" and c <= "9":
            digits += 1
        elif c == ".":
            dots += 1
            if dots > 1:
                return None
        else:
            return None
        i += 1
    if digits == 0:
        return None
    return float(text)

def apply(metric):
    parsed = parse_percent(metric.fields.get("usage"))
    if parsed == None:
        return None
    metric.fields["usage"] = parsed
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["engenius"]
