[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_engenius"
        config_type = "engenius"
        brand = "engenius"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB ifTable, 用于自动展开 ifDescr/ifOperStatus 等接口属性列) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64 位 IF-MIB HC 流量计数器 (ifXTable，无线 AP 上联高吞吐不易回绕，按 ifIndex 与上表接口行对齐) ----
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- 可选库存标签：firmware_version / device_name（非健康必做；无响应则缺省）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14125.9.1.1.1.0"
        name = "firmware_version"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14125.9.1.1.4.0"
        name = "device_name"
        is_tag = true
    # ---- CPU / 内存：cpu_loading / mem_usage 均为标量，顶层 field 带实例 .0 直接 GET，落 measurement snmp，查询用 snmp_ 前缀 ----
    # cpu_loading 1.3.6.1.4.1.14125.9.1.1.9.0 → device_cpu_usage；mem_usage 1.3.6.1.4.1.14125.9.1.1.10.0 → device_memory_usage。
    # 两者都是 DisplayString 百分比文本（如 "12%"），下方 starlark 去掉 % 后转为 0-100 数值。
    # 空串 / 非数字 / 解析失败时只丢弃该字段，不当 0%。设备无该叶时字段缺省，不报错、不伪造。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14125.9.1.1.9.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14125.9.1.1.10.0"
        name = "device_memory_usage"
    # ---- 温度/风扇：无私有 Gauge，不臆造。关联客户端表逐行计数与信道利用率不采。----
    # 不扩展 ifHC* / ifOperStatus；接口仍仅 ifIndex/ifDescr + ifHCInOctets/ifHCOutOctets。

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def parse_percent(raw):
    if raw == None:
        return None
    t = type(raw)
    if t == "int":
        return float(raw)
    if t == "float":
        return raw
    text = str(raw).strip()
    if text.endswith("%"):
        text = text[:-1].strip()
    if text == "":
        return None
    body = text
    if body[0] == "+" or body[0] == "-":
        body = body[1:]
    dots = 0
    digits = 0
    for c in body.elems():
        if c >= "0" and c <= "9":
            digits += 1
        elif c == ".":
            dots += 1
        else:
            return None
    if digits == 0 or dots > 1:
        return None
    return float(text)

def apply(metric):
    for key in ["device_cpu_usage", "device_memory_usage"]:
        if key not in metric.fields:
            continue
        parsed = parse_percent(metric.fields[key])
        if parsed == None:
            metric.fields.pop(key)
        else:
            metric.fields[key] = parsed
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["engenius"]
