[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_pbi"
        config_type = "pbi"
        brand = "pbi"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- 机箱温度 chestTemp：PBI-MGSYSTEM-MIB mgSystem.basicInfo.29，标量 INTEGER，单位 ℃ ----
    # 顶层 field GET 必须带实例 .0；禁止 table.field。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1070.3.1.1.29.0"
        name = "device_temperature_celsius"
# ---- CPU/内存/风扇/电源：PBI-MGSYSTEM-MIB 无机箱 CPU、内存、风扇与电源 Gauge，仅有 DisplayString trap 表，不采集。----

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    f = metric.fields
    t = f.get("device_temperature_celsius")
    if t != None:
        if t < -40 or t > 125:
            f.pop("device_temperature_celsius")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["pbi"]
