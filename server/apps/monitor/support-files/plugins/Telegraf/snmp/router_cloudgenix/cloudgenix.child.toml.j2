        name = "voltage_volts"
# ---- CgxEnvStatus：up(1)→1，其余已定义取值→2；未定义取值丢弃该状态字段。转速 0..100000；温度原值 -40000..125000 后 ÷1000；电压原值 1..100000 后 ÷1000。----
[[processors.starlark]]
    namepass = ["device_fan", "cloudgenix_fan", "device_psu", "device_temperature", "cloudgenix_temperature", "cloudgenix_power"]
    source = '''
def map_env_status(value):
    if value == None:
        return None
    code = int(value)
    if code == 1:
        return 1
    if code == 2 or code == 3 or code == 4 or code == 6:
        return 2
    return None

def apply_status(f):
    mapped = map_env_status(f.get("state"))
    if mapped == None:
        if f.get("state") != None:
            f.pop("state")
    else:
        f["state"] = mapped

def apply(metric):
    f = metric.fields
    name = metric.name
    if name == "device_fan" or name == "device_psu" or name == "cloudgenix_temperature" or name == "cloudgenix_power":
        apply_status(f)
    if name == "cloudgenix_fan":
        speed = f.get("speed_rpm")
        if speed != None:
            speed = int(speed)
            if speed < 0 or speed > 100000:
                f.pop("speed_rpm")
    if name == "device_temperature":
        raw = f.get("celsius")
        if raw != None:
            raw = int(raw)
            if raw < -40000 or raw > 125000:
                f.pop("celsius")
            else:
                f["celsius"] = float(raw) / 1000.0
    if name == "cloudgenix_power":
        raw = f.get("voltage_volts")
        if raw != None:
            raw = int(raw)
            if raw < 0 or raw > 100000:
                f.pop("voltage_volts")
            else:
                f["voltage_volts"] = float(raw) / 1000.0
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["cloudgenix"]
