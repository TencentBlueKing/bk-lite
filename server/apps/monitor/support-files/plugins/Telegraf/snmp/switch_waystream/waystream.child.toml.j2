[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_waystream"
        config_type = "waystream"
        brand = "waystream"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU（PEN 9303 wsSystem）：优先 wsCPUIdleLoad，使用率 = 100−idle；
    # 回退 wsCPUUserLoad + wsCPUSystemLoad。标量放入 device_cpu 表。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.1.20"
        name = "idle"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.1.16"
        name = "user"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.1.18"
        name = "system"
    # ---- 内存（PEN 9303 wsSystem）：wsMemoryUsed + wsMemoryTotal，单位 KB，查询侧 ×1024 为字节；
    # 回退 wsMemoryPctFree（十分之一百分比，查询侧 ÷10 后 100−空闲率）。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.1.12"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.1.10"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.1.15"
        name = "pct_free"
    # ---- 可选温度表 wsTempMeasured：百分之一摄氏度，查询侧 ÷100。机型无该表时自然无点。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.2.1.1.2"
        name = "celsius"
# ---- 风扇/电源：本轮不采。----
