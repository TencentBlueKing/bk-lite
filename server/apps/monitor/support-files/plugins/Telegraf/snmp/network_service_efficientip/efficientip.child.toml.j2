[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_efficientip"
        config_type = "efficientip"
        brand = "efficientip"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"

    # ---- EfficientIP 硬件标量 (PEN 2440 / eipHw*) ----
    # eipHwCpuLoadInt：每核 load average * 100 的整数，字段 cpu_load。
    [[inputs.snmp.table]]
        name = "cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2440.1.14.8.1.0"
        name = "load"

    # eipHwMemUsed：已用物理内存百分比，字段 memory_used。
    [[inputs.snmp.table]]
        name = "memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2440.1.14.9.1.0"
        name = "used"

    # eipHwTempCpu：CPU 温度（摄氏度）。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2440.1.14.3.1.0"
        name = "celsius"

    # eipHwPsu1Status：电源 1 状态。0=无电源, 1=AC 已接(正常), 2=在位未接电, 3=不在位。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2440.1.14.5.2.0"
        name = "state"

    # ---- EfficientIP 服务标量 (PEN 2440 / eipSvc*) ----
    # 状态枚举：0=disabled, 1=running, 2=misconfigured, 3=failed。仅 1 视为正常。
    [[inputs.snmp.table]]
        name = "network_service_dns_service"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2440.1.16.8.1.0"
        name = "state"

    [[inputs.snmp.table]]
        name = "network_service_dns"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2440.1.16.8.2.0"
        name = "cpu"

    [[inputs.snmp.table]]
        name = "network_service_dhcp_service"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2440.1.16.6.1.0"
        name = "state"

    [[inputs.snmp.table]]
        name = "network_service_dhcp"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2440.1.16.6.2.0"
        name = "cpu"

    [[inputs.snmp.table]]
        name = "network_service_database"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2440.1.16.5.2.0"
        name = "cpu"

# ---- 状态归一：1=running/ok → 1(正常)，其余含未知码 default=2(异常)。----
[[processors.enum]]
    namepass = [
        "device_psu",
        "network_service_dns_service",
        "network_service_dhcp_service"
    ]
    [[processors.enum.mapping]]
        field = "state"
        dest = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            1 = 1
