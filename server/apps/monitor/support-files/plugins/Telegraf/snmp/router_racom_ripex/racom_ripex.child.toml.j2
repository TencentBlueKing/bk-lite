[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_racom_ripex"
        config_type = "racom_ripex"
        brand = "racom_ripex"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- RACOM RipEX2 / M!DGE3 机箱状态（RACOM-RA2-MIB，PEN 33555，chassisStation 1.3.6.1.4.1.33555.3.1.4）----
    # 四个对象均为 DecimalNumber（DISPLAY-HINT d-1），原始值 ÷10 得摄氏度 / 伏；标量顶层 field 带 .0，落 measurement snmp，查询用 snmp_ 前缀。
    # radioTemperature：射频板温度；无主射频的 M!DGE3（纯蜂窝）上该对象可能不存在，GET 失败即无点。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.33555.3.1.4.1.0"
        name = "radio_temperature_raw"
    # modemTemperature：Modem 板温度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.33555.3.1.4.2.0"
        name = "modem_temperature_raw"
    # cpuTemperature：CPU 温度，作为设备温度 device_temperature_celsius。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.33555.3.1.4.3.0"
        name = "cpu_temperature_raw"
    # inputVoltage：电源输入电压。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.33555.3.1.4.4.0"
        name = "input_voltage_raw"
# ---- CPU/内存使用率、风扇、电源状态：RA2 MIB 不提供，不采集。RAy3 微波（33555.4 子树）由 transmission_racom 采集，不在本插件内。----

# ---- ÷10 换算：温度原始值须为 -500~1500 的整数（-50~150 ℃），电压原始值须为 1~1000 的整数（0.1~100 V，0 视为未测量）；无效值丢弃，原始字段不落库。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
FIELDS = [
    ("radio_temperature_raw", "radio_temperature_celsius", -500, 1500),
    ("modem_temperature_raw", "modem_temperature_celsius", -500, 1500),
    ("cpu_temperature_raw", "device_temperature_celsius", -500, 1500),
    ("input_voltage_raw", "device_voltage_volts", 1, 1000),
]

def apply(metric):
    for src, dst, low, high in FIELDS:
        value = metric.fields.pop(src, None)
        if type(value) == "int" and value >= low and value <= high:
            metric.fields[dst] = value / 10.0
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["racom_ripex"]
