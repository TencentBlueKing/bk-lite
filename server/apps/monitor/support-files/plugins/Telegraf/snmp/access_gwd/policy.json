{
  "object": "Access",
  "plugin": "Access GWD SNMP",
  "templates": [
    {
      "name": "GWD板卡CPU使用率过高",
      "alert_name": "接入设备${resource_name} 板卡 ${metric__board} CPU使用率过高",
      "description": "监控 GWD EPON 各板卡 CPU 使用率，持续高于阈值时提示控制面或管理面负载过高。",
      "metric_name": "device_board_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 95,
          "method": ">"
        },
        {
          "level": "error",
          "value": 90,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 80,
          "method": ">"
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "GWD板卡内存使用率过高",
      "alert_name": "接入设备${resource_name} 板卡 ${metric__board} 内存使用率过高",
      "description": "监控 GWD EPON 各板卡内存使用率，持续高于阈值时提示内存资源紧张或进程异常。",
      "metric_name": "device_board_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 95,
          "method": ">"
        },
        {
          "level": "error",
          "value": 90,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 80,
          "method": ">"
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "GWD板卡温度过高",
      "alert_name": "接入设备${resource_name} 板卡 ${metric__board} 温度过高",
      "description": "监控 GWD EPON 各板卡温度，持续高于阈值时提示散热异常或环境温度过高。",
      "metric_name": "device_board_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 85,
          "method": ">"
        },
        {
          "level": "error",
          "value": 75,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 65,
          "method": ">"
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "GWD设备温度过高",
      "alert_name": "接入设备${resource_name} 设备 ${metric__index} 温度过高",
      "description": "监控 GWD EPON 设备温度，持续高于阈值时提示机箱散热异常或环境温度过高。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 80,
          "method": ">"
        },
        {
          "level": "error",
          "value": 70,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 60,
          "method": ">"
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "GWD电源异常",
      "alert_name": "接入设备${resource_name} 电源 ${metric__index} 异常",
      "description": "监控 GWD EPON 电源运行状态，电源断电时触发告警，提示供电故障或冗余缺失。",
      "metric_name": "device_psu_state",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 2,
          "method": "="
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "GWD风扇异常",
      "alert_name": "接入设备${resource_name} 风扇 ${metric__index} 异常",
      "description": "监控 GWD EPON 风扇告警状态，风扇告警时触发，提示散热能力下降。",
      "metric_name": "device_fan_state",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 2,
          "method": "="
        }
      ],
      "group_algorithm": "max"
    }
  ]
}
