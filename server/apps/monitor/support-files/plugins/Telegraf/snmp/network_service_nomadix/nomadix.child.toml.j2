[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_nomadix"
        config_type = "nomadix"
        brand = "nomadix"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # Current online subscribers (aaaSubCurrTable). Do not walk the
    # authorization config table 1.3.6.1.4.1.3309.1.3.2.18.2.
    # Row count is aggregated as active_subscribers; subIndex/subMac tag the raw series.
    [[inputs.snmp.table]]
        oid = "1.3.6.1.4.1.3309.1.3.2.18.1"
        name = "active"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3309.1.3.2.18.1.1.1"
        name = "subIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3309.1.3.2.18.1.1.2"
        name = "subMac"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3309.1.3.2.18.1.1.1"
        name = "subscribers"
    # Optional current DAT sessions (datSessionTable). First column is the session index.
    [[inputs.snmp.table]]
        oid = "1.3.6.1.4.1.3309.1.3.8.1"
        name = "active_dat"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3309.1.3.8.1.1.1"
        name = "sessions"
# ---- CPU/内存/温度：私有 MIB 无稳定整机标量 → 不臆造，不采。AAA/计费配置表不当成健康指标。----
