[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_adtran"
        config_type = "adtran"
        brand = "adtran"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- ADTRAN-AOSCPU 标量（adGenAOSCpuUtil 1.3.6.1.4.1.664.5.53.1.4，PEN 664）----
    # 顶层 field GET 必须带实例 .0；禁止 table.field（标量 GET-NEXT 会走到空子树，指标静默为空）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.664.5.53.1.4.1.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.664.5.53.1.4.3.0"
        name = "device_cpu_usage_1min"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.664.5.53.1.4.4.0"
        name = "device_cpu_usage_5min"
    # 内存：MemPool 总量 + HeapFree 空闲（必须 …1.4.8.0）。HeapSize …1.4.7.0 只作为 heap_size，不得当作 free。
    # 用量在查询侧按 (total-free)/total 推导。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.664.5.53.1.4.6.0"
        name = "device_memory_total"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.664.5.53.1.4.8.0"
        name = "device_memory_free"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.664.5.53.1.4.7.0"
        name = "device_memory_heap_size"
        conversion = "int"
# ---- 温度/风扇/电源：ADTRAN-AOSCPU 未暴露温度/风扇/电源标量 → N/A。----
