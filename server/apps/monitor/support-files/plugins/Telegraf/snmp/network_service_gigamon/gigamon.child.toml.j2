[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_gigamon"
        config_type = "gigamon"
        brand = "gigamon"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Gigamon GigaVUE CPU：GIGAMON-SNMP-MIB cpuUtilization 1.3.6.1.4.1.26866.2.13.0（OCTET STRING，标量，顶层 field 带 .0）----
    # 值为文本：含 % 时取最后一个 % 前紧挨着的数值；不含 % 时只接受整段为纯数字；0~100 时输出 device_cpu_usage，否则丢弃。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.26866.2.13.0"
        name = "cpu_utilization_raw"
        conversion = ""
# ---- 内存：GIGAMON-SNMP-MIB 没有内存使用率对象（cpuRAMSize 只是容量文本），不采集。----
# ---- 温度/风扇/电源：fans / temperatureSensors / powerSupply 为整段描述文本，不是可直接使用的数值，不采集。----

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def _is_number(text):
    if text == "" or text == ".":
        return False
    dots = 0
    for ch in text.elems():
        if ch == ".":
            dots += 1
        elif not ch.isdigit():
            return False
    return dots <= 1

def _parse_cpu(text):
    text = text.strip()
    pos = text.rfind("%")
    if pos < 0:
        if _is_number(text):
            return float(text)
        return None
    head = text[:pos].rstrip()
    start = len(head)
    for i in range(len(head)):
        ch = head[len(head) - 1 - i]
        if ch.isdigit() or ch == ".":
            start = len(head) - 1 - i
        else:
            break
    value = head[start:]
    if not _is_number(value):
        return None
    return float(value)

def apply(metric):
    raw = metric.fields.pop("cpu_utilization_raw", None)
    if raw == None:
        return metric
    if type(raw) in ["int", "float"]:
        value = float(raw)
    else:
        value = _parse_cpu(str(raw))
    if value != None and value >= 0 and value <= 100:
        metric.fields["device_cpu_usage"] = value
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["gigamon"]
