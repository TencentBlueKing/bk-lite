[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_cisco_nexus"
        config_type = "cisco_nexus"
        brand = "cisco_nexus"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.9.9.305.1.1.1.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.9.9.305.1.1.2.0"
        name = "device_memory_usage"
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.117.1.1.2.1.2"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "ent_class"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "psu_name"
        is_tag = true
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.117.1.4.1.1.1"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "fan_name"
        is_tag = true

[[processors.starlark]]
    namepass = ["snmp", "device_psu", "device_fan"]
    source = '''
def apply(metric):
    name = metric.name
    f = metric.fields
    if name == "snmp":
        for key in ["device_cpu_usage", "device_memory_usage"]:
            v = f.get(key)
            if v == None:
                continue
            if v < 0 or v > 100:
                f.pop(key)
                continue
            if v == 65535 or v == 65534 or v == -1:
                f.pop(key)
                continue
            if v == 2147483647 or v == -2147483648 or v == 4294967295:
                f.pop(key)
        if len(f.keys()) == 0:
            return None
        return metric
    if name == "device_psu":
        cls = f.pop("ent_class", None)
        st = f.get("state")
        if st == None:
            return None
        if cls != 6 and cls != "6":
            return None
        mapped = None
        if st == 2 or st == "2":
            mapped = 1
        if st == 1 or st == 3 or st == 4 or st == 5 or st == 6 or st == 7 or st == 8 or st == 9 or st == 10 or st == 11 or st == 12:
            mapped = 2
        if st == "1" or st == "3" or st == "4" or st == "5" or st == "6" or st == "7" or st == "8" or st == "9" or st == "10" or st == "11" or st == "12":
            mapped = 2
        if mapped == None:
            return None
        f["state"] = mapped
        return metric
    if name == "device_fan":
        st = f.get("state")
        if st == None:
            return None
        mapped = None
        if st == 2 or st == "2":
            mapped = 1
        if st == 1 or st == 3 or st == 4 or st == "1" or st == "3" or st == "4":
            mapped = 2
        if mapped == None:
            return None
        f["state"] = mapped
        return metric
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["cisco_nexus"]
