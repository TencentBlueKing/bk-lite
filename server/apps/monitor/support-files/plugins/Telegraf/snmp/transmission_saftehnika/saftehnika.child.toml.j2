[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_saftehnika"
        config_type = "saftehnika"
        brand = "saftehnika"
        product_branch = "{{ product_branch | default('integra-b', true) }}"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    {% set _branch = product_branch | default('integra-b', true) %}
    {% if _branch == 'integra-w' %}
    {% set _sys = '1.3.6.1.4.1.7571.100.1.1.7.2' %}
    {% else %}
    {% set _sys = '1.3.6.1.4.1.7571.100.1.1.7.1' %}
    {% endif %}
    # Integra-B 系统树 7.1 / Integra-W 系统树 7.2：下发时按 product_branch 二选一，禁止混采。
    # CPU 空闲 ×10% → cpu_usage_percent = 100 - idle/10
    [[inputs.snmp.table]]
        name = "cpu_usage"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "{{ _sys }}.4.10"
        name = "idle"
        conversion = "int"
    # 空闲内存 ×10% → memory_usage_percent = 100 - free/10
    [[inputs.snmp.table]]
        name = "memory_usage"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "{{ _sys }}.4.9"
        name = "free"
        conversion = "int"
    # CPU 温度 ×10 °C，查询侧 /10 → cpu_temperature_celsius
    [[inputs.snmp.table]]
        name = "cpu_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "{{ _sys }}.4.2"
        name = "celsius"
        conversion = "int"
# ---- 风扇/电源：无稳定可轮询共享健康对象，N/A 不采。----
