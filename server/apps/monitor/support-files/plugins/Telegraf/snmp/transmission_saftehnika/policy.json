{
  "object": "Transmission",
  "plugin": "Transmission SAF Tehnika SNMP",
  "templates": [
    {
      "name": "SAF Tehnika传输设备CPU使用率过高",
      "alert_name": "传输设备${resource_name} CPU 使用率过高",
      "description": "监控 SAF Tehnika Integra 传输设备的 CPU 使用率（100 减去空闲×10% 读数）。持续高于阈值时提示微波回传业务压力、控制平面负载或异常流量。",
      "metric_name": "cpu_usage_percent",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "SAF Tehnika传输设备内存使用率过高",
      "alert_name": "传输设备${resource_name} 内存使用率过高",
      "description": "监控 SAF Tehnika Integra 传输设备的内存使用率（100 减去空闲×10% 读数）。持续高于阈值时提示控制面资源紧张或服务异常。",
      "metric_name": "memory_usage_percent",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 95,
          "method": ">"
        },
        {
          "level": "error",
          "value": 90,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 80,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "SAF Tehnika传输设备CPU温度过高",
      "alert_name": "传输设备${resource_name} CPU 温度过高",
      "description": "监控 SAF Tehnika Integra 传输设备的 CPU 温度（×10 °C 读数经 /10 转为摄氏度）。持续高于阈值时提示散热异常、环境温度过高或设备过载。",
      "metric_name": "cpu_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 85,
          "method": ">"
        },
        {
          "level": "error",
          "value": 75,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 65,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
