[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_redline"
        config_type = "redline"
        brand = "redline"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- AN80i (PEN 10728) 射频链路 ----
    # Prefer scalar an80iIfAvrSinAdr 1.3.6.1.4.1.10728.2.10.2.1.2.12.0 → sinadr
    # Integer32，不换算。PTP 平均 SINADR 标量；禁止改绑 PMP 表列 an80iIfPmpLinkDLSinAdr（.2.2.3.1.8）。
    [[inputs.snmp.table]]
        name = "sinadr"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10728.2.10.2.1.2.12.0"
        name = "sinadr"
        conversion = "int"
    # PMP an80iIfPmpLinkDLRssi 1.3.6.1.4.1.10728.2.10.2.2.3.1.7.<linkId> → dl_rssi
    # 先走 an80iIfPmpLinkId（.2.2.2.1.1）发现 linkId，再取 DL RSSI。禁止绑定 PTP RSSI 标量或 PMP 父表。
    [[inputs.snmp.table]]
        name = "dl"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10728.2.10.2.2.2.1.1"
        name = "linkId"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10728.2.10.2.2.3.1.7"
        name = "rssi"
        conversion = "int"
    # 可选 an80iIfPmpLinkULRssi 1.3.6.1.4.1.10728.2.10.2.2.3.1.14.<linkId> → ul_rssi
    # 同样先走 linkId。部分 PMP 行或缺省固件可能无此列。
    [[inputs.snmp.table]]
        name = "ul"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10728.2.10.2.2.2.1.1"
        name = "linkId"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.10728.2.10.2.2.3.1.14"
        name = "rssi"
        conversion = "int"
# ---- CPU/内存/温度/风扇/电源：AN80i 无私有稳定共享健康标量 → N/A，不臆造 CPU%/内存%。----
