[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_forcepoint"
        config_type = "forcepoint"
        brand = "forcepoint"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Forcepoint NGFW CPU (STONESOFT-FIREWALL-MIB fwCpuTotal, 每核%, PEN 1369；按列 walk,avg) ----
    # 待现网核验：1.3.6.1.4.1.1369.5.2.1.11.1.1.3（每核 CPU%，forcepoint-ngfw-330.snmprec 实测 20/17/23）。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1369.5.2.1.11.1.1.3"
        name = "usage"
    # ---- Forcepoint 内存 (fwMemBytesTotal/fwMemBytesUsed, bytes；用量=used/total,盘自适应) ----
    # 待现网核验：fwMemBytesTotal .1369.5.2.1.11.2.4.0 / fwMemBytesUsed .2.6.0（字节，snmprec total=4001021952 used=411578368）。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1369.5.2.1.11.2.4"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1369.5.2.1.11.2.6"
        name = "used"
    # ---- 会话：FORCEPOINT-NGFW-ENGINE-MIB fwConnNumber，标量 GET 必须带 .0 ----
    # fwConnNumber 1.3.6.1.4.1.47565.1.1.1.4.0 → firewall_active_sessions
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.47565.1.1.1.4.0"
        name = "firewall_active_sessions"
    # ---- 温度：fwHwTempSensorTable，表列禁止 .0 ----
    # fwHwTemperatureName …1.16.1.2（tag）/ fwHwTemperature …1.16.1.3（°C）
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47565.1.1.1.16.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47565.1.1.1.16.1.3"
        name = "celsius"
    # ---- 电源：fwPsuTable，表列禁止 .0 ----
    # fwPsuName …1.17.1.2（tag）/ fwPsuStatus …1.17.1.3（FwHwComponentStatus）
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47565.1.1.1.17.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47565.1.1.1.17.1.3"
        name = "state"
    # ---- 风扇：fwFanTable，表列禁止 .0 ----
    # fwFanName …1.18.1.2（tag）/ fwFan …1.18.1.3（RPM）/ fwFanStatus …1.18.1.4（FwHwComponentStatus）
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47565.1.1.1.18.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47565.1.1.1.18.1.3"
        name = "rpm"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.47565.1.1.1.18.1.4"
        name = "state"
# ---- FwHwComponentStatus 归一：ok(0)→1(正常)，notPresent(-1)/warning(1)/error(2)/fatalError(3)→2(异常)。----
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "0" = 1
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "0" = 1
