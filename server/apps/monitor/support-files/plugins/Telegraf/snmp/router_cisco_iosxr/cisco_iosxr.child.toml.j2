[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_cisco_iosxr"
        config_type = "cisco_iosxr"
        brand = "cisco_iosxr"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：CISCO-PROCESS-MIB cpmCPUTotalTable cpmCPUTotal5minRev，直接百分比，表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.9.9.109.1.1.1.1.8。超出 0..100 丢弃。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.109.1.1.1.1.8"
        name = "usage"
    # ---- 内存：CISCO-ENHANCED-MEMPOOL-MIB cempMemPoolTable，表列禁止 .0 ----
    # 名称 .3 作 tag pool_name；valid .6 仅保留 true(1)。
    # 优先 64 位 hc_used .18 / hc_free .20；二者缺失或都为 0 时回退 used .7 / free .8。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.221.1.1.1.1.3"
        name = "pool_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.221.1.1.1.1.6"
        name = "valid"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.221.1.1.1.1.7"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.221.1.1.1.1.8"
        name = "free"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.221.1.1.1.1.18"
        name = "hc_used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.221.1.1.1.1.20"
        name = "hc_free"
    # ---- 电源：CISCO-ENTITY-FRU-CONTROL-MIB cefcFRUPowerOperStatus + ENTITY-MIB 类别/名称，表列禁止 .0 ----
    # 仅保留 entPhysicalClass=powerSupply(6) 且有状态的行。on(2)→1；offAdmin(3) 及其它未列出值丢弃。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.117.1.1.2.1.2"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "ent_class"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "psu_name"
        is_tag = true
    # ---- 风扇托盘：cefcFanTrayOperStatus + entPhysicalName，表列禁止 .0 ----
    # up(2)→1，down(3)/warning(4)→2，unknown(1) 及其它丢弃。无状态的行丢弃。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.117.1.4.1.1.1"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "fan_name"
        is_tag = true

# ---- CPU 范围过滤；内存 HC 优先并计算使用率；电源/风扇状态归一；辅助字段不落库。----
[[processors.starlark]]
    namepass = ["device_cpu", "device_memory", "device_psu", "device_fan"]
    source = '''
def _num(v):
    if v == None:
        return None
    if type(v) == "int" or type(v) == "float":
        return float(v)
    err = catch(lambda: float(v))
    if err != None:
        return None
    return float(v)

def apply(metric):
    name = metric.name
    f = metric.fields
    if name == "device_cpu":
        usage = _num(f.get("usage"))
        if usage == None or usage < 0 or usage > 100:
            return None
        f["usage"] = usage
        return metric
    if name == "device_memory":
        valid = f.pop("valid", None)
        hc_used = f.pop("hc_used", None)
        hc_free = f.pop("hc_free", None)
        used = f.pop("used", None)
        free = f.pop("free", None)
        if valid != 1 and valid != "1":
            return None
        hcu = _num(hc_used)
        hcf = _num(hc_free)
        if hcu != None and hcf != None and (hcu != 0 or hcf != 0):
            used_n = hcu
            free_n = hcf
        else:
            used_n = _num(used)
            free_n = _num(free)
        if used_n == None or free_n == None:
            return None
        total = used_n + free_n
        if total <= 0:
            return None
        f["used"] = used_n
        f["free"] = free_n
        f["usage"] = float(int(used_n * 10000.0 / total + 0.5)) / 100.0
        return metric
    if name == "device_psu":
        cls = f.pop("ent_class", None)
        if cls != 6 and cls != "6":
            return None
        st = f.get("state")
        if st == 2 or st == "2":
            f["state"] = 1
        elif st == 1 or st == "1" or st == 4 or st == "4" or st == 5 or st == "5" or st == 6 or st == "6" or st == 7 or st == "7" or st == 8 or st == "8" or st == 9 or st == "9" or st == 10 or st == "10" or st == 11 or st == "11" or st == 12 or st == "12":
            f["state"] = 2
        else:
            return None
        return metric
    if name == "device_fan":
        st = f.get("state")
        if st == None:
            return None
        if st == 2 or st == "2":
            f["state"] = 1
        elif st == 3 or st == "3" or st == 4 or st == "4":
            f["state"] = 2
        else:
            return None
        return metric
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["cisco_iosxr"]
