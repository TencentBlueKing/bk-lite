{
  "object": "Wireless",
  "plugin": "Wireless Rajant SNMP",
  "templates": [
    {
      "name": "Rajant BreadCrumb系统温度过高",
      "alert_name": "无线设备${resource_name} 系统温度过高",
      "description": "监控 Rajant BreadCrumb 节点系统温度，持续高于阈值时提示散热不良、日照或环境温度过高。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 85,
          "method": ">"
        },
        {
          "level": "error",
          "value": 75,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 65,
          "method": ">"
        }
      ],
      "group_algorithm": "max"
    }
  ]
}
