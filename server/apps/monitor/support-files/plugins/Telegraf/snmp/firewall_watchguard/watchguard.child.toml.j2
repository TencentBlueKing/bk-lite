[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_watchguard"
        config_type = "watchguard"
        brand = "watchguard"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- WatchGuard CPU (WATCHGUARD-SYSTEM-STATISTICS-MIB wgSystemCpuUtil5, scalar GET) ----
    # sysObjectID 门控：1.3.6.1.4.1.3097.1.4（fbXSeries）或 1.3.6.1.4.1.3097.1.5（xtmSeries / Firebox T/M/V/Cloud）。
    # wgSystemCpuUtil5 1.3.6.1.4.1.3097.6.3.78.0 → device_cpu_usage；原始值为 0.01% 单位，盘侧 /100 得百分比。
    # 同单位备份：wgSystemCpuUtil1 ...77.0、wgSystemCpuUtil15 ...79.0。已弃用且闲置的 wgSystemCpuUtil ...6.3.4 不采。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3097.6.3.78.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3097.6.3.77.0"
        name = "device_cpu_usage_1min"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3097.6.3.79.0"
        name = "device_cpu_usage_15min"
    # ---- WatchGuard active connections (wgSystemCurrActiveConns scalar GET) ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3097.6.3.80.0"
        name = "firewall_active_connections"
    # ---- WatchGuard memory (UCD-SNMP-MIB memTotalReal / memTotalFree, kB；盘侧 *1024 转字节) ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.11.0"
        name = "device_memory_free"
# ---- 温度/风扇/电源：Firebox 无稳定、无需行级过滤的传感器标量 → N/A 不采。VPN 隧道为 per-tunnel 表，本轮不做。----
