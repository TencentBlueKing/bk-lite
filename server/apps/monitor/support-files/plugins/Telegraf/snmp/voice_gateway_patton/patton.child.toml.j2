[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_patton"
        config_type = "patton"
        brand = "patton"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"

    # ---- Patton SmartNode performance tree (SMARTNODE-MIB, performance = 1.3.6.1.4.1.1768.100.70) ----
    # The three tables are indexed by a DisplayString (cpuDescr / memDescr / tempProbeDescr), so the
    # description column is used as the tag instead of the encoded row index. table.field never uses .0.
    # CPU: cpuTable .70.10.2.1, cpuWorkloadCurrent .2 (Gauge32, percent).
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1768.100.70.10.2.1.1"
        name = "cpu"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1768.100.70.10.2.1.2"
        name = "usage"
    # Memory pools: memoryPoolTable .70.20.2.1, memTotalBytes .2 / memAllocatedBytes .3 / memFreeBytes .4 (bytes).
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1768.100.70.20.2.1.1"
        name = "pool"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1768.100.70.20.2.1.2"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1768.100.70.20.2.1.3"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1768.100.70.20.2.1.4"
        name = "free"
    # Temperature probes: tempProbeTable .70.30.2.1, currentDegreesCelsius .2 (Gauge32, degC).
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1768.100.70.30.2.1.1"
        name = "probe"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1768.100.70.30.2.1.2"
        name = "celsius"

# Memory pools: usage = allocated / (allocated + free) * 100; total falls back to allocated + free when absent.
# Rows without allocated/free or with an empty pool (allocated + free = 0) are dropped.
[[processors.starlark]]
    namepass = ["device_memory"]
    source = '''
def apply(metric):
    used = metric.fields.get("used")
    free = metric.fields.get("free")
    if used == None or free == None:
        return None
    used = int(used)
    free = int(free)
    pool = used + free
    if pool <= 0:
        return None
    total = metric.fields.get("total")
    if total == None or int(total) <= 0:
        metric.fields["total"] = pool
    metric.fields["usage"] = used * 100.0 / pool
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["patton"]
