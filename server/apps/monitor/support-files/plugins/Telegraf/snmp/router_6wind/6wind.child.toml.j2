[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_6wind"
        config_type = "6wind"
        brand = "6wind"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU (UCD-SNMP-MIB systemStats 1.3.6.1.4.1.2021.11)：标量，顶层 field 带 .0 → measurement snmp ----
    # ssCpuIdle .11.0 / ssCpuUser .9.0 / ssCpuSystem .10.0（Integer32 %）；starlark 输出 device_cpu_usage = 100−idle，缺 idle 时用 user+system。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.11.0"
        name = "cpu_idle_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.9.0"
        name = "cpu_user_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.10.0"
        name = "cpu_system_raw"
    # ---- Memory (UCD-SNMP-MIB memory 1.3.6.1.4.1.2021.4)：标量，顶层 field 带 .0 → measurement snmp ----
    # memTotalReal .4.5.0 / memAvailReal .4.6.0：Integer32，单位 kB，查询侧 ×1024 转字节；usage=(total−free)/total。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "device_memory_total"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.6.0"
        name = "device_memory_free"
        conversion = "int"
    # ---- Optional HOST-RESOURCES CPU fallback (hrProcessorLoad, per-core %, 1.3.6.1.2.1.25) ----
    [[inputs.snmp.table]]
        name = "device_cpu_hr"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.3.3.1.2"
        name = "usage"
    # ---- Optional HOST-RESOURCES physical-memory fallback (hrStorage RAM rows only) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.25.2.3"
        name = "device_memory_hr"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.2"
        name = "storage_type"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.3"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.4"
        name = "allocation_units"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.5"
        name = "size"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.6"
        name = "used"
        conversion = "int"
# ---- 温度/风扇/电源 N/A 不采。企业号 7336 的 IPsec/License 私有对象不是本轮最小健康集，不采。----

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def valid(v):
    return v != None and type(v) in ["int", "float"] and v >= 0 and v <= 100

def apply(metric):
    idle = metric.fields.pop("cpu_idle_raw", None)
    user = metric.fields.pop("cpu_user_raw", None)
    system = metric.fields.pop("cpu_system_raw", None)
    if valid(idle):
        metric.fields["device_cpu_usage"] = 100 - idle
    elif valid(user) and valid(system) and user + system <= 100:
        metric.fields["device_cpu_usage"] = user + system
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["6wind"]

[[processors.starlark]]
    namepass = ["device_memory_hr"]
    source = '''
def apply(metric):
    storage_type = metric.tags.get("storage_type", "")
    descr = metric.tags.get("descr", "").lower()
    normalized = storage_type.lstrip(".")
    is_ram = normalized == "1.3.6.1.2.1.25.2.1.2" or descr == "physical memory" or descr == "real memory" or descr == "ram"
    if not is_ram:
        return None
    units = metric.fields.get("allocation_units")
    size = metric.fields.get("size")
    used = metric.fields.get("used")
    if units == None or size == None:
        return None
    metric.fields["total"] = size * units
    if used != None:
        metric.fields["used"] = used * units
        metric.fields["free"] = (size - used) * units
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["6wind"]
