[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_audiocodes"
        config_type = "audiocodes"
        brand = "audiocodes"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB ifTable, 用于自动展开 ifDescr/ifOperStatus 等接口属性列) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64 位 IF-MIB HC 流量计数器 (ifXTable，高速无线接口不易回绕，按 ifIndex 与上表接口行对齐) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- AudioCodes 板级状态标量（AC-SYSTEM-MIB acSysState = 1.3.6.1.4.1.5003.9.10.10.2.5）----
    # 顶层 field 带实例 .0（measurement snmp → 查询 snmp_ 前缀）；设备未实现的对象（如无数据面的机型）不产出该字段。
    # acSysStateTemperature .1：板卡温度，摄氏度（0..100）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5003.9.10.10.2.5.1.0"
        name = "device_temperature_celsius"
    # acSysStateVoIpCpuUtilization .10 / acSysStateVoIpMemoryUtilization .11：语音面 CPU / 内存使用率（%），作为主 CPU / 内存指标。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5003.9.10.10.2.5.10.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5003.9.10.10.2.5.11.0"
        name = "device_memory_usage"
    # acSysStateDataCpuUtilization .8 / acSysStateDataMemoryUtilization .9：数据面 CPU / 内存使用率（%）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5003.9.10.10.2.5.8.0"
        name = "device_data_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5003.9.10.10.2.5.9.0"
        name = "device_data_memory_usage"
