[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_cisco"
        config_type = "cisco"
        brand = "cisco"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Cisco CPU utilization (CISCO-PROCESS-MIB cpmCPUTotal5minRev) ----
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.109.1.1.1.1.8"
        name = "usage"
    # ---- Cisco Memory pool (CISCO-MEMORY-POOL-MIB) ----
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.2"
        name = "name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.5"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.6"
        name = "free"
    # ---- Cisco Temperature sensors (CISCO-ENVMON-MIB) ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.13.1.3.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.13.1.3.1.3"
        name = "celsius"
    # ---- Cisco Fans (CISCO-ENVMON-MIB ciscoEnvMonFanState) ----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.13.1.4.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.13.1.4.1.3"
        name = "state"
    # ---- Cisco Power supplies (CISCO-ENVMON-MIB ciscoEnvMonSupplyState) ----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.13.1.5.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.13.1.5.1.3"
        name = "state"
    # ---- 光模块 DDM：CISCO-ENTITY-SENSOR-MIB entSensorValueTable，INDEX=entPhysicalIndex，表列禁止 .0 ----
    # 表 1.3.6.1.4.1.9.9.91.1.1.1。type/scale/precision/value 同表；descr=ENTITY-MIB entPhysicalName。
    # inputs.snmp 不能按 type 过滤，必须把 type 采下来；查询侧只保留 dBm(14)，再按 descr 拆 RX/TX。
    # 换算：value * 10^((scale-9)*3 - precision) → dBm（units=9）。IOS-XE/Catalyst；不扩 IF。
    [[inputs.snmp.table]]
        name = "device_optical"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.91.1.1.1.1.1"
        name = "sensor_type"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.91.1.1.1.1.2"
        name = "scale"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.91.1.1.1.1.3"
        name = "precision"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.91.1.1.1.1.4"
        name = "value"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true

# ---- 光模块：只保留 CISCO-ENTITY-SENSOR dBm(14)，避免把温/压/电流传感器写入 optical 表。----
[[processors.starlark]]
    namepass = ["device_optical"]
    source = '''
def apply(metric):
    if metric.tags.get("sensor_type") != "14":
        return None
    value = metric.fields.get("value")
    if value == None:
        return None
    if value == -1000000000:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["cisco"]
