[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_raisecom_switch"
        config_type = "raisecom_switch"
        brand = "raisecom"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：RAISECOM-SYSTEM-MIB raisecomTotalCPUUtilization oneMin，整实例 GET，禁止再拼 .0 ----
    # 列 OID …8886.1.1.1.3.1.2.1.2，INDEX raisecomTotalCPUPeriod，oneMin(3)。
    # SYNTAX INTEGER (0..10000) UNITS percent；DESCRIPTION 写明为 busy percentage，按百分比直采，不做 /100。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8886.1.1.1.3.1.2.1.2.3"
        name = "device_cpu_usage"
    # ---- 内存：raisecomMemoryTotal / raisecomMemoryAvailable 标量，顶层 field GET 必须带实例 .0 ----
    # UNITS Byte，查询侧不做 *1024；利用率按 (total-free)/total 计算。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8886.1.1.3.2.1.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8886.1.1.3.2.2.0"
        name = "device_memory_free"
    # ---- 机箱温度：raisecomTemperatureValue 标量，顶层 field GET 必须带实例 .0 ----
    # UNITS Celsius，直接摄氏度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8886.1.1.4.2.1.0"
        name = "device_temperature_celsius"
# ---- 风扇/电源：本轮不采（SYSTEM-MIB 无对应机箱风扇/电源健康标量）。----
