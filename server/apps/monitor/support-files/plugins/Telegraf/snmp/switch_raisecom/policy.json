{
  "object": "Switch",
  "plugin": "Switch Raisecom SNMP",
  "templates": [
    {
      "name": "Raisecom交换机CPU使用率过高",
      "alert_name": "交换机${resource_name} CPU 使用率过高",
      "description": "监控 Raisecom ISCOM/Gazelle 交换机一分钟总 CPU 使用率（raisecomTotalCPUUtilization oneMin），当持续高于阈值时触发告警，提示可能存在控制平面过载、转发表震荡或异常流量，避免管理响应变慢或转发受影响。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Raisecom交换机内存使用率过高",
      "alert_name": "交换机${resource_name} 内存使用率过高",
      "description": "监控 Raisecom ISCOM/Gazelle 交换机整体内存使用率（按 (总量-空闲)/总量 计算），当超过阈值时触发告警，便于及时发现内存泄漏、表项过大或容量不足等问题，防止设备不稳定或分配失败。",
      "metric_name": "device_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Raisecom交换机温度过高",
      "alert_name": "交换机${resource_name} 温度过高",
      "description": "监控 Raisecom ISCOM/Gazelle 交换机机箱温度（raisecomTemperatureValue），当超过阈值时触发告警，提示散热故障或环境过热，防止热保护停机。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 70,
          "method": ">"
        },
        {
          "level": "error",
          "value": 60,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 50,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
