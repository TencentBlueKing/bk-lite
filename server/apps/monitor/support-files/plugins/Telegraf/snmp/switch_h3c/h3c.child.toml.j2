[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_h3c"
        config_type = "h3c"
        brand = "h3c"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：HH3C-ENTITY-EXT-MIB hh3cEntityExtCpuUsage，直接百分比，实体表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.6。多数实体行回 0，有效值在承载 CPU 的实体上。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.6"
        name = "usage"
    # 可选 1/5 分钟 CPU：hh3cEntityExtCpuUsageIn1Minute ...1.33 / hh3cEntityExtCpuUsageIn5Minutes ...1.34。
    # 与 instant .6 同表，不改变既有 device_cpu_usage 口径。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.33"
        name = "usage_1min"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.34"
        name = "usage_5min"
    # ---- 内存：HH3C-ENTITY-EXT-MIB hh3cEntityExtMemUsage，直接利用率百分比，实体表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.8。多数实体行回 0，有效值在承载内存的实体上。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.8"
        name = "usage"
    # ---- 温度：HH3C-ENTITY-EXT-MIB hh3cEntityExtTemperature，摄氏度，实体表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.12。不支持温度的实体回填 65535，starlark 丢弃该哨兵。
    # descr 取 ENTITY-MIB entPhysicalName（与温度同行 entPhysicalIndex）。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.12"
        name = "celsius"
    # ---- 可选电压：HH3C-ENTITY-EXT-MIB hh3cEntityExtVoltage，毫伏，实体表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.14。starlark 丢弃 65535；查询侧 /1000 为伏特。
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.14"
        name = "volts"
    # ---- 可选功耗：HH3C-ENTITY-EXT-MIB hh3cEntityExtCurrentPower，瓦特，实体表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.25506.2.6.1.3.1.1.3。这是功耗读数，不是电源健康枚举。
    # 表按 hh3cEntityExtPowerPhysicalIndex 索引（index_as_tag）；电源健康走下方 class=6。
    [[inputs.snmp.table]]
        name = "device_power"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.3.1.1.3"
        name = "watts"
    # ---- 风扇：ENTITY-MIB entPhysicalClass fan(7) + hh3cEntityExtOperStatus ----
    # OperStatus 列 1.3.6.1.4.1.25506.2.6.1.1.1.1.3：1 notSupported / 2 disabled / 3 enabled / 4 dangerous。
    # entPhysicalClass 1.3.6.1.2.1.47.1.1.1.1.5 作 tag；starlark 只保留 class=7。
    # processors.enum：enabled(3)/notSupported(1)→1(正常)，其余→2(异常)。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "entPhysicalClass"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.3"
        name = "state"
    # ---- 电源：ENTITY-MIB entPhysicalClass powerSupply(6) + 同一 OperStatus 列 ----
    # starlark 只保留 class=6；枚举归一同风扇。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "entPhysicalClass"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.3"
        name = "state"

# ---- 温度：丢弃 65535 不支持哨兵，避免 max() / 告警被哨兵污染。----
[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    value = metric.fields.get("celsius")
    if value == None:
        return None
    if value == 65535:
        return None
    return metric
'''
# ---- 电压：同样丢弃 65535 不支持哨兵。----
[[processors.starlark]]
    namepass = ["device_voltage"]
    source = '''
def apply(metric):
    value = metric.fields.get("volts")
    if value == None:
        return None
    if value == 65535:
        return None
    return metric
'''
# ---- 风扇：只保留 ENTITY-MIB entPhysicalClass fan(7)。----
[[processors.starlark]]
    namepass = ["device_fan"]
    source = '''
def apply(metric):
    if metric.tags.get("entPhysicalClass") != "7":
        return None
    return metric
'''
# ---- 电源：只保留 ENTITY-MIB entPhysicalClass powerSupply(6)。----
[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    if metric.tags.get("entPhysicalClass") != "6":
        return None
    return metric
'''
# ---- 风扇状态归一：enabled(3)→1(正常)，notSupported(1) 视为无传感器/不适用→1(正常)，disabled/dangerous 及其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            "3" = 1
# ---- 电源状态归一：同 OperStatus；enabled(3)/notSupported(1)→1(正常)，其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            "3" = 1
