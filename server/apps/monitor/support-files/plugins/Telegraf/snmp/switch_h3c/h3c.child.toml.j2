[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_h3c"
        config_type = "h3c"
        brand = "h3c"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- H3C/HPE Comware CPU (HH3C-ENTITY-EXT-MIB hh3cEntityExtCpuUsage, %, per-entity table, PEN 25506) ----
    # 待现网核验：列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.6（每实体 CPU%；多数实体返0,载 CPU 实体非0,snmprec hpe5900 ent192=5/a5500 ent65=8）。
    # device_cpu_usage 在 metrics.json 用 max() by instance_id 取活跃实体,避免零稀释。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.6"
        name = "usage"
    # 可选 1/5 分钟 CPU：hh3cEntityExtCpuUsageIn1Minute ...1.1.1.1.33 / hh3cEntityExtCpuUsageIn5Minutes ...1.34。
    # 与 instant .6 同表，不改变既有 device_cpu_usage 口径。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.33"
        name = "usage_1min"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.34"
        name = "usage_5min"
    # ---- H3C/HPE Comware memory (HH3C-ENTITY-EXT-MIB hh3cEntityExtMemUsage, 直接利用率%, per-entity table) ----
    # 待现网核验：列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.8（每实体内存%直采;snmprec hpe5900 ent192=32/a5500 ent65=47）。
    # device_memory_usage 用 max() by instance_id 取活跃实体。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.8"
        name = "usage"
    # ---- H3C 温度 (HH3C-ENTITY-EXT-MIB hh3cEntityExtTemperature, °C, per-entity) ----
    # 待现网核验：列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.12。不支持温度的实体回填 65535，
    # metrics 查询侧 != 65535 过滤哨兵；descr 取 ENTITY-MIB entPhysicalName（同 entPhysicalIndex）。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.12"
        name = "celsius"
    # ---- H3C 电压 (HH3C-ENTITY-EXT-MIB hh3cEntityExtVoltage, 毫伏, per-entity, 可选) ----
    # 待现网核验：列 OID 1.3.6.1.4.1.25506.2.6.1.1.1.1.14。metrics 查询侧 /1000 → volts，并过滤 65535 不支持哨兵。
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.14"
        name = "volts"
    # ---- H3C 功耗表 (HH3C-ENTITY-EXT-MIB hh3cEntityExtCurrentPower, W, 可选) ----
    # 待现网核验：列 OID 1.3.6.1.4.1.25506.2.6.1.3.1.1.3（当前功耗瓦特，不是 PSU 健康枚举）。
    # PSU 健康走下方 ENTITY class=6 + OperStatus；本表仅作可选功耗读数。
    [[inputs.snmp.table]]
        name = "device_power"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.3.1.1.3"
        name = "watts"
    # ---- H3C 风扇：ENTITY-MIB entPhysicalClass fan(7) + hh3cEntityExtOperStatus ----
    # 待现网核验：OperStatus 1.3.6.1.4.1.25506.2.6.1.1.1.1.3（Hh3cOperState: 1 notSupported / 2 disabled / 3 enabled / 4 dangerous）。
    # class 取 entPhysicalClass 1.3.6.1.2.1.47.1.1.1.1.5 作 tag；metrics 查询侧 entPhysicalClass='7'。
    # processors.enum 把 enabled(3)→1(正常)，其余→2(异常)。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "entPhysicalClass"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.3"
        name = "state"
    # ---- H3C 电源：ENTITY-MIB entPhysicalClass powerSupply(6) + 同一 OperStatus 列 ----
    # metrics 查询侧 entPhysicalClass='6'；枚举归一同风扇。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "entPhysicalClass"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25506.2.6.1.1.1.1.3"
        name = "state"

# ---- 风扇状态归一：enabled(3)→1(正常)，notSupported/disabled/dangerous 及其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "3" = 1
# ---- 电源状态归一：同 OperStatus 枚举，enabled(3)→1(正常)，其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "3" = 1
