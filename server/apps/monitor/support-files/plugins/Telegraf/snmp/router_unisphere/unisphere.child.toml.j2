[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_unisphere"
        config_type = "unisphere"
        brand = "unisphere"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- 系统内存（juniSystemMemUtilPct，Integer32 %；-1 为未知，丢弃该字段，不当作 0%）----
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4874.2.2.2.1.1.3"
        name = "usage"
    # ---- 模块 CPU（juniSystemModuleSoftwareTable，INDEX slot.level，整表 walk，不写死行）----
    # juniSystemModuleCpuUtilPct → device_cpu_usage；可选 1 分钟 / 5 分钟平均。-1 为未知，丢弃。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4874.2.2.2.1.3.5.1.3"
        name = "usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4874.2.2.2.1.3.5.1.10"
        name = "usage_1min"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4874.2.2.2.1.3.5.1.11"
        name = "usage_5min"
    # ---- 模块内存（juniSystemModuleMemUtilPct，按卡辅助；主内存仍用系统标量）----
    [[inputs.snmp.table]]
        name = "device_module_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4874.2.2.2.1.3.5.1.4"
        name = "usage"
    # ---- 温度（juniSystemTempValue，℃，INDEX tempIndex）----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4874.2.2.2.1.9.4.1.3"
        name = "celsius"
    # ---- 电源状态（juniSystemPowerStatus，up(3) 为正常，其余归一为异常）----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4874.2.2.2.1.8.2.1.2"
        name = "state"
    # ---- 风扇状态（juniSystemFanStatus，up(3) 为正常，其余归一为异常）----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4874.2.2.2.1.9.2.1.2"
        name = "state"

[[processors.starlark]]
    namepass = ["device_cpu", "device_memory", "device_module_memory"]
    source = '''
def apply(metric):
    for key in ("usage", "usage_1min", "usage_5min"):
        value = metric.fields.get(key)
        if value == -1:
            metric.fields.pop(key)
    if metric.fields.get("usage") == None and metric.fields.get("usage_1min") == None and metric.fields.get("usage_5min") == None:
        return None
    return metric
'''

[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "3" = 1
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "3" = 1
