{
  "object": "Wanopt",
  "plugin": "Wanopt Venturi SNMP",
  "templates": [
    {
      "name": "Venturi服务器CPU使用率过高",
      "alert_name": "WAN优化${resource_name} CPU 使用率过高",
      "description": "监控 Venturi Wireless 优化服务器的整机 CPU 使用率（vServerCpuUtilization），当持续高于阈值时触发告警，提示可能存在优化或转发负载过重。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 95,
          "method": ">"
        },
        {
          "level": "error",
          "value": 90,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 85,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Venturi缓冲区使用率过高",
      "alert_name": "WAN优化${resource_name} 缓冲区使用率过高",
      "description": "监控 Venturi Wireless 优化服务器的 VBuf 缓冲池使用率，当持续高于阈值时触发告警，提示优化缓冲资源紧张。",
      "metric_name": "venturi_vbuf_usage_percent",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 95,
          "method": ">"
        },
        {
          "level": "error",
          "value": 90,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 85,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
