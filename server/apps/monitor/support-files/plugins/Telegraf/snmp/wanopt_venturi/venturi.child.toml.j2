[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_venturi"
        config_type = "venturi"
        brand = "venturi"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：vServerCpuUtilization 标量 Gauge32 百分比，顶层 field 必须带 .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3382.12.1.3.1.1.9.0"
        name = "device_cpu_usage"
    # ---- VBuf 总量/已用：辅助字段，starlark 计算 venturi_vbuf_usage_percent 后删除 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3382.12.1.3.1.1.1.0"
        name = "vbuf_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3382.12.1.3.1.1.2.0"
        name = "vbuf_used"
# ---- CPU 保留 0..100；VBuf 用量 = used*100/total（仅 total>0 且 0≤used≤total）；辅助字段不落盘。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    f = metric.fields
    cpu = f.get("device_cpu_usage")
    if cpu != None:
        cpu = int(cpu)
        if cpu < 0 or cpu > 100:
            f.pop("device_cpu_usage")
    total = f.pop("vbuf_total", None)
    used = f.pop("vbuf_used", None)
    if total != None and used != None:
        total = int(total)
        used = int(used)
        if total > 0 and used >= 0 and used <= total:
            f["venturi_vbuf_usage_percent"] = float(used) * 100.0 / float(total)
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["venturi"]
