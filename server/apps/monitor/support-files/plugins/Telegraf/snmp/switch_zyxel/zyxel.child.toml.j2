[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_zyxel"
        config_type = "zyxel"
        brand = "zyxel"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU/内存标量：顶层 field GET 必须带实例 .0；table.field 禁止 .0 ----
    # 识别门：sysObjectID 前缀 1.3.6.1.4.1.890.1.15（NebulaFlex / XGS1930 / XS1930）。
    # ES-COMMON sysMgmtCPUUsage / sysMgmtMemUsage 为 Integer32 0-100。
    # 较老 GS CPU 标量 890.1.5.8.20.12.7.0 作同名字段 fallback（ES-COMMON 存在时覆盖）。
    # 不采集 GS1900 HW-MONITOR 温度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.890.1.5.8.20.12.7.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.890.1.15.3.2.4.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.890.1.15.3.2.5.0"
        name = "device_memory_usage"
    # ---- 较老 GS 温度表（ZYXEL 私有 MIB，°C）；表列，禁止 .0 ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.890.1.5.8.20.9.2.1.2"
        name = "celsius"
# ---- 风扇/电源：风扇以原始 RPM 上报(非状态)、无电源状态 OID → 标 N/A 不采。----
