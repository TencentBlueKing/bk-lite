{
  "collector": "Telegraf",
  "collect_type": "snmp_eaton",
  "plugin": "NetworkService Eaton UPS PDU Environmental SNMP",
  "plugin_desc": "Eaton XUPS SNMP collection for appliances under Eaton PEN 534. The shared SNMP floor supplies MIB-II uptime and IF-MIB 64-bit HC interface traffic. This child template adds XUPS battery charge percent and output load percent. Shared CPU, memory, fan and power-health scalars are not claimed.",
  "support_collect_detect": true,
  "status_query": "any({instance_type='network_service', collect_type='snmp_eaton'}) by (instance_id)",
  "name": "NetworkService",
  "icon": "mm-network_service_网络服务",
  "type": "Network Device",
  "description": "",
  "default_metric": "any({instance_type='network_service'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "snmp_uptime",
    "network_service_eaton_battery_capacity",
    "network_service_eaton_output_load"
  ],
  "metrics": [
    {
      "metric_group": "NetworkService",
      "name": "network_service_eaton_battery_capacity",
      "query": "avg(network_service_eaton_battery_capacity{instance_type='network_service', __$labels__}) by (instance_id)",
      "display_name": "Eaton Battery Charge",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "XUPS battery charge as a percent of full capacity."
    },
    {
      "metric_group": "NetworkService",
      "name": "network_service_eaton_output_load",
      "query": "avg(network_service_eaton_output_load{instance_type='network_service', __$labels__}) by (instance_id)",
      "display_name": "Eaton Output Load",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "XUPS output load as a percent of rated capacity."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCInOctets",
      "query": "rate(interface_ifHCInOctets{instance_type='network_service', __$labels__}[5m])",
      "display_name": "Interface Incoming Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average inbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCInOctets counter."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCOutOctets",
      "query": "rate(interface_ifHCOutOctets{instance_type='network_service', __$labels__}[5m])",
      "display_name": "Interface Outgoing Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average outbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCOutOctets counter."
    },
    {
      "metric_group": "Base",
      "name": "snmp_uptime",
      "query": "sum(snmp_uptime{instance_type='network_service', __$labels__}/100) by (instance_id)",
      "display_name": "System Uptime",
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Device uptime since the last restart, derived from sysUpTime."
    }
  ]
}
