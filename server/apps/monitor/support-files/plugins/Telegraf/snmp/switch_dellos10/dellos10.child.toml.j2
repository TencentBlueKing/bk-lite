[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_dellos10"
        config_type = "dellos10"
        brand = "dellos10"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
        [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.3.3.1.2"
        name = "usage"
        [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.674.11000.5000.100.4.1.1.4.1.5"
        name = "celsius"
        [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.674.11000.5000.100.4.1.2.3.1.7"
        name = "state"
        [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.674.11000.5000.100.4.1.2.1.1.4"
        name = "state"
    # ---- 内存：UCD-SNMP-MIB memory 标量（OS10 基于 Linux 的 net-snmp 代理提供），顶层 field 带 .0 → measurement snmp，查询用 snmp_ 前缀 ----
    # memTotalReal 1.3.6.1.4.1.2021.4.5.0 / memAvailReal 1.3.6.1.4.1.2021.4.6.0：Integer32，单位 kB；下方 starlark ×1024 → 字节并计算已用与使用率。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "mem_total_kb_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.6.0"
        name = "mem_avail_kb_raw"
# ---- 状态归一:风扇/电源 good(2)→1(正常),其余(failed/notPowered/null)→2(异常)。----
# ---- Dell EMC OS10 交换机:CPU=HOST-RESOURCES hrProcessorLoad(.25.3.3.1.2,每核avg);内存=UCD-SNMP-MIB memTotalReal/memAvailReal(.2021.4.5.0/.4.6.0,kB 标量);温度=os10CardTemp(.674.11000.5000.100.4.1.1.4.1.5,专用表max);风扇=os10FanOperStatus(.4.1.2.3.1.7);电源=os10PowerSupplyOperStatus(.4.1.2.1.1.4)。fan/psu 原生 1=normal/2=abnormal 恰为本约定,无需 enum。----

# ---- 内存：kB ×1024 → 字节，输出 device_memory_total / free / used 与 usage=(total-free)/total*100；总量非正、空闲为负或超出总量时不输出内存字段。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    total = metric.fields.pop("mem_total_kb_raw", None)
    free = metric.fields.pop("mem_avail_kb_raw", None)
    if type(total) not in ["int", "float"] or type(free) not in ["int", "float"]:
        return metric
    if total <= 0 or free < 0 or free > total:
        return metric
    metric.fields["device_memory_total"] = int(total) * 1024
    metric.fields["device_memory_free"] = int(free) * 1024
    metric.fields["device_memory_used"] = (int(total) - int(free)) * 1024
    metric.fields["device_memory_usage"] = (total - free) * 100.0 / total
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["dellos10"]
