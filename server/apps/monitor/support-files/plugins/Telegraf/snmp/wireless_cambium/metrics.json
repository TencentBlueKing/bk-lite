{
  "collector": "Telegraf",
  "collect_type": "snmp_cambium",
  "plugin": "Wireless Cambium SNMP",
  "plugin_desc": "SNMP monitoring template for Cambium wireless device. It reports uptime, CPU utilization, interface traffic, and wireless clients/radio (enterprise PEN 17713).",
  "support_collect_detect": true,
  "status_query": "any({instance_type='wireless', collect_type='snmp_cambium'}) by (instance_id)",
  "name": "Wireless",
  "icon": "mm-wireless_无线设备",
  "type": "Network Device",
  "description": "",
  "default_metric": "any({instance_type='wireless'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "device_total_incoming_traffic",
    "device_total_outgoing_traffic",
    "device_cpu_usage"
  ],
  "metrics": [
    {
      "metric_group": "Wireless",
      "name": "device_cpu_usage",
      "query": "avg(device_cpu_usage{instance_type='wireless', __$labels__}) by (instance_id) / 10",
      "display_name": "CPU Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "ePMP sysCPUUsage converted from 0.1-percent units (0..1000) to a 0-100 percentage."
    },
    {
      "metric_group": "Wireless",
      "name": "wireless_cambium_sta_count",
      "query": "max(wireless_cambium_sta_count{instance_type='wireless', __$labels__}) by (instance_id)",
      "display_name": "Connected Station Count",
      "data_type": "Number",
      "unit": "short",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Optional ePMP AP connected-station count. Subscriber modules that do not expose the object omit the series."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCInOctets",
      "query": "rate(interface_ifHCInOctets{instance_type='wireless', __$labels__}[5m])",
      "display_name": "Interface Incoming Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average inbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCInOctets counter."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCOutOctets",
      "query": "rate(interface_ifHCOutOctets{instance_type='wireless', __$labels__}[5m])",
      "display_name": "Interface Outgoing Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average outbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCOutOctets counter."
    },
    {
      "metric_group": "Traffic",
      "name": "device_total_incoming_traffic",
      "query": "sum(rate(interface_ifHCInOctets{instance_type='wireless', __$labels__}[5m])) by (instance_id)",
      "display_name": "Device Total Incoming Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Total inbound interface bytes per second over five minutes, summed from 64-bit ifHCInOctets."
    },
    {
      "metric_group": "Traffic",
      "name": "device_total_outgoing_traffic",
      "query": "sum(rate(interface_ifHCOutOctets{instance_type='wireless', __$labels__}[5m])) by (instance_id)",
      "display_name": "Device Total Outgoing Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Total outbound interface bytes per second over five minutes, summed from 64-bit ifHCOutOctets."
    },
    {
      "metric_group": "Base",
      "name": "snmp_uptime",
      "query": "sum(snmp_uptime{instance_type='wireless', __$labels__}/100) by (instance_id)",
      "display_name": "System Uptime",
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Device uptime since the last restart, derived from sysUpTime."
    }
  ]
}
