[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_cambium"
        config_type = "cambium"
        brand = "cambium"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64 位 IF-MIB HC 流量计数器 (ifXTable，高速无线接口不易回绕，按 ifIndex 与上表接口行对齐) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"

    # ---- ePMP sysCPUUsage 1.3.6.1.4.1.17713.21.2.1.64.0：标量，顶层 field 带 .0，单位 0.1%（0..1000）----
    # 下方 starlark ÷10 输出 device_cpu_usage（0~100 %），越界值丢弃。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17713.21.2.1.64.0"
        name = "cpu_usage_permille_raw"
    # ---- cambiumAPNumberOfConnectedSTA 1.3.6.1.4.1.17713.21.1.2.10.0：AP 已连接终端数，标量，SM 上可能缺失 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.17713.21.1.2.10.0"
        name = "wireless_cambium_sta_count"

# ---- sysCPUUsage 以 0.1% 为单位：÷10 得百分比；非数值或超出 0..1000 时丢弃。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    raw = metric.fields.pop("cpu_usage_permille_raw", None)
    if type(raw) in ["int", "float"] and raw >= 0 and raw <= 1000:
        metric.fields["device_cpu_usage"] = raw / 10.0
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["cambium"]
