[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_phoenixcontact"
        config_type = "phoenixcontact"
        brand = "phoenixcontact"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- 冗余电源状态 flWorkBasicPowerStat → power_status ----
    # 原始码 unknown(1) / sourceOne(3) / sourceTwo(4) / sourceBoth(5)。
    [[inputs.snmp.table]]
        name = "power"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4346.11.11.1.6"
        name = "status"
    # ---- 机箱温度 flWorkFWCtrlActualDeviceTemperature，摄氏度 ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4346.11.11.11.2.11.1"
        name = "celsius"
    # ---- 可选：固件运行状态 flWorkFWInfoOperStatus；健康文本作 tag ----
    # other(1) / ok(2) / notOk(3)。健康文本为 DisplayString，仅作标签，不臆造数值。
    [[inputs.snmp.table]]
        name = "firmware_oper"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4346.11.11.11.1.11"
        name = "status"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4346.11.11.11.1.12"
        name = "health_text"
        is_tag = true
    # ---- 可选：告警触点状态 flWorkFWCtrlAlarmContactStatus ----
    # open(1)=告警 / closed(2)=正常。
    [[inputs.snmp.table]]
        name = "alarm_contact"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.4346.11.11.11.2.7.3"
        name = "status"
# ---- CPU/内存/风扇：无私有 CPU 或内存使用率标量，不臆造 CPU%；风扇无独立可轮询对象 → N/A 不采。----
