        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Huawei SmartAX OLT 板卡：HWMUSA-DEV-MIB hwMusaSlotConfExtTable（1.3.6.1.4.1.2011.2.6.7.1.1.2.1，table.field 不带 .0，索引为 框号.槽位号）----
    # hwMusaBoardSlotDesc .7 → descr；hwMusaBoardCpuRate .5 / hwMusaBoardRamUseRate .6（-1 或 0~100 %，仅主控板支持，-1 表示取不到）；
    # hwMusaBoardRamTotal/Used/Free .18/.19/.20（Counter64 字节，0 表示取不到）；hwMusaBoardTemperature .10（℃，0x7FFFFFFF 无效）；
    # hwMusaBoardPowerInputStatus .17 normal(1)/fault(2)/invalid(3，非电源板)。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.5"
        name = "usage"
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.6"
        name = "usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.18"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.19"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.20"
        name = "free"
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.10"
        name = "celsius"
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.2.6.7.1.1.2.1.7"
