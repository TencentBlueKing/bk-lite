# ---- ONU / 光模块等大表未纳入。----

# ---- CPU：-1（取不到，非主控板或状态异常）或超出 0~100 时丢弃。----
[[processors.starlark]]
    namepass = ["device_cpu"]
    source = '''
def apply(metric):
    usage = metric.fields.get("usage")
    if type(usage) not in ["int", "float"] or usage < 0 or usage > 100:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["huawei_olt"]

# ---- 内存：usage 为 -1 或超出 0~100 时丢弃整行；容量字段为 0（取不到）时去掉该字段。----
[[processors.starlark]]
    namepass = ["device_memory"]
    source = '''
def apply(metric):
    usage = metric.fields.get("usage")
    if type(usage) not in ["int", "float"] or usage < 0 or usage > 100:
        return None
    for key in ["total", "used", "free"]:
        value = metric.fields.get(key)
        if value != None and (type(value) not in ["int", "float"] or value <= 0):
            metric.fields.pop(key)
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["huawei_olt"]

# ---- 温度：0x7FFFFFFF（无效）或超出 -40~150 ℃ 时丢弃。----
[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    value = metric.fields.get("celsius")
    if type(value) not in ["int", "float"] or value < -40 or value > 150:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["huawei_olt"]

# ---- 电源输入：normal(1)→1(正常)，fault(2)→2(异常)；invalid(3，非电源板) 与其它值丢弃。----
[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    state = metric.fields.get("state")
    if state != 1 and state != 2:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["huawei_olt"]
