[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_dcn"
        config_type = "dcn"
        brand = "dcn"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- DCN CPU (DCN-MIB switchCpuUsage, 直接利用率%, 标量, PEN 6339) ----
    # 顶层 field GET 必须带实例 .0；禁止 table.field（标量 GET-NEXT 会走到空子树，指标静默为空）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6339.100.1.11.10.0"
        name = "device_cpu_usage"
    # ---- DCN system memory (DCN-MIB switchMemorySize/switchMemoryBusy, 字节, 标量) ----
    # 顶层 field GET 必须带实例 .0。已是字节，不做 *1024；利用率在共享盘按 used/total 计算。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6339.100.1.11.6.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6339.100.1.11.7.0"
        name = "device_memory_used"
    # ---- DCN 温度 (DCN-MIB switchTemperature, 直接 ℃, 标量) ----
    # 顶层 field GET 必须带实例 .0；禁止 table.field。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6339.100.1.11.9.0"
        name = "device_temperature_celsius"
    # ---- DCN fans (DCN-MIB sysFanTable) ----
    # sysFanStatus …12.1.3：abnormal(1)/normal(0)。原生正常态=0，下方 processors.enum 归一(0→1，其余→2)。
    # sysFanSpeed …12.1.4：none(0)/low(1)/medium-low(2)/medium(3)/medium-high(4)/high(5)，档位枚举不是 RPM。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6339.100.1.12.1.3"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6339.100.1.12.1.4"
        name = "speed"
    # ---- DCN power supplies (DCN-MIB sysPowerStateTable) ----
    # sysPowerStatus …7.1.5：normal(0)/abnormal(1)/na(2)。原生正常态=0，下方 processors.enum 归一(0→1，其余→2)。
    # sysPowerState …7.1.2：sysPowerInstalled(1)/sysPowerNotInstalled(0)。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6339.100.1.7.1.5"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.6339.100.1.7.1.2"
        name = "present"
# ---- 风扇/电源状态归一：原生 0=normal → 统一 1=normal/2=abnormal（偏离 1 即异常）。na(2) 走 default=2。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "0" = 1
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "0" = 1
