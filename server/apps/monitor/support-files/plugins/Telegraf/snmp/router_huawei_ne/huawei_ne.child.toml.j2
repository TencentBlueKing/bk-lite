[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_huawei_ne"
        config_type = "huawei_ne"
        brand = "huawei_ne"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # Device identity tags (hwDeviceEsn / hwProductName).
    # Chassis sysObjectID dictionary (display names). Interfaces use built-in IF-MIB; no IF expansion.
    # NE40E family 1.3.6.1.4.1.2011.2.62 / 1.3.6.1.4.1.2011.2.297
    # NE9000 family 1.3.6.1.4.1.2011.2.315 / ne9000SysOid ...315.2
    #   ...315.2.1 NetEngine 9000-20 · ...315.2.2 NetEngine 9000-8
    #   ...315.2.3 NetEngine 9000-8 Admin · ...315.2.4 NetEngine 9000-8 LS
    #   ...315.2.5 NetEngine 9000-20 Admin · ...315.2.6 NetEngine 9000-20 LS
    # NE8000 family 1.3.6.1.4.1.2011.2.360 / NetEngine8000SysOid ...360.1
    #   ...360.1.1  NetEngine 8000 X4 · ...360.1.3  NetEngine 8000 X8
    #   ...360.1.27 NetEngine 8000 X16 · ...360.1.5  NetEngine 8000 F1A
    #   ...360.1.39 NetEngine 8000 F2A-8K36H · ...360.1.23 NetEngine 8000 F8
    #   ...360.1.7  NetEngine 8000 M14 · ...360.1.9  NetEngine 8000 M8
    #   ...360.1.13 NetEngine 8000 M6 · ...360.1.55 NetEngine 8000 M4
    #   ...360.1.11 NetEngine 8000 M1A · ...360.1.25 NetEngine 8000 M1B
    #   ...360.1.29 NetEngine 8000 M1C · ...360.1.21 NetEngine 8000 M1D
    #   common 8000E: ...360.1.35 X4 · ...360.1.31 X8 · ...360.1.43 X16
    #                 ...360.1.49 F8 · ...360.1.47 M14 · ...360.1.45 M8 · ...360.1.57 M4
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2011.5.25.188.1.1.0"
        name = "hwDeviceEsn"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2011.5.25.188.1.4.0"
        name = "hwProductName"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Entity CPU (hwEntityCpuUsage, per entity, 0-100) ----
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5"
        name = "usage"
    # ---- Entity memory (hwEntityMemUsage, direct %) ----
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7"
        name = "usage"
    # ---- Entity temperature (hwEntityTemperature, C) ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11"
        name = "celsius"
    # ---- Entity voltage (hwEntityVoltage, mV; query /1000 -> V) ----
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.13"
        name = "volts"
    # ---- Entity oper / standby / board power ----
    [[inputs.snmp.table]]
