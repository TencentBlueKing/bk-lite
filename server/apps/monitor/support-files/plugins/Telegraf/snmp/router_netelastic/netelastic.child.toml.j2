[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_netelastic"
        config_type = "netelastic"
        brand = "netelastic"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- NetElastic FlexBNG SYSINFO 标量（PEN 54268 · sysInfoMibInfo = 1.3.6.1.4.1.54268.1.8.1）----
    # 顶层 field GET 必须带实例 .0；cpuUsage / memUsage 已是 Unsigned32(0..100)%，不做倍率换算。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.54268.1.8.1.1.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.54268.1.8.1.2.0"
        name = "device_memory_usage"
# ---- 温度/风扇/电源：SYSINFO 无机箱环境叶 → N/A 不采。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    f = metric.fields
    cpu = f.get("device_cpu_usage")
    if cpu != None:
        if cpu < 0 or cpu > 100 or cpu == 65535 or cpu == 65534 or cpu == -1 or cpu == 2147483647 or cpu == -2147483648 or cpu == 4294967295:
            f.pop("device_cpu_usage")
    mem = f.get("device_memory_usage")
    if mem != None:
        if mem < 0 or mem > 100 or mem == 65535 or mem == 65534 or mem == -1 or mem == 2147483647 or mem == -2147483648 or mem == 4294967295:
            f.pop("device_memory_usage")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["netelastic"]
