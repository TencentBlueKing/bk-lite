# DisplayString 比率 0..1 → 百分比；字符串状态 → 1 正常 / 2 异常 / 3 未知。
# 空值与 notPresent 映射为 1；厂商字面 unknown 映射为 3 且不告警；告警策略仅匹配 =2。
[[processors.starlark]]
    namepass = ["sangfor_eds_block_pool", "sangfor_eds_capacity_pool", "sangfor_eds_disk", "sangfor_eds_lun", "sangfor_eds_host"]
    [processors.starlark.tagpass]
        config_type = ["storage_sangfor_eds"]
    source = '''
def in_list(value, items):
    for item in items:
        if value == item:
            return True
    return False

def to_percent(metric, field):
    v = metric.fields.get(field)
    if v == None:
        return
    t = type(v)
    if t != "int" and t != "float":
        return
    n = float(v)
    if n < 0:
        return
    if n <= 1.0:
        metric.fields[field] = n * 100.0
    else:
        metric.fields[field] = n

def map_status(v, good, bad):
    if v == None:
        return 1
    s = str(v).strip().lower()
    if s == "" or s == "notpresent" or s == "not present" or s == "none":
        return 1
    if in_list(s, good):
        return 1
    if in_list(s, bad):
        return 2
    return 3

def apply(metric):
    name = metric.name
    if name == "sangfor_eds_block_pool":
        to_percent(metric, "usage_rate")
        metric.fields["status"] = map_status(metric.fields.get("status"), ["normal", "ok", "healthy", "up"], ["error", "abnormal", "fault", "failed", "down", "warn", "warning"])
    if name == "sangfor_eds_capacity_pool":
        to_percent(metric, "usage_rate")
        metric.fields["status"] = map_status(metric.fields.get("status"), ["normal", "ok", "healthy", "up"], ["error", "abnormal", "fault", "failed", "down", "warn", "warning"])
        metric.fields["daemon_status"] = map_status(metric.fields.get("daemon_status"), ["normal"], ["error"])
        metric.fields["pg_status"] = map_status(metric.fields.get("pg_status"), ["normal"], ["error"])
    if name == "sangfor_eds_disk":
        to_percent(metric, "usage_rate")
        metric.fields["status"] = map_status(metric.fields.get("status"), ["online"], ["offline"])
        metric.fields["bad_sector"] = map_status(metric.fields.get("bad_sector"), ["normal"], ["warn", "warning", "error"])
    if name == "sangfor_eds_lun":
        to_percent(metric, "usage_rate")
    if name == "sangfor_eds_host":
        to_percent(metric, "cpu_usage")
        to_percent(metric, "mem_usage")
        metric.fields["online_status"] = map_status(metric.fields.get("online_status"), ["online", "up", "true", "1", "normal"], ["offline", "down", "false", "0", "error", "abnormal"])
    return metric
'''
