[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_huawei_ar"
        config_type = "huawei_ar"
        brand = "huawei_ar"
    # ---- sysObjectID model dictionary (huaweiProducts.ar = 1.3.6.1.4.1.2011.2.224) ----
    # Identity only. Interface traffic uses built-in IF-MIB; do not expand IF here.
    # Device health adds entity voltage (mV→V) and board power (watts); milliwatt energy is a separate ENERGY table.
    # 340 AR8140-12G10XG
    # 341 AR8140-T-12G10XG
    # 349 AR720
    # 350 AR730
    # 363 AR6710-L50T2X4
    # 364 AR6710-L50T2X4-T
    # 365 AR6710-L26T2X4
    # 366 AR6710-L26T2X4-T
    # 368 AR5710-H8T2TS1
    # 369 AR5710-H8T2TS1-T
    # 370 AR6710-L8T3TS1X2
    # 371 AR6710-L8T3TS1X2-T
    # 378 AR8700-8
    # 379 AR6510-L11T1X2
    # 380 AR6510-L5T4S4
    # 381 AR5510-H8P2TW1
    # 382 AR5510-H10T1
    # 383 AR5510-L5T-LTE4EA
    # 384 AR5510-L5T
    # 385 AR6500-10
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Huawei CPU utilization (HUAWEI-ENTITY-EXTENT-MIB hwEntityCpuUsage, per entity, %) ----
    # 来源：官方 HUAWEI-ENTITY-EXTENT-MIB（复用已产 huawei switch 的 OID，AR 路由器同 MIB）。
    # 待现网核验：hwEntityCpuUsage 1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5（已归一化为 0-100%）。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5"
        name = "usage"
    # ---- Huawei memory utilization (HUAWEI-ENTITY-EXTENT-MIB hwEntityMemUsage, % 直报，per entity) ----
    # 待现网核验：hwEntityMemUsage 1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7 → 统一 device_memory_usage(原始%)。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7"
        name = "usage"
    # ---- Huawei AR environment sensors (HUAWEI-ENTITY-EXTENT-MIB) ----
    # 待现网核验：温度 hwEntityTemperature 1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11"
        name = "celsius"
    # ---- Entity voltage (hwEntityVoltage, mV; query /1000 -> V) ----
    # Same hwEntityStateTable index as CPU/Mem/Temp (entPhysicalIndex).
    # descr = ENTITY-MIB entPhysicalName. Distinct from optical hwEntityOpticalVoltage (...3.1.6).
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.13"
        name = "volts"
    # ---- Entity board power (hwEntityBoardPower, watts) ----
    # Same hwEntityStateTable index; descr = entPhysicalName. Absent leaves yield an empty table.
    [[inputs.snmp.table]]
        name = "device_entity"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.24"
        name = "board_power"
    # 待现网核验：风扇状态 hwEntityFanState 1.3.6.1.4.1.2011.5.25.31.1.1.10.1.7。
    # 风扇转速 hwEntityFanSpeed ...10.1.5，Integer32，单位为满速百分比；与 state 同 hwFanStatusTable 索引。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.7"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.5"
        name = "speed"
    # 待现网核验：电源状态按同族实体状态表采集，状态码经 enum 归一为 1=正常/2=异常。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.20.1.7"
        name = "state"
    # ---- Huawei AR SFP optical DDM (HUAWEI-ENTITY-EXTENT-MIB hwOpticalModuleInfoTable, index=entPhysicalIndex) ----
    # RX=hwEntityOpticalRxPower ...3.1.8 / TX=hwEntityOpticalTxPower ...3.1.9。
    # TEMP=hwEntityOpticalTemperature ...3.1.5（°C）/ VOLT=hwEntityOpticalVoltage ...3.1.6（mV）/
    # BIAS=hwEntityOpticalBiasCurrent ...3.1.7（µA）。descr=entPhysicalName。
    # 线侧光功率是 µW（MIB 文本常误标 dBm）；查询侧 10*log10(µW/1000)→dBm，与 switch_huawei 对齐。
    # 无效哨兵 2147483647；无模块/无效功率常为 <=0。电压查询侧 /1000 → V。不做 starlark 换算。
    [[inputs.snmp.table]]
        name = "device_optical"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.8"
        name = "rx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.9"
        name = "tx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.5"
        name = "temperature"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.7"
        name = "bias"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.6"
        name = "voltage"
    # ---- Chassis/board energy (hwCurrentPower / hwBoardCurrentPower, milliwatts) ----
    # 线侧为毫瓦，展示可 ÷1000 为瓦特。仅 HUAWEI-ENERGYMNGT-MIB 1.3.6.1.4.1.2011.6.157。
    # hwCurrentPower ...6.157.1.6 / hwAveragePower ...1.3 / hwRatedPower ...1.4
    # 板卡表 hwBoardName ...2.1.1.3 / hwBoardCurrentPower ...2.1.1.4 / hwBoardRatedPower ...2.1.1.5
    # 板卡无效值（-1 / 空 hwBoardName）在查询侧丢弃。
    [[inputs.snmp.table]]
        name = "device_energy"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.1.6"
        name = "current_power_mw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.1.3"
        name = "average_power_mw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.1.4"
        name = "rated_power_mw"
    [[inputs.snmp.table]]
        name = "device_board"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.2.1.1.3"
        name = "hwBoardName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.2.1.1.4"
        name = "current_power_mw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.157.2.1.1.5"
        name = "rated_power_mw"
# ---- BGP 邻居走 BGP4-MIB bgpPeerTable(per-peer walk,需聚合计数)→本轮 N/A,后续可补 BGP peer 数。----

[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
