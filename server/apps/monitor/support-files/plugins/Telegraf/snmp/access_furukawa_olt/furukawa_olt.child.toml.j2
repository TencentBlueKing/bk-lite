[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_furukawa_olt"
        config_type = "furukawa_olt"
        brand = "furukawa_olt"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Furukawa OLT 3516 机箱健康标量（FELOLT3500 树 1.3.6.1.4.1.10428.10.2.1.2.1.1.1.2，企业号 PEN 10428），顶层 field 带 .0 → measurement snmp，查询用 snmp_ 前缀 ----
    # oltGenHwCpu .1.0 CPU 负载（INTEGER %）；oltGenHwMemTot .2.0 / oltGenHwMemFree .3.0 内存总量 / 空闲（INTEGER，绝对单位未定义，只用于计算使用率）；
    # oltGenHwTemperature .4.0 温度（INTEGER ℃）。下方 starlark 校验范围并计算内存使用率，原始字段不落库。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.10428.10.2.1.2.1.1.1.2.1.0"
        name = "cpu_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.10428.10.2.1.2.1.1.1.2.2.0"
        name = "mem_total_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.10428.10.2.1.2.1.1.1.2.3.0"
        name = "mem_free_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.10428.10.2.1.2.1.1.1.2.4.0"
        name = "temperature_raw"
# ---- ONU / PON 光功率等大表未纳入。----

# ---- CPU 0~100 → device_cpu_usage；内存 usage=(total-free)/total*100（总量非正、空闲为负或超出总量时不输出）；温度 -40~150 ℃ → device_temperature_celsius；越界或非数值丢弃对应字段。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def num(value):
    return type(value) in ["int", "float"]

def apply(metric):
    cpu = metric.fields.pop("cpu_raw", None)
    total = metric.fields.pop("mem_total_raw", None)
    free = metric.fields.pop("mem_free_raw", None)
    temp = metric.fields.pop("temperature_raw", None)
    if num(cpu) and cpu >= 0 and cpu <= 100:
        metric.fields["device_cpu_usage"] = cpu
    if num(total) and num(free) and total > 0 and free >= 0 and free <= total:
        metric.fields["device_memory_usage"] = (total - free) * 100.0 / total
    if num(temp) and temp >= -40 and temp <= 150:
        metric.fields["device_temperature_celsius"] = temp
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["furukawa_olt"]
