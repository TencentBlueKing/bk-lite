[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_ubiquoss"
        config_type = "ubiquoss"
        brand = "ubiquoss"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：优先 1 分钟均值 1.3.6.1.4.1.7800.100.1.1.3.2.0（device_cpu_usage）。----
    # 5 秒 .3.1.0（usage_5s）与 5 分钟 .3.3.0（usage_5min）作回退，均为 0-100。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.3.2"
        name = "usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.3.1"
        name = "usage_5s"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.3.3"
        name = "usage_5min"
    # ---- 内存：Alloc/Free/Total 标量 .4.1.0 / .4.2.0 / .4.3.0。----
    # Alloc 是已分配量，不是现成百分比。利用率优先 Alloc/Total，缺 Alloc 时用 1-Free/Total。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.4.1"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.4.2"
        name = "free"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.4.3"
        name = "total"
    # ---- 风扇：可选标量 1.3.6.1.4.1.7800.100.2.1.2.1.3.0，设备未实现时采集端跳过。----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.2.1.2.1.3"
        name = "speed"
