[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_ubiquoss"
        config_type = "ubiquoss"
        brand = "ubiquoss"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：UBQS-SYSRSC 标量（0-100%），顶层 field 带 .0 → measurement snmp。----
    # 主值 ubiCpuOneMin 7800.100.1.1.3.2.0；5 秒 .3.1.0 与 5 分钟 .3.3.0 作查询侧回退。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.3.2.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.3.1.0"
        name = "device_cpu_usage_5s"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.3.3.0"
        name = "device_cpu_usage_5min"
    # ---- 内存：ubiMemoryAlloc/Free/Total 标量 .4.1.0 / .4.2.0 / .4.3.0，单位 kbyte，查询侧 ×1024 为字节。----
    # Alloc 是已分配量，不是现成百分比。利用率优先 Alloc/Total，缺 Alloc 时用 1-Free/Total。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.4.1.0"
        name = "device_memory_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.4.2.0"
        name = "device_memory_free"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.7800.100.1.1.4.3.0"
        name = "device_memory_total"
    # ---- 温度：ubiEnvMonTemperatureTable（7800.100.2.1.1），描述 ...1.1.2 作 tag，读数 ...1.1.3 摄氏度。----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.2.1.1.1.2"
        name = "sensorName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.2.1.1.1.3"
        name = "celsius"
    # ---- 风扇：ubiEnvMonFanTable（7800.100.2.1.2），描述 ...2.1.2 作 tag，状态 ubiEnvMonFanState ...2.1.3（枚举，非转速）。----
    # 原始码 1 normal / 2 warning / 3 critical / 4 shutdown / 5 notPresent / 6 notFunctioning → 下方 processors.enum 归一。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.2.1.2.1.2"
        name = "fanName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.2.1.2.1.3"
        name = "state"
    # ---- 电源：ubiEnvMonSupplyTable（7800.100.2.1.3），描述 ...3.1.2 作 tag，状态 ubiEnvMonSupplyState ...3.1.3，枚举同风扇。----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.2.1.3.1.2"
        name = "psuName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.7800.100.2.1.3.1.3"
        name = "state"
# ---- 风扇/电源状态归一：1 normal / 5 notPresent(缺位) → 1(正常)，其余(2 warning / 3 critical / 4 shutdown / 6 notFunctioning) → 2(异常)。----
[[processors.enum]]
    namepass = ["device_fan", "device_psu"]
    [processors.enum.tagpass]
        brand = ["ubiquoss"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            "5" = 1
