[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_fortimail"
        config_type = "fortimail"
        brand = "fortimail"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # FortiMail 系统标量（FORTINET-FORTIMAIL-MIB fmlSystem，PEN 12356 树 12356.105）：顶层 field 带 .0 → measurement snmp
    # fmlSysCpuUsage 1.3.6.1.4.1.12356.105.1.6.0：瞬时 CPU%
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12356.105.1.6.0"
        name = "device_cpu_usage"
    # fmlSysMemUsage …105.1.7.0：瞬时内存%
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12356.105.1.7.0"
        name = "device_memory_usage"
    # fmlSysLogDiskUsage …105.1.8.0：日志盘%
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12356.105.1.8.0"
        name = "device_log_disk_usage"
    # fmlSysMailDiskUsage …105.1.9.0：邮件盘%
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12356.105.1.9.0"
        name = "device_mail_disk_usage"
# 百分比越界（含 4294967295 等哨兵）丢弃，不写占位 0
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    f = metric.fields
    keys = ["device_cpu_usage", "device_memory_usage", "device_log_disk_usage", "device_mail_disk_usage"]
    for key in keys:
        v = f.get(key)
        if v == None:
            continue
        bad = False
        if v < 0:
            bad = True
        if v > 100:
            bad = True
        if v == 65535:
            bad = True
        if v == 65534:
            bad = True
        if v == 2147483647:
            bad = True
        if v == -2147483648:
            bad = True
        if v == 4294967295:
            bad = True
        if bad:
            f.pop(key)
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["fortimail"]
