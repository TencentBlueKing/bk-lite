[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_aruba_wireless"
        config_type = "aruba_wireless"
        brand = "aruba_aos"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- WLSX-SYSTEMEXT scalars, top-level field GET with instance .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14823.2.2.1.2.1.30.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14823.2.2.1.2.1.31.0"
        name = "device_memory_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14823.2.2.1.2.1.10.0"
        name = "device_temperature_celsius"
    # ---- WLSX-SWITCH AP/STA scalars, top-level field GET with instance .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14823.2.2.1.1.3.1.0"
        name = "wireless_ap_count"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.14823.2.2.1.1.3.2.0"
        name = "wireless_station_count"
