[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_pandacom"
        config_type = "pandacom"
        brand = "pandacom"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Chassis health scalars (PEN 3652) ----
    # nmATemperature 1.3.6.1.4.1.3652.3.1.1.6.0 INTEGER °C → temperature_celsius
    [[inputs.snmp.table]]
        name = "temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3652.3.1.1.6"
        name = "celsius"
        conversion = "int"
    # nmPSU1Status 1.3.6.1.4.1.3652.3.2.1.3.0
    # ENUM notInstalled(0)/fail(1)/temperatureWarning(2)/pass(3) → psu1_status
    [[inputs.snmp.table]]
        name = "psu1"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3652.3.2.1.3"
        name = "status"
        conversion = "int"
    # nmPSU2Status 1.3.6.1.4.1.3652.3.2.1.4.0 → psu2_status
    [[inputs.snmp.table]]
        name = "psu2"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3652.3.2.1.4"
        name = "status"
        conversion = "int"
    # Optional nmFanState 1.3.6.1.4.1.3652.3.2.1.5.0
    # ENUM notAvailable(0)/pass(3)/fail(4)/notInstalled(5) → fan_status
    [[inputs.snmp.table]]
        name = "fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3652.3.2.1.5"
        name = "status"
        conversion = "int"
    # Optional nmPSU3Status 1.3.6.1.4.1.3652.3.2.1.12.0
    # ENUM notInstalled(0)/fail(1)/temperatureWarning(2)/pass(3)/notAvailable(255) → psu3_status
    [[inputs.snmp.table]]
        name = "psu3"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3652.3.2.1.12"
        name = "status"
        conversion = "int"
# ---- CPU/memory and amplifier branch: no confirmed shared health scalars → not collected. ----
