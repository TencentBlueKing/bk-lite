[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_pica8"
        config_type = "pica8"
        brand = "pica8"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Pica8 PicOS CPU (PICA-PRIVATE-MIB cpuUsage, INTEGER 0..100, PEN 35098) ----
    # 顶层 field GET 必须带实例 .0；禁止 table.field（标量 GET-NEXT 会走到空子树，指标静默为空）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35098.1.1.0"
        name = "device_cpu_usage"
    # ---- Pica8 PicOS 内存 / 温度（PICA-PRIVATE-MIB hostStatusGroup 1.3.6.1.4.1.35098.1，均为 DisplayString 标量，顶层 field 带 .0）----
    # totalPhyMemory .2.0 / usedPhyMemory .3.0 / freePhyMemory .4.0：带容量单位的字符串（如 "8165432KB"）；
    # switchTemperature .5.0 / cpuTemperature .6.0 / switchChipTemperature .7.0：整数摄氏度字符串。下方 starlark 解析，原始字段不落库。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35098.1.2.0"
        name = "mem_total_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35098.1.3.0"
        name = "mem_used_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35098.1.4.0"
        name = "mem_free_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35098.1.5.0"
        name = "temp_switch_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35098.1.6.0"
        name = "temp_cpu_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.35098.1.7.0"
        name = "temp_chip_raw"
# ---- 风扇（switchFanSpeed 为无单位说明的字符串）/ 电源本插件不采集（N/A）。----

# ---- 内存：解析 "数字 + 可选单位"（B / KB / MB / GB，大小写不敏感，K/M/G 同义）。三项都带单位时输出 device_memory_total / used / free（字节）；
# ---- usage=used/total*100：两者都带单位时按字节计算，都不带单位时按原值计算，其它情况不输出。总量非正或已用大于总量时整组不输出。
# ---- 温度：三个温度字符串（允许末尾带 C / °C）解析出的 -40~150 ℃ 数值取最大值 → device_temperature_celsius；均无效则不输出。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
UNITS = {"": 0, "B": 1, "K": 1024, "KB": 1024, "KIB": 1024, "M": 1048576, "MB": 1048576, "MIB": 1048576, "G": 1073741824, "GB": 1073741824, "GIB": 1073741824}

def split_number(raw):
    text = str(raw).strip()
    end = 0
    for i in range(len(text)):
        c = text[i]
        if c.isdigit() or (c == "." and i > 0):
            end = i + 1
        else:
            break
    if end == 0 or text[:end].count(".") > 1 or text[end - 1] == ".":
        return None
    unit = text[end:].strip().upper()
    if unit not in UNITS:
        return None
    return (float(text[:end]), UNITS[unit])

def apply(metric):
    total = split_number(metric.fields.pop("mem_total_raw", ""))
    used = split_number(metric.fields.pop("mem_used_raw", ""))
    free = split_number(metric.fields.pop("mem_free_raw", ""))
    if total != None and used != None:
        if total[1] > 0 and used[1] > 0:
            t = total[0] * total[1]
            u = used[0] * used[1]
        elif total[1] == 0 and used[1] == 0:
            t = total[0]
            u = used[0]
        else:
            t = 0
            u = 0
        if t > 0 and u >= 0 and u <= t:
            metric.fields["device_memory_usage"] = u * 100.0 / t
            if total[1] > 0 and used[1] > 0:
                metric.fields["device_memory_total"] = int(t)
                metric.fields["device_memory_used"] = int(u)
                if free != None and free[1] > 0 and free[0] * free[1] <= t:
                    metric.fields["device_memory_free"] = int(free[0] * free[1])
    best = None
    for key in ["temp_switch_raw", "temp_cpu_raw", "temp_chip_raw"]:
        text = str(metric.fields.pop(key, "")).strip()
        if text.endswith("C"):
            text = text[:-1].strip().rstrip("°").strip()
        sign = 1
        if text.startswith("-"):
            sign = -1
            text = text[1:]
        value = split_number(text)
        if value != None and value[1] == 0 and sign * value[0] >= -40 and sign * value[0] <= 150:
            if best == None or sign * value[0] > best:
                best = sign * value[0]
    if best != None:
        metric.fields["device_temperature_celsius"] = best
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["pica8"]
