{
  "object": "Wireless",
  "plugin": "Wireless Albentia SNMP",
  "templates": [
    {
      "name": "Albentia无线设备射频温度过高",
      "alert_name": "无线设备${resource_name} 射频温度过高",
      "description": "监控 Albentia 无线设备射频温度，超过阈值时触发告警，提示可能存在散热不良、机箱温升或射频硬件热压力。",
      "metric_name": "rf_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 70,
          "method": ">"
        },
        {
          "level": "error",
          "value": 60,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 55,
          "method": ">"
        }
      ]
    }
  ]
}
