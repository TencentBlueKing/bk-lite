{
  "object": "Wireless",
  "plugin": "Wireless Meru SNMP",
  "templates": [
    {
      "name": "Meru无线控制器CPU使用率过高",
      "alert_name": "无线控制器${resource_name} CPU 使用率过高",
      "description": "监控 Meru 无线控制器的 CPU 使用率，当持续高于阈值时触发告警，提示可能存在控制平面或终端管理负载过重，避免影响管理响应。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Meru无线控制器内存使用率过高",
      "alert_name": "无线控制器${resource_name} 内存使用率过高",
      "description": "监控 Meru 无线控制器的内存使用率，当超过阈值时触发告警。内存压力过高可能影响控制器服务，需及时排查容量或异常负载。",
      "metric_name": "device_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
