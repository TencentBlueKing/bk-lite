[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_teltonika"
        config_type = "teltonika"
        brand = "teltonika"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Teltonika private CPU usage (cpuUsage, 0-100%, scalar GET with instance .0) ----
    # 顶层 field GET 必须带实例 .0；禁止 table.field（标量 GET-NEXT 会走到空子树，指标静默为空）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.48690.1.8.0"
        name = "device_cpu_usage"
    # ---- UCD-SNMP-MIB memory scalars (memTotalReal / memAvailReal, KB, GET with instance .0) ----
    # 顶层 field GET 必须带实例 .0。原始单位为 KB，共享盘查询 *1024 转字节。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.6.0"
        name = "device_memory_free"
    # ---- Modem temperature table (mTemperature, integer 0.1°C; table.field must not use .0) ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.48690.2.2.1.1"
        name = "mIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.48690.2.2.1.17"
        name = "celsius"
    # ---- 风扇/电源：Teltonika RUT 系列为无风扇紧凑型工业设计，风扇/电源 N/A。----

[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    value = metric.fields.get("celsius")
    if value == None:
        return metric
    metric.fields["celsius"] = float(value) / 10.0
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["teltonika"]
