[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_teltonika"
        config_type = "teltonika"
        brand = "teltonika"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Private CPU scalar (cpuUsage), top-level field GET with instance .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.48690.1.8.0"
        name = "device_cpu_usage"
    # ---- HOST-RESOURCES CPU fallback (hrProcessorLoad, per-core %) ----
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.3.3.1.2"
        name = "usage"
    # ---- UCD-SNMP-MIB memory (total + free, KB) ----
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.4.5"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.4.6"
        name = "free"
    # ---- Modem temperature table (mTemperature, integer 0.1°C; table.field must not use .0) ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.48690.2.2.1.1"
        name = "mIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.48690.2.2.1.17"
        name = "celsius"
    # ---- 风扇/电源：Teltonika RUT 系列为无风扇紧凑型工业设计，风扇/电源 N/A。----

[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    value = metric.fields.get("celsius")
    if value == None:
        return metric
    metric.fields["celsius"] = float(value) / 10.0
    return metric
'''
