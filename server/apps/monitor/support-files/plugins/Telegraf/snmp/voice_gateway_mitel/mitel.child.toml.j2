[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_mitel"
        config_type = "mitel"
        brand = "mitel"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- CPU (UCD-SNMP 1.3.6.1.4.1.2021; MiVoice 5000 host health) ----
    # ssCpuIdle 1.3.6.1.4.1.2021.11.11.0 → cpu_usage_percent = 100−idle；缺 idle 时用 ssCpuUser+ssCpuSystem。
    [[inputs.snmp.table]]
        name = "cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.11.11"
        name = "idle"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.11.9"
        name = "user"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.11.10"
        name = "system"
    # ---- Memory (UCD-SNMP memTotalReal/memAvailReal, kB; usage=(total-avail)/total) ----
    [[inputs.snmp.table]]
        name = "memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.4.5"
        name = "total"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.4.6"
        name = "free"
        conversion = "int"
    # ---- Optional memTotalFree (UCD-SNMP 1.3.6.1.4.1.2021.4.11.0, kB) ----
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.4.11"
        name = "total_free"
        conversion = "int"
# ---- 保持既有 IF-MIB 64 位 HC 底盘；不扩展 ifInErrors、ifOperStatus 或 32 位字节计数器。不混入 3300/MiVB 通话负荷叶子。温度/风扇/电源 N/A 不采。----

[[processors.starlark]]
    namepass = ["cpu"]
    source = '''
def apply(metric):
    idle = metric.fields.get("idle")
    user = metric.fields.get("user")
    system = metric.fields.get("system")
    if idle != None:
        metric.fields["usage_percent"] = 100 - idle
    elif user != None and system != None:
        metric.fields["usage_percent"] = user + system
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["mitel"]
