[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_mitel"
        config_type = "mitel"
        brand = "mitel"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- CPU (UCD-SNMP 1.3.6.1.4.1.2021 systemStats；MiVoice 5000 主机健康) ----
    # 以下均为标量：顶层 field 带实例 .0 直接 GET，落 measurement snmp，查询用 snmp_ 前缀。
    # ssCpuIdle .11.11.0 → cpu_usage_percent = 100 − idle；缺 idle 时用 ssCpuUser(.11.9.0) + ssCpuSystem(.11.10.0)。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.11.0"
        name = "cpu_idle"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.9.0"
        name = "cpu_user"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.10.0"
        name = "cpu_system"
        conversion = "int"
    # ---- Memory (UCD-SNMP memory，kB；采集侧由 starlark ×1024 换算为字节) ----
    # memTotalReal .4.5.0 → memory_total；memAvailReal .4.6.0 → memory_free；usage = (total − free) / total × 100。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "memory_total"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.6.0"
        name = "memory_free"
        conversion = "int"
    # ---- 可选 memTotalFree (.4.11.0，kB) ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.11.0"
        name = "memory_total_free"
        conversion = "int"
# ---- 保持既有 IF-MIB 64 位 HC 底盘；不扩展 ifInErrors、ifOperStatus 或 32 位字节计数器。不混入 3300/MiVB 通话负荷叶子。温度/风扇/电源 N/A 不采。----

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    idle = metric.fields.get("cpu_idle")
    user = metric.fields.get("cpu_user")
    system = metric.fields.get("cpu_system")
    if idle != None:
        metric.fields["cpu_usage_percent"] = 100 - idle
    elif user != None and system != None:
        metric.fields["cpu_usage_percent"] = user + system
    for key in ("memory_total", "memory_free", "memory_total_free"):
        v = metric.fields.get(key)
        if v != None:
            metric.fields[key] = int(v) * 1024
    total = metric.fields.get("memory_total")
    free = metric.fields.get("memory_free")
    if total != None and free != None and total > 0 and free <= total:
        metric.fields["memory_used"] = total - free
        metric.fields["memory_usage_percent"] = (total - free) * 100.0 / total
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["mitel"]
