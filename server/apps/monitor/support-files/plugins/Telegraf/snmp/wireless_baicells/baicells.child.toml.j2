[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_baicells"
        config_type = "baicells"
        brand = "baicells"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- BAICELLS-MIB deviceInfo 1.3.6.1.4.1.53058.2.1（PEN 53058）：标量，顶层 field 带 .0；值为 DisplayString，由下方 starlark 解析 → measurement snmp，查询用 snmp_ 前缀 ----
    # MemoryTotal .11.0 / MemoryFree .12.0：如 "249856 kB"、"244 MB" → device_memory_total / device_memory_free / device_memory_used（字节）与 device_memory_usage。本 MIB 修订无 CPU 对象。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.53058.2.1.11.0"
        name = "mem_total_text"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.53058.2.1.12.0"
        name = "mem_free_text"

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
UNIT_BYTES = {"B": 1, "BYTE": 1, "BYTES": 1, "K": 1024, "KB": 1024, "KIB": 1024, "M": 1048576, "MB": 1048576, "MIB": 1048576, "G": 1073741824, "GB": 1073741824, "GIB": 1073741824}

def parse(raw):
    text = str(raw).strip()
    number = ""
    rest = ""
    for i in range(len(text)):
        c = text[i]
        if c.isdigit() or (c == "." and number != "" and "." not in number):
            number += c
        else:
            rest = text[i:]
            break
    if number == "" or number.endswith("."):
        return None, None
    return float(number), rest.strip().upper()

def apply(metric):
    total_raw = metric.fields.pop("mem_total_text", None)
    free_raw = metric.fields.pop("mem_free_text", None)
    if total_raw == None or free_raw == None:
        return metric
    total, total_unit = parse(total_raw)
    free, free_unit = parse(free_raw)
    if total == None or free == None or total <= 0:
        return metric
    if total_unit == "" and free_unit == "":
        # 无单位时两值同量纲，只算使用率，不臆测字节换算
        if free > total:
            return metric
        metric.fields["device_memory_usage"] = (total - free) * 100.0 / total
        return metric
    if total_unit not in UNIT_BYTES or free_unit not in UNIT_BYTES:
        return metric
    total_bytes = int(total * UNIT_BYTES[total_unit])
    free_bytes = int(free * UNIT_BYTES[free_unit])
    if total_bytes <= 0 or free_bytes > total_bytes:
        return metric
    metric.fields["device_memory_total"] = total_bytes
    metric.fields["device_memory_free"] = free_bytes
    metric.fields["device_memory_used"] = total_bytes - free_bytes
    metric.fields["device_memory_usage"] = (total_bytes - free_bytes) * 100.0 / total_bytes
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["baicells"]
