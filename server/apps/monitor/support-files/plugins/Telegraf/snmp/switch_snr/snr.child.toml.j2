[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_snr"
        config_type = "snr"
        brand = "snr"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- SNR (NAG-MIB, IANA PEN 40418) sysSlotTable per-slot health ----
    # CPU：sysCpuUsage 列 OID 1.3.6.1.4.1.40418.7.100.1.8.1.11（%）。多 slot 走表 → device_cpu_usage。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.40418.7.100.1.8.1.11"
        name = "usage"
    # ---- SNR system memory (NAG-MIB sysMemorySize/sysMemoryBusy, bytes, per-slot) ----
    # total 列 ...8.1.7 / used 列 ...8.1.8；利用率按 used/total 计算。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.40418.7.100.1.8.1.7"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.40418.7.100.1.8.1.8"
        name = "used"
    # ---- SNR chassis temperature (NAG-MIB sysTemperature, °C, per-slot table) ----
    # 列 OID 1.3.6.1.4.1.40418.7.100.1.8.1.10（专用温度列，-100 表示不支持）。device_temperature_celsius max()。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.40418.7.100.1.8.1.10"
        name = "celsius"
    # ---- SNR fan state (NAG-MIB sysFanTable 1.3.6.1.4.1.40418.7.100.1.12, INDEX sysFanIndex) ----
    # sysFanInserted = sysFanEntry 2 → 列 ...12.1.2，sysFanNotInstalled(0) / sysFanInstalled(1)。
    # sysFanStatus = sysFanEntry 3 → 列 ...12.1.3，原始码 0=normal / 1=abnormal。
    # 下方 starlark 丢弃未安装（inserted=0）的风扇行，并归一为 1=正常/2=异常（共享盘约定 1=正常,>1=异常）。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.40418.7.100.1.12.1.2"
        name = "inserted"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.40418.7.100.1.12.1.3"
        name = "state"
# ---- 风扇状态归一：未安装（inserted=0）的空位丢弃；0=normal→1(正常)，1=abnormal 及其余→2(异常)。----
# ---- 注意：SNR 正常码为 0（与 Eltex 的 1 不同），故 0 映射到 1。inserted 字段用后删除。----
[[processors.starlark]]
    namepass = ["device_fan"]
    source = '''
def apply(metric):
    inserted = metric.fields.pop("inserted", None)
    if inserted != None and int(inserted) == 0:
        return None
    if "state" not in metric.fields:
        return None
    if int(metric.fields["state"]) == 0:
        metric.fields["state"] = 1
    else:
        metric.fields["state"] = 2
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["snr"]
# ---- 温度/电源：NAG-MIB 无独立电源状态列（仅 sysFanStatus 风扇 + sysTemperature 温度）。----
# ---- 电源 → N/A（MIB 不提供电源状态对象）。----
