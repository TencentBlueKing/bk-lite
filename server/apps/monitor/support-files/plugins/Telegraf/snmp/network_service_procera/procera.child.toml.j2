[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_procera"
        config_type = "procera"
        brand = "procera"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU Load 标量 packetprocessingLoadVal（顶层 field 必须带 .0，写入 measurement snmp）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.15397.2.1.8.15.1.0"
        name = "procera_cpu_load"
    # ---- BMC 温度表 tempSensorTable；单位列仅作换算辅助，不入库、不作 tag ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.15397.2.30.3.1.1.1"
        name = "sensor_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.15397.2.30.3.1.1.2"
        name = "celsius"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.15397.2.30.3.1.1.4"
        name = "temp_unit"
    # ---- BMC 风扇表 fanSensorTable；单位列仅作门控辅助，不入库、不作 tag ----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.15397.2.30.3.4.1.1"
        name = "fanSensorId"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.15397.2.30.3.4.1.2"
        name = "speed"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.15397.2.30.3.4.1.3"
        name = "fan_status"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.15397.2.30.3.4.1.4"
        name = "fan_unit"
    # ---- 内存/电源：HW-SENSORS 无内存利用率与独立 PSU 表，不采集。----

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    raw = metric.fields.get("procera_cpu_load")
    if raw != None:
        value = float(raw)
        if value >= 0.0 and value <= 4294967294.0:
            metric.fields["procera_cpu_load"] = value
        else:
            metric.fields.pop("procera_cpu_load")
    f = metric.fields
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["procera"]

[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def is_sentinel(v):
    n = int(v)
    if n == 65535 or n == 65534 or n == -1:
        return True
    if n == 2147483647 or n == -2147483648:
        return True
    if n == 4294967295:
        return True
    return False

def round1(x):
    if x >= 0.0:
        return float(int(x * 10.0 + 0.5)) / 10.0
    return float(int(x * 10.0 - 0.5)) / 10.0

def unit_kind(raw):
    if raw == None:
        return None
    u = str(raw).lower().strip()
    if u == "c" or u == "celsius" or u == "degrees c" or u == "degree c" or u == "degc" or u == "deg c" or u == "°c":
        return "c"
    if u == "f" or u == "fahrenheit" or u == "degrees f" or u == "degree f" or u == "degf" or u == "deg f" or u == "°f":
        return "f"
    if u == "k" or u == "kelvin" or u == "degrees k" or u == "degree k" or u == "degk" or u == "deg k":
        return "k"
    return None

def apply(metric):
    unit_raw = metric.fields.pop("temp_unit", None)
    raw = metric.fields.get("celsius")
    if raw == None:
        return None
    if is_sentinel(raw):
        return None
    kind = unit_kind(unit_raw)
    if kind == None:
        return None
    value = float(raw)
    if kind == "f":
        value = round1((value - 32.0) * 5.0 / 9.0)
    elif kind == "k":
        value = round1(value - 273.15)
    if value < -40.0 or value > 125.0:
        return None
    metric.fields["celsius"] = value
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["procera"]

[[processors.starlark]]
    namepass = ["device_fan"]
    source = '''
def is_sentinel(v):
    n = int(v)
    if n == 65535 or n == 65534 or n == -1:
        return True
    if n == 2147483647 or n == -2147483648:
        return True
    if n == 4294967295:
        return True
    return False

def map_status(raw):
    if raw == None:
        return None
    s = str(raw).lower().strip()
    if s == "ok":
        return 1
    if s == "cr" or s == "nr" or s == "critical" or s == "non-recoverable" or s == "nc":
        return 2
    return None

def apply(metric):
    unit_raw = metric.fields.pop("fan_unit", None)
    status_raw = metric.fields.pop("fan_status", None)
    u = ""
    if unit_raw != None:
        u = str(unit_raw).lower().strip()
    if u != "rpm":
        return None
    raw = metric.fields.get("speed")
    keep_speed = False
    if raw != None and not is_sentinel(raw):
        value = float(raw)
        if value >= 0.0 and value <= 30000.0:
            metric.fields["speed"] = value
            keep_speed = True
    if not keep_speed:
        metric.fields.pop("speed", None)
    mapped = map_status(status_raw)
    if mapped != None:
        metric.fields["state"] = mapped
    f = metric.fields
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["procera"]
