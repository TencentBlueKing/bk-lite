[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_paloalto"
        config_type = "paloalto"
        brand = "paloalto"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Palo Alto CPU usage (HOST-RESOURCES hrProcessorLoad, per-core %, headline avg by instance) ----
    # 待现网核验：1.3.6.1.2.1.25.3.3.1.2（每核 0-100%，共享盘 avg by instance_id 取整机均值）。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.3.3.1.2"
        name = "usage"
    # ---- Palo Alto memory (PAN-COMMON-MIB panhrStorageTable; used/total = used×units / size×units) ----
    # 待现网核验：Descr 1.3.6.1.4.1.25461.2.1.2.12.3.1.3；AllocationUnits ...12.3.1.4；
    #   Size ...12.3.1.5；Used ...12.3.1.6；Available ...12.3.1.7（可选）。
    #   starlark 按 descr 保留 RAM 行（Memory / Physical Memory / Real Memory / RAM）。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.12.3.1.3"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.12.3.1.4"
        name = "allocation_units"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.12.3.1.5"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.12.3.1.6"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.12.3.1.7"
        name = "available"
    # ---- Palo Alto firewall-specific session health (PAN-COMMON-MIB panSession, scalars) ----
    # PAN-COMMON-MIB panSession = 1.3.6.1.4.1.25461.2.1.2.3。待现网核验。
    #   panSessionUtilization .1.0(%) / panSessionMax .2.0 / panSessionActive .3.0 /
    #   panSessionActiveTcp .4.0 / panSessionActiveUdp .5.0 / panSessionActiveICMP .6.0
    [[inputs.snmp.table]]
        name = "firewall"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.3.1"
        name = "session_utilization"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.3.2"
        name = "max_sessions"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.3.3"
        name = "active_sessions"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.3.4"
        name = "active_sessions_tcp"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.3.5"
        name = "active_sessions_udp"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.25461.2.1.2.3.6"
        name = "active_sessions_icmp"

[[processors.starlark]]
    namepass = ["device_memory"]
    source = '''
def apply(metric):
    descr = metric.tags.get("descr", "").lower().strip()
    if not descr:
        return None
    if "swap" in descr or "cached" in descr or "buffer" in descr or "virtual" in descr or "shared" in descr:
        return None
    if descr == "memory" or descr == "ram" or "physical memory" in descr or "real memory" in descr:
        return metric
    return None
'''
# ---- 温度/风扇/电源：Palo Alto 走 PAN-ENTITY-EXT entity-sensor（需按 entPhySensorType 行级过滤）。----
# ---- telegraf inputs.snmp 不能按传感器类型过滤 → 标 N/A 不采（架构限制，同 fortinet/checkpoint 温度）。----
