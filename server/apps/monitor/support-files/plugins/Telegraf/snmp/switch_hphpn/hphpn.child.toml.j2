[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_hphpn"
        config_type = "hphpn"
        brand = "hphpn"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：STATISTICS-MIB hpSwitchCpuStat 标量，顶层 field GET 必须带实例 .0；禁止 table.field+.0 ----
    # 发现身份为 sysObjectID 前缀 1.3.6.1.4.1.11.2.3.7.11（ProCurve / ArubaOS-Switch）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.11.2.14.11.5.1.9.6.1.0"
        name = "device_cpu_usage"
    # ---- 内存：NETSWITCH-MIB hpLocalMem 表，used/total 字节；table.field 不得带 .0 ----
    # hpLocalMemAllocBytes ...1.1.1.7；hpLocalMemTotalBytes ...1.1.1.5。利用率 used/total。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.11.2.14.11.5.1.1.2.1.1.1.7"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.11.2.14.11.5.1.1.2.1.1.1.5"
        name = "total"
# ---- 温度/风扇/电源：HP 的温度走 ENTITY-SENSOR entPhySensorValue(需按 entPhySensorType 行过滤)、----
# ---- 风扇/电源同在 hpicfSensorTable(fan+psu+temp 混表,需按 hpicfSensorObjectId/entPhysicalClass 行过滤区分)。----
# ---- telegraf inputs.snmp 不能行级 类型/类 过滤 → 直采会把不同传感器混进同字段 → 标 N/A 不采(架构限制,同 mellanox/arista 温度)。----
