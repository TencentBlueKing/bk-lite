{
  "object": "Wireless",
  "plugin": "Wireless Airspan SNMP",
  "templates": [
    {
      "name": "Airspan无线设备传感器温度过高",
      "alert_name": "无线设备${resource_name} 传感器温度过高",
      "description": "监控 Airspan 无线设备传感器温度，超过阈值时触发告警，提示可能存在散热不良、环境温度过高或硬件热压力。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 70,
          "method": ">"
        },
        {
          "level": "error",
          "value": 60,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 55,
          "method": ">"
        }
      ]
    }
  ]
}
