{
  "collector": "Telegraf",
  "collect_type": "snmp_bluecat",
  "plugin": "NetworkService BlueCat SNMP",
  "plugin_desc": "SNMP monitoring template for BlueCat network service device. It reports uptime, CPU utilization, memory utilization, and interface traffic (enterprise PEN 13315).",
  "support_collect_detect": true,
  "status_query": "any({instance_type='network_service', collect_type='snmp_bluecat'}) by (instance_id)",
  "name": "NetworkService",
  "icon": "mm-network_service_网络服务",
  "type": "Network Device",
  "description": "",
  "default_metric": "any({instance_type='network_service'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "snmp_uptime",
    "network_service_bluecat_dns_state",
    "device_cpu_usage",
    "device_memory_usage"
  ],
  "metrics": [
    {
      "metric_group": "NetworkService",
      "name": "network_service_bluecat_dns_state",
      "query": "max(network_service_bluecat_dns_state{instance_type='network_service', __$labels__}) by (instance_id)",
      "display_name": "BlueCat DNS Status",
      "data_type": "Enum",
      "unit": "none",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "BCN-DNS operational state. Value 1 is running/healthy; every other value is treated as fault."
    },
    {
      "metric_group": "NetworkService",
      "name": "network_service_bluecat_dns_query_success",
      "query": "rate(network_service_bluecat_dns_query_success{instance_type='network_service', __$labels__}[5m])",
      "display_name": "BlueCat DNS Successful Queries",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Rate of BCN-DNS queries that resulted in a successful answer over the past five minutes."
    },
    {
      "metric_group": "NetworkService",
      "name": "device_cpu_usage",
      "query": "100 - avg(device_cpu_idle{instance_type='network_service', __$labels__}) by (instance_id)",
      "display_name": "CPU Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "CPU utilization derived from UCD-SNMP idle percent (100 minus ssCpuIdle) as documented for BlueCat DNS/DHCP servers."
    },
    {
      "metric_group": "NetworkService",
      "name": "device_memory_usage",
      "query": "avg((device_memory_total{instance_type='network_service', __$labels__} - device_memory_free{instance_type='network_service', __$labels__}) / clamp_min(device_memory_total{instance_type='network_service', __$labels__}, 1) * 100) by (instance_id)",
      "display_name": "Memory Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Memory utilization derived from UCD-SNMP memTotalReal and memTotalFree as documented for BlueCat DNS/DHCP servers."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCInOctets",
      "query": "rate(interface_ifHCInOctets{instance_type='network_service', __$labels__}[5m])",
      "display_name": "Interface Incoming Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average inbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCInOctets counter."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCOutOctets",
      "query": "rate(interface_ifHCOutOctets{instance_type='network_service', __$labels__}[5m])",
      "display_name": "Interface Outgoing Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Average outbound interface bytes per second over five minutes from the 64-bit IF-MIB ifHCOutOctets counter."
    },
    {
      "metric_group": "Base",
      "name": "snmp_uptime",
      "query": "sum(snmp_uptime{instance_type='network_service', __$labels__}/100) by (instance_id)",
      "display_name": "System Uptime",
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Device uptime since the last restart, derived from sysUpTime."
    }
  ]
}
