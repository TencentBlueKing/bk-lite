[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_alaxala"
        config_type = "alaxala"
        brand = "alaxala"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Alaxala 机箱表（AlaxalA 私有 MIB，PEN 21839），各机型在 axsEx 下有独立分支，列布局相同 ----
    # 列：.11 <机型>CpuLoad1m（1 分钟 CPU 使用率 0~100 %）；.8 <机型>MemoryUsedSize / .9 <机型>MemoryFreeSize（单位 kB）。
    # 设备只会应答自己机型的分支，其它分支 walk 为空、不产生数据。内存 kB → 字节由下方 starlark 换算。
    # AX2430S（axsEx 6）：ax2430sChassisEntry 1.3.6.1.4.1.21839.2.2.6.2.1.2.1.<列>.<机箱索引>（table.field 不带 .0）。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21839.2.2.6.2.1.2.1.11"
        name = "usage"
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21839.2.2.6.2.1.2.1.8"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21839.2.2.6.2.1.2.1.9"
        name = "free"
    # AX3650S（axsEx 15）：ax3650sChassisEntry 1.3.6.1.4.1.21839.2.2.15.2.1.2.1.<列>.<机箱索引>（table.field 不带 .0）。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21839.2.2.15.2.1.2.1.11"
        name = "usage"
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21839.2.2.15.2.1.2.1.8"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21839.2.2.15.2.1.2.1.9"
        name = "free"
    # AX3830S（axsEx 17）：ax3830sChassisEntry 1.3.6.1.4.1.21839.2.2.17.2.1.2.1.<列>.<机箱索引>（table.field 不带 .0）。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21839.2.2.17.2.1.2.1.11"
        name = "usage"
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21839.2.2.17.2.1.2.1.8"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.21839.2.2.17.2.1.2.1.9"
        name = "free"
# ---- 温度/风扇/电源：N/A 不采。----
# ---- 机箱表只有温度监视点数量与离散温度状态，非可轮询摄氏度数值 → 温度不采。----
# ---- 风扇/电源状态表未纳入本模板 → N/A。----

# ---- CPU：超出 0~100 的值丢弃。----
[[processors.starlark]]
    namepass = ["device_cpu"]
    source = '''
def apply(metric):
    usage = metric.fields.get("usage")
    if type(usage) not in ["int", "float"] or usage < 0 or usage > 100:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["alaxala"]

# ---- 内存：MemoryUsedSize / MemoryFreeSize 单位为 kB，×1024 换算为字节；缺值、负值或 used+free 为 0 时丢弃整行。----
[[processors.starlark]]
    namepass = ["device_memory"]
    source = '''
def apply(metric):
    used = metric.fields.get("used")
    free = metric.fields.get("free")
    if type(used) not in ["int", "float"] or type(free) not in ["int", "float"]:
        return None
    if used < 0 or free < 0 or used + free <= 0:
        return None
    metric.fields["used"] = int(used) * 1024
    metric.fields["free"] = int(free) * 1024
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["alaxala"]
