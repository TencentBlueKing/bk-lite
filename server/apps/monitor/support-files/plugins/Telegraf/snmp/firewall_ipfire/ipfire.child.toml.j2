[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_ipfire"
        config_type = "ipfire"
        brand = "ipfire"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- UCD-SNMP-MIB systemStats 1.3.6.1.4.1.2021.11：标量，顶层 field 带 .0 → measurement snmp ----
    # ssCpuIdle .11.0 / ssCpuUser .9.0 / ssCpuSystem .10.0：Integer32 百分比；starlark 输出 device_cpu_usage = 100−idle，缺 idle 时用 user+system。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.11.0"
        name = "cpu_idle_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.9.0"
        name = "cpu_user_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.11.10.0"
        name = "cpu_system_raw"
    # ---- UCD-SNMP-MIB memory 1.3.6.1.4.1.2021.4：标量，顶层 field 带 .0 → measurement snmp ----
    # memTotalReal .4.5.0 / memAvailReal .4.6.0：Integer32 kB；starlark ×1024 输出 device_memory_total / free / used 字节与 device_memory_usage。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "mem_total_kb_raw"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.6.0"
        name = "mem_avail_kb_raw"
    # ---- 回退：HOST-RESOURCES-MIB hrProcessorLoad 1.3.6.1.2.1.25.3.3.1.2（每核 %，table.field 不带 .0）----
    [[inputs.snmp.table]]
        name = "device_cpu_hr"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.3.3.1.2"
        name = "usage"
    # ---- 回退：HOST-RESOURCES-MIB hrStorageTable 1.3.6.1.2.1.25.2.3.1（按列 walk，table.field 不带 .0），starlark 只保留 hrStorageRam 行 ----
    [[inputs.snmp.table]]
        name = "device_memory_hr"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.2"
        name = "storage_type"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.4"
        name = "alloc_units"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.5"
        name = "size"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.6"
        name = "used_units"
# ---- 温度/风扇/电源：IPFire 为通用 x86 软件防火墙，Net-SNMP 无厂商环境传感器对象，不采集。----

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def pct(v):
    return v != None and type(v) in ["int", "float"] and v >= 0 and v <= 100

def apply(metric):
    idle = metric.fields.pop("cpu_idle_raw", None)
    user = metric.fields.pop("cpu_user_raw", None)
    system = metric.fields.pop("cpu_system_raw", None)
    if pct(idle):
        metric.fields["device_cpu_usage"] = 100 - idle
    elif pct(user) and pct(system) and user + system <= 100:
        metric.fields["device_cpu_usage"] = user + system
    total = metric.fields.pop("mem_total_kb_raw", None)
    avail = metric.fields.pop("mem_avail_kb_raw", None)
    if type(total) == "int" and type(avail) == "int" and total > 0 and avail >= 0 and avail <= total:
        metric.fields["device_memory_total"] = total * 1024
        metric.fields["device_memory_free"] = avail * 1024
        metric.fields["device_memory_used"] = (total - avail) * 1024
        metric.fields["device_memory_usage"] = (total - avail) * 100.0 / total
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["ipfire"]

[[processors.starlark]]
    namepass = ["device_memory_hr"]
    source = '''
def apply(metric):
    storage_type = str(metric.fields.pop("storage_type", ""))
    units = metric.fields.pop("alloc_units", None)
    size = metric.fields.pop("size", None)
    used = metric.fields.pop("used_units", None)
    if not (storage_type.endswith("1.3.6.1.2.1.25.2.1.2") or storage_type.endswith("hrStorageRam")):
        return None
    if type(units) != "int" or type(size) != "int" or type(used) != "int":
        return None
    if units <= 0 or size <= 0 or used < 0 or used > size:
        return None
    metric.fields["total"] = size * units
    metric.fields["used"] = used * units
    metric.fields["free"] = (size - used) * units
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["ipfire"]
