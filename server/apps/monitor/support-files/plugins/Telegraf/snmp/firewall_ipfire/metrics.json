{
  "collector": "Telegraf",
  "collect_type": "snmp_ipfire",
  "plugin": "Firewall IPFire SNMP",
  "plugin_desc": "SNMP monitoring template for IPFire firewall. It reports uptime, CPU utilization, memory utilization, and interface traffic via Net-SNMP UCD-SNMP-MIB (enterprise PEN 2021) with HOST-RESOURCES fallback.",
  "support_collect_detect": true,
  "status_query": "any({instance_type='firewall', collect_type='snmp_ipfire'}) by (instance_id)",
  "name": "Firewall",
  "icon": "mm-firewall_防火墙",
  "type": "Network Device",
  "description": "",
  "default_metric": "any({instance_type='firewall'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "snmp_uptime",
    "device_cpu_usage",
    "device_memory_usage",
    "device_total_incoming_traffic",
    "device_total_outgoing_traffic"
  ],
  "metrics": [
    {
      "metric_group": "Base",
      "name": "snmp_uptime",
      "query": "sum(snmp_uptime{instance_type='firewall', __$labels__}/100) by (instance_id)",
      "display_name": "System Uptime",
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the uptime of the device since the last restart. By monitoring the uptime, network administrators can understand the stability and reliability of the device and identify potential reboot or failure issues."
    },
    {
      "metric_group": "Firewall",
      "name": "device_cpu_usage",
      "query": "max(snmp_device_cpu_usage{instance_type='firewall', __$labels__}) by (instance_id) or avg(device_cpu_hr_usage{instance_type='firewall', __$labels__}) by (instance_id)",
      "display_name": "CPU Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Overall CPU utilization of the IPFire firewall, computed as 100 minus UCD-SNMP ssCpuIdle (falling back to ssCpuUser plus ssCpuSystem), then to the average HOST-RESOURCES hrProcessorLoad across cores."
    },
    {
      "metric_group": "Firewall",
      "name": "device_memory_usage",
      "query": "max(snmp_device_memory_usage{instance_type='firewall', __$labels__}) by (instance_id) or (100 * sum(device_memory_hr_used{instance_type='firewall', __$labels__}) by (instance_id) / sum(device_memory_hr_total{instance_type='firewall', __$labels__}) by (instance_id))",
      "display_name": "Memory Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Physical memory utilization of the IPFire firewall, computed as (memTotalReal − memAvailReal) / memTotalReal from UCD-SNMP, falling back to the HOST-RESOURCES hrStorage RAM row."
    },
    {
      "metric_group": "Firewall",
      "name": "device_memory_total",
      "query": "max(snmp_device_memory_total{instance_type='firewall', __$labels__}) by (instance_id) or sum(device_memory_hr_total{instance_type='firewall', __$labels__}) by (instance_id)",
      "display_name": "Total Memory",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Total physical memory in bytes (UCD-SNMP memTotalReal kB × 1024, or HOST-RESOURCES hrStorageSize × allocation units for the RAM row)."
    },
    {
      "metric_group": "Firewall",
      "name": "device_memory_free",
      "query": "max(snmp_device_memory_free{instance_type='firewall', __$labels__}) by (instance_id) or sum(device_memory_hr_free{instance_type='firewall', __$labels__}) by (instance_id)",
      "display_name": "Free Memory",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Available physical memory in bytes (UCD-SNMP memAvailReal kB × 1024, or HOST-RESOURCES RAM size minus used)."
    },
    {
      "metric_group": "Firewall",
      "name": "device_memory_used",
      "query": "max(snmp_device_memory_used{instance_type='firewall', __$labels__}) by (instance_id) or sum(device_memory_hr_used{instance_type='firewall', __$labels__}) by (instance_id)",
      "display_name": "Used Memory",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "Used physical memory in bytes (UCD-SNMP total minus available, or HOST-RESOURCES hrStorageUsed × allocation units for the RAM row)."
    },
    {
      "metric_group": "Status",
      "name": "interface_ifAdminStatus",
      "query": "interface_ifAdminStatus{instance_type='firewall', __$labels__}",
      "display_name": "Interface Admin Status",
      "data_type": "Enum",
      "unit": "[{\"name\":\"up\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"down\",\"id\":2,\"color\":\"#ff4d4f\"},{\"name\":\"testing\",\"id\":3,\"color\":\"#faad14\"}]",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the administrative status of the network interface."
    },
    {
      "metric_group": "Status",
      "name": "interface_ifOperStatus",
      "query": "interface_ifOperStatus{instance_type='firewall', __$labels__}",
      "display_name": "Interface Oper Status",
      "data_type": "Enum",
      "unit": "[{\"name\":\"up\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"down\",\"id\":2,\"color\":\"#ff4d4f\"},{\"name\":\"testing\",\"id\":3,\"color\":\"#faad14\"}]",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric reflects the actual operational status of the network interface."
    },
    {
      "metric_group": "Bandwidth",
      "name": "interface_ifSpeed",
      "query": "interface_ifSpeed{instance_type='firewall', __$labels__}",
      "display_name": "Interface Bandwidth",
      "data_type": "Number",
      "unit": "bitps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the maximum data transmission speed supported by the network interface."
    },
    {
      "metric_group": "Packet Error",
      "name": "interface_ifInErrors",
      "query": "rate(interface_ifInErrors{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Incoming Errors Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric calculates the average rate of incoming error packets over the past 5 minutes."
    },
    {
      "metric_group": "Packet Error",
      "name": "interface_ifOutErrors",
      "query": "rate(interface_ifOutErrors{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Outgoing Errors Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric calculates the average rate of outgoing error packets over the past 5 minutes."
    },
    {
      "metric_group": "Packet Loss",
      "name": "interface_ifInDiscards",
      "query": "rate(interface_ifInDiscards{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Incoming Discards Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric represents the average rate of incoming discarded packets over the past 5 minutes."
    },
    {
      "metric_group": "Packet Loss",
      "name": "interface_ifOutDiscards",
      "query": "rate(interface_ifOutDiscards{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Outgoing Discards Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric calculates the average rate of outgoing discarded packets over the past 5 minutes."
    },
    {
      "metric_group": "Packet",
      "name": "interface_ifInUcastPkts",
      "query": "rate(interface_ifInUcastPkts{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Incoming Unicast Packets Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the average rate of incoming unicast packets over the past 5 minutes."
    },
    {
      "metric_group": "Packet",
      "name": "interface_ifOutUcastPkts",
      "query": "rate(interface_ifOutUcastPkts{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Outgoing Unicast Packets Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric calculates the average rate of outgoing unicast packets over the past 5 minutes."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifInOctets",
      "query": "rate(interface_ifInOctets{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Interface Incoming Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the average rate of bytes received over the past 5 minutes."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifOutOctets",
      "query": "rate(interface_ifOutOctets{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Interface Outgoing Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric calculates the average rate of bytes sent over the past 5 minutes."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCInOctets",
      "query": "rate(interface_ifHCInOctets{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Interface Incoming Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the average rate of bytes received over the past 5 minutes, based on the 64-bit ifHCInOctets counter which does not wrap on high-speed interfaces."
    },
    {
      "metric_group": "Traffic",
      "name": "interface_ifHCOutOctets",
      "query": "rate(interface_ifHCOutOctets{instance_type='firewall', __$labels__}[5m])",
      "display_name": "Interface Outgoing Traffic Rate (HC)",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [
        {
          "name": "ifDescr",
          "description": "ifDescr"
        }
      ],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric calculates the average rate of bytes sent over the past 5 minutes, based on the 64-bit ifHCOutOctets counter which does not wrap on high-speed interfaces."
    },
    {
      "metric_group": "Traffic",
      "name": "device_total_incoming_traffic",
      "query": "sum(rate(interface_ifHCInOctets{instance_type='firewall', __$labels__}[5m])) by (instance_id)",
      "display_name": "Device Total Incoming Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric indicates the average rate of total bytes received by the entire device over the past 5 minutes."
    },
    {
      "metric_group": "Traffic",
      "name": "device_total_outgoing_traffic",
      "query": "sum(rate(interface_ifHCOutOctets{instance_type='firewall', __$labels__}[5m])) by (instance_id)",
      "display_name": "Device Total Outgoing Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [],
      "instance_id_keys": [
        "instance_id"
      ],
      "description": "This metric represents the average rate of total bytes sent by the entire device over the past 5 minutes."
    }
  ]
}
