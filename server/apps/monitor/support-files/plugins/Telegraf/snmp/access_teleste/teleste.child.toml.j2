[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_teleste"
        config_type = "teleste"
        brand = "teleste"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"

    # Teleste common element MIB (PEN 3715, common = 1.3.6.1.4.1.3715.99).
    # statusFan (elementStatus .99.1.2.6.0) is a scalar: fanNormal(1) / fanFailure(2) for all fans of the element.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3715.99.1.2.6.0"
        name = "device_fan_state"

    # Per-module internal temperature: moduleStatusTable (.99.2.2.1.1, INDEX moduleId).
    # statusInternalTemperature .3 is in 0.1 degC, 0 = not available; moduleName (moduleTable .99.2.1.1.1.2) is the module tag.
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3715.99.2.1.1.1.2"
        name = "module"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3715.99.2.2.1.1.3"
        name = "celsius"

# Fan state: fanNormal(1) -> 1, fanFailure(2) and anything else -> 2.
[[processors.enum]]
    namepass = ["snmp"]
    [[processors.enum.mapping]]
        field = "device_fan_state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
    [processors.enum.tagpass]
        brand = ["teleste"]

# Temperature: 0.1 degC -> degC; 0 means not available and the row is dropped.
[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    raw = metric.fields.get("celsius")
    if raw == None:
        return None
    raw = int(raw)
    if raw == 0:
        return None
    metric.fields["celsius"] = raw / 10.0
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["teleste"]
