[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_yeastar"
        config_type = "yeastar"
        brand = "yeastar"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"

    # ---- Yeastar P-Series 私有健康标量（IANA PEN 22736）----
    # pCPUUtilization 1.3.6.1.4.1.22736.3.1.8.0：百分比文本，解析为 cpu_usage_percent。
    [[inputs.snmp.table]]
        name = "cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.22736.3.1.8.0"
        name = "usage_percent"
    # pMemoryUsage 1.3.6.1.4.1.22736.3.1.7.0：百分比文本，解析为 memory_usage_percent。
    [[inputs.snmp.table]]
        name = "memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.22736.3.1.7.0"
        name = "usage_percent"
    # pLocalStorageUsage 1.3.6.1.4.1.22736.3.1.6.0：百分比文本，解析为 local_storage_usage_percent。
    [[inputs.snmp.table]]
        name = "local_storage"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.22736.3.1.6.0"
        name = "usage_percent"
    # pConcurrentCall 1.3.6.1.4.1.22736.3.1.9.0：Integer32 并发通话数。
    [[inputs.snmp.table]]
        name = "concurrent"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.22736.3.1.9.0"
        name = "calls"
        conversion = "int"
    # pAsteriskStatus 1.3.6.1.4.1.22736.3.1.11.0：running(1)/stopped(2)，下方 enum 归一。
    [[inputs.snmp.table]]
        name = "asterisk"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.22736.3.1.11.0"
        name = "status"
        conversion = "int"
# ---- 不扩展 IF-MIB 错误计数、ifOperStatus 或 32 位字节计数器。----

[[processors.starlark]]
    namepass = ["cpu", "memory", "local_storage"]
    source = '''
def parse_percent(raw):
    if raw == None:
        return None
    text = str(raw).strip()
    if text.endswith("%"):
        text = text[:-1].strip()
    if text == "":
        return None
    return float(text)

def apply(metric):
    parsed = parse_percent(metric.fields.get("usage_percent"))
    if parsed == None:
        return None
    metric.fields["usage_percent"] = parsed
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["yeastar"]

[[processors.enum]]
    namepass = ["asterisk"]
    [processors.enum.tagpass]
        brand = ["yeastar"]
    [[processors.enum.mapping]]
        field = "status"
        dest = "status"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            1 = 1
