[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_rubytech"
        config_type = "rubytech"
        brand = "rubytech"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- sysObjectID：型号分支选择，禁止混用 FGS2924R / ES2226 私有树 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.2.0"
        name = "sysObjectID"
        is_tag = true
# @bk_include_ifmib_table
    # ---- FGS2924R 型号分支（sysObjectID 1.3.6.1.4.1.5205.2.34）----
    # fgs2924rCpuLoad DisplayString（含 %）解析为 cpu_usage_percent。
    # fgs2924rRamSize 1.3.6.1.4.1.5205.2.34.1.1.1.9 仅为容量，不作为使用率，不采。
    [[inputs.snmp.table]]
        name = "cpu_fgs2924r"
        inherit_tags = ["source", "sysObjectID"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5205.2.34.1.1.1.13"
        name = "usage_percent"
    # ---- ES2226 型号分支（sysObjectID 1.3.6.1.4.1.5205.2.31）----
    # es2226CPULoad DisplayString（含 %）解析为 cpu_usage_percent。
    # es2226RamSize 1.3.6.1.4.1.5205.2.31.1.1.1.9 仅为容量，不作为使用率，不采。
    [[inputs.snmp.table]]
        name = "cpu_es2226"
        inherit_tags = ["source", "sysObjectID"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5205.2.31.1.1.1.11"
        name = "usage_percent"
# ---- 温度/风扇/电源：无已确认的整机健康标量 → N/A 不采。----

[[processors.starlark]]
    namepass = ["cpu_fgs2924r", "cpu_es2226"]
    source = '''
def parse_percent(raw):
    if raw == None:
        return None
    t = type(raw)
    if t == "int":
        return float(raw)
    if t == "float":
        return raw
    text = str(raw)
    digits = ""
    started = False
    i = 0
    while i < len(text):
        c = text[i]
        if c >= "0" and c <= "9":
            digits += c
            started = True
        elif c == "." and started:
            if "." not in digits:
                digits += c
        elif started:
            break
        i += 1
    if digits == "" or digits == ".":
        return None
    return float(digits)

def oid_arc_matches(s, prefix):
    n = len(s)
    p = len(prefix)
    i = 0
    while i + p <= n:
        if s[i:i+p] == prefix:
            if i + p == n or s[i+p] == ".":
                return True
        i += 1
    return False

def oid_matches(soid, prefix):
    s = str(soid)
    if len(s) > 0 and s[0] == ".":
        s = s[1:]
    tail = prefix
    root = "1.3.6.1.4.1."
    if prefix[:len(root)] == root:
        tail = prefix[len(root):]
    return oid_arc_matches(s, prefix) or oid_arc_matches(s, tail)

def apply(metric):
    soid = metric.tags.get("sysObjectID", "")
    name = metric.name
    if name == "cpu_fgs2924r":
        if not oid_matches(soid, "1.3.6.1.4.1.5205.2.34"):
            return None
    elif name == "cpu_es2226":
        if not oid_matches(soid, "1.3.6.1.4.1.5205.2.31"):
            return None
    else:
        return None
    value = parse_percent(metric.fields.get("usage_percent"))
    if value == None:
        return None
    metric.name = "cpu"
    metric.fields["usage_percent"] = value
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["rubytech"]
