{
  "object": "NetworkService",
  "plugin": "NetworkService Hikvision SNMP",
  "templates": [
    {
      "name": "Hikvision网络服务CPU使用率过高",
      "alert_name": "网络服务${resource_name} CPU 使用率过高",
      "description": "监控海康威视摄像机/NVR 的 CPU 使用率，当持续高于阈值时触发告警，提示设备负载过高可能影响编码与录像。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
