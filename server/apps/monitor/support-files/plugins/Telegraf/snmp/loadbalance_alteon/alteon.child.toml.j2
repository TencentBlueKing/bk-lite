[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_alteon"
        config_type = "alteon"
        brand = "alteon"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Radware Alteon CPU / 内存（ALTEON-CHEETAH-SWITCH-MIB agentStats，PEN 1872）：标量，顶层 field 带 .0 → measurement snmp，查询用 snmp_ 前缀 ----
    # mpCpuStatsUtil1Second 1.3.6.1.4.1.1872.2.5.1.2.2.1.0：MP CPU 1 秒利用率，Integer32 直接 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1872.2.5.1.2.2.1.0"
        name = "device_cpu_usage"
    # mpMemStatsTotal .1872.2.5.1.2.8.1.0 / mpMemStatsFree .1872.2.5.1.2.8.3.0：Integer32 字节；使用率 = (total-free)/total。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1872.2.5.1.2.8.1.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1872.2.5.1.2.8.3.0"
        name = "device_memory_free"
# ---- 连接/温度/风扇/电源：Alteon CHEETAH MIB 未暴露标量会话/温/风/电(或 per-row 混表) → N/A。----

# ---- 无效值丢弃：CPU 超出 0~100 丢弃；内存总量 <= 0、空闲 < 0 或空闲大于总量时两个内存字段一起丢弃。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    cpu = metric.fields.get("device_cpu_usage")
    if cpu != None and (cpu < 0 or cpu > 100):
        metric.fields.pop("device_cpu_usage")
    total = metric.fields.get("device_memory_total")
    free = metric.fields.get("device_memory_free")
    if total != None or free != None:
        if total == None or free == None or total <= 0 or free < 0 or free > total:
            metric.fields.pop("device_memory_total", None)
            metric.fields.pop("device_memory_free", None)
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["alteon"]
