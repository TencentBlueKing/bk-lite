[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_firebrick"
        config_type = "firebrick"
        brand = "firebrick"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- FireBrick CPU（FIREBRICK-CPU-MIB fbCpuUsageTable，INDEX {fbCpuPeriod, fbCpuCore}）----
    # fbCpuAll 精确 GET 实例 .0.1：period=0（最近 1 秒瞬时值）、core=1；这里的 .0 是 period 索引。
    # 单位为百分之一的百分点（10000=100%），下方 starlark ÷100 → device_cpu_usage（0-100）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.24693.100.2.1.1.2.0.1"
        name = "cpu_all_raw"
    # ---- FireBrick 内存（FIREBRICK-GLOBAL fbGlobalMemory）：fbTotalMem .1.0 / fbFreeMem .2.0，标量，单位 KiB ----
    # 下方 starlark ×1024 → device_memory_total / device_memory_free（字节）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.24693.100.4.1.1.0"
        name = "memory_total_kib"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.24693.100.4.1.2.0"
        name = "memory_free_kib"
# ---- 温度/风扇：监控读数表按行混排多种类型（类型/名称为文本列），采集端无法按类型过滤 → N/A 不采。电源：无对应对象 → N/A。----
# ---- 单位换算：CPU 百分之一百分点 ÷100；内存 KiB ×1024。原始字段换算后删除。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    cpu = metric.fields.pop("cpu_all_raw", None)
    if cpu != None:
        metric.fields["device_cpu_usage"] = float(cpu) / 100.0
    total = metric.fields.pop("memory_total_kib", None)
    if total != None:
        metric.fields["device_memory_total"] = int(total) * 1024
    free = metric.fields.pop("memory_free_kib", None)
    if free != None:
        metric.fields["device_memory_free"] = int(free) * 1024
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["firebrick"]
