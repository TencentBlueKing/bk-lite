[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_siae"
        config_type = "siae"
        brand = "siae"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- SIAE equipment temperature: sensorTempValue, degrees Celsius ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3373.1103.77.2.1.9"
        name = "sensor_label"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3373.1103.77.2.1.2"
        name = "celsius"
    # ---- SIAE power supply: SIAE-POWER-SUPPLY-MIB pwrSupplyTable 1.3.6.1.4.1.3373.1103.89.2，行索引 pwrSupplyIndex，table.field 不带 .0 ----
    # pwrSupplyLabel .1.3 作 label 标签；pwrSupplyAdminStatus .1.4 disable(1)/enable(2)；
    # pwrSupplyAlarm .1.5 为 AlarmStatus：cleared(1)，activeReportable*(2-6) 为告警。下方 starlark 归一为 device_psu_state。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3373.1103.89.2.1.3"
        name = "label"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3373.1103.89.2.1.4"
        name = "admin"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3373.1103.89.2.1.5"
        name = "state"
        conversion = "int"
    # ---- CPU/内存/风扇：SIAE-SENSOR-TEMP-MIB 已确认设备温度与温度告警上下文；射频/链路/告警对象不提升为共享设备健康，未确认稳定 CPU、内存、风扇共享健康对象，避免臆造。 ----

[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    admin = metric.fields.pop("admin", None)
    if admin != None and int(admin) == 1:
        return None
    raw = metric.fields.get("state")
    if raw == None:
        return None
    value = int(raw)
    if value == 1:
        metric.fields["state"] = 1
    elif value >= 2 and value <= 6:
        metric.fields["state"] = 2
    else:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["siae"]
