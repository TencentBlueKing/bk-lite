[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_arista"
        config_type = "arista"
        brand = "arista"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：HOST-RESOURCES hrProcessorLoad，每核 0-100%，表列禁止 .0 ----
    # 列 OID 1.3.6.1.2.1.25.3.3.1.2。共享盘 avg by instance 取整机均值。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.3.3.1.2"
        name = "usage"
    # ---- 内存：HOST-RESOURCES hrStorageUsed/Size，表列禁止 .0 ----
    # descr 1.3.6.1.2.1.25.2.3.1.3；allocation units ...1.4；Size ...1.5；Used ...1.6。
    # starlark 按 hrStorageDescr 只保留 RAM 行，再把 allocation units 换成字节。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.3"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.4"
        name = "allocation_units"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.5"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.2.3.1.6"
        name = "used"
    # ---- 温度：ENTITY-SENSOR-MIB entPhySensorValue，表列禁止 .0 ----
    # type 1.3.6.1.2.1.99.1.1.1.1；scale ...1.2；precision ...1.3；value ...1.4。
    # starlark 只保留 type=celsius(8)，再按 scale/precision 换算为摄氏度。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.99.1.1.1.1"
        name = "sensor_type"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.99.1.1.1.2"
        name = "scale"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.99.1.1.1.3"
        name = "precision"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.99.1.1.1.4"
        name = "celsius"
    # ---- 风扇：ENTITY-MIB entPhysicalClass fan(7) + ENTITY-STATE entStateOper ----
    # class 1.3.6.1.2.1.47.1.1.1.1.5；name ...1.7；oper 1.3.6.1.2.1.131.1.1.1.3。
    # starlark 只保留 class=7 且 oper 有值；enum 将 enabled(3)→1(正常)，其余→2(异常)。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "entPhysicalClass"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.131.1.1.1.3"
        name = "state"
    # ---- 电源：ENTITY-MIB entPhysicalClass powerSupply(6) + 同一 entStateOper ----
    # starlark 只保留 class=6 且 oper 有值；枚举归一同风扇。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.5"
        name = "entPhysicalClass"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.131.1.1.1.3"
        name = "state"

# ---- 内存：只保留 RAM 行（hrStorageDescr），allocation units × used/size → 字节。----
[[processors.starlark]]
    namepass = ["device_memory"]
    source = '''
def apply(metric):
    descr = metric.tags.get("descr") or ""
    name = descr.strip().lower()
    if name != "ram" and name != "physical memory" and name != "real memory":
        return None
    units = metric.fields.get("allocation_units")
    if units == None or units == 0:
        units = 1
    used = metric.fields.get("used")
    total = metric.fields.get("total")
    if used != None:
        metric.fields["used"] = used * units
    if total != None:
        metric.fields["total"] = total * units
    if "allocation_units" in metric.fields:
        metric.fields.pop("allocation_units")
    if "descr" in metric.tags:
        metric.tags.pop("descr")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["arista"]

# ---- 温度：只保留 celsius(8)，value * 10^((scale-9)*3 - precision)。----
[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def pow10(exp):
    result = 1.0
    n = exp
    negative = False
    if n < 0:
        negative = True
        n = 0 - n
    i = 0
    while i < n:
        result = result * 10.0
        i = i + 1
    if negative:
        return 1.0 / result
    return result

def apply(metric):
    if metric.tags.get("sensor_type") != "8":
        return None
    value = metric.fields.get("celsius")
    if value == None:
        return None
    scale = metric.fields.get("scale")
    precision = metric.fields.get("precision")
    if scale == None:
        scale = 9
    if precision == None:
        precision = 0
    exp = (int(scale) - 9) * 3 - int(precision)
    metric.fields["celsius"] = float(value) * pow10(exp)
    if "scale" in metric.fields:
        metric.fields.pop("scale")
    if "precision" in metric.fields:
        metric.fields.pop("precision")
    if "sensor_type" in metric.tags:
        metric.tags.pop("sensor_type")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["arista"]

# ---- 风扇：只保留 ENTITY-MIB entPhysicalClass fan(7)，且必须有 oper 状态。----
[[processors.starlark]]
    namepass = ["device_fan"]
    source = '''
def apply(metric):
    if metric.tags.get("entPhysicalClass") != "7":
        return None
    if metric.fields.get("state") == None:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["arista"]

# ---- 电源：只保留 ENTITY-MIB entPhysicalClass powerSupply(6)，且必须有 oper 状态。----
[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    if metric.tags.get("entPhysicalClass") != "6":
        return None
    if metric.fields.get("state") == None:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["arista"]

# ---- 风扇状态归一：enabled(3)→1(正常)，unknown/disabled/testing 及其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "3" = 1

# ---- 电源状态归一：同 entStateOper；enabled(3)→1(正常)，其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "3" = 1
