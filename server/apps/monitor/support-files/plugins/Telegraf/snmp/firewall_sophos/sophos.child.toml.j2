[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_sophos"
        config_type = "sophos"
        brand = "sophos"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # Sophos SFOS 健康：顶层 field GET 必须带实例 .0；table.field 禁止 .0。
    # CPU 走 HOST-RESOURCES hrProcessorLoad 表（每核 0-100%，查询侧 avg）；内存/磁盘/温度为 PEN 2604 标量。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.3.3.1.2"
        name = "usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2604.5.1.2.5.2.0"
        name = "device_memory_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2604.5.1.2.5.1.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2604.5.1.2.4.2.0"
        name = "device_disk_usage"
    # SystemHealth：CPU/NPU 温度标量单位为十分之一摄氏度，查询侧 ÷10；风扇转速 RPM 表；电源 up(1)/down(2)。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2604.5.1.9.2.0"
        name = "device_temperature_celsius"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2604.5.1.9.1.0"
        name = "device_npu_temperature_celsius"
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2604.5.1.9.3.1.2"
        name = "speed"
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2604.5.1.9.4.1.2"
        name = "state"

# up(1)→1；down(2)/未知→2
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            "2" = 2
