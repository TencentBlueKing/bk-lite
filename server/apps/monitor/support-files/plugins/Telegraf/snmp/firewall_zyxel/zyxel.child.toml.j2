[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_zyxel_firewall"
        config_type = "zyxel"
        brand = "zyxel"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # Zyxel ZLD sysCPUUsage — INTEGER 0-100, scalar GET.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.890.1.6.22.1.1.0"
        name = "device_cpu_usage"
    # Zyxel ZLD sysRAMUsage — INTEGER 0-100, scalar GET. Direct percent; no byte total.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.890.1.6.22.1.2.0"
        name = "device_memory_usage"
    # Zyxel ZLD sysCPU5SecUsage / sysCPU1MinUsage / sysCPU5MinUsage — INTEGER 0-100.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.890.1.6.22.1.3.0"
        name = "device_cpu_usage_5s"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.890.1.6.22.1.4.0"
        name = "device_cpu_usage_1m"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.890.1.6.22.1.5.0"
        name = "device_cpu_usage_5m"
    # Zyxel ZLD sysSessionNum — current session/connection count, scalar GET.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.890.1.6.22.1.6.0"
        name = "firewall_active_sessions"
# Temperature/fan/power: ZLD common system tree has no chassis temperature, fan, or PSU gauge — N/A, not collected.
