[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_exalt"
        config_type = "exalt"
        brand = "exalt"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- ExaltComProducts (PEN 25651) 标量：顶层 field 带实例 .0 直接 GET，落 measurement snmp，查询用 snmp_ 前缀 ----
    # locCurrentTemp 1.3.6.1.4.1.25651.1.2.4.2.3.1.3.0 → device_temperature_celsius，Integer32 摄氏度，查询侧不缩放。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.25651.1.2.4.2.3.1.3.0"
        name = "device_temperature_celsius"
        conversion = "int"
    # 可选 locTempAlarm 1.3.6.1.4.1.25651.1.2.4.2.3.1.2.0 → device_temp_alarm
    # AlarmLevelT：almNORMAL(0)/almMINOR(1)/almMAJOR(2)。设备未实现该标量时字段缺省。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.25651.1.2.4.2.3.1.2.0"
        name = "device_temp_alarm"
        conversion = "int"
    # locCurrentRSL 1.3.6.1.4.1.25651.1.2.4.3.1.3.0 → rsl_dbm，Integer32 dBm，查询侧不缩放。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.25651.1.2.4.3.1.3.0"
        name = "rsl_dbm"
        conversion = "int"
    # 可选 locLinkState 1.3.6.1.4.1.25651.1.2.4.2.3.1.1.0 → device_link_state
    # AlarmLevelT：almNORMAL(0) 无误码连接 / almMINOR(1) 误码连接 / almMAJOR(2) 无链路。设备未实现该标量时字段缺省。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.25651.1.2.4.2.3.1.1.0"
        name = "device_link_state"
        conversion = "int"
# ---- CPU/内存/风扇/电源：ExaltComProducts 已确认内部温度、接收电平与可选温度/链路告警。无私有 CPU%/内存% 对象，不臆造。风扇与电源不是稳定共享健康对象，不采。----
