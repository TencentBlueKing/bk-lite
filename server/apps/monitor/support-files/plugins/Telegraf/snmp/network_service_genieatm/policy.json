{
  "object": "NetworkService",
  "plugin": "NetworkService GenieATM SNMP",
  "templates": [
    {
      "name": "GenieATM网络服务CPU使用率过高",
      "alert_name": "网络服务${resource_name} CPU 使用率过高",
      "description": "监控 GenieATM 设备的 CPU 使用率，当持续高于阈值时触发告警，提示流量分析负载过高。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "GenieATM网络服务内存使用率过高",
      "alert_name": "网络服务${resource_name} 内存使用率过高",
      "description": "监控 GenieATM 设备的内存使用率，当持续高于阈值时触发告警，提示可能存在内存压力。",
      "metric_name": "device_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 95,
          "method": ">"
        },
        {
          "level": "error",
          "value": 90,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 80,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
