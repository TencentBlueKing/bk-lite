[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_cradlepoint"
        config_type = "cradlepoint"
        brand = "cradlepoint"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- CP-SYSTEM-MIB 标量（PEN 20992, wipipeSystem）：顶层 field 带 .0 → measurement snmp ----
    # cpuUtilization 1.3.6.1.4.1.20992.4.2.0：CPU 使用率 %（INTEGER 0..100）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20992.4.2.0"
        name = "device_cpu_usage"
    # memoryUtilization 1.3.6.1.4.1.20992.4.6.0：内存使用率 %（INTEGER 0..100）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.20992.4.6.0"
        name = "device_memory_usage"
# ---- 风扇/电源/温度：CP-SYSTEM-MIB 无机箱温度与风扇/电源 Gauge → N/A。CPU/内存采 wipipeSystem 标量。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    cpu = metric.fields.get("device_cpu_usage")
    if cpu != None:
        if cpu < 0 or cpu > 100:
            metric.fields.pop("device_cpu_usage")
    mem = metric.fields.get("device_memory_usage")
    if mem != None:
        if mem < 0 or mem > 100:
            metric.fields.pop("device_memory_usage")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["cradlepoint"]
