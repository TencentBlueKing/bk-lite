{
  "object": "Access",
  "plugin": "Access Intelbras OLT SNMP",
  "templates": [
    {
      "metric_name": "device_cpu_usage",
      "alert_name": "CPU usage high",
      "algorithm": "Threshold",
      "threshold": 85,
      "level": "warning"
    },
    {
      "metric_name": "device_memory_usage",
      "alert_name": "Memory usage high",
      "algorithm": "Threshold",
      "threshold": 85,
      "level": "warning"
    },
    {
      "metric_name": "device_temperature_switch_celsius",
      "alert_name": "Switch chipset temperature high",
      "algorithm": "Threshold",
      "threshold": 70,
      "level": "warning"
    },
    {
      "metric_name": "device_temperature_gpon_celsius",
      "alert_name": "GPON chipset temperature high",
      "algorithm": "Threshold",
      "threshold": 70,
      "level": "warning"
    }
  ]
}
