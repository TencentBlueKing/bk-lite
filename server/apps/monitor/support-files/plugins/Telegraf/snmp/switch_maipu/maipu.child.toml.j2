[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_maipu"
        config_type = "maipu"
        brand = "maipu"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Maipu CPU（MPIOS-MIB sysCpu.cpuUtilTable = 1.3.6.1.4.1.5651.3.20.1.1.3.5，INDEX cpuUtilCpuId）----
    # cpuUtilCurrentUtil .10：各 CPU 当前利用率 %；设备需开启 sysCpuStatus=spyCpu(2) 才会填充本表。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.3.5.1.10"
        name = "usage"
    # ---- Maipu 内存（MPIOS-MIB sysMemory = 1.3.6.1.4.1.5651.3.20.1.1.1）：标量，顶层 field 带 .0 → measurement snmp ----
    # memoryTotalBytes .8.0 / numBytesAlloc .5.0 / numBytesFree .1.0：字节；allocBytesPercent .9.0：已分配占比 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.1.8.0"
        name = "device_memory_total"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.1.5.0"
        name = "device_memory_used"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.1.1.0"
        name = "device_memory_free"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.1.9.0"
        name = "device_memory_usage"
    # ---- Maipu 温度（MPIOS-MIB sysTemperature = 1.3.6.1.4.1.5651.3.20.1.1.4）：标量，顶层 field 带 .0，℃ ----
    # sysMainBoardTemper .3.0：主板温度；sysCpuTemper .1.0：CPU 温度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.4.3.0"
        name = "device_temperature_celsius"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.4.1.0"
        name = "device_cpu_temperature_celsius"
# ---- 风扇/电源：MPIOS-MIB 无风扇与电源状态对象（紧凑机型多为无风扇被动散热）→ N/A 不采。----
