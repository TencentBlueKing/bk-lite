[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_maipu"
        config_type = "maipu"
        brand = "maipu"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Maipu CPU（MPIOS-MIB sysCpu.cpuUtilTable = 1.3.6.1.4.1.5651.3.20.1.1.3.5，INDEX cpuUtilCpuId）----
    # cpuUtilCurrentUtil .10：各 CPU 当前利用率 %；设备需开启 sysCpuStatus=spyCpu(2) 才会填充本表。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.3.5.1.10"
        name = "usage"
    # ---- Maipu 内存（MPIOS-MIB sysMemory = 1.3.6.1.4.1.5651.3.20.1.1.1）：标量，table 不带 .0 → measurement device_memory ----
    # memoryTotalBytes .8 / numBytesAlloc .5 / numBytesFree .1：字节；allocBytesPercent .9：已分配占比 %。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.1.8"
        name = "total"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.1.5"
        name = "used"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.1.1"
        name = "free"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.1.9"
        name = "usage"
    # ---- Maipu 温度（MPIOS-MIB sysTemperature = 1.3.6.1.4.1.5651.3.20.1.1.4）：标量，table 不带 .0，℃ ----
    # sysMainBoardTemper .3：主板温度 → device_temperature_celsius。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.4.3"
        name = "celsius"
    # sysCpuTemper .1：CPU 温度 → device_cpu_temperature_celsius。
    [[inputs.snmp.table]]
        name = "device_cpu_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5651.3.20.1.1.4.1"
        name = "celsius"
    # ---- Maipu 电源状态表 (.5651.1.1.1.1.5.1.1.2, 每电源 ok(1)/failed(2)) ----
    # 待现网核验：原始码 ok=1；下方 enum 归一 1→1(正常),其余→2(异常)。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5651.1.1.1.1.5.1.1.2"
        name = "state"
# ---- 风扇：Maipu MyPower S 系列紧凑接入交换机为无风扇被动散热设计，未暴露独立风扇状态 OID → 风扇 N/A。----
# ---- 状态归一：电源 ok(1)→1(正常),其余→2(异常)。----
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1

