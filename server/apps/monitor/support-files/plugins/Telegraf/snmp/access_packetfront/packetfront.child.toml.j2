[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_packetfront"
        config_type = "packetfront"
        brand = "packetfront"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # Chassis environment tables (PEN 9303). Walk full tables; empty tables yield no rows.
    # Do not invent CPU% or memory.
    # Temperature Integer32 is hundredths of a degree Celsius; metric query uses /100.
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.2.1.1.1"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.2.1.1.2"
        name = "celsius"
    # Fan RPM Integer32, INDEX fan number.
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.2.3.1.1"
        name = "fan"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.2.3.1.2"
        name = "rpm"
    # Optional board voltage Integer32 millivolts; metric query uses /1000 to volts.
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.2.2.1.1"
        name = "channel"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9303.4.1.2.2.1.3"
        name = "volts"
