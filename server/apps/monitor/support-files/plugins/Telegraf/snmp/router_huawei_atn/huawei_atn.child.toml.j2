[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_huawei_atn"
        config_type = "huawei_atn"
        brand = "huawei_atn"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # Device identity tags (hwDeviceEsn / hwProductName).
    # Chassis sysObjectID dictionary (display names). Interfaces use built-in IF-MIB; no IF expansion.
    # ATN family 1.3.6.1.4.1.2011.2.220 (atn)
    # Core: ...220.1 ATN 980 · ...220.2 ATN 990 · ...220.3 ATN 910 · ...220.4 ATN 950
    #       ...220.5 ATN 950B · ...220.15 ATN 910B · ...220.28 ATN 980B · ...220.31 ATN 950C
    #       ...220.65 ATN 980C · ...220.73 ATN 950D
    # 910C: ...220.32 ATN 910C-A · ...220.33 B · ...220.35 D · ...220.61 F · ...220.63 E
    #       ...220.67 H · ...220.69 S · ...220.71 G · ...220.79 ATN 910C-K · ...220.85 ATN 910C-M
    #       ...220.98 ATN 910C-H-C · ...220.100 ATN 910C-S-C
    # 910D: ...220.75 ATN 910D-A · ...220.87 ATN 910D-B · ...220.92 ATN 910D-C · ...220.94 ATN 910D-H
    # 905:  ...220.97 ATN 905-L · ...220.108 ATN 905-L-Q · ...220.77 ATN 905-G · ...220.89 ATN 905-S
    # Other: ...220.81 ATN 950-C · ...220.83 ATN 980D · ...220.104 ATN 980E · ...220.106 ATN 910E-A
    # IoT variants and remaining verified leaves 1-108 in the same tree share this plugin.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2011.5.25.188.1.1.0"
        name = "hwDeviceEsn"
        is_tag = true
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2011.5.25.188.1.4.0"
        name = "hwProductName"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Entity CPU (hwEntityCpuUsage, per entity, 0-100) ----
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5"
        name = "usage"
    # ---- Entity memory (hwEntityMemUsage, direct %) ----
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7"
        name = "usage"
    # ---- Entity temperature (hwEntityTemperature, C) ----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11"
        name = "celsius"
    # ---- Entity voltage (hwEntityVoltage, mV; query /1000 -> V) ----
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.13"
        name = "volts"
    # ---- Entity oper / standby / board power ----
    [[inputs.snmp.table]]
        name = "device_entity"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.2"
        name = "oper_status"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.3"
        name = "standby_status"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.24"
        name = "board_power"
    # Fans (hwEntityFanState / Speed / Present).
    # hwEntityFanIndex is a table index, not a description; use index_as_tag like PSU.
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.7"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.5"
        name = "speed"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.10.1.6"
        name = "present"
    # ---- PSU (hwEntityPwrState / Present) ----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.6"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.18.1.5"
        name = "present"
    # ---- Optical DDM (Rx/Tx uW; temp/bias/voltage) ----
    [[inputs.snmp.table]]
        name = "device_optical"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.8"
        name = "rx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.9"
        name = "tx_power"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.5"
        name = "temperature"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.7"
        name = "bias"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.3.1.6"
        name = "voltage"
    # ---- Device CPU duty (hwCpuDevDuty / 1min / 5min) ----
    [[inputs.snmp.table]]
        name = "device_cpu_dev"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.3.4.1.2"
        name = "duty"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.3.4.1.3"
        name = "avg_duty_1min"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.3.4.1.4"
        name = "avg_duty_5min"
    # ---- Device memory 64-bit size/free ----
    [[inputs.snmp.table]]
        name = "device_memory_dev"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.3.5.1.1.8"
        name = "size"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.3.5.1.1.9"
        name = "free"
    # ---- Chassis used/total power ----
    [[inputs.snmp.table]]
        name = "device_power"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.3.2"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.3.1"
        name = "total"
