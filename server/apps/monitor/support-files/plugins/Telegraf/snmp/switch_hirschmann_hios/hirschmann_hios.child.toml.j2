[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_hirschmann_hios"
        config_type = "hirschmann_hios"
        brand = "hirschmann_hios"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- Hirschmann HiOS CPU（HMIT-SYSTEM-MIB cpuCoreUtilization，直接 0-100%，表列禁止 .0）----
    # 列 OID 1.3.6.1.4.1.248.100.1.3.600.9.1.1.3；INDEX cpuIndex+cpuCoreId。
    # 仅适用于 sysObjectID 落在 1.3.6.1.4.1.248.100* 的 HiOS 设备，不采集 Classic 1.3.6.1.4.1.248.14。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.100.1.3.600.9.1.1.3"
        name = "usage"
    # ---- Hirschmann HiOS 内存（HMIT-SYSTEM-MIB memTable，表列禁止 .0，INDEX memIndex）----
    # memUtilization 1.3.6.1.4.1.248.100.1.3.600.10.1.1.10：Unsigned32 0-100% → device_memory_usage。
    # memKBytesFree ...10.1.1.12 / memTotalKBytes ...10.1.1.14：Counter64 KiB，下方 starlark ×1024 转为字节。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.100.1.3.600.10.1.1.10"
        name = "usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.100.1.3.600.10.1.1.14"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.248.100.1.3.600.10.1.1.12"
        name = "free"
# ---- 风扇/电源：HMIT-SYSTEM-MIB 本轮无干净风扇/电源 Gauge，不采集。----

# ---- 内存 KiB → 字节；有总量与空闲时补 used = total - free。usage 已是百分比，不换算。----
[[processors.starlark]]
    namepass = ["device_memory"]
    source = '''
def apply(metric):
    for key in ("total", "free"):
        val = metric.fields.get(key)
        if val != None:
            metric.fields[key] = int(val) * 1024
    total = metric.fields.get("total")
    free = metric.fields.get("free")
    if total != None and free != None:
        metric.fields["used"] = int(total) - int(free)
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["hirschmann_hios"]
