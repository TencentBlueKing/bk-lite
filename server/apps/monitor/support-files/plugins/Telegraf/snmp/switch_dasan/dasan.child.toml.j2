[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_dasan"
        config_type = "dasan"
        brand = "dasan"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：dsSwitchSystem 标量，顶层 field GET 必须带实例 .0；禁止 table.field+.0 ----
    # dsCpuLoad1m 作 headline；5s / 10m 为同组可选窗口。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6296.9.1.1.1.8.0"
        name = "device_cpu_usage_5s"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6296.9.1.1.1.9.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6296.9.1.1.1.10.0"
        name = "device_cpu_usage_10m"
    # ---- 内存：dsTotalMem / dsUsedMem / dsFreeMem，INTEGER 厂商单位，标量 field 带 .0 ----
    # 利用率 used/total（单位相消）；不把 dsTemperatureStatus 当摄氏度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6296.9.1.1.1.14.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6296.9.1.1.1.15.0"
        name = "device_memory_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6296.9.1.1.1.16.0"
        name = "device_memory_free"
# ---- 风扇/电源枚举与温度状态未进本轮最小集。本对象不采集 6296.101 OLT 树。----
