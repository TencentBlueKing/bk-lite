[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_grandstream_ucm"
        config_type = "grandstream_ucm"
        brand = "grandstream_ucm"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- GS-SoftWareUCM-SNMP-MIB sSysinfo 1.3.6.1.4.1.12581.2.2（PEN 12581）：标量，顶层 field 带 .0 → measurement snmp，查询用 snmp_ 前缀 ----
    # sMemoryUsage .7.0：OCTET STRING 内存使用，如 "45%"、"45"（按百分比）或 "460M/1024M"（已用/总量）→ device_memory_usage（及 used/total 字节）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12581.2.2.7.0"
        name = "mem_usage_text"
    # sCpuUsage .8.0：OCTET STRING CPU 负载均值，如 "0.52" 或 "0.52 0.48 0.40" → device_cpu_load1 / load5 / load15；若带 % 则按 CPU 使用率 → device_cpu_usage。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12581.2.2.8.0"
        name = "cpu_usage_text"
    # concurrentCall .9.0：INTEGER 当前并发呼叫数 → concurrent_calls。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12581.2.2.9.0"
        name = "concurrent_calls"

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
UNIT_BYTES = {"": 1, "B": 1, "K": 1024, "KB": 1024, "KIB": 1024, "M": 1048576, "MB": 1048576, "MIB": 1048576, "G": 1073741824, "GB": 1073741824, "GIB": 1073741824}

def numbers(text):
    out = []
    cur = ""
    for i in range(len(text)):
        c = text[i]
        if c.isdigit() or (c == "." and cur != "" and "." not in cur):
            cur += c
        else:
            if cur != "" and not cur.endswith("."):
                out.append(float(cur))
            cur = ""
    if cur != "" and not cur.endswith("."):
        out.append(float(cur))
    return out

def size_bytes(part):
    part = part.strip().upper()
    num = ""
    for i in range(len(part)):
        c = part[i]
        if c.isdigit() or (c == "." and num != "" and "." not in num):
            num += c
        else:
            break
    if num == "" or num.endswith("."):
        return None
    unit = part[len(num):].strip()
    if unit not in UNIT_BYTES:
        return None
    return (float(num) * UNIT_BYTES[unit], unit != "")

def plain_number(text):
    t = text.strip()
    if t.endswith("%"):
        t = t[:-1].strip()
    if t == "" or t.startswith(".") or t.endswith(".") or t.count(".") > 1:
        return None
    for i in range(len(t)):
        if not (t[i].isdigit() or t[i] == "."):
            return None
    return float(t)

def apply(metric):
    mem = metric.fields.pop("mem_usage_text", None)
    cpu = metric.fields.pop("cpu_usage_text", None)
    calls = metric.fields.get("concurrent_calls")
    if calls != None and (type(calls) not in ["int", "float"] or calls < 0):
        metric.fields.pop("concurrent_calls")
    if mem != None:
        text = str(mem).strip()
        if "/" in text:
            parts = text.split("/")
            a = size_bytes(parts[0])
            b = size_bytes(parts[1]) if len(parts) == 2 else None
            if a != None and b != None and a[1] == b[1]:
                used = a[0]
                total = b[0]
                if total > 0 and used <= total:
                    metric.fields["device_memory_usage"] = used * 100.0 / total
                    # 两侧都带容量单位才输出字节；纯数字只算使用率
                    if a[1]:
                        metric.fields["device_memory_used"] = int(used)
                        metric.fields["device_memory_total"] = int(total)
        else:
            value = plain_number(text)
            if value != None and value >= 0 and value <= 100:
                metric.fields["device_memory_usage"] = value
    if cpu != None:
        text = str(cpu).strip()
        vals = numbers(text)
        if "%" in text:
            if len(vals) == 1 and vals[0] >= 0 and vals[0] <= 100:
                metric.fields["device_cpu_usage"] = vals[0]
        elif len(vals) >= 1:
            for key, idx in [("device_cpu_load1", 0), ("device_cpu_load5", 1), ("device_cpu_load15", 2)]:
                if idx < len(vals):
                    metric.fields[key] = vals[idx]
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["grandstream_ucm"]
