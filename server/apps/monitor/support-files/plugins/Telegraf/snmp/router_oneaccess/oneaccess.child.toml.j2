[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_oneaccess"
        config_type = "oneaccess"
        brand = "oneaccess"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # 识别门：sysObjectID 前缀 1.3.6.1.4.1.13191（oneAccess / ONEACCESS-SYS-MIB）。
    # 标量：顶层 field GET 必须带实例 .0；禁止 table.field 采标量（walk 空或误当表列）。
    # ---- CPU%：oacSysCpuUsed，Unsigned32 0-100 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.13191.10.3.3.1.2.1.0"
        name = "device_cpu_usage"
    # ---- 内存%：oacSysMemoryUsed，Unsigned32 0-100 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.13191.10.3.3.1.1.4.0"
        name = "device_memory_usage"
    # ---- 内存字节：oacSysMemoryTotal / oacSysMemoryFree / oacSysMemoryAllocated ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.13191.10.3.3.1.1.3.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.13191.10.3.3.1.1.1.0"
        name = "device_memory_free"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.13191.10.3.3.1.1.2.0"
        name = "device_memory_allocated"
    # ---- 多核 CPU 表：oacSysCpuUsedCoresTable；table.field 禁止 .0 ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.4.1.13191.10.3.3.1.2.3"
        name = "device_cpu_core"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.13191.10.3.3.1.2.3.1.3"
        name = "usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.13191.10.3.3.1.2.3.1.4"
        name = "usage_1min"
# ---- 温度/风扇/电源：OneAccess 紧凑型企业 CPE 为无风扇固定配置设计，ONEACCESS-SYS-MIB 未以无需行级过滤的标量形式暴露独立温度/风扇/电源传感器 → N/A。不采硬件组件 DisplayString 表。接口走内置 IF-MIB。----
