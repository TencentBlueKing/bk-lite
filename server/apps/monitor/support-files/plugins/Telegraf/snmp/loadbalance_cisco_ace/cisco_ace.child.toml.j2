        name = "usage"
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.2"
        name = "pool_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.4"
        name = "valid"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.5"
        name = "used"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.48.1.1.1.6"
        name = "free"
    [[inputs.snmp.table]]
        name = "ace_np"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.480.1.1.7.1.1"
        name = "cpu_usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.9.9.480.1.1.6.1.3"
