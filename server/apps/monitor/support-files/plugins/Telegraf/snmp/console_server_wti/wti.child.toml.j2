[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_wti"
        config_type = "wti"
        brand = "wti"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"

    # WTI-CONSOLE-MIB environment unit leaves under 1.3.6.1.4.1.2634.1.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.3.0"
        name = "device_temperature_celsius"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.22.0"
        name = "wti_input_power_1_state"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.23.0"
        name = "wti_input_power_2_state"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.24.0"
        name = "wti_input_power_3_state"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.25.0"
        name = "wti_input_power_4_state"

    # 环境单元支路计量（WTI-CONSOLE-MIB environmentUnitTable 1.3.6.1.4.1.2634.1.200.10，INDEX environmentUnitIndex 0..3）：按表遍历，table.field 不带 .0。
    # 每个单元有 A / B / C / D 四条支路：environmentUnitCurrentX 为 1/10 A，environmentUnitVoltageX 为 V，environmentUnitPowerX 为 W。
    [[inputs.snmp.table]]
        name = "wti_environment_unit"
        inherit_tags = ["source"]
        index_as_tag = true
    # environmentUnitName（.2）：单元名称，作为 unit_name 标签。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.2"
        name = "unit_name"
        is_tag = true
    # A：.4 / .5 / .6；B：.7 / .8 / .9；C：.10 / .11 / .12；D：.13 / .14 / .15。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.4"
        name = "current_a_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.5"
        name = "voltage_a_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.6"
        name = "power_a_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.7"
        name = "current_b_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.8"
        name = "voltage_b_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.9"
        name = "power_b_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.10"
        name = "current_c_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.11"
        name = "voltage_c_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.12"
        name = "power_c_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.13"
        name = "current_d_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.14"
        name = "voltage_d_raw"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2634.1.200.10.1.15"
        name = "power_d_raw"

[[processors.enum]]
    [processors.enum.tagpass]
        brand = ["wti"]
    [[processors.enum.mapping]]
        field = "wti_input_power_1_state"
        dest = "wti_input_power_1_state"
        default = 2
        [processors.enum.mapping.value_mappings]
            1 = 1
    [[processors.enum.mapping]]
        field = "wti_input_power_2_state"
        dest = "wti_input_power_2_state"
        default = 2
        [processors.enum.mapping.value_mappings]
            1 = 1
    [[processors.enum.mapping]]
        field = "wti_input_power_3_state"
        dest = "wti_input_power_3_state"
        default = 2
        [processors.enum.mapping.value_mappings]
            1 = 1
    [[processors.enum.mapping]]
        field = "wti_input_power_4_state"
        dest = "wti_input_power_4_state"
        default = 2
        [processors.enum.mapping.value_mappings]
            1 = 1

[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    states = []
    for key in (
        "wti_input_power_1_state",
        "wti_input_power_2_state",
        "wti_input_power_3_state",
        "wti_input_power_4_state",
    ):
        states.append(metric.fields.get(key, 2))
    metric.fields["device_psu_state"] = max(states)
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["wti"]

# ---- 支路计量拆分：每个单元按支路拆成 wti_branch（标签 branch=A / B / C / D），原始行不落库。
# 电压须为 1~600 V，否则视为该支路不存在、整条支路不出点；电流原始值须为 0~10000（÷10 → A）；功率须为 0~100000 W。----
[[processors.starlark]]
    namepass = ["wti_environment_unit"]
    source = '''
def apply(metric):
    out = []
    f = metric.fields
    for b in ["a", "b", "c", "d"]:
        current = f.get("current_" + b + "_raw")
        volts = f.get("voltage_" + b + "_raw")
        watts = f.get("power_" + b + "_raw")
        if type(volts) != "int" or volts < 1 or volts > 600:
            continue
        m = Metric("wti_branch")
        for k, v in metric.tags.items():
            m.tags[k] = v
        m.tags["branch"] = b.upper()
        m.fields["voltage_volts"] = volts
        if type(current) == "int" and current >= 0 and current <= 10000:
            m.fields["current_amps"] = current / 10.0
        if type(watts) == "int" and watts >= 0 and watts <= 100000:
            m.fields["power_watts"] = watts
        m.time = metric.time
        out.append(m)
    if len(out) == 0:
        return None
    return out
'''
    [processors.starlark.tagpass]
        brand = ["wti"]
