[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_bridgewave"
        config_type = "bridgewave"
        brand = "bridgewave"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- BRWAVE-RADIO-MIB brwaveRadioStatus 1.3.6.1.4.1.6080.3.1.3（PEN 6080）：标量，顶层 field 带 .0 → measurement snmp，查询用 snmp_ 前缀 ----
    # brwaveRadioUnitTemperature .2.0：机组温度，Integer32 百分之一摄氏度，查询侧 /100。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6080.3.1.3.2.0"
        name = "device_temperature_celsius"
        conversion = "int"
    # brwaveRadioTxTemperature .3.0：发射机温度，Integer32 百分之一摄氏度，查询侧 /100。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6080.3.1.3.3.0"
        name = "tx_temperature_celsius"
        conversion = "int"
    # brwaveRadioRSL .4.0：接收信号电平，Integer32 原值上报。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6080.3.1.3.4.0"
        name = "rsl"
        conversion = "int"
    # brwaveRadioInVoltage .1.0：输入电压，Integer32 原值上报，不作为共享电源健康指标。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.6080.3.1.3.1.0"
        name = "device_in_voltage"
        conversion = "int"
# ---- CPU/内存/风扇/电源：BRWAVE-RADIO 已确认机组温度、发射机温度、RSL 与可选输入电压标量。无稳定、无需行级过滤的 CPU%/内存% 共享健康对象 → N/A，不臆造。----
