[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_f5"
        config_type = "f5"
        brand = "f5"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # F5 BIG-IP CPU/内存/客户端连接标量：顶层 field GET 必须带实例 .0；table.field 禁止 .0。
    # sysGlobalHostCpuUsageRatio5s 直接 %；sysStatMemoryTotal/Used 为字节；sysStatClientCurConns 为当前客户端连接。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3375.2.1.1.2.20.21.0"
        name = "device_cpu_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3375.2.1.1.2.1.44.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3375.2.1.1.2.1.45.0"
        name = "device_memory_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3375.2.1.1.2.1.8.0"
        name = "lb_current_connections"
    # ---- HA：故障切换与配置同步。标量，顶层 field 必须带 .0，禁止写成 table.field。----
    # 故障切换：unknown(0) offline(1) forcedOffline(2) standby(3) active(4)
    # 仅 standby(3)/active(4) 视为角色正常。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3375.2.1.14.3.1.0"
        name = "failover_status"
    # 配置同步：unknown(0) syncing(1) needManualSync(2) inSync(3) syncFailed(4)
    # syncDisconnected(5) standalone(6) awaitingInitialSync(7) incompatibleVersion(8) partialSync(9)
    # 仅 syncing(1)/inSync(3)/standalone(6) 视为正常；单机不是故障。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.3375.2.1.14.1.1.0"
        name = "sync_status"
    # F5 机箱传感器表：table.field 禁止 .0。
    # sysChassisTempTemperature 摄氏度；sysChassisFanStatus / sysChassisPowerSupplyStatus：good(1)→1，其余→2。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3375.2.1.3.2.3.2.1.2"
        name = "celsius"
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3375.2.1.3.2.1.2.1.2"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3375.2.1.3.2.1.2.1.3"
        name = "speed"
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.3375.2.1.3.2.2.2.1.2"
        name = "state"

# good(1)→1；bad(0)/notpresent(2)/未知→2
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
[[processors.enum]]
    namepass = ["device_psu"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
# 故障切换：standby(3)/active(4) → 1（角色正常）；unknown/offline/forcedOffline → 2
[[processors.enum]]
    namepass = ["snmp"]
    [[processors.enum.mapping]]
        field = "failover_status"
        dest = "failover_ok"
        default = 2
        [processors.enum.mapping.value_mappings]
            "3" = 1
            "4" = 1
# 配置同步：syncing(1)/inSync(3)/standalone(6) → 1；其余 → 2。单机不算故障。
[[processors.enum]]
    namepass = ["snmp"]
    [[processors.enum.mapping]]
        field = "sync_status"
        dest = "sync_ok"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            "3" = 1
            "6" = 1
