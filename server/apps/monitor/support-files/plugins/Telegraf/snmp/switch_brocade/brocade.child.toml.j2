[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_brocade"
        config_type = "brocade"
        brand = "brocade"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Brocade/Foundry/Ruckus ICX CPU (snAgGblCpuUtil1MinAvg, 1 分钟平均, 直接 0-100%, 标量) ----
    # 顶层 field GET 必须带实例 .0；禁止 table.field（标量 GET-NEXT 会走到空子树，指标静默为空）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1991.1.1.2.1.52.0"
        name = "device_cpu_usage"
    # ---- 系统 DRAM (snAgSystemDRAMUtil %, snAgSystemDRAMTotal / snAgSystemDRAMFree 字节, 标量) ----
    # 顶层 field GET 必须带实例 .0。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1991.1.1.2.12.4.1.0"
        name = "device_memory_usage"
    # ---- 动态内存使用率回退 (snAgGblDynMemUtil %, 标量) ----
    # 顶层 field GET 必须带实例 .0。无 DRAM OID 的机型用此指标。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1991.1.1.2.1.53.0"
        name = "device_memory_dynmem_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1991.1.1.2.12.4.2.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1991.1.1.2.12.4.3.0"
        name = "device_memory_free"
    # ---- 机箱温度 (snChasActualTemperature, 标量, 原始单位 0.5℃) ----
    # 顶层 field GET 必须带实例 .0；下方 starlark ×0.5 换算为摄氏度。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.1991.1.1.1.1.18.0"
        name = "device_temperature_celsius"
    # ---- 风扇 (snChasFanTable)：描述 ...3.1.1.2 作 tag；状态 snChasFanOperStatus ...3.1.1.3 ----
    # 原始码 1 other / 2 normal / 3 failure → 下方 processors.enum 归一(2→1，其余→2)。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1991.1.1.1.3.1.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1991.1.1.1.3.1.1.3"
        name = "state"
    # ---- 电源 (snChasPwrSupplyTable)：描述 ...2.1.1.2 作 tag；状态 snChasPwrSupplyOperStatus ...2.1.1.3 ----
    # 枚举同风扇：1 other / 2 normal / 3 failure → 下方 processors.enum 归一(2→1，其余→2)。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1991.1.1.1.2.1.1.2"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.1991.1.1.1.2.1.1.3"
        name = "state"

# ---- 机箱温度原始值单位为 0.5℃，×0.5 换算为摄氏度。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    raw = metric.fields.get("device_temperature_celsius")
    if raw != None:
        metric.fields["device_temperature_celsius"] = float(raw) * 0.5
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["brocade"]

# ---- 风扇/电源状态归一：2 normal→1(正常)，其余(1 other / 3 failure)→2(异常)。----
[[processors.enum]]
    namepass = ["device_fan", "device_psu"]
    [processors.enum.tagpass]
        brand = ["brocade"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "2" = 1
