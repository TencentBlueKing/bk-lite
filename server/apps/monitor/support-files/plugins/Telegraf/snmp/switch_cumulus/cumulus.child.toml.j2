[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_cumulus"
        config_type = "cumulus"
        brand = "cumulus"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, telegraf auto-walks ifTable columns) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Cumulus Linux CPU load (HOST-RESOURCES-MIB hrProcessorLoad, per-core %, telegraf averages over the table) ----
    # 待现网核验：hrProcessorLoad 表 1.3.6.1.2.1.25.3.3.1.2（每核 0-100%），盘侧 avg by instance 取整机均值。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.25.3.3.1.2"
        name = "usage"
    # ---- Cumulus Linux memory (UCD-SNMP-MIB memory 1.3.6.1.4.1.2021.4)：标量，顶层 field 带 .0 → measurement snmp，查询用 snmp_ 前缀 ----
    # memTotalReal .4.5.0 / memAvailReal .4.6.0：Integer32，单位 kB；下方 starlark ×1024 → 字节。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.5.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2021.4.6.0"
        name = "device_memory_free"
    # ---- Cumulus Linux temperature (LM-SENSORS-MIB lmTempSensorsValue, 表 OID, 单位 m℃ → ℃ 由设备/盘侧口径) ----
    # 待现网核验：lmTempSensorsValue 表 1.3.6.1.4.1.2021.13.16.2.1.3（℃，部分平台 m℃ 需缩放）；盘侧 max by instance 取最高温传感器。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2021.13.16.2.1.3"
        name = "celsius"
# ---- 风扇/电源：Cumulus Linux 以软件 NOS 运行于白盒交换机硬件，标准 NET-SNMP（HOST-RESOURCES/UCD/LM-SENSORS）未以无需行级过滤的标量形式暴露独立风扇状态与电源状态 OID → 风扇/电源 N/A 不采。CPU/内存/温度/接口四项干净可采。----

# ---- 内存 kB → 字节；总量非正或空闲超出总量时整组丢弃。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    total = metric.fields.pop("device_memory_total", None)
    free = metric.fields.pop("device_memory_free", None)
    if total == None or free == None or total <= 0 or free < 0 or free > total:
        return metric
    metric.fields["device_memory_total"] = int(total) * 1024
    metric.fields["device_memory_free"] = int(free) * 1024
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["cumulus"]
