[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_netscaler"
        config_type = "netscaler"
        brand = "netscaler"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # NetScaler CPU：nsCPUusage 为每 CPU 表列（table.field 禁止 .0，查询侧 avg）；
    # resCpuUsage 为整机标量（顶层 field GET 必须带实例 .0）。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.5951.4.1.1.41.6.1.2"
        name = "usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5951.4.1.1.41.1.0"
        name = "device_cpu_usage"
    # NetScaler 内存/客户端连接标量：顶层 field GET 必须带实例 .0；table.field 禁止 .0。
    # resMemUsage 直接 %；tcpCurClientConn 为当前客户端连接（含 Opening/Established/Closing）；
    # tcpCurClientConnEstablished 仅为 Established，不作主当前连接。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5951.4.1.1.41.2.0"
        name = "device_memory_usage"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5951.4.1.1.46.2.0"
        name = "lb_current_connections"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.5951.4.1.1.46.12.0"
        name = "lb_established_connections"
# ---- 温度/风扇/电源：nsSysHealthTable 按传感器名字符串索引混合电压/风扇/温度，inputs.snmp 不支持行级名称过滤 → N/A 不采。----
