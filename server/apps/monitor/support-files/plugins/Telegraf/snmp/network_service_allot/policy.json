{
  "object": "NetworkService",
  "plugin": "NetworkService Allot SNMP",
  "templates": [
    {
      "name": "Allot网络服务CPU使用率过高",
      "alert_name": "网络服务${resource_name} CPU 使用率过高",
      "description": "监控 Allot 网络服务设备的整机 CPU 使用率，当持续高于阈值时触发告警，提示流量转发与过滤处理负载过高的风险。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Allot网络服务内存使用率过高",
      "alert_name": "网络服务${resource_name} 内存使用率过高",
      "description": "监控 Allot 网络服务设备的系统内存使用率，当超过阈值时触发告警，便于及时发现映射/流表内存压力。",
      "metric_name": "device_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Allot网络服务温度过高",
      "alert_name": "网络服务${resource_name} 温度过高",
      "description": "监控 Allot 网络服务设备的温度读数，当温度持续偏高时触发告警。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 80,
          "method": ">"
        },
        {
          "level": "error",
          "value": 70,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 60,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
