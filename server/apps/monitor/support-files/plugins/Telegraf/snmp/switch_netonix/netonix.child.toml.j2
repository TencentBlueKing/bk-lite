[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_netonix"
        config_type = "netonix"
        brand = "netonix"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Netonix 温度传感器表（NETONIX-SWITCH-MIB tempTable = 1.3.6.1.4.1.46242.3.1，INDEX tempIndex）----
    # tempDescription .2 作 sensor 标签；temp .3：℃。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.3.1.2"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.3.1.3"
        name = "celsius"
    # ---- 风扇表（fanTable = …46242.2.1，INDEX fanIndex）：fanSpeed .2 转速 ----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.2.1.2"
        name = "speed"
    # ---- 电压表（voltageTable = …46242.4.1，INDEX voltageIndex）：voltageDescription .2 作 sensor 标签；voltage .3 以 0.01V 为单位，下方 starlark ÷100 ----
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.4.1.2"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.4.1.3"
        name = "volts"
    # ---- 功耗/DCDC 标量（顶层 field 带 .0 → measurement snmp）----
    # totalPowerConsumption .6.0：整机功耗，0.1W；dcdcInputCurrent .7.0：DCDC 输入电流，0.1A（下方 starlark ÷10）；dcdcEfficiency .8.0：DCDC 效率 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.46242.6.0"
        name = "device_power_used"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.46242.7.0"
        name = "device_input_current_amps"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.46242.8.0"
        name = "device_dcdc_efficiency"
# ---- CPU/内存：NETONIX-SWITCH-MIB 无 CPU/内存对象 → N/A。PoE 为端口级状态字符串，本插件不采。----
# ---- 单位换算：电压 ÷100 → V；功耗 ÷10 → W；电流 ÷10 → A。----
[[processors.starlark]]
    namepass = ["snmp", "device_voltage"]
    source = '''
def apply(metric):
    if metric.name == "device_voltage":
        v = metric.fields.get("volts")
        if v != None:
            metric.fields["volts"] = int(v) / 100.0
        return metric
    for key in ["device_power_used", "device_input_current_amps"]:
        v = metric.fields.get(key)
        if v != None:
            metric.fields[key] = int(v) / 10.0
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["netonix"]
