[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_moxa"
        config_type = "moxa"
        brand = "moxa"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Moxa EDS-408A CPU / 内存 / 电源输入（MOXA-EDS408A-MIB swMgmt = 1.3.6.1.4.1.8691.7.7.1）：标量，顶层 field 带 .0 → measurement snmp ----
    # 其它 EDS 型号位于 8691.7.<型号>.1，叶号相同；本模板按 EDS-408A（型号段 7）采集。
    # cpuLoading5s .53.0：最近 5 秒 CPU 负载 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8691.7.7.1.53.0"
        name = "device_cpu_usage"
    # memoryUsage .59.0：内存使用率 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8691.7.7.1.59.0"
        name = "device_memory_usage"
    # monitor(10).power1InputStatus .10.1.0 / power2InputStatus .10.2.0：not-present(0) / present(1)。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8691.7.7.1.10.1.0"
        name = "power1_input_status"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.8691.7.7.1.10.2.0"
        name = "power2_input_status"
# ---- 温度/风扇：EDS-408A MIB 无机箱温度与风扇对象（无风扇被动散热）→ N/A 不采。----
# ---- 电源输入标量拆为 device_psu 指标（state=输入1，state_backup=输入2，沿用 device_psu_state / device_psu_state_backup）----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    p1 = metric.fields.pop("power1_input_status", None)
    p2 = metric.fields.pop("power2_input_status", None)
    if p1 == None and p2 == None:
        return metric
    psu = Metric("device_psu")
    for key, value in metric.tags.items():
        psu.tags[key] = value
    psu.time = metric.time
    if p1 != None:
        psu.fields["state"] = int(p1)
    if p2 != None:
        psu.fields["state_backup"] = int(p2)
    return [metric, psu]
'''
    [processors.starlark.tagpass]
        brand = ["moxa"]
# ---- 状态归一：电源输入 present(1)→1(正常)，not-present(0) 及其它→2(异常)。----
[[processors.enum]]
    namepass = ["device_psu"]
    [processors.enum.tagpass]
        brand = ["moxa"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
    [[processors.enum.mapping]]
        field = "state_backup"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
