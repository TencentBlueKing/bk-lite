{
  "object": "Switch",
  "plugin": "Switch Moxa SNMP",
  "templates": [
    {
      "name": "Moxa交换机CPU使用率过高",
      "alert_name": "交换机${resource_name} CPU 使用率过高",
      "description": "监控 Moxa EDS 工业交换机的 CPU 负载，当持续高于阈值时触发告警，提示可能存在环网协议震荡、广播风暴或管理面过载。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Moxa交换机内存使用率过高",
      "alert_name": "交换机${resource_name} 内存使用率过高",
      "description": "监控 Moxa EDS 工业交换机的内存使用率，当持续高于阈值时触发告警，提示可能存在内存泄漏或资源紧张。",
      "metric_name": "device_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 95,
          "method": ">"
        },
        {
          "level": "error",
          "value": 90,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 80,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Moxa交换机电源异常",
      "alert_name": "交换机${resource_name} 电源状态异常",
      "description": "监控 Moxa 工业交换机的双路电源输入状态，当任一电源输入故障或断电时触发告警，提示需检查供电冗余，避免单电源失效导致设备宕机。",
      "metric_name": "device_psu_state",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 1,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
