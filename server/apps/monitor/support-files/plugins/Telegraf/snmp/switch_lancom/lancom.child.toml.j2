[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_lancom"
        config_type = "lancom"
        brand = "lancom"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- LCOS-SX 机箱温度 / 空闲内存（lcsSystemInformation，标量 field 带 .0）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2356.14.1.1.1.201.0"
        name = "temp_s1"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2356.14.1.1.1.202.0"
        name = "temp_s2"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2356.14.1.1.1.203.0"
        name = "temp_s3"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2356.14.1.1.1.204.0"
        name = "lancom_memory_free_mb"
    # ---- GENERAL 风扇表（表列禁止 .0）：状态 + RPM ----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2356.100.1.1.3.1.5"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2356.100.1.1.3.1.6"
        name = "speed"
    # ---- GENERAL 电源表（表列禁止 .0）：状态 ----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2356.100.1.1.4.1.5"
        name = "state"
[[processors.starlark]]
    namepass = ["snmp", "device_fan", "device_psu"]
    source = '''
def keep_temp(raw):
    if raw == None:
        return None
    value = int(raw)
    if value < -40 or value > 125:
        return None
    return value

def keep_mem(raw):
    if raw == None:
        return None
    value = int(raw)
    if value < 0 or value > 1048576:
        return None
    return value

def keep_rpm(raw):
    if raw == None:
        return None
    value = int(raw)
    if value < 0 or value > 100000:
        return None
    return value

def map_module(raw):
    if raw == None:
        return None
    value = int(raw)
    if value == 2 or value == 4 or value == 9:
        return 1
    if value >= 1 and value <= 9:
        return 2
    return None

def emit_temp(metric, raw, index):
    value = keep_temp(raw)
    if value == None:
        return None
    row = Metric("device_temperature")
    for key, tag in metric.tags.items():
        row.tags[key] = tag
    row.tags["index"] = index
    row.time = metric.time
    row.fields["celsius"] = value
    return row

def apply(metric):
    if metric.name == "snmp":
        t1 = emit_temp(metric, metric.fields.pop("temp_s1", None), "1")
        t2 = emit_temp(metric, metric.fields.pop("temp_s2", None), "2")
        t3 = emit_temp(metric, metric.fields.pop("temp_s3", None), "3")
        mem = keep_mem(metric.fields.pop("lancom_memory_free_mb", None))
        if mem != None:
            metric.fields["lancom_memory_free_mb"] = mem
        out = []
        if len(metric.fields.keys()) > 0:
            out.append(metric)
        if t1 != None:
            out.append(t1)
        if t2 != None:
            out.append(t2)
        if t3 != None:
            out.append(t3)
        if len(out) == 0:
            return None
        return out
    if metric.name == "device_fan":
        mapped = map_module(metric.fields.pop("state", None))
        if mapped != None:
            metric.fields["state"] = mapped
        rpm = keep_rpm(metric.fields.get("speed"))
        if rpm == None:
            metric.fields.pop("speed", None)
        else:
            metric.fields["speed"] = rpm
        if len(metric.fields.keys()) == 0:
            return None
        return metric
    if metric.name == "device_psu":
        mapped = map_module(metric.fields.pop("state", None))
        if mapped == None:
            return None
        metric.fields["state"] = mapped
        return metric
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["lancom"]
