[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_nexans"
        config_type = "nexans"
        brand = "nexans"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Nexans 机箱温度 / 告警继电器（NEXANS-BM-MIB bmSwitchInfo = 1.3.6.1.4.1.266.20.1）：标量，顶层 field 带 .0 → measurement snmp ----
    # infoTemperature .12.0：机壳温度，Integer32 ℃（允许上限 infoTemperatureMaxAllowed .13.0 未采）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.266.20.1.12.0"
        name = "device_temperature_celsius"
    # infoAlarmStateM1 .21.0：主告警继电器状态，notSupported(1) / alarmOff(2) / alarmOn(3) / alarmOnLinkDown(4) / alarmOnForced(5) /
    # alarmOffForced(6) / alarmOnPowerSupplyS1(7) / S2(8) / S1orS2(9) / 其余为功能输入或远程告警。冗余继电器 M2（.22.0）未采。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.266.20.1.21.0"
        name = "alarm_state_m1"
# ---- 告警继电器标量拆为 device_psu 指标（沿用共享盘 device_psu_state）----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    raw = metric.fields.pop("alarm_state_m1", None)
    if raw == None:
        return metric
    psu = Metric("device_psu")
    for key, value in metric.tags.items():
        psu.tags[key] = value
    psu.time = metric.time
    psu.fields["state"] = int(raw)
    return [metric, psu]
'''
    [processors.starlark.tagpass]
        brand = ["nexans"]
# ---- 电源告警归一：notSupported(1) / alarmOff(2) → 1(正常)，其余（alarmOn、电源 S1/S2 告警等）→ 2(异常)。----
# ---- 共享盘 device_psu_state 约定 1=正常,>1=异常。----
[[processors.enum]]
    namepass = ["device_psu"]
    [processors.enum.tagpass]
        brand = ["nexans"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            "2" = 1
# ---- CPU/内存/风扇：NEXANS-BM-MIB 无 CPU、无内存、无风扇对象（GigaSwitch/DualSwitch 为无风扇工业交换机），故 N/A 不采。----
