[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_acksys"
        config_type = "acksys"
        brand = "acksys"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true

    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"

    # ---- ACKSYS WaveOS 私有健康标量（IANA PEN 28097）----
    # os-statFreeHeap / os-statTotalHeap / os-statHeapLowWater：堆空闲、总量与低水位，单位字节。
    [[inputs.snmp.table]]
        name = "heap"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28097.1.3.1"
        name = "free_bytes"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28097.1.3.2"
        name = "total_bytes"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28097.1.3.3"
        name = "low_water_bytes"
        conversion = "int"
    # motherBoard0：主板温度传感器 0，原始单位毫摄氏度；查询侧 /1000 转为摄氏度。
    # 读数 ≤ -274000 mC 表示传感器不可用。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28097.9.7.2.1.1"
        name = "celsius"
        conversion = "int"
    # powerStatus-PW1/PW2：powerOff(1)/powerOn(2)，下方 enum 归一为 1=正常 / 2=异常。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28097.6.1"
        name = "state"
        conversion = "int"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28097.6.2"
        name = "state_backup"
        conversion = "int"
    # apClientCount：仅接入点模式有效的已关联客户端数标量。
    [[inputs.snmp.table]]
        name = "wireless_client"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28097.1.1.3.3"
        name = "count"
        conversion = "int"
    # bridge-modeRSSIdBm：仅网桥模式有效的对端连接 RSSI（dBm）。
    [[inputs.snmp.table]]
        name = "wireless_signal"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28097.1.1.2.4"
        name = "strength"
        conversion = "int"
# ---- 无私有 CPU 使用率标量，不伪造 CPU%。不扩展 IF-MIB 错误计数、ifOperStatus 或 32 位字节计数器。----

[[processors.enum]]
    namepass = ["device_psu"]
    [processors.enum.tagpass]
        brand = ["acksys"]
    [[processors.enum.mapping]]
        field = "state"
        dest = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "2" = 1
            2 = 1
    [[processors.enum.mapping]]
        field = "state_backup"
        dest = "state_backup"
        default = 2
        [processors.enum.mapping.value_mappings]
            "2" = 1
            2 = 1
