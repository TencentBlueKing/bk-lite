[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_tachyon"
        config_type = "tachyon"
        brand = "tachyon"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.31.1.1"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.1"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Tachyon TNA 300 system health scalars (TACHYON-MIB, PEN 57344) ----
    # cpuUsagePercent: 1.3.6.1.4.1.57344.1.3.6.0, Gauge32 direct percent.
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.57344.1.3.6"
        name = "usage"
    # memoryUsagePercent: 1.3.6.1.4.1.57344.1.3.7.0, Gauge32 direct percent.
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.57344.1.3.7"
        name = "usage"
    # cpuTemperature: 1.3.6.1.4.1.57344.1.3.3.0, Integer32 degrees Celsius, no scaling.
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.57344.1.3.3"
        name = "celsius"
    # ---- Tachyon TNA 300 wirelessRadioTable (TACHYON-MIB, PEN 57344) ----
    # INDEX wirelessRadioName (DisplayString). table.field OIDs have no .0 suffix.
    # wirelessRadioName 1.3.6.1.4.1.57344.1.2.2.1.2 -> tag radio (for example wlan0).
    # wirelessRadioModemTemperature 1.3.6.1.4.1.57344.1.2.2.1.10 Integer32 Celsius, no scaling.
    # wirelessRadioTemperature 1.3.6.1.4.1.57344.1.2.2.1.11 Integer32 Celsius, no scaling.
    [[inputs.snmp.table]]
        name = "radio"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.57344.1.2.2.1.2"
        name = "radio"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.57344.1.2.2.1.11"
        name = "temperature_celsius"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.57344.1.2.2.1.10"
        name = "modem_temperature_celsius"
    # ---- Fan/PSU: TACHYON-MIB exposes CPU/memory/temperature scalars but no stable fan or power-supply state objects. ----

# ---- Radio temperature filter: keep -40..125 C; drop sentinels -1, -273, 2147483647. ----
[[processors.starlark]]
    namepass = ["radio"]
    source = '''
def apply(metric):
    radio = metric.tags.get("radio")
    if radio == None or radio == "":
        return None
    for key in ["temperature_celsius", "modem_temperature_celsius"]:
        value = metric.fields.get(key)
        if value == None:
            continue
        if type(value) not in ["int", "float"]:
            metric.fields.pop(key)
            continue
        if value == -1 or value == -273 or value == 2147483647:
            metric.fields.pop(key)
            continue
        if value < -40 or value > 125:
            metric.fields.pop(key)
    f = metric.fields
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["tachyon"]

