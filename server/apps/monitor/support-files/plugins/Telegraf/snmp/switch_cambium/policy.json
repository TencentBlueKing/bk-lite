{
  "object": "Switch",
  "plugin": "Switch Cambium SNMP",
  "templates": [
    {
      "name": "Cambium交换机CPU使用率过高",
      "alert_name": "交换机${resource_name} CPU 使用率过高",
      "description": "监控 Cambium cnMatrix 交换机 CPU 使用率（issSwitchCurrentCPUThreshold），当持续高于阈值时触发告警，提示可能存在控制平面过载、转发表震荡或异常流量，避免管理响应变慢或转发受影响。",
      "metric_name": "device_cpu_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Cambium交换机内存使用率过高",
      "alert_name": "交换机${resource_name} 内存使用率过高",
      "description": "监控 Cambium cnMatrix 交换机的内存使用率（issSwitchCurrentRAMUsage），当超过阈值时触发告警，便于及时发现内存压力导致转发表或控制平面性能下降的风险。",
      "metric_name": "device_memory_usage",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 90,
          "method": ">"
        },
        {
          "level": "error",
          "value": 80,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 70,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "Cambium交换机温度过高",
      "alert_name": "交换机${resource_name} 温度过高",
      "description": "监控 Cambium cnMatrix 交换机的机箱温度（issSwitchCurrentTemperature），当持续高于阈值时触发告警，提示可能存在散热不良或环境温度过高，避免器件过热损坏。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 70,
          "method": ">"
        },
        {
          "level": "error",
          "value": 60,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 55,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
