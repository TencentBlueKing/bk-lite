[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_hillstone"
        config_type = "hillstone"
        brand = "hillstone"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Hillstone 系统标量（HILLSTONE-SYSTEM-MIB hillstoneSysMibObjects = 28557.2.2.1）：顶层 field 带 .0 → measurement snmp ----
    # sysCPU .3.0：CPU 使用率 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.28557.2.2.1.3.0"
        name = "device_cpu_usage"
    # sysTotalMemory .4.0 / sysCurMemory .5.0：Gauge32，单位 KB；下方 starlark ×1024 转字节并计算利用率。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.28557.2.2.1.4.0"
        name = "memory_total_kb"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.28557.2.2.1.5.0"
        name = "memory_used_kb"
    # sysCurSession .7.0：当前活动会话数（Gauge32）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.28557.2.2.1.7.0"
        name = "firewall_active_sessions"
    # ---- Hillstone 温度表（HILLSTONE-TEMPERATURE-MIB 28557.2.28.1.2.1，每检测点一行，列 OID 不带 .0）----
    # hillstoneTemperatureValue .3（℃），hillstoneTemperatureDescr .2 作 tag。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28557.2.28.1.2.1.3"
        name = "celsius"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28557.2.28.1.2.1.2"
        name = "tempName"
        is_tag = true
    # ---- Hillstone 电源表（HILLSTONE-POWER-MIB 28557.2.27.1.2.1，每电源一行）----
    # hillstonePowerState .3：good(0) / notInstalled(1) / warning(2) / failure(3) / failureOrPoweredOff(4) / unsupported(5)。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28557.2.27.1.2.1.3"
        name = "state"
    # ---- Hillstone 风扇表（HILLSTONE-FAN-MIB 28557.2.26.1.2.1，每风扇一行）----
    # hillstoneFanState .5：good(0) / notInstalled(1) / warning(2) / failure(3) / failureOrPoweredOff(4) / noFan(5)；
    # hillstoneFanSpeed .4 转速；hillstoneFanDescr .2 作 tag。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28557.2.26.1.2.1.2"
        name = "fanName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28557.2.26.1.2.1.5"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.28557.2.26.1.2.1.4"
        name = "speed"
# ---- 内存：KB → 字节，利用率 = used / total × 100。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    total = metric.fields.pop("memory_total_kb", None)
    used = metric.fields.pop("memory_used_kb", None)
    if total != None:
        metric.fields["device_memory_total"] = int(total) * 1024
    if used != None:
        metric.fields["device_memory_used"] = int(used) * 1024
    if total != None and used != None and int(total) > 0:
        metric.fields["device_memory_usage"] = float(used) * 100.0 / float(total)
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["hillstone"]
# ---- 电源状态归一：good(0)→1，notInstalled(1,空位)→1，warning(2)/failure(3)/failureOrPoweredOff(4)/unsupported(5)→2。----
[[processors.enum]]
    namepass = ["device_psu"]
    [processors.enum.tagpass]
        brand = ["hillstone"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "0" = 1
            "1" = 1
# ---- 风扇状态归一：good(0)→1，notInstalled(1)/noFan(5)→1，warning(2)/failure(3)/failureOrPoweredOff(4)→2。----
[[processors.enum]]
    namepass = ["device_fan"]
    [processors.enum.tagpass]
        brand = ["hillstone"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "0" = 1
            "1" = 1
            "5" = 1
