[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_volius"
        config_type = "volius"
        brand = "volius"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- 机箱温度：vlsCaseTemperature，标量 VlsDeciCelsius（0.1℃），顶层 field 带 .0 ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.34652.2.10.6.0"
        name = "device_temperature_celsius"
    # ---- 风扇转速：vlsFanSpeed，标量 VlsRPM，顶层 field 带 .0（OA/OT 有，OR/OS 缺省）----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.34652.2.10.11.0"
        name = "volius_fan_speed"
    # ---- 供电电压表：vlsSupplyVoltageTable，table.field 不含 .0；实际/标称均为 VlsMillivolt ----
    [[inputs.snmp.table]]
        name = "volius_supply"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.34652.2.10.7.1.3"
        name = "voltage_volts"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.34652.2.10.7.1.2"
        name = "nominal_volts"
# ---- 私有树无整机 CPU/Mem Gauge；不采集型号相关光功率与告警表。----
# ---- 标量换算：温度÷10 为℃，超 −40..125 丢弃；风扇 RPM <0 或 >30000 及哨兵丢弃。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    f = metric.fields
    temp = f.get("device_temperature_celsius")
    if temp != None:
        celsius = float(temp) / 10.0
        if celsius < -40 or celsius > 125:
            f.pop("device_temperature_celsius")
        else:
            f["device_temperature_celsius"] = celsius
    fan = f.get("volius_fan_speed")
    if fan != None:
        rpm = int(fan)
        if rpm < 0 or rpm > 30000:
            f.pop("volius_fan_speed")
        else:
            f["volius_fan_speed"] = rpm
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["volius"]
# ---- 供电电压：原始 mV ÷1000 → V；哨兵 2147483647/−2147483648 或 |raw|>100000 丢弃该字段。----
[[processors.starlark]]
    namepass = ["volius_supply"]
    source = '''
def apply(metric):
    f = metric.fields
    keys = ["voltage_volts", "nominal_volts"]
    for key in keys:
        raw = f.get(key)
        if raw == None:
            continue
        ival = int(raw)
        if ival == 2147483647 or ival == -2147483648:
            f.pop(key)
            continue
        absval = ival
        if absval < 0:
            absval = -absval
        if absval > 100000:
            f.pop(key)
            continue
        f[key] = float(ival) / 1000.0
    if len(f.keys()) == 0:
        return None
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["volius"]
