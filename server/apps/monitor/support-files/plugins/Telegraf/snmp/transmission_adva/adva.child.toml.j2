[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_adva"
        config_type = "adva"
        brand = "adva"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- 内存：ADVA-MIB neInfo neMemorySizeTotal / neMemorySizeFree，标量，单位 kBytes ----
    # 顶层 field GET 必须带实例 .0；禁止 table.field。查询侧 ×1024 转为字节，使用率按 (total-free)/total。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2544.2.1.4.0"
        name = "device_memory_total"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.2544.2.1.5.0"
        name = "device_memory_free"
# ---- CPU/温度/风扇/电源：ADVA-MIB 通用 neInfo 无机箱 CPU 使用率与温度/风扇/电源状态对象，N/A。----
