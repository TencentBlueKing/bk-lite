[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_radwin"
        config_type = "radwin"
        brand = "radwin"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- RADWIN-MIB-WINLINK1000 (PEN 4458) 板温标量：顶层 field 带 .0 直接 GET ----
    # winlink1000OduAdmTemperatureC 1.3.6.1.4.1.4458.1000.1.1.44.0 → snmp_device_temperature_celsius
    # INTEGER，ODU 板内温度，整摄氏度，查询侧不缩放；设备不返回该叶时不产生该字段。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.4458.1000.1.1.44.0"
        name = "device_temperature_celsius"
        conversion = "int"
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
# ---- CPU/内存/风扇/电源：RADWIN-MIB-WINLINK1000 无 CPU/内存利用率或风扇/电源状态对象（CpuID 为标识而非利用率），保持 N/A，不臆造。----
