[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_transition"
        config_type = "transition"
        brand = "transition"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU 温度 tnDevSysHwInforCPUtmp → cpu_temperature_celsius（表列，摄氏度） ----
    # 企业号 868。按行采集，不把表臆造成整机标量。
    [[inputs.snmp.table]]
        name = "cpu_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.868.3.3.1.1.1.2.1.5"
        name = "celsius"
    # ---- 可选：板卡温度 tnDevSysHwInforBoardtmp → device_temperature_celsius ----
    # 部分机型不返回该列，缺省时该表自然为空。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.868.3.3.1.1.1.2.1.4"
        name = "celsius"
# ---- CPU/内存使用率：无私有 CPU% 或内存占用率对象，不臆造。风扇/电源无稳定可轮询健康量 → N/A 不采。----
