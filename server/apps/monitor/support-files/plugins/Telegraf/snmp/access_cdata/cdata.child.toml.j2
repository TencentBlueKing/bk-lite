[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_cdata"
        config_type = "cdata"
        brand = "cdata"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # FD-SYSTEM sysBaseInfo / chassisInfo scalars (PEN 34592).
    # sysCpuUtilization Integer32 0-100. chassisTemperature Unsigned32 as reported.
    # powerStatusBit: bit0 PSU A, bit1 PSU B (1=on). fanStatusBit: bits fan1-4.
    # No stable private memory-utilization scalar; do not invent mem%.
    [[inputs.snmp.table]]
        name = "device"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.34592.1.3.1.1.8.0"
        name = "cpu_usage"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.34592.1.3.1.3.4.0"
        name = "temperature_celsius"
    [[inputs.snmp.table]]
        name = "psu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.34592.1.3.1.3.5.0"
        name = "status"
    [[inputs.snmp.table]]
        name = "fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.34592.1.3.1.3.6.0"
        name = "status_bitmap"
