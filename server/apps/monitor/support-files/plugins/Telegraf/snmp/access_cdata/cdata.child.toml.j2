[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_cdata"
        config_type = "cdata"
        brand = "cdata"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # FD-SYSTEM sysBaseInfo / chassisInfo (PEN 34592): all four objects are scalars,
    # so they are top-level fields with instance .0 (direct GET), landing in measurement snmp;
    # queries use the snmp_ prefix.
    # sysCpuUtilization .1.1.8.0 Integer32 0-100. chassisTemperature .1.3.4.0 Unsigned32 as reported.
    # powerStatusBit .1.3.5.0: bit0 PSU A, bit1 PSU B (1=on). fanStatusBit .1.3.6.0: bits fan1-4 (1=on).
    # No stable private memory-utilization scalar; do not invent mem%.
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.34592.1.3.1.1.8.0"
        name = "device_cpu_usage"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.34592.1.3.1.3.4.0"
        name = "device_temperature_celsius"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.34592.1.3.1.3.5.0"
        name = "psu_status"
        conversion = "int"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.34592.1.3.1.3.6.0"
        name = "fan_status_bitmap"
        conversion = "int"
