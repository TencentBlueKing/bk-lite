[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_smartoptics"
        config_type = "smartoptics"
        brand = "smartoptics"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- DCP-ENV-MON temperature (PEN 30826, dcpEnvMonTemperatureTable) ----
    # 先 walk 行索引/传感器名，再采集温度列。原始值为 0.1°C，metrics.json 查询 /10 还原摄氏度。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.1.1.1.1.1"
        name = "index"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.1.1.1.1.2"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.1.1.1.1.3"
        name = "celsius"
    # ---- DCP-ENV-MON fan status / optional speed (dcpEnvMonFanTable) ----
    # FanStatus 1=notPresent / 2=ok / 3=alarm。下方 processors.enum 归一为 1=正常(ok/缺位)/2=异常(alarm 及未知码)。
    # 转速列为选配，无风扇转速的机型该列缺省，device_fan_speed 自然跳过。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.3.1.1.1.1"
        name = "index"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.3.1.1.1.2"
        name = "fan"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.3.1.1.1.3"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.3.1.1.1.5"
        name = "speed"
    # ---- DCP-ENV-MON optional power consumption (dcpEnvMonPowerConsumptionTable, Watt) ----
    # 功耗列为选配，无功耗传感器的机型该表缺省，device_power_watts 自然跳过。
    [[inputs.snmp.table]]
        name = "device_power"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.2.1.1.1.1"
        name = "index"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.2.1.1.1.2"
        name = "sensor"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.30826.2.2.6.1.2.1.1.1.3"
        name = "watts"
    # ---- CPU/内存：DCP-ENV-MON 无 CPU、内存对象，禁止臆造使用率。----
# ---- 风扇状态归一：2=ok→1(正常)，1=notPresent(缺位)→1(正常)，3=alarm 及其余→2(异常)。----
# ---- 共享盘 device_fan_state 约定 1=正常,>1=异常。----
[[processors.enum]]
    namepass = ["device_fan"]
    [[processors.enum.mapping]]
        field = "state"
        default = 2
        [processors.enum.mapping.value_mappings]
            "1" = 1
            "2" = 1
