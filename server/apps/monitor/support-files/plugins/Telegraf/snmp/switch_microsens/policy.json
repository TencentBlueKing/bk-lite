{
  "object": "Switch",
  "plugin": "Switch Microsens SNMP",
  "templates": [
    {
      "name": "MICROSENS交换机温度过高",
      "alert_name": "交换机${resource_name} 温度过高",
      "description": "监控 MICROSENS 工业交换机的机箱温度，当持续高于阈值时触发告警，提示可能存在散热不良或环境温度过高，避免器件过热损坏。",
      "metric_name": "device_temperature_celsius",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 70,
          "method": ">"
        },
        {
          "level": "error",
          "value": 60,
          "method": ">"
        },
        {
          "level": "warning",
          "value": 55,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "MICROSENS交换机电源异常",
      "alert_name": "交换机${resource_name} 电源状态异常",
      "description": "监控 MICROSENS 工业交换机的冗余电源模块状态，当电源故障或未就绪时触发告警，提示需检查供电冗余，避免单电源失效导致设备宕机。",
      "metric_name": "device_psu_state",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 1,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    },
    {
      "name": "MICROSENS交换机风扇异常",
      "alert_name": "交换机${resource_name} 风扇状态异常",
      "description": "监控 MICROSENS G6 工业交换机的风扇状态，当风扇降级、故障或缺失时触发告警，提示散热能力下降，避免设备过热。",
      "metric_name": "device_fan_state",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 1,
          "method": ">"
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
