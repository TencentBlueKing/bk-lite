[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_asterfusion"
        config_type = "asterfusion"
        brand = "asterfusion"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- CPU：cpuUtilization 标量，DisplayString 百分比文本，解析为 device_cpu_usage ----
    # OID 1.3.6.1.4.1.56928.2.1.1.0。starlark 去掉 % 后转为 0-100 数值。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56928.2.1.1.0"
        name = "usage"
    # ---- 内存：memUtilization 标量，DisplayString 百分比文本，解析为 device_memory_usage ----
    # OID 1.3.6.1.4.1.56928.2.1.2.0。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56928.2.1.2.0"
        name = "usage"
    # ---- 温度：afTemperatureCPU / afTemperatureSwitch 标量，取较大值写入 device_temperature_celsius ----
    # CPU 1.3.6.1.4.1.56928.2.1.3.31.0；交换机 1.3.6.1.4.1.56928.2.1.3.30.0。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56928.2.1.3.31.0"
        name = "cpu"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56928.2.1.3.30.0"
        name = "switch_sensor"
# ---- 风扇转速/状态表列 OID 未纳入本轮已证明集合，电源健康也无稳定枚举，均不采。----

[[processors.starlark]]
    namepass = ["device_cpu", "device_memory"]
    [processors.starlark.tagpass]
        brand = ["asterfusion"]
    source = '''
def parse_percent(raw):
    if raw == None:
        return None
    text = str(raw).strip()
    if text.endswith("%"):
        text = text[:-1].strip()
    if text == "":
        return None
    return float(text)

def apply(metric):
    parsed = parse_percent(metric.fields.get("usage"))
    if parsed == None:
        return None
    metric.fields["usage"] = parsed
    return metric
'''

[[processors.starlark]]
    namepass = ["device_temperature"]
    [processors.starlark.tagpass]
        brand = ["asterfusion"]
    source = '''
def parse_number(raw):
    if raw == None:
        return None
    text = str(raw).strip()
    if text.endswith("%") or text.endswith("C") or text.endswith("c"):
        text = text[:-1].strip()
    if text == "":
        return None
    return float(text)

def apply(metric):
    vals = []
    for key in ("cpu", "switch_sensor"):
        parsed = parse_number(metric.fields.get(key))
        if parsed != None:
            vals.append(parsed)
        if key in metric.fields:
            metric.fields.pop(key)
    if not vals:
        return None
    metric.fields["celsius"] = max(vals)
    return metric
'''
