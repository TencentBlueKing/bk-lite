[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_pulsesecure"
        config_type = "pulsesecure"
        brand = "pulsesecure"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Pulse Secure (Ivanti) IVE 健康标量（PULSESECURE-PSG-MIB，企业号 PEN 12532）----
    # 以下均为标量：顶层 field 带实例 .0，落 measurement snmp，查询用 snmp_ 前缀。
    # iveCpuUtil（.10.0）：CPU 使用率，Gauge32 0..100，直接%。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12532.10.0"
        name = "device_cpu_usage"
    # iveMemoryUtil（.11.0）：内存使用率，Gauge32 0..100，直接%（无 used/free 字节）。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12532.11.0"
        name = "device_memory_usage"
    # iveSwapUtil（.24.0）：Swap 使用率，Gauge32 0..100，直接%。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12532.24.0"
        name = "device_swap_usage"
    # diskFullPercent（.25.0）：磁盘使用率，Gauge32 0..100，直接%。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12532.25.0"
        name = "device_disk_usage"
    # iveTemperature（.42.0）：机箱温度，Gauge32，°C 直采无缩放；仅 MAG 刀片返回真值，其他平台返回 0。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12532.42.0"
        name = "device_temperature_celsius"
    # signedInWebUsers（.2.0）：已登录 Web 用户数，Gauge32。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12532.2.0"
        name = "device_web_users"
    # iveConcurrentUsers（.12.0）：本节点已占用的并发用户许可数，Gauge32。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.12532.12.0"
        name = "device_concurrent_users"
# ---- 风扇/电源：PULSESECURE-PSG-MIB 无风扇/电源状态对象 → N/A。温度仅 MAG 平台有效(非 MAG 返回 0)，max() 自然取真值。----
