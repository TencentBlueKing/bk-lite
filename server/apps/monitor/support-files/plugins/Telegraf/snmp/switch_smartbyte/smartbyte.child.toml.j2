[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_smartbyte"
        config_type = "smartbyte"
        brand = "smartbyte"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # ---- NMS-SYS-MIB（PEN 56166 · nmsModule …56166.1 · sys …1.2 · sysModule …1.2.1），标量顶层 field 带 .0 ----
    # cpuUtilized …1.2.1.1.0：近 1 分钟 CPU 利用率 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.56166.1.2.1.1.0"
        name = "device_cpu_usage"
    # memUtilized …1.2.1.2.0：内存利用率 %。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.56166.1.2.1.2.0"
        name = "device_memory_usage"
    # ---- 电源表 …1.2.3.1：INDEX powerIndex；.2 powerType 作可选 tag（unknown 丢弃）；.3 powerState。不采集电压列。----
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56166.1.2.3.1.2"
        name = "power_type"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56166.1.2.3.1.3"
        name = "state"
    # ---- 温度表 …1.2.4.1：INDEX temperatureIndex；.2 temperatureValue，单位 ℃，无缩放。----
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56166.1.2.4.1.2"
        name = "celsius"
    # ---- 风扇状态表 …1.2.5.1：INDEX fanIndex；.3 fanStatus。不采集 fanSpeedStatus（非 RPM）。----
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.56166.1.2.5.1.3"
        name = "state"
# ---- 标量过滤：CPU/Mem 超出 0..100 丢弃。----
[[processors.starlark]]
    namepass = ["snmp"]
    source = '''
def apply(metric):
    f = metric.fields
    cpu = f.get("device_cpu_usage")
    if cpu != None:
        if cpu < 0 or cpu > 100:
            f.pop("device_cpu_usage")
    mem = f.get("device_memory_usage")
    if mem != None:
        if mem < 0 or mem > 100:
            f.pop("device_memory_usage")
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["smartbyte"]
# ---- 温度：丢哨兵；超出 -40..125 ℃ 丢弃整行。无缩放。----
[[processors.starlark]]
    namepass = ["device_temperature"]
    source = '''
def apply(metric):
    raw = metric.fields.get("celsius")
    if raw == None:
        return None
    if raw == -1 or raw == 32767 or raw == 65534 or raw == 65535 or raw == 2147483647 or raw == -2147483648 or raw == 4294967295:
        return None
    value = float(raw)
    if value < -40 or value > 125:
        return None
    metric.fields["celsius"] = value
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["smartbyte"]
# ---- 风扇：normal(1)→1，failure(2)→2，其余丢弃。保留 index。----
[[processors.starlark]]
    namepass = ["device_fan"]
    source = '''
def apply(metric):
    raw = metric.fields.get("state")
    if raw == None:
        return None
    code = int(raw)
    if code == 1:
        metric.fields["state"] = 1
        return metric
    if code == 2:
        metric.fields["state"] = 2
        return metric
    return None
'''
    [processors.starlark.tagpass]
        brand = ["smartbyte"]
# ---- 电源：on(1)→1，off(2)→2，其余丢弃；powerType unknown(0) 去掉 tag。保留 index。----
[[processors.starlark]]
    namepass = ["device_psu"]
    source = '''
def apply(metric):
    pt = metric.tags.get("power_type")
    if pt == "0" or pt == "unknown":
        metric.tags.pop("power_type")
    raw = metric.fields.get("state")
    if raw == None:
        return None
    code = int(raw)
    if code == 1:
        metric.fields["state"] = 1
        return metric
    if code == 2:
        metric.fields["state"] = 2
        return metric
    return None
'''
    [processors.starlark.tagpass]
        brand = ["smartbyte"]
