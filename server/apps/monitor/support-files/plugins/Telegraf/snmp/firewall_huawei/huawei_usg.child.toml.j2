[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_huawei_usg"
        config_type = "huawei_usg"
        brand = "huawei"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB) + 64-bit HC ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.2.2"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Huawei USG CPU (HUAWEI-ENTITY-EXTENT-MIB hwEntityCpuUsage, per entity, 0-100%) ----
    # 现网核验：USG6390 ...1.1.5.<entPhysicalIndex> 可读；多实体 → Telegraf index + descr 维度（metrics 声明 dimensions=descr）。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.5"
        name = "usage"
    # ---- Huawei USG Memory (hwEntityMemUsage, USG6000 整机内存%, per entity) ----
    # 现网核验：...1.1.7.<index>；多实体 → descr 维度。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.7"
        name = "usage"
    # ---- Huawei USG Temperature (hwEntityTemperature, °C, per entity) ----
    # 现网核验：...1.1.11.<index>；多实体 → descr 维度。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.11"
        name = "celsius"
    # ---- Huawei USG Voltage (hwEntityVoltage, per entity, raw unit mV) ----
    # 标准 MIB 单位为 mV → metrics 查询 /1000 得 V。多实体 → descr 维度。
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.47.1.1.1.1.7"
        name = "descr"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.5.25.31.1.1.1.1.13"
        name = "volts"
    # ---- 会话（HUAWEI-SECURITY-SESSION-STAT-MIB，当前并发 / 新建会话）----
    # 不设私有表根：只 walk 数值列。部分机型为单实例，部分带虚系统下标；index 仅作标签。
    [[inputs.snmp.table]]
        name = "firewall"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.69.1.1.2"
        name = "active_sessions"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.69.1.1.4"
        name = "new_sessions"
    # ---- 会话与半连接（HUAWEI-SECURITY-STAT-MIB 整机监控标量）----
    # 当前总会话 / 建连速率 / 半连接 / TCP·UDP·ICMP 会话。Counter64 在此表示当前值，不做 rate()。
    [[inputs.snmp.table]]
        name = "firewall"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.1.2.1.4.0"
        name = "total_sessions"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.1.2.1.3.0"
        name = "session_rate"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.1.2.1.5.0"
        name = "half_open_sessions"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.1.2.1.6.0"
        name = "active_sessions_tcp"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.1.2.1.7.0"
        name = "active_sessions_udp"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.1.2.1.8.0"
        name = "active_sessions_icmp"
    # ---- 整机会话与吞吐（HUAWEI-SECURITY-STAT-MIB device 标量）----
    # 吞吐优先 64 位对象；32 位 Gauge 在高速设备上可能回绕。未支持的对象为空，不阻断其余指标。
    [[inputs.snmp.table]]
        name = "firewall"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.6.2.0"
        name = "device_sessions"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.6.3.0"
        name = "device_session_rate"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.6.4.0"
        name = "throughput32"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.6.5.0"
        name = "throughput"
    # ---- USG9500 SPU CPU（hwSecStatPerfAndPhyTable，按 PerfIndex；槽位/CPU 为列而非 ENTITY 下标）----
    # 禁止 walk 私有表根 15.2。未插 SPU 或非框式机型表为空，不阻断整机会话/吞吐。
    [[inputs.snmp.table]]
        name = "firewall_spu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.2.1.2"
        name = "slot"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.2.1.3"
        name = "cpu"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2011.6.122.15.2.1.6"
        name = "usage"
# ---- 风扇/电源/光衰：本模板不建模风扇运行状态、电源状态与光功率。----
# 风扇仅有注册与否，语义不等于运行状态。电源仅有整机计数，无 per-PSU 状态。
# 光功率并非本插件会话/吞吐范围。
