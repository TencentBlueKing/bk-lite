[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_ipinfusion"
        config_type = "ipinfusion"
        brand = "ipinfusion"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        name = "interface"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.1"
        name = "ifIndex"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- CPU：CMM-CHASSIS-MIB cmmStackCpuTable cmmStackUnitCpuUtilization，UNITS 0.01%，表列禁止 .0 ----
    # 列 OID 1.3.6.1.4.1.36673.100.1.2.5.1.9，INDEX=cmmStackUnitIndex。starlark ÷100 为百分比。
    [[inputs.snmp.table]]
        name = "device_cpu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.36673.100.1.2.5.1.9"
        name = "usage"
    # ---- 内存：cmmSysRamTable 总量 MBytes / 已用%（UNITS 已是百分比），表列禁止 .0 ----
    # total 1.3.6.1.4.1.36673.100.1.2.4.1.1 → starlark ×1048576 为字节；usage .4.1.2 直接为 %。
    [[inputs.snmp.table]]
        name = "device_memory"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.36673.100.1.2.4.1.1"
        name = "total"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.36673.100.1.2.4.1.2"
        name = "usage"
    # ---- 机箱温度：cmmSysTemperatureTable，UNITS 0.01℃，表列禁止 .0 ----
    # 名称 .10.1.2 作 tag sensor_name；读数 .10.1.3 starlark ÷100 为 ℃。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.36673.100.1.2.10.1.2"
        name = "sensor_name"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.36673.100.1.2.10.1.3"
        name = "celsius"
    # ---- 风扇：cmmFanTable RPM + 状态，INDEX=(unit,tray,fan)，表列禁止 .0 ----
    # RPM .9.1.2 用量程过滤；状态 .9.1.5 running(2)/notpresent(1)→1，faulty(3)/stalled(4)/unknown(5)/not-applicable(-100002)→2，MIB 未定义值丢弃。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.36673.100.1.2.9.1.2"
        name = "speed"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.36673.100.1.2.9.1.5"
        name = "state"
    # ---- 电源：cmmSysPowerSupplyTable 状态 + PSU 温度1，表列禁止 .0 ----
    # 状态 .6.1.2 running(2)/notpresent(1)→1，faulty(3)/unknown(4)/not-applicable(-100002)→2，MIB 未定义值丢弃。
    # 温度 .6.1.11 UNITS 0.01℃，starlark ÷100。无有效字段的行丢弃。
    [[inputs.snmp.table]]
        name = "device_psu"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.36673.100.1.2.6.1.2"
        name = "state"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.36673.100.1.2.6.1.11"
        name = "temperature_celsius"

# ---- CMM 数值换算与状态归一：每字段只用量程过滤（下限高于 -100001），换算只做一次。----
[[processors.starlark]]
    namepass = ["device_cpu", "device_memory", "device_temperature", "device_fan", "device_psu"]
    source = '''
def _num(v):
    if v == None:
        return None
    if type(v) == "int" or type(v) == "float":
        return float(v)
    err = catch(lambda: float(v))
    if err != None:
        return None
    return float(v)

def apply(metric):
    name = metric.name
    f = metric.fields
    if name == "device_cpu":
        raw = _num(f.get("usage"))
        if raw == None:
            return None
        usage = raw / 100.0
        if usage < 0 or usage > 100:
            return None
        f["usage"] = usage
        return metric
    if name == "device_memory":
        total = _num(f.get("total"))
        usedpct = _num(f.get("usage"))
        if total != None and total > 0:
            f["total"] = int(total * 1048576)
        else:
            f.pop("total", None)
        if usedpct != None and usedpct >= 0 and usedpct <= 100:
            f["usage"] = usedpct
        else:
            f.pop("usage", None)
        if len(f.keys()) == 0:
            return None
        return metric
    if name == "device_temperature":
        raw = _num(f.get("celsius"))
        if raw == None:
            return None
        celsius = raw / 100.0
        if celsius < -40 or celsius > 150:
            return None
        f["celsius"] = celsius
        return metric
    if name == "device_fan":
        rpm = _num(f.get("speed"))
        if rpm == None:
            f.pop("speed", None)
        elif rpm < 0 or rpm > 50000:
            f.pop("speed", None)
        else:
            f["speed"] = rpm
        st = _num(f.get("state"))
        if st == 2 or st == 1:
            f["state"] = 1
        elif st == 3 or st == 4 or st == 5 or st == -100002:
            f["state"] = 2
        else:
            f.pop("state", None)
        if len(f.keys()) == 0:
            return None
        return metric
    if name == "device_psu":
        st = _num(f.get("state"))
        if st == 2 or st == 1:
            f["state"] = 1
        elif st == 3 or st == 4 or st == -100002:
            f["state"] = 2
        else:
            f.pop("state", None)
        raw = _num(f.get("temperature_celsius"))
        if raw == None:
            f.pop("temperature_celsius", None)
        else:
            temp = raw / 100.0
            if temp < -40 or temp > 150:
                f.pop("temperature_celsius", None)
            else:
                f["temperature_celsius"] = temp
        if len(f.keys()) == 0:
            return None
        return metric
    return metric
'''
    [processors.starlark.tagpass]
        brand = ["ipinfusion"]
