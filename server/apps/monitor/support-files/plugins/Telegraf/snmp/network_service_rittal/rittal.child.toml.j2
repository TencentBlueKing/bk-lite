[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_rittal"
        config_type = "rittal"
        brand = "rittal"

    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
# @bk_include_ifmib_table
    # RITTAL-CMC-III-MIB cmcIIIVarTable under PEN 2606.7.
    # Walk the whole variable table. Do not hardcode a row index such as .1.5.
    # Exact cmcIIIVarName varies by sensor config; queries map by Unit/Name.
    # Do not invent CPU% or memory. Do not collect CMC-III control/command trees.
    [[inputs.snmp.table]]
        oid = "1.3.6.1.4.1.2606.7.4.2.2"
        name = "cmcIIIVar"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2606.7.4.2.2.1.3"
        name = "cmcIIIVarName"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2606.7.4.2.2.1.5"
        name = "cmcIIIVarUnit"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2606.7.4.2.2.1.10"
        name = "cmcIIIVarValueStr"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.2606.7.4.2.2.1.11"
        name = "cmcIIIVarValueInt"
