{
  "object": "Zookeeper",
  "plugin": "Zookeeper",
  "templates": [
    {
      "name": "请求延迟过高",
      "alert_name": "ZooKeeper节点 ${resource_name} 响应延迟",
      "description": "监控平均请求处理延迟，高延迟会影响依赖ZK的协调服务。需检查网络和磁盘IO性能。",
      "metric_name": "zookeeper_avg_latency",
      "algorithm": "max_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 500,
          "method": ">="
        },
        {
          "level": "error",
          "value": 300,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 100,
          "method": ">="
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "数据节点暴增",
      "alert_name": "ZooKeeper集群 ${resource_name} znode过多",
      "description": "监控znode总数，过量znode会导致内存压力和同步延迟。需清理临时节点或扩容集群。",
      "metric_name": "zookeeper_znode_count",
      "algorithm": "max_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 1000000,
          "method": ">="
        },
        {
          "level": "error",
          "value": 500000,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 100000,
          "method": ">="
        }
      ],
      "group_algorithm": "max"
    },
    {
      "name": "网络包异常",
      "alert_name": "ZooKeeper节点 ${resource_name} 流量异常",
      "description": "监控接收的网络包数量，突增可能表明客户端异常或攻击行为。",
      "metric_name": "zookeeper_packets_received",
      "algorithm": "last_over_time",
      "threshold": [
        {
          "level": "critical",
          "value": 1000,
          "method": ">="
        },
        {
          "level": "error",
          "value": 500,
          "method": ">="
        },
        {
          "level": "warning",
          "value": 200,
          "method": ">="
        }
      ],
      "group_algorithm": "avg"
    }
  ]
}
