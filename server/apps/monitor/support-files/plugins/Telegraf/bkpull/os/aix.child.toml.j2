[[inputs.prometheus]]
    startup_error_behavior = "retry"
    urls = [
        "http://{{ host }}:{{ port | default(9100, true) }}/metrics",
    ]
    interval = "{{ interval }}s"
    timeout = "{{ interval }}s"
    response_timeout = "{{ interval }}s"
    [inputs.prometheus.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "bkpull"
        config_type = "aix"
