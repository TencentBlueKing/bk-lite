{
  "plugin": "Host AIX",
  "plugin_desc": "The platform installs official node_exporter on the AIX host. A Linux collector node scrapes CPU, memory, disk, network, and LPAR metrics via Prometheus.",
  "support_collect_detect": true,
  "status_query": "any({instance_type='os', collect_type='bkpull', config_type='aix'}) by (instance_id)",
  "instance_fact_bindings": [{"fact":"asset.ip","value_type":"ip","resolver":"input","options":{"field":"host","required":true}}],
  "instance_summary_columns": [{"fact":"asset.ip","title":"monitor.views.assetIp","order":10}],
  "node_selector": {
    "is_container": true
  },
  "name": "Host",
  "icon": "mm-host_主机",
  "type": "OS",
  "description": "",
  "default_metric": "any({instance_type='os'}) by (instance_id)",
  "instance_id_keys": ["instance_id"],
  "supplementary_indicators": ["cpu_usage_total", "mem_used_percent", "disk_used_percent"],
  "display_fields": [
    {"name":"CPU使用率","sort_order":0,"metrics":[{"plugin":"Host","metric":"cpu_usage_total"},{"plugin":"Windows WMI","metric":"cpu_usage_total"},{"plugin":"Host Remote","metric":"cpu_usage_total"},{"plugin":"Host AIX","metric":"cpu_usage_total"}]},
    {"name":"内存使用率","sort_order":1,"metrics":[{"plugin":"Host","metric":"mem_used_percent"},{"plugin":"Windows WMI","metric":"mem_used_percent"},{"plugin":"Host Remote","metric":"mem_used_percent"},{"plugin":"Host AIX","metric":"mem_used_percent"}]},
    {"name":"磁盘使用率","sort_order":2,"metrics":[{"plugin":"Host","metric":"disk_used_percent"},{"plugin":"Windows WMI","metric":"disk_used_percent"},{"plugin":"Host Remote","metric":"disk_used_percent"},{"plugin":"Host AIX","metric":"disk_used_percent"}]},
    {"name":"网络入向吞吐","sort_order":3,"metrics":[{"plugin":"Host","metric":"net_bytes_recv_rate"},{"plugin":"Windows WMI","metric":"net_bytes_recv_rate"},{"plugin":"Host Remote","metric":"net_bytes_recv_rate"},{"plugin":"Host AIX","metric":"net_bytes_recv_rate"}]},
    {"name":"磁盘IO使用率","sort_order":4,"metrics":[{"plugin":"Host","metric":"diskio_io_util"},{"plugin":"Windows WMI","metric":"diskio_io_util"}]}
  ],
  "metrics": [
    {
      "metric_group": "CPU",
      "name": "cpu_usage_total",
      "query": "100 * (1 - sum(rate(node_cpu_seconds_total_counter{mode=\"idle\", instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])) / sum(rate(node_cpu_seconds_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])))",
      "display_name": "CPU Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Reflects the overall CPU utilization of the host, representing the proportion of non-idle CPU time. Sustained high values usually indicate CPU resource pressure or bottlenecks."
    },
    {
      "metric_group": "CPU",
      "name": "cpu_usage_core",
      "query": "100 * (1 - sum by (cpu) (rate(node_cpu_seconds_total_counter{mode=\"idle\", instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])) / sum by (cpu) (rate(node_cpu_seconds_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])))",
      "display_name": "CPU Core Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [{"name": "cpu", "description": "cpu"}],
      "instance_id_keys": ["instance_id"],
      "description": "Describes the utilization of individual CPU cores, enabling analysis of load distribution and identification of imbalanced or hot cores."
    },
    {
      "metric_group": "CPU",
      "name": "cpu_usage_iowait_total",
      "query": "100 * sum(rate(node_cpu_seconds_total_counter{mode=\"wait\", instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])) / sum(rate(node_cpu_seconds_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m]))",
      "display_name": "CPU IOWait Rate",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Indicates the proportion of CPU time spent waiting for I/O operations to complete, commonly used to identify disk or I/O performance constraints."
    },
    {
      "metric_group": "CPU",
      "name": "cpu_usage_system_total",
      "query": "100 * sum(rate(node_cpu_seconds_total_counter{mode=\"system\", instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])) / sum(rate(node_cpu_seconds_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m]))",
      "display_name": "CPU System Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the percentage of CPU time spent executing kernel-level tasks. Abnormally high values may indicate increased system overhead or frequent system calls."
    },
    {
      "metric_group": "CPU",
      "name": "cpu_usage_user_total",
      "query": "100 * sum(rate(node_cpu_seconds_total_counter{mode=\"user\", instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])) / sum(rate(node_cpu_seconds_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m]))",
      "display_name": "CPU User Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Indicates the percentage of CPU time spent executing user-space application logic, commonly used to evaluate application CPU consumption."
    },
    {
      "metric_group": "System",
      "name": "system_load1",
      "query": "node_load1_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "1 Minute Average Load",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the average system load over the last 1 minute, primarily used to observe short-term load fluctuations."
    },
    {
      "metric_group": "System",
      "name": "system_load5",
      "query": "node_load5_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "5 Minute Average Load",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the average system load over the last 5 minutes, useful for analyzing short-term load trends."
    },
    {
      "metric_group": "System",
      "name": "system_load15",
      "query": "node_load15_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "15 Minute Average Load",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the average system load over the last 15 minutes, commonly used to evaluate long-term load stability."
    },
    {
      "metric_group": "Disk IO",
      "name": "disk_write_latency",
      "query": "1000 * rate(node_disk_write_time_seconds_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m]) / rate(node_disk_transfers_to_disk_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Disk Write Latency",
      "data_type": "Number",
      "unit": "ms",
      "dimensions": [{"name": "device", "description": "设备名"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the average latency of disk write operations, used to analyze disk write performance and responsiveness."
    },
    {
      "metric_group": "Disk IO",
      "name": "disk_read_latency",
      "query": "1000 * rate(node_disk_read_time_seconds_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m]) / clamp_min(rate(node_disk_transfers_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m]) - rate(node_disk_transfers_to_disk_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m]), 0)",
      "display_name": "Disk Read Latency",
      "data_type": "Number",
      "unit": "ms",
      "dimensions": [{"name": "device", "description": "设备名"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the average latency of disk read operations, used to analyze disk read performance and access delay."
    },
    {
      "metric_group": "Disk",
      "name": "disk_total",
      "query": "node_filesystem_size_bytes_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Disk Total",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [{"name": "device", "description": "磁盘设备"}, {"name": "mountpoint", "description": "挂载路径"}, {"name": "fstype", "description": "文件系统类型"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the total capacity of a disk or filesystem, used for capacity planning and resource management."
    },
    {
      "metric_group": "Disk",
      "name": "disk_free",
      "query": "node_filesystem_free_bytes_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Disk Free",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [{"name": "device", "description": "磁盘设备"}, {"name": "mountpoint", "description": "挂载路径"}, {"name": "fstype", "description": "文件系统类型"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the currently available free space of a disk or filesystem, used to monitor capacity risks."
    },
    {
      "metric_group": "Disk",
      "name": "disk_used_percent",
      "query": "100 * (1 - node_filesystem_free_bytes_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__} / node_filesystem_size_bytes_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__})",
      "display_name": "Disk Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [{"name": "device", "description": "磁盘设备"}, {"name": "mountpoint", "description": "挂载路径"}, {"name": "fstype", "description": "文件系统类型"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the percentage of disk space that has been consumed, a core metric for disk capacity monitoring."
    },
    {
      "metric_group": "Disk",
      "name": "disk_inodes_used_percent",
      "query": "100 * (1 - node_filesystem_files_free_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__} / node_filesystem_files_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__})",
      "display_name": "Inode Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [{"name": "device", "description": "磁盘设备"}, {"name": "mountpoint", "description": "挂载路径"}, {"name": "fstype", "description": "文件系统类型"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the percentage of inode usage in a filesystem, helping prevent failures caused by inode exhaustion."
    },
    {
      "metric_group": "Memory",
      "name": "mem_total",
      "query": "node_memory_total_bytes_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Total Memory",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the total amount of physical memory available on the system, serving as a baseline for memory evaluation."
    },
    {
      "metric_group": "Memory",
      "name": "mem_available",
      "query": "node_memory_available_bytes_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Available Memory",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the amount of memory available for applications without causing significant performance degradation."
    },
    {
      "metric_group": "Memory",
      "name": "mem_used_percent",
      "query": "100 * (1 - node_memory_available_bytes_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__} / node_memory_total_bytes_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__})",
      "display_name": "Memory Usage",
      "data_type": "Number",
      "unit": "percent",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the percentage of memory currently in use, indicating overall memory pressure."
    },
    {
      "metric_group": "Memory",
      "name": "mem_swap_free",
      "query": "node_memory_paging_space_free_bytes_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Swap Free Memory",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the amount of free swap space available, used to monitor buffering capacity under memory pressure."
    },
    {
      "metric_group": "Net",
      "name": "net_packets_recv_rate",
      "query": "rate(node_network_receive_packets_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Network Receive Packet Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the number of packets received per unit time on a network interface, reflecting packet-level traffic."
    },
    {
      "metric_group": "Net",
      "name": "net_packets_recv_total",
      "query": "node_network_receive_packets_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Network Received Packets",
      "data_type": "Number",
      "unit": "counts",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the cumulative number of packets received on a network interface, useful for analyzing inbound traffic volume."
    },
    {
      "metric_group": "Net",
      "name": "net_packets_sent_rate",
      "query": "rate(node_network_transmit_packets_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Network Send Packet Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the number of packets sent per unit time on a network interface."
    },
    {
      "metric_group": "Net",
      "name": "net_packets_sent_total",
      "query": "node_network_transmit_packets_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Network Sent Packets",
      "data_type": "Number",
      "unit": "counts",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the cumulative number of packets sent on a network interface, useful for analyzing outbound traffic volume."
    },
    {
      "metric_group": "Net",
      "name": "net_bytes_recv_rate",
      "query": "rate(node_network_receive_bytes_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Network Receive Throughput Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the amount of data received per unit time on a network interface, used to evaluate inbound bandwidth utilization."
    },
    {
      "metric_group": "Net",
      "name": "net_bytes_sent_rate",
      "query": "rate(node_network_transmit_bytes_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Network Send Throughput Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the amount of data sent per unit time on a network interface, used to evaluate outbound bandwidth utilization."
    },
    {
      "metric_group": "Net",
      "name": "net_err_in_rate",
      "query": "rate(node_network_receive_errors_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Network Receive Error Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the number of errored packets received per unit time, used to monitor network quality."
    },
    {
      "metric_group": "Net",
      "name": "net_err_out_rate",
      "query": "rate(node_network_transmit_errors_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Network Send Error Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the number of errored packets sent per unit time on a network interface."
    },
    {
      "metric_group": "Net",
      "name": "net_drop_in_rate",
      "query": "rate(node_network_receive_dropped_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Network Receive Drop Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the number of incoming packets dropped per unit time, indicating congestion or abnormal conditions."
    },
    {
      "metric_group": "Net",
      "name": "net_drop_in_total",
      "query": "node_network_receive_dropped_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Network Receive Drops",
      "data_type": "Number",
      "unit": "counts",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the cumulative number of incoming packets dropped on a network interface, useful for locating congestion, buffer pressure, or driver anomalies."
    },
    {
      "metric_group": "Net",
      "name": "net_drop_out_rate",
      "query": "rate(node_network_transmit_dropped_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Network Send Drop Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the number of outgoing packets dropped per unit time on a network interface."
    },
    {
      "metric_group": "Net",
      "name": "net_drop_out_total",
      "query": "node_network_transmit_dropped_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Network Send Drops",
      "data_type": "Number",
      "unit": "counts",
      "dimensions": [{"name": "device", "description": "网络接口"}],
      "instance_id_keys": ["instance_id"],
      "description": "Represents the cumulative number of outgoing packets dropped on a network interface, useful for troubleshooting outbound network issues."
    },
    {
      "metric_group": "LPAR",
      "name": "lpar_entitled_capacity",
      "query": "node_partition_entitled_capacity_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Entitled Capacity",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Current LPAR entitled capacity."
    },
    {
      "metric_group": "LPAR",
      "name": "lpar_memory_online",
      "query": "node_partition_memory_online_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Memory Online",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Current LPAR online memory."
    },
    {
      "metric_group": "LPAR",
      "name": "lpar_memory_max",
      "query": "node_partition_memory_max_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Memory Max",
      "data_type": "Number",
      "unit": "bytes",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Maximum configurable LPAR memory."
    },
    {
      "metric_group": "LPAR",
      "name": "lpar_cpus_online",
      "query": "node_partition_cpus_online_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "CPUs Online",
      "data_type": "Number",
      "unit": "counts",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Current number of online LPAR CPUs."
    },
    {
      "metric_group": "LPAR",
      "name": "lpar_smt_threads",
      "query": "node_partition_smt_threads_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "SMT Threads",
      "data_type": "Number",
      "unit": "counts",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Current LPAR SMT thread count."
    },
    {
      "metric_group": "LPAR",
      "name": "lpar_power_save",
      "query": "node_partition_power_save_mode_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Power Save",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Current LPAR power-save mode."
    },
    {
      "metric_group": "LPAR",
      "name": "lpar_physical_cpu_seconds",
      "query": "rate(node_cpu_physical_seconds_total_counter{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}[5m])",
      "display_name": "Physical CPU Seconds",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Physical CPU seconds consumed by the LPAR."
    },
    {
      "metric_group": "LPAR",
      "name": "lpar_run_queue",
      "query": "node_cpu_runqueue_gauge{instance_type=\"os\", collect_type=\"bkpull\", config_type=\"aix\", __$labels__}",
      "display_name": "Run Queue",
      "data_type": "Number",
      "unit": "none",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "Current LPAR run-queue length."
    }
  ]
}
