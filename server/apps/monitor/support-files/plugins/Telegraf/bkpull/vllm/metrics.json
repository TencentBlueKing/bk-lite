{
  "plugin": "VLLM",
  "plugin_desc": "由 Telegraf Pull 采集器通过 Prometheus 指标端点采集 vLLM 推理服务关键监控指标，覆盖请求队列、KV 缓存占用、Token 吞吐与时延等核心运维场景。",
  "status_query": "any({instance_type='vllm', collect_type='bkpull'}) by (instance_id)",
  "instance_fact_bindings": [
    {
      "fact": "asset.ip",
      "value_type": "ip",
      "resolver": "input",
      "options": {
        "field": "server_url"
      }
    }
  ],
  "instance_summary_columns": [
    {
      "fact": "asset.ip",
      "title": "monitor.views.assetIp",
      "order": 10
    }
  ],
  "name": "VLLM",
  "icon": "mm-vllm_VLLM",
  "type": "LLM Inference",
  "description": "",
  "default_metric": "any({instance_type='vllm'}) by (instance_id)",
  "instance_id_keys": [
    "instance_id"
  ],
  "supplementary_indicators": [
    "vllm:num_requests_running_gauge",
    "vllm:num_requests_waiting_gauge",
    "vllm:kv_cache_usage_perc_gauge",
    "vllm:generation_tokens_total_counter_rate",
    "vllm:inter_token_latency_seconds_p99",
    "vllm:e2e_request_latency_seconds_p90"
  ],
  "display_fields": [
    {
      "name": "运行中请求数",
      "sort_order": 0,
      "metrics": [
        {
          "plugin": "VLLM",
          "metric": "vllm:num_requests_running_gauge"
        }
      ]
    },
    {
      "name": "排队请求数",
      "sort_order": 1,
      "metrics": [
        {
          "plugin": "VLLM",
          "metric": "vllm:num_requests_waiting_gauge"
        }
      ]
    },
    {
      "name": "KV缓存占用",
      "sort_order": 2,
      "metrics": [
        {
          "plugin": "VLLM",
          "metric": "vllm:kv_cache_usage_perc_gauge"
        }
      ]
    },
    {
      "name": "生成Token速率",
      "sort_order": 3,
      "metrics": [
        {
          "plugin": "VLLM",
          "metric": "vllm:generation_tokens_total_counter_rate"
        }
      ]
    }
  ],
  "metrics": [
    {
      "metric_group": "请求队列",
      "name": "vllm:num_requests_running_gauge",
      "display_name": "运行中请求数",
      "instance_id_keys": [
        "instance_id"
      ],
      "data_type": "Number",
      "unit": "counts",
      "dimensions": [],
      "description": "当前正在模型执行批次中的请求数量。",
      "query": "vllm:num_requests_running_gauge{__$labels__}"
    },
    {
      "metric_group": "请求队列",
      "name": "vllm:num_requests_waiting_gauge",
      "display_name": "排队请求数",
      "instance_id_keys": [
        "instance_id"
      ],
      "data_type": "Number",
      "unit": "counts",
      "dimensions": [],
      "description": "当前等待调度容量的请求数量。",
      "query": "vllm:num_requests_waiting_gauge{__$labels__}"
    },
    {
      "metric_group": "缓存",
      "name": "vllm:kv_cache_usage_perc_gauge",
      "display_name": "KV缓存占用比例",
      "instance_id_keys": [
        "instance_id"
      ],
      "data_type": "Number",
      "unit": "percentunit",
      "dimensions": [],
      "description": "已使用 KV cache 块占比（0–1）。",
      "query": "vllm:kv_cache_usage_perc_gauge{__$labels__}"
    },
    {
      "metric_group": "Token吞吐",
      "name": "vllm:prompt_tokens_total_counter_rate",
      "display_name": "Prefill Token 速率",
      "instance_id_keys": [
        "instance_id"
      ],
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [],
      "description": "最近 5 分钟 prompt（prefill）token 处理速率。",
      "query": "sum(rate(vllm:prompt_tokens_total_counter{__$labels__}[5m])) by (instance_id)"
    },
    {
      "metric_group": "Token吞吐",
      "name": "vllm:generation_tokens_total_counter_rate",
      "display_name": "生成 Token 速率",
      "instance_id_keys": [
        "instance_id"
      ],
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [],
      "description": "最近 5 分钟生成 token 速率。",
      "query": "sum(rate(vllm:generation_tokens_total_counter{__$labels__}[5m])) by (instance_id)"
    },
    {
      "metric_group": "时延",
      "name": "vllm:time_to_first_token_seconds_p99",
      "display_name": "首 Token 时延 P99",
      "instance_id_keys": [
        "instance_id"
      ],
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
      "description": "最近 5 分钟 Time-to-First-Token（TTFT）P99。",
      "query": "histogram_quantile(0.99, sum(rate((label_replace({__name__=~\"vllm:time_to_first_token_seconds_[0-9.]+\", __$labels__}, \"le\", \"$1\", \"__name__\", \"vllm:time_to_first_token_seconds_(.+)\"))[5m:]) or label_replace(rate(vllm:time_to_first_token_seconds_count{__$labels__}[5m]), \"le\", \"+Inf\", \"__name__\", \".*\")) by (instance_id, le))"
    },
    {
      "metric_group": "时延",
      "name": "vllm:e2e_request_latency_seconds_p99",
      "display_name": "端到端请求时延 P99",
      "instance_id_keys": [
        "instance_id"
      ],
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
