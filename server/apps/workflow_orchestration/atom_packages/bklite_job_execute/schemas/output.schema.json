          "target": {"type": "object", "title": "目标"},
          "status": {"type": "string", "enum": ["SUCCESS", "FAILED"], "title": "状态"},
          "exit_code": {"type": "integer", "title": "退出码"},
          "stdout": {"type": "string", "title": "标准输出"},
          "stderr": {"type": "string", "title": "错误输出"},
          "data": {"title": "业务 JSON"},
