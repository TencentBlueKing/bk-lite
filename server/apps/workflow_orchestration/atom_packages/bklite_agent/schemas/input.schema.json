{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": "integer",
      "title": "智能体",
      "x-widget": "select",
      "x-binding": "literal-only"
    },
    "message": {
      "type": "string",
      "title": "输入内容",
      "minLength": 1,
      "maxLength": 50000,
      "x-widget": "textarea"
    },
    "prompt": {
      "type": "string",
      "title": "补充提示词",
      "maxLength": 10000,
      "x-widget": "textarea"
    },
    "knowledge_files": {
      "type": "array",
      "title": "上传知识",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["workflow_agent_knowledge"]},
          "name": {"type": "string", "maxLength": 255},
          "format": {"type": "string", "enum": ["md"]},
          "size": {"type": "integer", "minimum": 1, "maximum": 10485760},
          "token": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "required": ["kind", "name", "format", "size", "token"]
      },
      "x-widget": "agent-knowledge-upload",
      "x-binding": "literal-only"
    },
    "memory_context": {
      "type": "string",
      "title": "记忆上下文",
      "maxLength": 100000,
      "x-widget": "textarea"
    }
  },
  "required": ["agent_id", "message"]
}
