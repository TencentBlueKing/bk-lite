# RUM control-plane / gateway defaults for Django apps.rum
# Copy into server/.env when enabling rum in INSTALL_APPS.
#
# Browser snippets use the console origin the operator opened:
#   {origin}/rum/v1/collect
#   {origin}/rum/v1/replay
#   {origin}/rum/bklite-rum-sdk.js
# Set RUM_PUBLIC_ORIGIN only when those paths are published on another host.
# RUM_PUBLIC_ORIGIN=https://rum.example.com

RUM_TENANT_ID=core

# Django publishes as rum_ctl; controller subscribes as rum_controller.
# Leave RUM_NATS_URL empty to use the host from NATS_SERVERS (any account in
# that URL is ignored). Set it only when RUM uses a different host, such as
# the local compose fixture on 127.0.0.1:14222. The value is host-only.
# A URL with embedded userinfo, or a user without a password, leaves the
# control plane unavailable. Startup still proceeds.
RUM_NATS_URL=nats://127.0.0.1:14222
RUM_NATS_USER=rum_ctl
RUM_NATS_PASSWORD=rum-ctl-contract-password
RUM_NATS_TIMEOUT_SECONDS=5

# HMAC secret for replay ref/segment tokens (≥32 chars). Required for grant/manifest signing.
RUM_REPLAY_SIGNING_SECRET=dev-bklite-rum-replay-signing-secret-32b

# Replay index (Redis DB 2). Empty Redis URL → replay column stays "—".
# Replay objects are read from the platform MinIO bucket rum-replay
# (MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY / MINIO_USE_HTTPS).
RUM_REPLAY_INDEX_REDIS_URL=redis://rum-replay-exporter:rum-replay-exporter-dev-secret-000003@127.0.0.1:16379/2

# VictoriaLogs / VictoriaTraces. Empty → analyticsUnavailable degrade.
# Host ports from deploy/rum/.env.example (VL 19428, VT 10429).
RUM_VICTORIA_LOGS_URL=http://127.0.0.1:19428
RUM_VICTORIA_TRACES_URL=http://127.0.0.1:10429
RUM_VICTORIA_ACCOUNT_ID=0
RUM_VICTORIA_PROJECT_ID=0
RUM_VICTORIA_TIMEOUT_SECONDS=15
