# Celery 通用弹性配置。启用前按负载与整机预算填写空值；不是生产容量推荐。
ENABLE_CELERY=true
CELERY_CRITICAL_MIN=
CELERY_CRITICAL_MAX=
CELERY_NOTIFICATION_MIN=
CELERY_NOTIFICATION_MAX=
CELERY_STATE_MIN=
CELERY_STATE_MAX=
CELERY_BACKGROUND_MIN=
CELERY_BACKGROUND_MAX=
CELERY_TOTAL_CONCURRENCY_LIMIT=

# 所有可能同时运行的同构四池实例数，包含升级重叠；MAX 总和按此倍数校验。
CELERY_WORKER_REPLICAS=1
# 多实例时必须显式指定；仅唯一实例 true，其余 false。此参数不是分布式锁。
CELERY_RUN_BEAT=true
AUTOSCALE_KEEPALIVE=60
# 移除旧 CELERY_CONCURRENCY。broker、结果后端和凭据沿用部署环境注入。
