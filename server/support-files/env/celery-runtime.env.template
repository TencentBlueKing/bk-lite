# Celery 单实例默认启动配置；可按负载覆盖，整机容量仍须实测。
ENABLE_CELERY=true
CELERY_CRITICAL_MIN=1
CELERY_CRITICAL_MAX=2
CELERY_NOTIFICATION_MIN=1
CELERY_NOTIFICATION_MAX=2
CELERY_STATE_MIN=1
CELERY_STATE_MAX=2
CELERY_BACKGROUND_MIN=1
CELERY_BACKGROUND_MAX=1
CELERY_TOTAL_CONCURRENCY_LIMIT=12

# 所有可能同时运行的同构四池实例数，包含升级重叠；四池MAX及专用worker并发总和按此倍数校验。
CELERY_WORKER_REPLICAS=1
# 多实例时必须显式指定；仅唯一实例 true，其余 false。此参数不是分布式锁。
CELERY_RUN_BEAT=true
AUTOSCALE_KEEPALIVE=60
# 旧 CELERY_CONCURRENCY 仅提示废弃并忽略，不会扩大四池并发，可删除。
# broker、结果后端和凭据沿用部署环境注入。

# 上游既有专用消费者计入总预算，不是新增 worker；全装时额外 2+2+1 槽。
DASHBOARD_REPORT_RENDER_CONCURRENCY=2
OPSPILOT_CELERY_CONCURRENCY=2
# patch_maintenance 固定并发1。INSTALL_APPS为空或包含opspilot时计入OpsPilot。
# 保留上游原生prefork回收策略；KiB阈值不是在途任务硬内存上限。
CELERY_MAX_TASKS_PER_CHILD=200
CELERY_MAX_MEMORY_PER_CHILD=512000
