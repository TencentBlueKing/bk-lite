# APM 数据面是运行期可降级依赖，不得从 batch_init 或 Server 启动入口等待这些地址。
# 下列回环地址仅用于契约夹具/本机验证；生产必须替换为中心侧受信地址并由运维环境注入。
APM_VICTORIATRACES_QUERY_ENDPOINT=http://127.0.0.1:10428
APM_VICTORIATRACES_QUERY_TIMEOUT=15
APM_VICTORIATRACES_VERIFY_TLS=true
APM_VICTORIATRACES_USER=
APM_VICTORIATRACES_PASSWORD=

# Beat 运行期健康探针。未配置的组件显示 pending，不阻断 API、Worker、Beat 或 Listener 启动。
APM_REGIONAL_COLLECTOR_HEALTH_ENDPOINT=http://127.0.0.1:13133/
APM_REGIONAL_COLLECTOR_METRICS_ENDPOINT=http://127.0.0.1:18888/metrics
APM_NATS_MONITOR_ENDPOINT=http://127.0.0.1:18222
APM_NATS_MONITOR_USER=
APM_NATS_MONITOR_PASSWORD=
APM_SYSTEM_COLLECTOR_HEALTH_ENDPOINT=http://127.0.0.1:23133/
APM_VICTORIATRACES_HEALTH_ENDPOINT=http://127.0.0.1:10428/health

# 与部署侧 Stream/Consumer 和保留期保持一致，用于容量与保留期健康判定。
APM_NATS_STREAM=APM_TRACES
APM_NATS_CONSUMER=BKLITE_APM_SYSTEM
APM_NATS_STREAM_MAX_BYTES=268435456
APM_TRACE_RETENTION=35d
