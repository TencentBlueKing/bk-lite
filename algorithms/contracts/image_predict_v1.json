    "code",
    "message",
    "details"
  ],
  "error_example": {
    "code": "E1000",
    "message": "invalid request",
    "details": {
      "stage": "request_validation"
    }
  },
  "response_fields": [
    "results",
    "metadata",
    "success",
    "error"
