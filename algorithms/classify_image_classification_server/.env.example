# ============================================
# 模型加载配置
# ============================================
# 可选值: dummy | local | mlflow
MODEL_SOURCE=dummy

# 本地模型配置 (当 MODEL_SOURCE=local 时使用)
# 示例: D:/Work/bk-lite/algorithms/mlruns/1/<run_id>/artifacts/model
MODEL_PATH=/path/to/local/model

# MLflow 配置 (当 MODEL_SOURCE=mlflow 时使用)
MLFLOW_TRACKING_URI=http://localhost:5000
# 示例: models:/yolo_classifier/1 或 models:/yolo_classifier/Production
MLFLOW_MODEL_URI=models:/yolo_classifier/production

# ============================================
# 日志配置
# ============================================
# 可选值: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ============================================
# BentoML 服务配置
# ============================================
# 服务监听地址
BENTOML_HOST=0.0.0.0
BENTOML_PORT=3001

# 工作进程数
BENTOML_WORKERS=1

# 请求超时(秒)
BENTOML_TIMEOUT=60

# 批量预测配置
MAX_BATCH_SIZE=100

# 单张图片完整 Base64/Data URI 的编码字节上限（默认 10 MiB）
MLOPS_PREDICT_MAX_IMAGE_BYTES=10485760

# 单请求完整 Base64/Data URI 的累计编码字节上限（默认 96 MiB）
MLOPS_PREDICT_MAX_IMAGE_BATCH_BASE64_BYTES=100663296

# 单请求 Base64 解码后累计字节上限（默认 64 MiB）
MLOPS_PREDICT_MAX_IMAGE_BATCH_BYTES=67108864

# 单请求累计图片像素上限（默认 64 MiPixels）
MLOPS_PREDICT_MAX_IMAGE_BATCH_PIXELS=67108864

# 以上预算仅接受正整数；空值、非法值、0 或负数会安全回退到默认值。
